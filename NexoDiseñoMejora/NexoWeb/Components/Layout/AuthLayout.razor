@* AuthLayout: layout exclusivo para pantallas de autenticacion (Login, y a futuro
   Recuperar Contrasena / Restablecer Contrasena, etc).

   A diferencia de MainLayout, este layout NO renderiza AppBar, Drawer ni NavMenu.
   Su unica responsabilidad es mostrar el "shell" visual de dos columnas
   (imagen + panel de formulario) y dejar que cada pagina inyecte su propio
   contenido dentro de @Body. No contiene logica de negocio ni de autenticacion. *@
@inherits LayoutComponentBase

<MudThemeProvider Theme="@NexoTheme.Theme" />
<MudPopoverProvider />
<MudSnackbarProvider />

<div class="auth-shell">
    <section class="auth-shell__visual" aria-hidden="true">
        <div class="auth-shell__visual-overlay"></div>

        <div class="auth-shell__blob auth-shell__blob--one"></div>
        <div class="auth-shell__blob auth-shell__blob--two"></div>
        <div class="auth-shell__blob auth-shell__blob--three"></div>

        <div class="auth-shell__brand">
            <img src="images/LogoV.png" alt="NEXO ERP" class="auth-shell__brand-mark" />
            <span class="auth-shell__brand-name">NEXO <strong>ERP</strong></span>
        </div>
        <div class="auth-shell__caption">
            <p class="auth-shell__caption-title">Gestion empresarial, sin fricciones.</p>
            <p class="auth-shell__caption-subtitle">
                Produccion, inventario, compras y catalogo en una sola plataforma.
            </p>
        </div>
    </section>

    @* Recorte en ondas: un SVG fluido (preserveAspectRatio="none") que se estira al
       alto de la pantalla y crea el borde organico entre la foto y el panel del
       formulario, en vez de una linea recta. El relleno usa var(--nexo-bg) para
       fusionarse exactamente con el fondo del panel derecho. *@
    <div class="auth-shell__divider" aria-hidden="true">
        <svg viewBox="0 0 200 1000" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path class="auth-shell__divider-path"
                  d="M120,0 C40,110 170,230 90,340 C10,450 175,540 110,660 C50,770 165,880 120,1000 L200,1000 L200,0 Z" />
        </svg>
    </div>

    <section class="auth-shell__panel">
        <div class="auth-shell__panel-inner">
            @Body
        </div>
    </section>
</div>