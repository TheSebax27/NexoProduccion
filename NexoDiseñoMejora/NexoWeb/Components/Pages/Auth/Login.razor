@page "/login"
@layout AuthLayout
@inject NexoWeb.Common.ApiClient.INexoApiClient ApiClient
@inject NexoWeb.Common.Auth.AuthStateService AuthState
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesion - NEXO ERP</PageTitle>

<div class="login-card">

    <div class="login-card__logo">
        <img src="images/LogoV.png" alt="NEXO ERP" class="login-card__logo-mark" />
        <span class="login-card__logo-text">NEXO <strong>ERP</strong></span>
    </div>

    <h1 class="login-card__title">Bienvenido de nuevo</h1>
    <p class="login-card__subtitle">
        Ingresa tus credenciales corporativas para acceder a tu panel de control.
    </p>

    <div class="login-field">
        <label class="login-field__label" for="login-usuario">Usuario</label>
        <div class="login-input">
            <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Class="login-input__icon" />
            <input id="login-usuario"
                   class="login-input__control"
                   type="text"
                   autocomplete="username"
                   placeholder="Ingresa tu usuario"
                   @bind="_username"
                   @bind:event="oninput"
                   disabled="@_cargando" />
        </div>
    </div>

    <div class="login-field">
        <label class="login-field__label" for="login-password">Contrasena</label>
        <div class="login-input">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" Class="login-input__icon" />
            <input id="login-password"
                   class="login-input__control"
                   type="@(_mostrarPassword ? "text" : "password")"
                   autocomplete="current-password"
                   placeholder="Ingresa tu contrasena"
                   @bind="_password"
                   @bind:event="oninput"
                   disabled="@_cargando" />
            <button type="button"
                    class="login-input__toggle"
                    title="@ObtenerTituloToggle()"
                    @onclick="() => _mostrarPassword = !_mostrarPassword">
                <MudIcon Icon="@(_mostrarPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                         Size="Size.Small" />
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="login-alert" role="alert">
            <MudIcon Icon="@Icons.Material.Outlined.Error" Size="Size.Small" />
            <span>@_error</span>
        </div>
    }

    <div class="login-card__row">
        <label class="login-checkbox">
            <input type="checkbox" @bind="_recordarme" disabled="@_cargando" />
            <span class="login-checkbox__box"></span>
            <span class="login-checkbox__label">Recordarme</span>
        </label>

        <a href="#" class="login-card__forgot">¿Olvidaste tu contrasena?</a>
    </div>

    <button type="button"
            class="login-card__submit"
            disabled="@_cargando"
            @onclick="EntrarAsync">
        @if (_cargando)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="login-card__spinner" />
            <span>Ingresando...</span>
        }
        else
        {
            <span>Iniciar sesion</span>
        }
    </button>

</div>

@code {
    private string _username = "";
    private string _password = "";
    private bool _mostrarPassword;
    private bool _recordarme;
    private string? _error;
    private bool _cargando;

    private string ObtenerTituloToggle() =>
        _mostrarPassword ? "Ocultar contrasena" : "Mostrar contrasena";

    private async Task EntrarAsync()
    {
        _error = null;
        _cargando = true;

        var respuesta = await ApiClient.LoginAsync(new NexoWeb.Common.Dtos.LoginRequest(_username, _password));

        _cargando = false;

        if (respuesta is null)
        {
            _error = "Usuario o contrasena incorrectos.";
            return;
        }

        await AuthState.IniciarSesionAsync(respuesta);
        Navegacion.NavigateTo("/", forceLoad: false);
    }
}