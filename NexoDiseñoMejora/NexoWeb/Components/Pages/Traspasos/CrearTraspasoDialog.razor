@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudSelect T="int" @bind-Value="_bodegaOrigenId" Label="Bodega Origen" Class="mb-3">
            @foreach (var bodega in Bodegas)
            {
                <MudSelectItem T="int" Value="@bodega.BodegaID">@bodega.Nombre (@bodega.CentroCosto)</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int" @bind-Value="_bodegaDestinoId" Label="Bodega Destino" Class="mb-4">
            @foreach (var bodega in Bodegas.Where(b => b.BodegaID != _bodegaOrigenId))
            {
                <MudSelectItem T="int" Value="@bodega.BodegaID">@bodega.Nombre (@bodega.CentroCosto)</MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Articulos a trasladar</MudText>

        @foreach (var linea in _lineas)
        {
            <MudGrid Class="mb-2" AlignItems="Center.Center">
                <MudItem xs="7">
                    <MudSelect T="int" @bind-Value="linea.ArticuloID" Label="Articulo" Dense="true">
                        @foreach (var articulo in Articulos)
                        {
                            <MudSelectItem T="int" Value="@articulo.ArticuloID">@articulo.SKU - @articulo.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="linea.Cantidad" Label="Cantidad" Min="0.01m" Dense="true" />
                </MudItem>
                <MudItem xs="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="@(() => _lineas.Remove(linea))" />
                </MudItem>
            </MudGrid>
        }

        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarLinea" Class="mt-2">
            Agregar articulo
        </MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirmar" Disabled="!FormularioValido">
            Enviar Traspaso
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public List<BodegaItem> Bodegas { get; set; } = new();
    [Parameter] public List<ArticuloItem> Articulos { get; set; } = new();

    private int _bodegaOrigenId;
    private int _bodegaDestinoId;
    private List<LineaFormulario> _lineas = new();

    private class LineaFormulario
    {
        public int ArticuloID { get; set; }
        public decimal Cantidad { get; set; }
    }

    private bool FormularioValido =>
        _bodegaOrigenId > 0 && _bodegaDestinoId > 0 && _bodegaOrigenId != _bodegaDestinoId &&
        _lineas.Count > 0 && _lineas.All(l => l.ArticuloID > 0 && l.Cantidad > 0);

    protected override void OnInitialized() => AgregarLinea();

    private void AgregarLinea() => _lineas.Add(new LineaFormulario());

    private void Confirmar()
    {
        var request = new CrearTraspasoRequest(
            _bodegaOrigenId, _bodegaDestinoId,
            _lineas.Select(l => new DetalleTraspasoRequest(l.ArticuloID, null, l.Cantidad)).ToList());

        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancelar() => MudDialog.Cancel();
}