@using NexoWeb.Common.ApiClient
@inject INexoApiClient ApiClient
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudMenu StartIcon="@(_descargando ? null : Icons.Material.Filled.FileDownload)"
         Label="@(_descargando ? "Generando…" : "Exportar")"
         Variant="Variant.Outlined" Color="Color.Default"
         Disabled="_descargando" EndIcon="@Icons.Material.Filled.ArrowDropDown">
    <MudMenuItem OnClick="DescargarAsync" Icon="@Icons.Material.Filled.TableView">
        Excel (.xlsx)
    </MudMenuItem>
</MudMenu>

@code {
    [Parameter] public string Endpoint { get; set; } = "";
    [Parameter] public string NombreArchivo { get; set; } = "exportacion";

    private bool _descargando;

    async Task DescargarAsync()
    {
        if (_descargando) return;
        _descargando = true;
        StateHasChanged();
        try
        {
            var bytes = await ApiClient.GetBytesAsync(Endpoint);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("nexoDescargarArchivo",
                $"{NombreArchivo}_{DateTime.Now:yyyyMMdd}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        catch
        {
            Snackbar.Add("No se pudo generar el archivo. Intente de nuevo.", Severity.Error);
        }
        finally
        {
            _descargando = false;
            StateHasChanged();
        }
    }
}
