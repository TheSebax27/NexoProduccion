@page "/produccion/recetas"
@attribute [Authorize(Roles = "Administrador,SupervisorPlanta")]
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navegacion
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@using NexoWeb.Common.Dtos

<PageTitle>Recetas (BOM) - NEXO</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Recetas (BOM)</MudText>
<InfoAyuda Texto="Define los insumos y cantidades necesarias para producir un artículo (BOM). Cada cambio importante crea una nueva versión, sin borrar ni afectar el historial de órdenes que usaron versiones anteriores." />

<MudGrid Class="mb-4" Justify="Justify.SpaceBetween">
    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="int?" Value="_filtroProductoId" ValueChanged="OnFiltroCambiadoAsync"
                   Label="Filtrar por Producto Terminado" Clearable="true">
            @foreach (var articulo in _articulos)
            {
                <MudSelectItem T="int?" Value="@articulo.ArticuloID">@articulo.Nombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem>
        <MudSwitch T="bool" @bind-Value="_soloActivas" Label="Solo versiones activas" Color="Color.Primary"
                   @bind-Value:after="CargarAsync" />
    </MudItem>
</MudGrid>

<MudButton Variant="Variant.Filled" Color="Color.Success" Href="/produccion/recetas/crear"
           StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
    Nueva Receta
</MudButton>

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar las recetas: @_errorCarga</MudAlert>
}
@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_recetas.Count == 0)
{
    <MudText>No hay recetas registradas para este filtro.</MudText>
}
else if (Preferencias.VistaListado == "tarjetas")
{
    <div class="nexo-card-grid">
        @foreach (var receta in _recetas)
        {
            <div class="nexo-item-card">
                <div class="d-flex align-center justify-space-between">
                    <div class="nexo-item-card__title">@receta.ProductoTerminado</div>
                    <MudChip T="string" Color="@(receta.Estado ? Color.Success : Color.Default)" Size="Size.Small">
                        @(receta.Estado ? "Activa" : "Reemplazada")
                    </MudChip>
                </div>
                <div class="nexo-item-card__sub">@receta.NombreReceta · v@(receta.Version)</div>
                <div class="nexo-item-card__row"><span>Rendimiento</span><strong>@receta.CantidadRendimientoBase.ToString("N2") @receta.UnidadRendimiento</strong></div>
                <div class="nexo-item-card__actions">
                    <MudButton Size="Size.Small" OnClick="@(() => VerDetalleAsync(receta))">Ver Insumos</MudButton>
                    @if (receta.Estado)
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary" Href="@($"/produccion/recetas/{receta.RecetaID}/nueva-version")">Nueva Versión</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => DesactivarAsync(receta))">Desactivar</MudButton>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <MudTable Items="_recetas" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>Producto Terminado</MudTh>
            <MudTh>Receta</MudTh>
            <MudTh>Version</MudTh>
            <MudTh>Rendimiento</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Producto Terminado">@context.ProductoTerminado</MudTd>
            <MudTd DataLabel="Receta">@context.NombreReceta</MudTd>
            <MudTd DataLabel="Version">v@(context.Version)</MudTd>
            <MudTd DataLabel="Rendimiento">@context.CantidadRendimientoBase.ToString("N2") @context.UnidadRendimiento</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="@(context.Estado ? Color.Success : Color.Default)" Size="Size.Small">
                    @(context.Estado ? "Activa" : "Reemplazada")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudButton Size="Size.Small" OnClick="@(() => VerDetalleAsync(context))">
                    Ver Insumos
                </MudButton>
                @if (context.Estado)
                {
                    <MudButton Size="Size.Small" Color="Color.Primary"
                               Href="@($"/produccion/recetas/{context.RecetaID}/nueva-version")">
                        Nueva Version
                    </MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DesactivarAsync(context))">
                        Desactivar
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay recetas registradas para este filtro.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<RecetaResumen> _recetas = new();
    private List<ArticuloItem> _articulos = new();
    private int? _filtroProductoId;
    private bool _soloActivas = true;
    private bool _cargando = true;
    private string? _errorCarga;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Se filtra por nombre de tipo, no por ID: los IDs de Catalogo.TiposArticulo
            // dependen del orden de insercion de los datos semilla y no son confiables
            // como numero fijo. Este selector es "Filtrar por Producto Terminado", no
            // debe listar Materia Prima/Insumo/Servicio.
            _articulos = (await ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos") ?? new())
                .Where(a => a.TipoArticulo == "Producto Terminado")
                .ToList();
            await CargarAsync();
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
            _cargando = false;
        }
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _errorCarga = null;

        try
        {
            var query = new List<string> { $"soloActivas={_soloActivas.ToString().ToLower()}" };
            if (_filtroProductoId.HasValue)
                query.Add($"productoTerminadoId={_filtroProductoId}");

            var ruta = "api/produccion/recetas?" + string.Join("&", query);
            _recetas = await ApiClient.GetAsync<List<RecetaResumen>>(ruta) ?? new();
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task OnFiltroCambiadoAsync(int? nuevoValor)
    {
        _filtroProductoId = nuevoValor;
        await CargarAsync();
    }

    private async Task DesactivarAsync(RecetaResumen receta)
    {
        var confirmacion = await DialogService.ShowMessageBox(
            "Desactivar Receta",
            $"Esta receta no vuelve a estar disponible para crear ordenes de produccion. " +
            $"No se borra: las ordenes que ya la usaron siguen mostrando su historial correctamente.\n\n" +
            $"Receta: {receta.NombreReceta} (v{receta.Version})\n\n" +
            "¿Confirmar?",
            yesText: "Si, desactivar",
            noText: "Cancelar");

        if (confirmacion != true)
            return;

        try
        {
            await ApiClient.DeleteAsync($"api/produccion/recetas/{receta.RecetaID}");
            Snackbar.Add("Receta desactivada correctamente.", Severity.Success);
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task VerDetalleAsync(RecetaResumen receta)
    {
        var parametros = new DialogParameters<RecetaDetalleDialog>
        {
            { x => x.RecetaID, receta.RecetaID }
        };

        await DialogService.ShowAsync<RecetaDetalleDialog>(
            $"Insumos de: {receta.NombreReceta} (v{receta.Version})", parametros);
    }
}