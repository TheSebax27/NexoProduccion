@page "/produccion/recetas/crear"
@page "/produccion/recetas/{RecetaBaseId:int}/nueva-version"
@attribute [Authorize(Roles = "Administracion,Jefes")]
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navegacion
@using NexoWeb.Common.Dtos

<PageTitle>@(EsNuevaVersion ? "Nueva Version de Receta" : "Nueva Receta") - NEXO</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">
    @(EsNuevaVersion ? $"Nueva Version de Receta" : "Nueva Receta (BOM)")
</MudText>

@if (_cargandoCatalogos)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <MudPaper Class="pa-6 mb-4" MaxWidth="700px">
        @if (!EsNuevaVersion)
        {
            <MudSelect T="int?" Value="_productoTerminadoId" ValueChanged="@((int? v) => _productoTerminadoId = v)"
                       Label="Producto Terminado" Placeholder="Selecciona el artículo que produce esta receta"
                       Class="mb-4" Required="true">
                @foreach (var articulo in _productosTerminados)
                {
                    <MudSelectItem T="int?" Value="@((int?)articulo.ArticuloID)">@articulo.Nombre</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Estas creando una nueva version de la receta. La version actual se desactivara
                automaticamente al guardar (no se elimina, queda en el historial).
            </MudAlert>
        }

        <MudTextField @bind-Value="_nombreReceta" Label="Nombre de la Receta" Class="mb-4" Required="true" />

        <MudNumericField @bind-Value="_cantidadRendimientoBase" Label="Cantidad de Rendimiento Base"
                         Min="0.001m" Format="N2" Class="mb-4" Required="true"
                         HelperText="¿Cuántas unidades produce una corrida de esta receta?" />

        <MudSelect T="int?" Value="_unidadRendimientoId" ValueChanged="@((int? v) => _unidadRendimientoId = v)"
                   Label="Unidad de Rendimiento" Placeholder="Selecciona unidad de medida"
                   Class="mb-2" Required="true">
            @foreach (var unidad in _unidadesMedida)
            {
                <MudSelectItem T="int?" Value="@((int?)unidad.UnidadID)">@unidad.Nombre (@unidad.Abreviatura)</MudSelectItem>
            }
        </MudSelect>
        @if (EsUnidadCajaRendimiento)
        {
            <MudNumericField @bind-Value="_unidadesPorCaja" Label="Unidades individuales por caja (opcional)"
                             Min="1m" Format="N0" Class="mb-4"
                             HelperText="Si esta receta produce cajas, indica cuántas unidades trae cada caja para facilitar el cálculo de costos." />
        }
        else
        {
            <div class="mb-4" />
        }
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mb-2">Insumos de la Receta</MudText>

    <MudTable Items="_lineas" Dense="true" Hover="true" Class="mb-4">
        <HeaderContent>
            <MudTh>Insumo</MudTh>
            <MudTh>Cantidad</MudTh>
            <MudTh>Unidad</MudTh>
            <MudTh>% Merma Std.</MudTh>
            <MudTh>Centro de Trabajo</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @{
                var art = _insumosDisponibles.FirstOrDefault(a => a.ArticuloID == context.InsumoID);
                var esCaja = art?.EsUnidadCaja == true;
            }
            <MudTd DataLabel="Insumo">
                <MudSelect T="int?" Value="@((int?)context.InsumoID)"
                           ValueChanged="@((int? v) => OnInsumoSeleccionado(context, v))"
                           Dense="true" Placeholder="Selecciona un insumo">
                    @foreach (var articulo in _insumosDisponibles)
                    {
                        <MudSelectItem T="int?" Value="@((int?)articulo.ArticuloID)">
                            @articulo.Nombre
                            @if (articulo.EsUnidadCaja)
                            {
                                <text> (@articulo.UnidadesPorEmbalaje.Value.ToString("N0") u/cja)</text>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Cantidad">
                @if (esCaja)
                {
                    <div>
                        <MudNumericField @bind-Value="context.CantidadRequerida" Min="0.001m" Format="N3" Dense="true"
                                         HelperText="@($"cajas · {(context.CantidadRequerida * (art!.UnidadesPorEmbalaje ?? 1)).ToString("N0")} u")" />
                    </div>
                }
                else
                {
                    <MudNumericField @bind-Value="context.CantidadRequerida" Min="0.001m" Format="N3" Dense="true" />
                }
            </MudTd>
            <MudTd DataLabel="Unidad">
                @if (art is not null)
                {
                    <MudText Typo="Typo.body2">@(art.Unidad ?? "-")</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                }
            </MudTd>
            <MudTd DataLabel="% Merma Std.">
                <MudNumericField @bind-Value="context.PorcentajeMermaEstandar" Min="0m" Max="100m" Format="N1" Dense="true" />
            </MudTd>
            <MudTd DataLabel="Centro de Trabajo">
                <MudSelect T="int?" @bind-Value="context.CentroTrabajoID" Dense="true" Clearable="true">
                    @foreach (var centro in _centrosTrabajo)
                    {
                        <MudSelectItem T="int?" Value="@((int?)centro.CentroTrabajoID)">@centro.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                               OnClick="@(() => QuitarLinea(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Agrega al menos un insumo.</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarLinea" Class="mb-4">
        Agregar Insumo
    </MudButton>

    <br />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync"
               Disabled="@(!FormularioValido || _guardando)" StartIcon="@Icons.Material.Filled.Save">
        @(_guardando ? "Guardando..." : "Guardar Receta")
    </MudButton>
}

@code {
    // Si viene con valor, la pagina esta en modo "nueva version" de esta receta base.
    [Parameter] public int? RecetaBaseId { get; set; }

    private bool EsNuevaVersion => RecetaBaseId.HasValue;

    // Catalogos para llenar los desplegables
    private List<ArticuloItem> _articulos = new();
    private List<UnidadMedidaItem> _unidadesMedida = new();
    private List<CentroTrabajoItem> _centrosTrabajo = new();

    // Un Producto Terminado es lo que la receta PRODUCE; los insumos (Materia
    // Prima/Insumo/Servicio) son lo que la receta CONSUME. Servicio se incluye
    // porque cosas como una licencia de Windows tambien se "consumen" al armar
    // un producto (ej. un Computador necesita 1 licencia). No tiene sentido
    // mezclar Producto Terminado: no se elige como insumo de si mismo.
    private List<ArticuloItem> _productosTerminados => _articulos.Where(a => a.TipoArticulo == "Producto Terminado").ToList();
    private List<ArticuloItem> _insumosDisponibles => _articulos.Where(a => a.TipoArticulo is "Materia Prima" or "Insumo" or "Servicio").ToList();

    // Encabezado del formulario
    private int? _productoTerminadoId;
    private string _nombreReceta = string.Empty;
    private decimal _cantidadRendimientoBase = 1;
    private int? _unidadRendimientoId;
    private decimal? _unidadesPorCaja;

    private bool EsUnidadCajaRendimiento =>
        _unidadesMedida.FirstOrDefault(u => u.UnidadID == _unidadRendimientoId)?.Abreviatura == "cja";

    // Lineas dinamicas: se manejan como clase mutable en la UI y se convierten
    // a record inmutable (DetalleRecetaRequest) recien al enviar, siguiendo la
    // misma convencion que ya usa el resto del proyecto para formularios dinamicos.
    private class LineaRecetaEditable
    {
        public int InsumoID { get; set; }
        public decimal CantidadRequerida { get; set; }
        public int UnidadID { get; set; }
        public decimal PorcentajeMermaEstandar { get; set; }
        public int? CentroTrabajoID { get; set; }
    }

    private List<LineaRecetaEditable> _lineas = new();

    private bool _cargandoCatalogos = true;
    private bool _guardando;

    private bool FormularioValido =>
        !string.IsNullOrWhiteSpace(_nombreReceta) && _cantidadRendimientoBase > 0 &&
        _unidadRendimientoId is > 0 && (EsNuevaVersion || _productoTerminadoId is > 0) &&
        _lineas.Count > 0 && _lineas.All(l => l.InsumoID > 0 && l.CantidadRequerida > 0 && l.UnidadID > 0);

    protected override async Task OnInitializedAsync()
    {
        var tareaArticulos = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos");
        var tareaUnidades = ApiClient.GetAsync<List<UnidadMedidaItem>>("api/catalogo/articulos/unidades");
        var tareaCentrosTrabajo = ApiClient.GetAsync<List<CentroTrabajoItem>>("api/catalogo/centros-trabajo");

        await Task.WhenAll(tareaArticulos, tareaUnidades, tareaCentrosTrabajo);

        _articulos = await tareaArticulos ?? new();
        _unidadesMedida = await tareaUnidades ?? new();
        _centrosTrabajo = await tareaCentrosTrabajo ?? new();

        if (EsNuevaVersion)
        {
            // Precargamos nombre, rendimiento e insumos de la version actual para
            // que el usuario solo tenga que ajustar lo que cambio.
            var detalleActual = await ApiClient.GetAsync<List<RecetaDetalleItem>>(
                $"api/produccion/recetas/{RecetaBaseId}/detalle") ?? new();

            _lineas = detalleActual
                .OrderBy(d => d.Orden)
                .Select(d => new LineaRecetaEditable
                {
                    InsumoID = d.InsumoID,
                    CantidadRequerida = d.CantidadRequerida,
                    UnidadID = _unidadesMedida.FirstOrDefault(u => u.Abreviatura == d.Unidad)?.UnidadID ?? 0,
                    PorcentajeMermaEstandar = d.PorcentajeMermaEstandar,
                    CentroTrabajoID = d.CentroTrabajoID
                })
                .ToList();
        }
        else
        {
            AgregarLinea();
        }

        _cargandoCatalogos = false;
    }

    private void AgregarLinea() => _lineas.Add(new LineaRecetaEditable());

    private void QuitarLinea(LineaRecetaEditable linea) => _lineas.Remove(linea);

    private void OnInsumoSeleccionado(LineaRecetaEditable linea, int? articuloId)
    {
        linea.InsumoID = articuloId ?? 0;
        // Auto-rellena la unidad del artículo seleccionado
        var art = _insumosDisponibles.FirstOrDefault(a => a.ArticuloID == articuloId);
        if (art is not null)
            linea.UnidadID = _unidadesMedida.FirstOrDefault(u => u.Abreviatura == art.Unidad)?.UnidadID ?? 0;
    }

    private async Task GuardarAsync()
    {
        _guardando = true;

        try
        {
            var detalle = _lineas
                .Select((linea, indice) => new DetalleRecetaRequest(
                    linea.InsumoID, linea.CantidadRequerida, linea.UnidadID,
                    linea.PorcentajeMermaEstandar, linea.CentroTrabajoID, indice + 1))
                .ToList();

            if (EsNuevaVersion)
            {
                var request = new CrearNuevaVersionRequest(
                    _nombreReceta, _cantidadRendimientoBase, _unidadRendimientoId!.Value, detalle);

                await ApiClient.PostAsync<CrearNuevaVersionRequest, object?>(
                    $"api/produccion/recetas/{RecetaBaseId}/nueva-version", request);
            }
            else
            {
                var request = new CrearRecetaRequest(
                    _productoTerminadoId!.Value, _nombreReceta, _cantidadRendimientoBase, _unidadRendimientoId!.Value, detalle);

                await ApiClient.PostAsync<CrearRecetaRequest, object?>("api/produccion/recetas", request);
            }

            Snackbar.Add("Receta guardada correctamente.", Severity.Success);
            Navegacion.NavigateTo("/produccion/recetas");
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }
}