@page "/produccion/recetas/crear"
@page "/produccion/recetas/{RecetaBaseId:int}/nueva-version"
@attribute [Authorize]
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navegacion
@using NexoWeb.Common.Dtos

<PageTitle>@(EsNuevaVersion ? "Nueva Version de Receta" : "Nueva Receta") - NEXO</PageTitle>

<div class="nexo-page-header">
    <nav class="nexo-page-header__breadcrumb">
        <a class="nexo-page-header__crumb-link" href="/produccion/recetas">Recetas (BOM)</a>
        <span class="nexo-page-header__crumb-sep">›</span>
        <span class="nexo-page-header__crumb-cur">@(EsNuevaVersion ? "Nueva versión" : "Nueva receta")</span>
    </nav>
    <div class="nexo-page-header__body">
        <div>
            <h1 class="nexo-page-header__title">@(EsNuevaVersion ? "Nueva versión de receta" : "Nueva Receta (BOM)")</h1>
            <p class="nexo-page-header__sub">Define el producto terminado, los insumos y la maquinaria de esta receta.</p>
        </div>
    </div>
</div>

@if (_cargandoCatalogos)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <div class="nexo-form-layout">

    @* ── Datos generales ── *@
    <div class="nexo-section">
        <div class="nexo-section__header">
            <div class="nexo-section__icon" style="background:rgba(124,92,255,0.10);">
                <MudIcon Icon="@Icons.Material.Outlined.Assignment" Style="color:var(--n-purple); font-size:1.25rem;" />
            </div>
            <div>
                <div class="nexo-section__title">Datos generales</div>
                <div class="nexo-section__sub">Producto terminado, nombre y rendimiento de la receta</div>
            </div>
        </div>
        <div class="nexo-section__body">
        @if (!EsNuevaVersion)
        {
            <MudAutocomplete T="ArticuloItem"
                             @bind-Value="_productoTerminado"
                             SearchFunc="BuscarProductosTerminados"
                             ToStringFunc="@(a => a?.Nombre ?? "")"
                             Label="Producto Terminado*"
                             Placeholder="Escribe para buscar el artículo que produce esta receta"
                             Class="mb-4"
                             MinCharacters="1"
                             Clearable="true"
                             CoerceText="true"
                             ResetValueOnEmptyText="true" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Estás creando una nueva versión de la receta. La versión actual se desactivará
                automáticamente al guardar (no se elimina, queda en el historial).
            </MudAlert>
        }

        <MudTextField @bind-Value="_nombreReceta" Label="Nombre de la Receta" Class="mb-4" Required="true" Variant="Variant.Outlined" />

        <MudNumericField @bind-Value="_cantidadRendimientoBase" Label="Cantidad de Rendimiento Base"
                         Min="0.001m" Format="N2" Class="mb-1" Required="true" Variant="Variant.Outlined"
                         HelperText="¿Cuántas unidades produce una corrida de esta receta?" />
        </div>
    </div>

    @* ── Insumos ── *@
    <div class="nexo-section">
        <div class="nexo-section__header" style="justify-content:space-between;">
            <div class="d-flex align-center" style="gap:0.85rem;">
                <div class="nexo-section__icon" style="background:rgba(239,68,68,0.10);">
                    <MudIcon Icon="@Icons.Material.Outlined.Inventory" Style="color:#EF4444; font-size:1.25rem;" />
                </div>
                <div>
                    <div class="nexo-section__title">Insumos de la Receta</div>
                    <div class="nexo-section__sub">Materias primas y cantidades requeridas por lote</div>
                </div>
            </div>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarLinea">
                Agregar insumo
            </MudButton>
        </div>
        <div class="nexo-section__body" style="padding:0; overflow-x:auto;">

    <MudTable Items="_lineas" Dense="true" Hover="true" Class="mb-0" Elevation="0">
        <HeaderContent>
            <MudTh>Insumo</MudTh>
            <MudTh>Cantidad</MudTh>
            <MudTh>Presentación</MudTh>
            <MudTh>% Merma Std.</MudTh>
            <MudTh>Centro de Trabajo</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @{
                var esCaja = context.ArticuloSeleccionado?.EsUnidadCaja == true;
            }
            <MudTd DataLabel="Insumo">
                <MudAutocomplete T="ArticuloItem"
                                 Value="context.ArticuloSeleccionado"
                                 ValueChanged="@((ArticuloItem a) => OnInsumoSeleccionado(context, a))"
                                 SearchFunc="BuscarInsumos"
                                 ToStringFunc="@(a => a is null ? "" : FormatearInsumo(a))"
                                 Placeholder="Escribe para buscar insumo"
                                 Dense="true"
                                 MinCharacters="1"
                                 Clearable="true"
                                 CoerceText="true"
                                 ResetValueOnEmptyText="true" />
            </MudTd>
            <MudTd DataLabel="Cantidad">
                @if (esCaja)
                {
                    <div>
                        <MudNumericField @bind-Value="context.CantidadRequerida" Min="0.001m" Format="N3" Dense="true"
                                         HelperText="@($"cajas · {(context.CantidadRequerida * (context.ArticuloSeleccionado!.UnidadesPorEmbalaje ?? 1)).ToString("N0")} u")" />
                    </div>
                }
                else
                {
                    <MudNumericField @bind-Value="context.CantidadRequerida" Min="0.001m" Format="N3" Dense="true" />
                }
            </MudTd>
            <MudTd DataLabel="Presentación">
                @if (context.ArticuloSeleccionado is not null)
                {
                    <MudText Typo="Typo.body2">@(context.ArticuloSeleccionado.PresentacionNombre ?? context.ArticuloSeleccionado.PresentacionCodigo ?? "-")</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                }
            </MudTd>
            <MudTd DataLabel="% Merma Std.">
                <MudNumericField @bind-Value="context.PorcentajeMermaEstandar" Min="0m" Max="100m" Format="N1" Dense="true" />
            </MudTd>
            <MudTd DataLabel="Centro de Trabajo">
                <MudSelect T="int?" @bind-Value="context.CentroTrabajoID" Dense="true" Clearable="true">
                    @foreach (var centro in _centrosTrabajo)
                    {
                        <MudSelectItem T="int?" Value="@((int?)centro.CentroTrabajoID)">@centro.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                               OnClick="@(() => QuitarLinea(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Agrega al menos un insumo.</MudText>
        </NoRecordsContent>
    </MudTable>

        </div>
    </div>

    </div>@* fin nexo-form-layout *@
}

<div class="nexo-action-bar">
    <div class="nexo-action-bar__inner">
        <MudButton Variant="Variant.Outlined"
                   Style="border-color:var(--n-border-2); color:var(--n-text-2);"
                   OnClick="@(() => Navegacion.NavigateTo("/produccion/recetas"))">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync"
                   Disabled="@(!FormularioValido || _guardando)" StartIcon="@Icons.Material.Filled.Save">
            @(_guardando ? "Guardando..." : "Guardar Receta")
        </MudButton>
    </div>
</div>

@code {
    [Parameter] public int? RecetaBaseId { get; set; }
    [SupplyParameterFromQuery] public int? ArticuloId { get; set; }

    private bool EsNuevaVersion => RecetaBaseId.HasValue;

    private List<CentroTrabajoItem> _centrosTrabajo = new();

    private ArticuloItem? _productoTerminado;
    private string _nombreReceta = string.Empty;
    private decimal _cantidadRendimientoBase = 1;

    private class LineaRecetaEditable
    {
        public int InsumoID { get; set; }
        public ArticuloItem? ArticuloSeleccionado { get; set; }
        public decimal CantidadRequerida { get; set; }
        public decimal PorcentajeMermaEstandar { get; set; }
        public int? CentroTrabajoID { get; set; }
    }

    private List<LineaRecetaEditable> _lineas = new();


    private bool _cargandoCatalogos = true;
    private bool _guardando;

    private bool FormularioValido =>
        !string.IsNullOrWhiteSpace(_nombreReceta) && _cantidadRendimientoBase > 0 &&
        (EsNuevaVersion || _productoTerminado?.ArticuloID is > 0) &&
        _lineas.Count > 0 && _lineas.All(l => l.InsumoID > 0 && l.CantidadRequerida > 0);

    protected override async Task OnInitializedAsync()
    {
        _centrosTrabajo = await ApiClient.GetAsync<List<CentroTrabajoItem>>("api/catalogo/centros-trabajo") ?? new();

        if (EsNuevaVersion)
        {
            var detalleActual = await ApiClient.GetAsync<List<RecetaDetalleItem>>($"api/produccion/recetas/{RecetaBaseId}/detalle") ?? new();

            // Para cada insumo de la receta existente, cargar el artículo desde la API
            var idsInsumos = detalleActual.Select(d => d.InsumoID).Distinct().ToList();
            var articulos = new Dictionary<int, ArticuloItem>();
            foreach (var id in idsInsumos)
            {
                var art = await ApiClient.GetAsync<ArticuloItem>($"api/catalogo/articulos/{id}");
                if (art is not null) articulos[id] = art;
            }

            _lineas = detalleActual
                .OrderBy(d => d.Orden)
                .Select(d => new LineaRecetaEditable
                {
                    InsumoID = d.InsumoID,
                    ArticuloSeleccionado = articulos.GetValueOrDefault(d.InsumoID),
                    CantidadRequerida = d.CantidadRequerida,
                    PorcentajeMermaEstandar = d.PorcentajeMermaEstandar,
                    CentroTrabajoID = d.CentroTrabajoID
                })
                .ToList();

        }
        else
        {
            AgregarLinea();
            if (ArticuloId.HasValue)
            {
                _productoTerminado = await ApiClient.GetAsync<ArticuloItem>($"api/catalogo/articulos/{ArticuloId.Value}");
            }
        }

        _cargandoCatalogos = false;
    }

    private async Task<IEnumerable<ArticuloItem>> BuscarProductosTerminados(string texto, CancellationToken ct)
    {
        var resultado = await ApiClient.GetAsync<List<ArticuloItem>>(
            $"api/catalogo/articulos/buscar?q={Uri.EscapeDataString(texto ?? "")}&soloTerminados=true&max=30");
        return resultado ?? [];
    }

    private async Task<IEnumerable<ArticuloItem>> BuscarInsumos(string texto, CancellationToken ct)
    {
        var resultado = await ApiClient.GetAsync<List<ArticuloItem>>(
            $"api/catalogo/articulos/buscar?q={Uri.EscapeDataString(texto ?? "")}&max=30");
        return resultado ?? [];
    }

    private static string FormatearInsumo(ArticuloItem a)
    {
        var base_ = $"{a.Referencia} — {a.Nombre}";
        if (a.EsUnidadCaja)
            return $"{base_} ({a.UnidadesPorEmbalaje?.ToString("N0")} u/cja)";
        if (a.TipoArticulo == "Producto Terminado")
            return $"{base_} [PT]";
        return base_;
    }

    private void AgregarLinea() => _lineas.Add(new LineaRecetaEditable());

    private void QuitarLinea(LineaRecetaEditable linea) => _lineas.Remove(linea);

    private void OnInsumoSeleccionado(LineaRecetaEditable linea, ArticuloItem articulo)
    {
        linea.ArticuloSeleccionado = articulo;
        linea.InsumoID = articulo?.ArticuloID ?? 0;
    }

    private async Task GuardarAsync()
    {
        _guardando = true;

        try
        {
            var detalle = _lineas
                .Select((linea, indice) => new DetalleRecetaRequest(
                    linea.InsumoID, linea.CantidadRequerida,
                    linea.PorcentajeMermaEstandar, linea.CentroTrabajoID, indice + 1))
                .ToList();

            if (EsNuevaVersion)
            {
                var request = new CrearNuevaVersionRequest(
                    _nombreReceta, _cantidadRendimientoBase, detalle);

                await ApiClient.PostAsync<CrearNuevaVersionRequest, object?>(
                    $"api/produccion/recetas/{RecetaBaseId}/nueva-version", request);
            }
            else
            {
                var request = new CrearRecetaRequest(
                    _productoTerminado!.ArticuloID, _nombreReceta, _cantidadRendimientoBase, detalle);

                await ApiClient.PostAsync<CrearRecetaRequest, object?>("api/produccion/recetas", request);
            }

            Snackbar.Add("Receta guardada correctamente.", Severity.Success);
            Navegacion.NavigateTo("/produccion/recetas");
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }
}
