@page "/produccion/ordenes/crear"
@page "/produccion/ordenes/{OrdenProduccionId:int}/editar"
@attribute [Authorize(Roles = "Administrador,SupervisorPlanta")]
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navegacion
@using NexoWeb.Common.Dtos

<PageTitle>@(EsEdicion ? "Editar Orden de Produccion" : "Nueva Orden de Produccion") - NEXO</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@(EsEdicion ? $"Editar Orden {_codigoOp}" : "Nueva Orden de Produccion")</MudText>

@if (_cargandoCatalogos)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    @if (EsEdicion)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Solo se puede editar mientras la orden esta en estado Planificada (aun no se ha
            descontado materia prima). El codigo de la OP no se puede cambiar.
        </MudAlert>
    }
    <MudPaper Class="pa-6" MaxWidth="700px">
        <MudTextField @bind-Value="_codigoOp" Label="Codigo de la OP"
                      Class="mb-4" Required="true" Disabled="@EsEdicion"
                      HelperText="@(EsEdicion ? "No se puede cambiar una vez creada la orden." : null)" />

        <MudSelect T="int?" Value="_tipoProduccionId" ValueChanged="OnTipoProduccionCambiadoAsync"
                   Label="Tipo de Produccion" Placeholder="Selecciona un tipo" Class="mb-4" Required="true">
            @foreach (var tipo in _tiposProduccion)
            {
                <MudSelectItem T="int?" Value="@((int?)tipo.TipoProduccionID)">@tipo.Nombre</MudSelectItem>
            }
        </MudSelect>

        @if (_esMto)
        {
            <MudSelect T="int?" @bind-Value="_clienteId" Label="Cliente" Class="mb-4" Required="true">
                @foreach (var cliente in _clientes)
                {
                    <MudSelectItem T="int?" Value="@((int?)cliente.ClienteID)">@cliente.Nombre</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSelect T="int?" Value="_productoTerminadoId" ValueChanged="OnProductoTerminadoCambiadoAsync"
                   Label="Producto Terminado" Placeholder="Selecciona un producto terminado" Class="mb-4" Required="true">
            @foreach (var producto in _productosTerminados)
            {
                <MudSelectItem T="int?" Value="@((int?)producto.ArticuloID)">@producto.SKU - @producto.Nombre</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int?" @bind-Value="_recetaId" Label="Receta (BOM)" Placeholder="Selecciona una receta" Class="mb-4" Required="true"
                   Disabled="@(!_productoTerminadoId.HasValue)">
            @foreach (var receta in _recetas)
            {
                <MudSelectItem T="int?" Value="@((int?)receta.RecetaID)">@receta.NombreReceta (v@(receta.Version))</MudSelectItem>
            }
        </MudSelect>
        @if (_productoTerminadoId.HasValue && _recetas.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                Este producto no tiene ninguna receta activa. Crea una receta antes de continuar.
            </MudAlert>
        }

        <MudNumericField @bind-Value="_cantidadProgramada" Label="Cantidad programada" Min="0.01m" Format="N2" Class="mb-4" Required="true" />

        <MudSelect T="int?" @bind-Value="_centroCostoDestinoId" Label="Centro de Costo Destino"
                   Placeholder="Selecciona un centro de costo" Class="mb-4" Required="true">
            @foreach (var centro in _centrosCosto)
            {
                <MudSelectItem T="int?" Value="@((int?)centro.CentroCostoID)">@centro.Nombre</MudSelectItem>
            }
        </MudSelect>

        <MudSwitch T="bool" Value="_produccionLocal" ValueChanged="OnProduccionLocalCambiadaAsync"
                   Label="Produccion local (misma bodega para materia prima y producto terminado)"
                   Color="Color.Primary" Class="mb-2" />
        <MudText Typo="Typo.caption" Class="mb-4 d-block" Style="color: var(--n-text-3, #9B9BB4);">
            @(_produccionLocal
                ? "Se usara una sola bodega tanto para consumir materia prima como para almacenar el producto terminado."
                : "Se usaran bodegas distintas de origen (materia prima) y destino (producto terminado).")
        </MudText>

        @if (_produccionLocal)
        {
            <MudSelect T="int?" Value="_bodegaLocalId" ValueChanged="OnBodegaLocalCambiadaAsync"
                       Label="Bodega (Materia Prima y Producto Terminado)" Placeholder="Selecciona una bodega" Class="mb-4" Required="true">
                @foreach (var bodega in _todasLasBodegas)
                {
                    <MudSelectItem T="int?" Value="@((int?)bodega.BodegaID)">@bodega.Nombre (@bodega.CentroCosto)</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudSelect T="int?" @bind-Value="_bodegaOrigenMpId" Label="Bodega Origen (Materia Prima)"
                       Placeholder="Selecciona una bodega" Class="mb-4" Required="true">
                @foreach (var bodega in _bodegasMateriaPrima)
                {
                    <MudSelectItem T="int?" Value="@((int?)bodega.BodegaID)">@bodega.Nombre (@bodega.CentroCosto)</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?" @bind-Value="_bodegaDestinoPtId" Label="Bodega Destino (Producto Terminado)"
                       Placeholder="Selecciona una bodega" Class="mb-4" Required="true">
                @foreach (var bodega in _bodegasProductoTerminado)
                {
                    <MudSelectItem T="int?" Value="@((int?)bodega.BodegaID)">@bodega.Nombre (@bodega.CentroCosto)</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSelect T="int?" @bind-Value="_centroTrabajoId" Label="Centro de Trabajo (opcional)" Class="mb-4" Clearable="true">
            @foreach (var centro in _centrosTrabajo)
            {
                <MudSelectItem T="int?" Value="@((int?)centro.CentroTrabajoID)">@centro.Nombre</MudSelectItem>
            }
        </MudSelect>

        <MudDatePicker @bind-Date="_fechaPlanificada" Label="Fecha planificada" Class="mb-4" PickerVariant="PickerVariant.Dialog" DateFormat="dd/MM/yyyy" />

        <MudTextField @bind-Value="_observaciones" Label="Observaciones (opcional)" Lines="2" Class="mb-4" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync"
                   Disabled="@(!FormularioValido || _guardando)" StartIcon="@Icons.Material.Filled.Save">
            @(_guardando ? "Guardando..." : (EsEdicion ? "Guardar Cambios" : "Crear Orden"))
        </MudButton>
    </MudPaper>
}

@code {
    [Parameter] public int? OrdenProduccionId { get; set; }

    private bool EsEdicion => OrdenProduccionId.HasValue;

    // Catalogos para llenar los desplegables
    private List<TipoProduccionItem> _tiposProduccion = new();
    private List<ClienteItem> _clientes = new();
    private List<ArticuloItem> _productosTerminados = new();
    private List<RecetaResumen> _recetas = new();
    private List<CentroCostoItem> _centrosCosto = new();
    private List<BodegaItem> _bodegasMateriaPrima = new();
    private List<BodegaItem> _bodegasProductoTerminado = new();
    private List<BodegaItem> _todasLasBodegas = new();
    private List<CentroTrabajoItem> _centrosTrabajo = new();

    // Valores del formulario. Los desplegables obligatorios se manejan como
    // int? (en vez de int) para que MudSelect muestre el Placeholder mientras
    // no hay seleccion, en lugar del valor por defecto "0" tal cual.
    private string _codigoOp = "";
    private int? _tipoProduccionId;
    private bool _esMto;
    private int? _clienteId;
    private int? _productoTerminadoId;
    private int? _recetaId;
    private decimal _cantidadProgramada;
    private int? _centroCostoDestinoId;
    private int? _bodegaOrigenMpId;
    private int? _bodegaDestinoPtId;
    private bool _produccionLocal;
    private int? _bodegaLocalId;
    private int? _centroTrabajoId;
    private DateTime? _fechaPlanificada = DateTime.Today.AddDays(1);
    private string? _observaciones;

    private bool _cargandoCatalogos = true;
    private bool _guardando;

    private bool FormularioValido =>
        !string.IsNullOrWhiteSpace(_codigoOp) && _tipoProduccionId.HasValue &&
        _productoTerminadoId.HasValue && _recetaId.HasValue && _cantidadProgramada > 0 &&
        _centroCostoDestinoId.HasValue && _bodegaOrigenMpId.HasValue && _bodegaDestinoPtId.HasValue &&
        (!_esMto || _clienteId.HasValue);

    protected override async Task OnInitializedAsync()
    {
        var tareaTipos = ApiClient.GetAsync<List<TipoProduccionItem>>("api/produccion/ordenes/tipos-produccion");
        var tareaClientes = ApiClient.GetAsync<List<ClienteItem>>("api/catalogo/clientes");
        // Se filtra por nombre de tipo, no por ID: los IDs de Catalogo.TiposArticulo
        // dependen del orden de insercion de los datos semilla y no son confiables
        // como numero fijo (antes esto apuntaba por error al tipo Insumo).
        var tareaProductos = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos");
        var tareaCentrosCosto = ApiClient.GetAsync<List<CentroCostoItem>>("api/catalogo/centros-costo");
        var tareaBodegas = ApiClient.GetAsync<List<BodegaItem>>("api/catalogo/bodegas");
        var tareaCentrosTrabajo = ApiClient.GetAsync<List<CentroTrabajoItem>>("api/catalogo/centros-trabajo");

        await Task.WhenAll(tareaTipos, tareaClientes, tareaProductos, tareaCentrosCosto, tareaBodegas, tareaCentrosTrabajo);

        _tiposProduccion = await tareaTipos ?? new();
        _clientes = await tareaClientes ?? new();
        _productosTerminados = (await tareaProductos ?? new())
            .Where(a => a.TipoArticulo == "Producto Terminado")
            .ToList();
        _centrosCosto = await tareaCentrosCosto ?? new();
        _centrosTrabajo = await tareaCentrosTrabajo ?? new();

        _todasLasBodegas = await tareaBodegas ?? new();
        _bodegasMateriaPrima = _todasLasBodegas.Where(b => b.TipoBodega == "MATERIA_PRIMA").ToList();
        _bodegasProductoTerminado = _todasLasBodegas.Where(b => b.TipoBodega == "PRODUCTO_TERMINADO").ToList();

        if (EsEdicion)
        {
            var detalle = await ApiClient.GetAsync<OrdenProduccionDetalleEdicion>(
                $"api/produccion/ordenes/{OrdenProduccionId}/editar");

            if (detalle is not null)
            {
                _codigoOp = detalle.CodigoOP;
                _tipoProduccionId = detalle.TipoProduccionID;
                var tipoSeleccionado = _tiposProduccion.FirstOrDefault(t => t.TipoProduccionID == detalle.TipoProduccionID);
                _esMto = tipoSeleccionado?.Codigo == "MTO";
                _clienteId = detalle.ClienteID;
                _productoTerminadoId = detalle.ProductoTerminadoID;
                _cantidadProgramada = detalle.CantidadProgramada;
                _centroCostoDestinoId = detalle.CentroCostoDestinoID;
                _centroTrabajoId = detalle.CentroTrabajoID;
                _fechaPlanificada = detalle.FechaPlanificada;
                _observaciones = detalle.Observaciones;

                // soloActivas=false: si la version guardada en la orden ya fue
                // reemplazada por una version nueva de la receta, igual debe
                // aparecer en la lista para no perder la seleccion original.
                _recetas = await ApiClient.GetAsync<List<RecetaResumen>>(
                    $"api/produccion/recetas?productoTerminadoId={detalle.ProductoTerminadoID}&soloActivas=false") ?? new();
                _recetaId = detalle.RecetaID;

                if (detalle.BodegaOrigenMPID == detalle.BodegaDestinoPTID)
                {
                    _produccionLocal = true;
                    _bodegaLocalId = detalle.BodegaOrigenMPID;
                }
                _bodegaOrigenMpId = detalle.BodegaOrigenMPID;
                _bodegaDestinoPtId = detalle.BodegaDestinoPTID;
            }
        }

        _cargandoCatalogos = false;
    }

    private Task OnProduccionLocalCambiadaAsync(bool valor)
    {
        _produccionLocal = valor;

        if (_produccionLocal)
        {
            _bodegaLocalId = _bodegaOrigenMpId ?? _bodegaDestinoPtId;
            _bodegaOrigenMpId = _bodegaLocalId;
            _bodegaDestinoPtId = _bodegaLocalId;
        }

        return Task.CompletedTask;
    }

    private Task OnBodegaLocalCambiadaAsync(int? nuevaBodegaId)
    {
        _bodegaLocalId = nuevaBodegaId;
        _bodegaOrigenMpId = nuevaBodegaId;
        _bodegaDestinoPtId = nuevaBodegaId;
        return Task.CompletedTask;
    }

    private Task OnTipoProduccionCambiadoAsync(int? nuevoTipoId)
    {
        _tipoProduccionId = nuevoTipoId;
        var tipoSeleccionado = _tiposProduccion.FirstOrDefault(t => t.TipoProduccionID == nuevoTipoId);
        _esMto = tipoSeleccionado?.Codigo == "MTO";

        if (!_esMto)
            _clienteId = null;

        return Task.CompletedTask;
    }

    private async Task OnProductoTerminadoCambiadoAsync(int? nuevoProductoId)
    {
        _productoTerminadoId = nuevoProductoId;
        _recetaId = null;
        _recetas = nuevoProductoId.HasValue
            ? await ApiClient.GetAsync<List<RecetaResumen>>(
                $"api/produccion/recetas?productoTerminadoId={nuevoProductoId}&soloActivas=true") ?? new()
            : new();
    }

    private async Task GuardarAsync()
    {
        if (!FormularioValido)
            return;

        _guardando = true;

        try
        {
            if (EsEdicion)
            {
                var request = new ActualizarOrdenProduccionRequest(
                    _tipoProduccionId!.Value, _productoTerminadoId!.Value, _recetaId!.Value, _cantidadProgramada,
                    _esMto ? _clienteId : null, _centroCostoDestinoId!.Value, _bodegaOrigenMpId!.Value, _bodegaDestinoPtId!.Value,
                    _centroTrabajoId, _fechaPlanificada, _observaciones);

                await ApiClient.PutAsync<ActualizarOrdenProduccionRequest, object?>(
                    $"api/produccion/ordenes/{OrdenProduccionId}", request);

                Snackbar.Add("Orden de produccion actualizada correctamente.", Severity.Success);
            }
            else
            {
                var request = new CrearOrdenProduccionRequest(
                    _codigoOp, _tipoProduccionId!.Value, _productoTerminadoId!.Value, _recetaId!.Value, _cantidadProgramada,
                    _esMto ? _clienteId : null, _centroCostoDestinoId!.Value, _bodegaOrigenMpId!.Value, _bodegaDestinoPtId!.Value,
                    _centroTrabajoId, _fechaPlanificada, _observaciones);

                await ApiClient.PostAsync<CrearOrdenProduccionRequest, object?>("api/produccion/ordenes", request);

                Snackbar.Add("Orden de produccion creada correctamente.", Severity.Success);
            }

            Navegacion.NavigateTo("/produccion/ordenes");
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }
}