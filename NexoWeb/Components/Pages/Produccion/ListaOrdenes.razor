@page "/produccion/ordenes"
@attribute [Authorize]
@implements IDisposable
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@using NexoWeb.Common.Dtos

<PageTitle>Ordenes de Produccion — NEXO</PageTitle>

@* ── Hero ── *@
<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">Produccion</p>
            <h1 class="nexo-page-hero__title">Ordenes de Produccion</h1>
        </div>
    </div>
    @if (_puedeGestionar)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" Href="/produccion/ordenes/crear">
            Nueva Orden
        </MudButton>
    }
</div>

@* ── Alerta maquinaria en mantenimiento ── *@
@if (_enMantenimiento.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Filled.Build" Dense>
        <strong>Maquinas en mantenimiento:</strong>
        @string.Join(", ", _enMantenimiento.Select(m => m.Nombre))
        — algunas tareas pueden verse afectadas.
        <MudLink Href="/produccion/maquinaria" Class="ml-2">Ver maquinaria</MudLink>
    </MudAlert>
}

@* ── Pipeline de estados (filtro visual) ── *@
<div class="d-flex flex-wrap mb-4" style="gap:8px">
    @foreach (var (estado, color, icono) in _pipeline)
    {
        var count = _todas.Count(o => o.Estado == estado);
        var activo = _filtroEstado == estado;
        <div @onclick="@(() => SetFiltro(estado))"
             style="cursor:pointer; display:flex; align-items:center; gap:8px;
                    padding:10px 18px; border-radius:10px; transition:all .15s;
                    border:2px solid @(activo ? $"var(--mud-palette-{color})" : "var(--mud-palette-lines-default)");
                    background:@(activo ? $"color-mix(in srgb, var(--mud-palette-{color}) 12%, transparent)" : "var(--mud-palette-surface)")">
            <MudIcon Icon="@icono" Size="Size.Small"
                     Style="@($"color:var(--mud-palette-{color})")" />
            <div>
                <div style="font-size:0.78rem; font-weight:600; color:var(--mud-palette-text-primary)">@estado</div>
                <div style="font-size:1.1rem; font-weight:700; line-height:1; color:var(--mud-palette-@color)">@count</div>
            </div>
        </div>
    }
    @if (_filtroEstado is not null)
    {
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.FilterAltOff"
                   OnClick="@(() => SetFiltro(null))">
            Ver todas
        </MudButton>
    }
</div>

@* ── Contenido ── *@
@if (_cargando)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate Color="Color.Primary" />
    </div>
}
else if (_ordenes.Count == 0)
{
    <MudPaper Class="pa-8" Elevation="0"
              Style="border:2px dashed var(--mud-palette-lines-default); border-radius:12px; text-align:center">
        <MudIcon Icon="@Icons.Material.Outlined.Assignment" Size="Size.Large"
                 Style="color:var(--mud-palette-text-secondary); font-size:3rem" Class="mb-2" />
        <MudText Color="Color.Secondary">
            @(_filtroEstado is null ? "No hay ordenes de produccion." : $"No hay ordenes en estado '{_filtroEstado}'.")
        </MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="border-radius:12px; overflow:hidden">
        <MudTable Items="_ordenes" Hover Dense Breakpoint="Breakpoint.Sm" Elevation="0"
                  RowStyle="cursor:default">
            <HeaderContent>
                <MudTh Style="width:130px">Codigo</MudTh>
                <MudTh>Producto</MudTh>
                <MudTh Style="width:130px">Centro</MudTh>
                <MudTh Style="width:100px">Estado</MudTh>
                <MudTh Style="width:90px; text-align:right">Prog.</MudTh>
                <MudTh Style="width:90px; text-align:right">Real</MudTh>
                <MudTh Style="width:90px; text-align:right">C/U Real</MudTh>
                <MudTh Style="width:100px">Fecha</MudTh>
                <MudTh Style="width:150px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Codigo">
                    <span style="font-family:monospace; font-weight:600; font-size:0.82rem">
                        @context.CodigoOP
                    </span>
                </MudTd>
                <MudTd DataLabel="Producto">
                    <MudText Typo="Typo.body2">@context.Producto</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.CentroCosto</MudText>
                </MudTd>
                <MudTd DataLabel="Centro">
                    <MudText Typo="Typo.caption">@context.CentroCosto</MudText>
                </MudTd>
                <MudTd DataLabel="Estado">
                    @{
                        var (chip, chipIcon) = ChipEstado(context.Estado);
                    }
                    <MudChip T="string" Color="@chip" Size="Size.Small" Icon="@chipIcon"
                             Style="font-size:0.72rem; height:22px">
                        @context.Estado
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Prog." Style="text-align:right">
                    <span style="font-size:0.85rem; font-weight:600">@context.CantidadProgramada.ToString("N0")</span>
                </MudTd>
                <MudTd DataLabel="Real" Style="text-align:right">
                    @if (context.CantidadProducidaReal.HasValue)
                    {
                        var pct = context.CantidadProgramada > 0
                            ? context.CantidadProducidaReal.Value / context.CantidadProgramada * 100
                            : 0;
                        var colorPct = pct >= 95 ? "color:var(--mud-palette-success)"
                                     : pct >= 75 ? "color:var(--mud-palette-warning)"
                                     : "color:var(--mud-palette-error)";
                        <span style="font-size:0.85rem; font-weight:600; @colorPct">
                            @context.CantidadProducidaReal.Value.ToString("N0")
                        </span>
                        <div style="font-size:0.7rem; color:var(--mud-palette-text-secondary)">
                            @pct.ToString("N0")%
                        </div>
                    }
                    else
                    {
                        <span style="color:var(--mud-palette-text-secondary)">—</span>
                    }
                </MudTd>
                <MudTd DataLabel="C/U Real" Style="text-align:right">
                    <span style="font-size:0.82rem">
                        @(context.CostoUnitarioReal?.ToString("C0") ?? "—")
                    </span>
                </MudTd>
                <MudTd DataLabel="Fecha">
                    @{
                        var fecha = context.FechaInicio ?? context.FechaPlanificada;
                    }
                    @if (fecha.HasValue)
                    {
                        <span style="font-size:0.8rem">@fecha.Value.ToString("dd/MM/yy")</span>
                    }
                    else
                    {
                        <span style="color:var(--mud-palette-text-secondary)">—</span>
                    }
                </MudTd>
                <MudTd DataLabel="Acciones">
                    <div class="d-flex align-center" style="gap:2px">
                        @if (context.Estado == "Planificada" && _puedeGestionar)
                        {
                            <MudTooltip Text="Editar orden">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small" Color="Color.Default"
                                               Href="@($"/produccion/ordenes/{context.OrdenProduccionID}/editar")" />
                            </MudTooltip>
                            <MudTooltip Text="Liberar — descuenta materia prima">
                                <MudIconButton Icon="@Icons.Material.Filled.LockOpen"
                                               Size="Size.Small" Color="Color.Info"
                                               OnClick="@(() => LiberarConVerificacionAsync(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Cancelar orden">
                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                               Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => CancelarAsync(context.OrdenProduccionID))" />
                            </MudTooltip>
                        }
                        @if (context.Estado == "Liberada" && _puedeGestionar)
                        {
                            <MudTooltip Text="Iniciar produccion">
                                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                               Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => IniciarAsync(context.OrdenProduccionID))" />
                            </MudTooltip>
                        }
                        @if (context.Estado == "En Proceso" && _puedeGestionar)
                        {
                            <MudTooltip Text="Ajustar consumo real">
                                <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                               Size="Size.Small" Color="Color.Warning"
                                               OnClick="@(() => AbrirAjusteConsumoAsync(context))" />
                            </MudTooltip>
                        }
                        @if (context.Estado == "En Proceso" && _puedeCerrar)
                        {
                            <MudTooltip Text="Cerrar y registrar produccion final">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Size="Size.Small" Color="Color.Success"
                                               OnClick="@(() => AbrirCierreAsync(context.OrdenProduccionID))" />
                            </MudTooltip>
                        }
                        @if (context.Estado == "Finalizada")
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                     Icon="@Icons.Material.Filled.Done"
                                     Style="font-size:0.7rem; height:22px; pointer-events:none">
                                Completada
                            </MudChip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@* ── Leyenda de acciones ── *@
@if (_ordenes.Count > 0 && _puedeGestionar)
{
    <div class="d-flex flex-wrap mt-3" style="gap:12px; font-size:0.75rem; color:var(--mud-palette-text-secondary)">
        <span><MudIcon Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Style="font-size:14px; vertical-align:middle" /> Liberar</span>
        <span><MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Style="font-size:14px; vertical-align:middle" /> Iniciar</span>
        <span><MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Style="font-size:14px; vertical-align:middle" /> Ajustar consumo</span>
        <span><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="font-size:14px; vertical-align:middle" /> Cerrar</span>
        <span><MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Style="font-size:14px; vertical-align:middle" /> Cancelar</span>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAuth { get; set; }

    private List<OrdenProduccionResumen> _todas = [];
    private List<OrdenProduccionResumen> _ordenes = [];
    private string? _filtroEstado;
    private bool _cargando = true;
    private bool _puedeGestionar;
    private bool _puedeCerrar;
    private List<MaquinariaEnMantenimientoItem> _enMantenimiento = [];

    private static readonly (string Estado, string Color, string Icono)[] _pipeline =
    [
        ("Planificada",  "default",  Icons.Material.Filled.Schedule),
        ("Liberada",     "info",     Icons.Material.Filled.LockOpen),
        ("En Proceso",   "warning",  Icons.Material.Filled.Factory),
        ("Finalizada",   "success",  Icons.Material.Filled.CheckCircle),
        ("Cancelada",    "error",    Icons.Material.Filled.Cancel),
    ];

    protected override void OnInitialized()
    {
        Preferencias.OnCambio += OnPreferenciasCambiaron;
    }

    private void OnPreferenciasCambiaron() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Preferencias.OnCambio -= OnPreferenciasCambiaron;
    }

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAuth is not null)
        {
            var estado = await EstadoAuth;
            _puedeGestionar = estado.User.IsInRole("Administracion") || estado.User.IsInRole("Jefes");
            _puedeCerrar = _puedeGestionar;
        }
        await Task.WhenAll(CargarAsync(), CargarMaquinariaEnMantenimientoAsync());
    }

    private void SetFiltro(string? estado)
    {
        _filtroEstado = estado;
        _ordenes = _filtroEstado is null
            ? _todas
            : _todas.Where(o => o.Estado == _filtroEstado).ToList();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        try
        {
            _todas = await ApiClient.GetAsync<List<OrdenProduccionResumen>>("api/produccion/ordenes") ?? [];
            SetFiltro(_filtroEstado);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo cargar la lista: {ex.Message}", Severity.Error);
        }
        finally { _cargando = false; }
    }

    private async Task CargarMaquinariaEnMantenimientoAsync()
    {
        try
        {
            _enMantenimiento = await ApiClient.GetAsync<List<MaquinariaEnMantenimientoItem>>(
                "api/produccion/maquinaria/en-mantenimiento") ?? [];
        }
        catch { _enMantenimiento = []; }
    }

    // ── Verificacion antes de liberar ──────────────────────────────────
    private async Task LiberarConVerificacionAsync(OrdenProduccionResumen orden)
    {
        var parametros = new DialogParameters<VerificarStockDialog>
        {
            { x => x.Orden, orden }
        };
        var opts = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialogo = await DialogService.ShowAsync<VerificarStockDialog>(
            $"Liberar — {orden.CodigoOP}", parametros, opts);
        var resultado = await dialogo.Result;
        if (resultado is { Canceled: false })
            await EjecutarAccionAsync(
                () => ApiClient.PostAsync($"api/produccion/ordenes/{orden.OrdenProduccionID}/liberar"),
                "Orden liberada. Materia prima descontada.");
    }

    private async Task CancelarAsync(int id)
    {
        var ok = await DialogService.ShowMessageBox(
            "Cancelar orden",
            "La orden quedara marcada como Cancelada. No se toca inventario porque aun no habia sido liberada. Esta accion no se puede deshacer.",
            yesText: "Cancelar orden", cancelText: "Volver");
        if (ok != true) return;
        await EjecutarAccionAsync(
            () => ApiClient.PostAsync($"api/produccion/ordenes/{id}/cancelar"), "Orden cancelada.");
    }

    private async Task IniciarAsync(int id)
    {
        var ok = await DialogService.ShowMessageBox(
            "Iniciar produccion",
            "La orden pasara a 'En Proceso'. El consumo de materia prima ya fue descontado al liberar.",
            yesText: "Iniciar", cancelText: "Cancelar");
        if (ok != true) return;
        await EjecutarAccionAsync(
            () => ApiClient.PostAsync($"api/produccion/ordenes/{id}/iniciar"),
            "Orden iniciada.");
    }

    private async Task AbrirAjusteConsumoAsync(OrdenProduccionResumen orden)
    {
        var parametros = new DialogParameters<AjustarConsumoDialog>
        {
            { x => x.Orden, orden }
        };
        var dialogo = await DialogService.ShowAsync<AjustarConsumoDialog>(
            $"Ajustar Consumo — {orden.CodigoOP}", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await dialogo.Result;
    }

    private async Task AbrirCierreAsync(int id)
    {
        var dialogo = await DialogService.ShowAsync<CerrarOrdenDialog>("Cerrar Orden de Produccion");
        var resultado = await dialogo.Result;
        if (resultado is null || resultado.Canceled) return;
        var request = (CerrarOrdenProduccionRequest)resultado.Data!;
        await EjecutarAccionAsync(
            () => ApiClient.PostAsync<CerrarOrdenProduccionRequest, object?>(
                $"api/produccion/ordenes/{id}/cerrar", request),
            "Orden finalizada correctamente.");
    }

    private async Task EjecutarAccionAsync(Func<Task> accion, string mensajeExito)
    {
        try
        {
            await accion();
            Snackbar.Add(mensajeExito, Severity.Success);
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static (Color chip, string icono) ChipEstado(string estado) => estado switch
    {
        "Planificada" => (Color.Default,  Icons.Material.Filled.Schedule),
        "Liberada"    => (Color.Info,     Icons.Material.Filled.LockOpen),
        "En Proceso"  => (Color.Warning,  Icons.Material.Filled.Factory),
        "Finalizada"  => (Color.Success,  Icons.Material.Filled.CheckCircle),
        "Cancelada"   => (Color.Error,    Icons.Material.Filled.Cancel),
        _             => (Color.Default,  Icons.Material.Filled.HelpOutline)
    };
}
