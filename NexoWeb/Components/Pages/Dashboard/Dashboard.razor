    private bool _exportando;

    private async Task ExportarExcelAsync() =>
        await ExportarAsync("api/dashboard/exportar/excel", "xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

    private async Task ExportarPdfAsync() =>
        await ExportarAsync("api/dashboard/exportar/pdf", "pdf", "application/pdf");

    private async Task ExportarAsync(string ruta, string extension, string tipoContenido)
    {
        _exportando = true;
        try
        {
            var bytes = await ApiClient.GetBytesAsync(ruta);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("nexoDescargarArchivo", $"NEXO-Reporte-{DateTime.Now:yyyyMMdd-HHmm}.{extension}", tipoContenido, streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo generar el reporte: {ex.Message}", Severity.Error);
        }
        finally { _exportando = false; }
    }

    // ── Reportes (pestaña BI) ─────────────────────────────────────────────
    private sealed record RptInfo(string Tipo, string Nombre, string Descripcion);
    private List<RptInfo>                       _rptLista     = new();
    private string?                             _rptTipo;
    private DateTime?                           _rptDesde     = DateTime.Today.AddMonths(-3);
    private DateTime?                           _rptHasta     = DateTime.Today;
    private bool                                _rptCargando;
    private bool                                _rptEjecutado;
    private List<Dictionary<string, object?>>   _rptFilas     = new();

    private async Task CargarListaReportesAsync()
    {
        try
        {
            var lista = await ApiClient.GetAsync<List<RptInfo>>("api/reportes") ?? new();
            _rptLista = lista;
            if (_rptLista.Count > 0 && _rptTipo is null)
                _rptTipo = _rptLista[0].Tipo;
        }
        catch { }
    }

    private async Task EjecutarReporteAsync()
    {
        if (_rptTipo is null) return;
        _rptCargando = true;
        _rptFilas    = new();
        StateHasChanged();
        try
        {
            var req = new { Tipo = _rptTipo, Desde = _rptDesde, Hasta = _rptHasta, Limite = 500 };
            _rptFilas = await ApiClient.PostAsync<object, List<Dictionary<string, object?>>>("api/reportes/ejecutar", req) ?? new();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _rptCargando = false; _rptEjecutado = true; }
    }

    private async Task ExportarReporteExcelAsync()
    {
        if (_rptTipo is null) return;
        try
        {
            var req   = new { Tipo = _rptTipo, Desde = _rptDesde, Hasta = _rptHasta, Limite = 500 };
            var bytes = await ApiClient.PostBytesAsync<object>("api/reportes/exportar", req);
            var b64   = Convert.ToBase64String(bytes);
            var nombre = $"reporte_{_rptTipo}_{DateTime.Today:yyyy-MM-dd}.xlsx";
            await JS.InvokeVoidAsync("nexoDescargarArchivo", nombre,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
        }
        catch (Exception ex) { Snackbar.Add($"Error al exportar: {ex.Message}", Severity.Error); }
    }
