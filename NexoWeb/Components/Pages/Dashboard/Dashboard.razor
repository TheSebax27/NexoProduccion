    // ── Rutas alternativas cuando BI no es visible ───────────────────
    private static readonly (string Codigo, string Ruta)[] _rutasAlternativas =
    [
        ("PRODUCCION.ORDENES",     "/produccion/ordenes"),
        ("PRODUCCION.RECETAS",     "/produccion/recetas"),
        ("INVENTARIO.STOCK",       "/inventario/stock"),
        ("INVENTARIO.KARDEX",      "/inventario/kardex"),
        ("OPERACIONES.MOVIMIENTOS","/operaciones/movimientos"),
        ("OPERACIONES.COMPRAS",    "/compras/ordenes"),
        ("OPERACIONES.DESPACHOS",  "/logistica/despachos"),
        ("OPERACIONES.FACTURACION","/facturacion"),
        ("CATALOGO.ARTICULOS",     "/catalogo/articulos"),
        ("CRM.CLIENTES",           "/crm/clientes"),
        ("PLANIFICACION.DEMANDA",  "/planificacion/demanda"),
    ];

    protected override void OnInitialized()
    {
        Modulos.OnCambio += VerificarAccesoBI;
        VerificarAccesoBI();
    }

    public void Dispose() => Modulos.OnCambio -= VerificarAccesoBI;

    private void VerificarAccesoBI()
    {
        if (!Modulos.Cargado || Modulos.EsAdmin) return;
        if (Modulos.EsVisible("BI")) return;
        foreach (var (codigo, ruta) in _rutasAlternativas)
        {
            if (Modulos.EsVisible(codigo))
            {
                Navigation.NavigateTo(ruta, replace: true);
                return;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tareaPlanVsReal    = ApiClient.GetAsync<List<PlanVsRealPunto>>(
                $"api/dashboard/plan-vs-real?desde={_rangoPlanVsReal.Start:yyyy-MM-dd}&hasta={_rangoPlanVsReal.End:yyyy-MM-dd}");
            var tareaVariacion     = ApiClient.GetAsync<List<PlanVsRealPunto>>(
                $"api/dashboard/plan-vs-real?desde={_rangoVariacion.Start:yyyy-MM-dd}&hasta={_rangoVariacion.End:yyyy-MM-dd}");
            var tareaDistribucion  = ApiClient.GetAsync<List<DistribucionCentroCostoItem>>("api/dashboard/distribucion-centro-costo");
            var tareaPerdidas      = ApiClient.GetAsync<List<PerdidaPorMotivoItem>>(
                $"api/dashboard/perdidas-por-motivo?desde={_rangoPerdidas.Start:yyyy-MM-dd}&hasta={_rangoPerdidas.End:yyyy-MM-dd}");
            var tareaProductos     = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos/todos");
            var tareaCumplimiento  = ApiClient.GetAsync<List<CumplimientoCentroCostoItem>>("api/dashboard/cumplimiento-planificacion");

            await Task.WhenAll(tareaPlanVsReal, tareaVariacion, tareaDistribucion, tareaPerdidas, tareaProductos, tareaCumplimiento);

            _planVsReal = await tareaPlanVsReal ?? new();
            ActualizarGraficoPlanVsReal();

            var variacionDatos = await tareaVariacion ?? new();
            _variacionProduccion = variacionDatos
                .Select(p => (p.Fecha,
                    Porcentaje: p.TotalPlanificado > 0 ? (double)((p.TotalReal - p.TotalPlanificado) / p.TotalPlanificado * 100) : 0d,
                    SinPlan: p.TotalPlanificado == 0 && p.TotalReal > 0))
                .ToList();

            _distribucion = await tareaDistribucion ?? new();
            _labelsDistribucion = _distribucion.Select(d => d.CentroCosto).ToArray();
            _dataDistribucion   = _distribucion.Select(d => (double)d.TotalUnidadesProducidas).ToArray();

            _perdidas = await tareaPerdidas ?? new();
            ActualizarGraficoPerdidas();

            _productosTerminados = (await tareaProductos ?? new()).Where(a => a.TipoArticulo == "Producto Terminado").ToList();
            _cumplimiento = await tareaCumplimiento ?? new();

            _totalOrdenesFinalizadas = _cumplimiento.Sum(c => c.TotalOrdenesFinalizadas);
            _totalOrdenesATiempo     = _cumplimiento.Sum(c => c.OrdenesATiempo);
            _cumplimientoPromedio    = _cumplimiento.Count > 0 ? (double)_cumplimiento.Average(c => c.PorcentajeCumplimiento) : 0;
            _totalRealProducido      = _seriesPlanVsReal.FirstOrDefault(s => s.Name == "Real")?.Data.Sum() ?? 0;
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
        finally
        {
            _cargando = false;
        }

        await CargarResumenGeneralAsync();

        try { _combosActivos = await ApiClient.GetAsync<List<ComboItem>>("api/marketing/combos/activos") ?? new(); }
        catch { }
    }

    private async Task CargarResumenGeneralAsync()
    {
        try
        {
            _resumenCrm = await ApiClient.GetAsync<ResumenCrmItem>(
                $"api/dashboard/resumen-crm?desde={DateTime.Today.AddDays(-30):yyyy-MM-dd}&hasta={DateTime.Today:yyyy-MM-dd}") ?? new(0, 0);
            _clientesFrios = await ApiClient.GetAsync<List<ClienteFrioItem>>("api/crm/clientes-frios?diasSinContacto=30") ?? new();
            _empleadosPorCentroCosto = await ApiClient.GetAsync<List<EmpleadosPorCentroCostoItem>>("api/dashboard/empleados-por-centro-costo") ?? new();
            _totalEmpleadosActivos = _empleadosPorCentroCosto.Sum(e => e.TotalEmpleados);

            var cartResp = await ApiClient.GetAsync<FacturasPaginadasResponse>("api/facturacion/facturas?soloNoPagadas=true&pagina=1&tamano=5");
            _cartera = cartResp?.Items ?? new();
            var cartTotal = await ApiClient.GetAsync<FacturasPaginadasResponse>("api/facturacion/facturas?soloNoPagadas=true&pagina=1&tamano=200");
            _totalSaldoCartera = cartTotal?.Items?.Sum(f => f.SaldoPendiente) ?? _cartera.Sum(f => f.SaldoPendiente);
        }
