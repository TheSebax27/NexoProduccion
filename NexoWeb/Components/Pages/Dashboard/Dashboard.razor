            var tareaIngresos = ApiClient.GetAsync<List<IngresoPorMesPunto>>(
                $"api/dashboard/ingresos-por-mes?meses={_mesesFact}");
            var tareaClientes = ApiClient.GetAsync<List<TopClienteItem>>(
                $"api/dashboard/top-clientes?desde={_rangoFact.Start:yyyy-MM-dd}&hasta={_rangoFact.End:yyyy-MM-dd}&top=10");
            var tareaArticulos = ApiClient.GetAsync<List<TopArticuloItem>>(
