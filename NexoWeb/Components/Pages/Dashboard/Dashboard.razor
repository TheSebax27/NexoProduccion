                <div class="nexo-section" style="margin-top:0.25rem">
                    <div class="nexo-section__dot" style="background:#7C5CFF"></div>
                    <span class="nexo-section__label">Análisis de márgenes</span>
                    <div class="nexo-section__line"></div>
                    <MudDateRangePicker @bind-DateRange="_rangoFin" @bind-DateRange:after="OnRangoFinCambiadoAsync"
                                        Label="Período" Variant="Variant.Outlined" Margin="Margin.Dense"
                                        PickerVariant="PickerVariant.Dialog" DateFormat="dd/MM/yyyy"
                                        Style="max-width:280px;min-width:240px;" />
                </div>

                @* KPIs financieros *@
                <div class="nexo-kpi-grid mb-4">
                    <div class="nexo-kpi nexo-kpi--green">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@FinTotalVentas.ToString("C0")</div>
                        <div class="nexo-kpi__label">Ingresos (artículos)</div>
                        <div class="nexo-kpi__sub">Total facturado en el período</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--rose">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@FinTotalCosto.ToString("C0")</div>
                        <div class="nexo-kpi__label">Costo Estimado</div>
                        <div class="nexo-kpi__sub">CostoPromedio × cantidad vendida</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--@(FinPctMargen >= 30 ? "green" : FinPctMargen >= 15 ? "amber" : "red")">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Percent" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@FinPctMargen.ToString("N1")%</div>
                        <div class="nexo-kpi__label">Margen Bruto Global</div>
                        <div class="nexo-kpi__sub">@FinTotalMargen.ToString("C0") de utilidad estimada</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--indigo">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_margenArticulos.Count</div>
                        <div class="nexo-kpi__label">Artículos analizados</div>
                        <div class="nexo-kpi__sub">Con ventas en el período</div>
                    </div>
                </div>

                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-4">
                    El margen usa el <strong>CostoPromedio</strong> del catálogo. Para costos exactos por producción, revisa la tendencia de costo unitario en el tab Producción.
                </MudAlert>

                <div class="nexo-section"><div class="nexo-section__dot" style="background:#7C5CFF"></div><span class="nexo-section__label">Rentabilidad por artículo</span><div class="nexo-section__line"></div></div>
                <MudPaper Class="pa-5 mb-4">
                    @if (_margenArticulos.Count == 0)
                    {
                        <div class="nexo-empty-state">
                            <MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" />
                            <p class="nexo-empty-state__text">Sin ventas registradas en este período.</p>
                        </div>
                    }
                    else
                    {
                        <MudTable Items="_margenArticulos" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>#</MudTh>
                                <MudTh>Artículo</MudTh>
                                <MudTh Style="text-align:right">Vendido</MudTh>
                                <MudTh Style="text-align:right">Ingresos</MudTh>
                                <MudTh Style="text-align:right">Costo</MudTh>
                                <MudTh Style="text-align:right">Margen $</MudTh>
                                <MudTh Style="text-align:right">Margen %</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @{ var idx3 = _margenArticulos.IndexOf(context) + 1; }
                                <MudTd Style="font-size:0.78rem;color:#9B9BB4;font-weight:700">@idx3</MudTd>
                                <MudTd>
                                    <div style="font-size:0.85rem;font-weight:500">@context.Nombre</div>
                                    <div style="font-size:0.72rem;color:#9B9BB4">@context.SKU</div>
                                </MudTd>
                                <MudTd Style="text-align:right;font-size:0.82rem">@context.CantidadVendida.ToString("N0")</MudTd>
                                <MudTd Style="text-align:right;font-weight:600;color:#10B981">@context.TotalFacturado.ToString("C0")</MudTd>
                                <MudTd Style="text-align:right;font-size:0.82rem;color:#F43F5E">@context.CostoEstimado.ToString("C0")</MudTd>
                                <MudTd Style="text-align:right"><span style="@($"font-weight:700;color:{(context.MargenBruto >= 0 ? "#10B981" : "#EF4444")}")">@context.MargenBruto.ToString("C0")</span></MudTd>
                                <MudTd Style="text-align:right">
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(context.PorcentajeMargen >= 30 ? Color.Success : context.PorcentajeMargen >= 15 ? Color.Warning : Color.Error)">
                                        @context.PorcentajeMargen.ToString("N1")%
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            }
        </MudTabPanel>

        @* ══════════════════════════════════════════════ TAB REPORTES ══ *@
        <MudTabPanel Text="Reportes" Icon="@Icons.Material.Outlined.Assessment">

            <div class="nexo-section" style="margin-top:0.25rem">
                <div class="nexo-section__dot" style="background:#8B5CF6"></div>
                <span class="nexo-section__label">Centro de Reportes</span>
                <div class="nexo-section__line"></div>
            </div>
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)" Class="mb-4">
                Ejecuta reportes predefinidos y exporta los datos a Excel con el rango de fechas que necesites.
            </MudText>

            @* Controles *@
            <MudGrid Class="mb-4" Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_rptTipo" Label="Reporte" Variant="Variant.Outlined">
                        @foreach (var r in _rptLista)
                        {
                            <MudSelectItem Value="@r.Tipo">@r.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudDatePicker @bind-Date="_rptDesde" Label="Desde" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudDatePicker @bind-Date="_rptHasta" Label="Hasta" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="2" Class="d-flex align-end" style="gap:8px">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Outlined.PlayArrow"
                               OnClick="EjecutarReporteAsync" Disabled="_rptCargando">
                        @(_rptCargando ? "Cargando…" : "Ejecutar")
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.GridOn"
                               OnClick="ExportarReporteExcelAsync"
                               Disabled="@(_rptCargando || _rptFilas.Count == 0)">
                        Excel
                    </MudButton>
                </MudItem>
            </MudGrid>

            @* Resultado *@
            @if (_rptFilas.Count > 0)
            {
                var columnas = _rptFilas[0].Keys.ToList();
                <MudPaper Class="pa-0" Style="overflow:hidden">
                    <div class="nexo-chart-header pa-4 pb-3" style="border-bottom:1px solid var(--mud-palette-lines-default)">
                        <MudIcon Icon="@Icons.Material.Outlined.TableChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                        <div>
                            <div class="nexo-chart-header__title">@(_rptLista.FirstOrDefault(r => r.Tipo == _rptTipo)?.Nombre)</div>
                            <div class="nexo-chart-header__sub">@_rptFilas.Count fila(s) · @_rptDesde?.ToString("dd/MM/yyyy") — @_rptHasta?.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                    <div style="overflow-x:auto">
                        <MudTable Items="_rptFilas" Dense="true" Hover="true" Elevation="0" FixedHeader="true" Height="420px">
                            <HeaderContent>
                                @foreach (var col in columnas)
                                {
                                    <MudTh>@col</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate>
                                @foreach (var col in columnas)
                                {
                                    var val = context.TryGetValue(col, out var v) ? v : null;
                                    <MudTd DataLabel="@col">
                                        @if (val is decimal d)      { @d.ToString("N2") }
                                        else if (val is double dbl) { @dbl.ToString("N2") }
                                        else if (val is DateTime dt){ @dt.ToString("dd/MM/yyyy") }
                                        else                        { @(val?.ToString() ?? "-") }
                                    </MudTd>
                                }
                            </RowTemplate>
                        </MudTable>
                    </div>
                </MudPaper>
            }
            else if (!_rptCargando && _rptEjecutado)
            {
                <div class="nexo-empty-state">
                    <MudIcon Icon="@Icons.Material.Outlined.TableChart" Class="nexo-empty-state__icon" />
                    <p class="nexo-empty-state__text">Sin datos para el período seleccionado.</p>
                </div>
            }
            else if (!_rptEjecutado)
            {
                <MudPaper Class="pa-8 d-flex flex-column align-center justify-center" style="min-height:200px; opacity:.7">
                    <MudIcon Icon="@Icons.Material.Outlined.Assessment" Style="font-size:3rem; color:var(--mud-palette-primary); margin-bottom:12px" />
                    <MudText Typo="Typo.body2">Selecciona un reporte y haz clic en <strong>Ejecutar</strong>.</MudText>
                </MudPaper>
            }

        </MudTabPanel>

    </MudTabs>
}

@code {
    private bool _cargando = true;
    private string? _errorCarga;

    // ── Actividad, sparklines y estado del agente ──────────────────────
    private List<ActividadFeedItem>        _actividad    = new();
