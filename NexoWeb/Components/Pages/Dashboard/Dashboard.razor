            await Task.WhenAll(tareaResumen, tareaIngresos, tareaClientes, tareaArticulos);

            _resumenFact   = await tareaResumen  ?? new(0, 0, 0, 0);
            _ingresosMes   = await tareaIngresos ?? new();
            _topClientes   = await tareaClientes  ?? new();
            _topArticulos  = await tareaArticulos ?? new();
            ActualizarGraficoIngresos();
            _tabFactCargado = true;
        }
        catch (Exception ex)
