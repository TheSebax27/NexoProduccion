        new ChartSeries { Name = "OPs",          Data = _sparklines?.Ordenes.Select(x => (double)x.Valor).ToArray()     ?? Array.Empty<double>() },
        new ChartSeries { Name = "Cotizaciones", Data = _sparklines?.Cotizaciones.Select(x => (double)x.Valor).ToArray() ?? Array.Empty<double>() },
    };
    private string[] _labelsGeneralLinea =>
        _sparklines?.Facturas.Select(x => x.Fecha.ToString("dd/MM")).ToArray() ?? Array.Empty<string>();
    private double[] _dataGeneralDonut => new double[]
    {
        (double)(_sparklines?.Facturas.Sum(x => x.Valor)     ?? 0),
        (double)(_sparklines?.Ordenes.Sum(x => x.Valor)      ?? 0),
        (double)(_sparklines?.Cotizaciones.Sum(x => x.Valor) ?? 0),
    };
    private string[] _labelsGeneralDonut => new[] { "Facturas", "OPs", "Cotizaciones" };

    private static readonly ChartOptions _opcionesGrafico = new()
    {
        ChartPalette = new[] { "#7C5CFF", "#14B8A6", "#F59E0B", "#0EA5E9", "#10B981", "#EF4444", "#6366F1", "#EC4899" }
    };

    // ── Producción ───────────────────────────────────────────────────
    private List<PlanVsRealPunto> _planVsReal = new();
    private List<ChartSeries> _seriesPlanVsReal = new();
    private string[] _labelsPlanVsReal = Array.Empty<string>();
    private DateRange _rangoPlanVsReal = new(DateTime.Today.AddDays(-14), DateTime.Today);
    private List<(DateTime Fecha, double Porcentaje, bool SinPlan)> _variacionProduccion = new();
    private DateRange _rangoVariacion = new(DateTime.Today.AddDays(-30), DateTime.Today);
    private List<DistribucionCentroCostoItem> _distribucion = new();
    private double[] _dataDistribucion = Array.Empty<double>();
    private string[] _labelsDistribucion = Array.Empty<string>();
    private List<PerdidaPorMotivoItem> _perdidas = new();
    private double[] _dataPerdidas = Array.Empty<double>();
    private string[] _labelsPerdidas = Array.Empty<string>();
    private DateRange _rangoPerdidas = new(DateTime.Today.AddDays(-30), DateTime.Today);
    private List<ArticuloItem> _productosTerminados = new();
    private int _articuloSeleccionadoId;
    private List<TendenciaCostoPunto> _tendencia = new();
    private List<ChartSeries> _seriesTendencia = new() { new ChartSeries { Name = "Costo Unitario", Data = Array.Empty<double>() } };
    private string[] _labelsTendencia = Array.Empty<string>();
    private List<CumplimientoCentroCostoItem> _cumplimiento = new();
    private int _totalOrdenesFinalizadas;
    private int _totalOrdenesATiempo;
    private double _cumplimientoPromedio;
    private double _totalRealProducido;

    // ── General / Resumen ────────────────────────────────────────────
    private ResumenCrmItem _resumenCrm = new(0, 0);
    private List<ClienteFrioItem> _clientesFrios = new();
    private int _paginaFrios = 1;
    private const int TamanoFrios = 20;
    private int _totalPaginasFrios => (int)Math.Ceiling((double)_clientesFrios.Count / TamanoFrios);
    private IEnumerable<ClienteFrioItem> ClientesFriosPaginados =>
        _clientesFrios.Skip((_paginaFrios - 1) * TamanoFrios).Take(TamanoFrios);
    private List<FacturaItem> _cartera = new();
    private decimal _totalSaldoCartera;
    private List<DesviacionItem> _desviaciones = new();
    private List<ProyectoAlertaItem> _alertasProyectos = new();
    private List<EmpleadosPorCentroCostoItem> _empleadosPorCentroCosto = new();
    private int _totalEmpleadosActivos;
    private ResumenPlanificacionItem _resumenPlanificacion = new(0, 0);
    private ResumenInventarioItem _resumenInventario = new(0, 0);
    private EventoCalendarioItem? _proximoEvento;
    private List<ComboItem> _combosActivos = new();

    // ── Tab Facturación (lazy) ───────────────────────────────────────
    private bool _tabFactCargando;
    private bool _tabFactCargado;
    private ResumenFacturacionItem _resumenFact = new(0, 0, 0, 0);
    private List<IngresoPorMesPunto> _ingresosMes = new();
    private List<ChartSeries> _seriesIngresosMes = new();
    private string[] _labelsIngresosMes = Array.Empty<string>();
    private List<TopClienteItem> _topClientes = new();
    private List<TopArticuloItem> _topArticulos = new();
    private DevolucionesAnalytics? _analyticsDevolucion;
    private DateRange _rangoFact = new(DateTime.Today.AddMonths(-1), DateTime.Today);
    private int _mesesFact = 12;
    private List<ComparativaMesItem> _comparativaYoY = new();


    // ── Tab Inventario (lazy) ────────────────────────────────────────
    private bool _tabInvCargando;
    private bool _tabInvCargado;
    private List<AlertaStockItem> _alertasStock = new();

    // ── Tab Financiero (lazy) ────────────────────────────────────────
    private bool _tabFinCargando;
    private bool _tabFinCargado;
    private List<MargenArticuloItem> _margenArticulos = new();
    private DateRange _rangoFin = new(DateTime.Today.AddMonths(-3), DateTime.Today);

    // Propiedades computadas para KPIs financieros (evitan @{} inline en Razor)
    private decimal FinTotalVentas  => _margenArticulos.Sum(m => m.TotalFacturado);
    private decimal FinTotalCosto   => _margenArticulos.Sum(m => m.CostoEstimado);
    private decimal FinTotalMargen  => _margenArticulos.Sum(m => m.MargenBruto);
    private decimal FinPctMargen    => FinTotalVentas > 0 ? (FinTotalMargen / FinTotalVentas * 100) : 0;

    // ── Rutas alternativas cuando BI no es visible ───────────────────
    private static readonly (string Codigo, string Ruta)[] _rutasAlternativas =
    [
        ("PRODUCCION.ORDENES",     "/produccion/ordenes"),
        ("PRODUCCION.RECETAS",     "/produccion/recetas"),
        ("INVENTARIO.STOCK",       "/inventario/stock"),
        ("INVENTARIO.KARDEX",      "/inventario/kardex"),
("OPERACIONES.COMPRAS",    "/compras/ordenes"),
        ("OPERACIONES.DESPACHOS",  "/logistica/despachos"),
        ("OPERACIONES.FACTURACION","/facturacion"),
        ("CATALOGO.ARTICULOS",     "/catalogo/articulos"),
        ("CRM.CLIENTES",           "/crm/clientes"),
        ("PLANIFICACION.DEMANDA",  "/planificacion/demanda"),
    ];

    protected override void OnInitialized()
    {
        Modulos.OnCambio += VerificarAccesoBI;
        VerificarAccesoBI();
    }

    private async Task AbrirMapaClientesAsync()
    {
        await DialogService.ShowAsync<MapaClientesDialog>("Mapa de Clientes",
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    public void Dispose()
    {
        Modulos.OnCambio -= VerificarAccesoBI;
        _timerActividad?.Stop();
        _timerActividad?.Dispose();
    }

    private void VerificarAccesoBI()
    {
        if (!Modulos.Cargado || Modulos.EsAdmin) return;
        if (Modulos.EsVisible("BI")) return;
        foreach (var (codigo, ruta) in _rutasAlternativas)
        {
            if (Modulos.EsVisible(codigo))
            {
                Navigation.NavigateTo(ruta, replace: true);
                return;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tareaPlanVsReal    = ApiClient.GetAsync<List<PlanVsRealPunto>>(
                $"api/dashboard/plan-vs-real?desde={_rangoPlanVsReal.Start:yyyy-MM-dd}&hasta={_rangoPlanVsReal.End:yyyy-MM-dd}");
            var tareaVariacion     = ApiClient.GetAsync<List<PlanVsRealPunto>>(
                $"api/dashboard/plan-vs-real?desde={_rangoVariacion.Start:yyyy-MM-dd}&hasta={_rangoVariacion.End:yyyy-MM-dd}");
            var tareaDistribucion  = ApiClient.GetAsync<List<DistribucionCentroCostoItem>>("api/dashboard/distribucion-centro-costo");
            var tareaPerdidas      = ApiClient.GetAsync<List<PerdidaPorMotivoItem>>(
                $"api/dashboard/perdidas-por-motivo?desde={_rangoPerdidas.Start:yyyy-MM-dd}&hasta={_rangoPerdidas.End:yyyy-MM-dd}");
            var tareaProductos     = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos/todos");
            var tareaCumplimiento  = ApiClient.GetAsync<List<CumplimientoCentroCostoItem>>("api/dashboard/cumplimiento-planificacion");

            await Task.WhenAll(tareaPlanVsReal, tareaVariacion, tareaDistribucion, tareaPerdidas, tareaProductos, tareaCumplimiento);

            _planVsReal = await tareaPlanVsReal ?? new();
            ActualizarGraficoPlanVsReal();

            var variacionDatos = await tareaVariacion ?? new();
            _variacionProduccion = variacionDatos
                .Select(p => (p.Fecha,
                    Porcentaje: p.TotalPlanificado > 0 ? (double)((p.TotalReal - p.TotalPlanificado) / p.TotalPlanificado * 100) : 0d,
                    SinPlan: p.TotalPlanificado == 0 && p.TotalReal > 0))
                .ToList();

            _distribucion = await tareaDistribucion ?? new();
            _labelsDistribucion = _distribucion.Select(d => d.CentroCosto).ToArray();
            _dataDistribucion   = _distribucion.Select(d => (double)d.TotalUnidadesProducidas).ToArray();

            _perdidas = await tareaPerdidas ?? new();
            ActualizarGraficoPerdidas();

            _productosTerminados = (await tareaProductos ?? new()).Where(a => a.TipoArticulo == "Producto Terminado").ToList();
            _cumplimiento = await tareaCumplimiento ?? new();

            _totalOrdenesFinalizadas = _cumplimiento.Sum(c => c.TotalOrdenesFinalizadas);
            _totalOrdenesATiempo     = _cumplimiento.Sum(c => c.OrdenesATiempo);
            _cumplimientoPromedio    = _cumplimiento.Count > 0 ? (double)_cumplimiento.Average(c => c.PorcentajeCumplimiento) : 0;
            _totalRealProducido      = _seriesPlanVsReal.FirstOrDefault(s => s.Name == "Real")?.Data.Sum() ?? 0;
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
        finally
        {
            _cargando = false;
        }

        await CargarResumenGeneralAsync();

        try { _combosActivos = await ApiClient.GetAsync<List<ComboItem>>("api/marketing/combos/activos") ?? new(); }
        catch { }
    }

    private async Task CargarResumenGeneralAsync()
    {
        try
        {
            _resumenCrm = await ApiClient.GetAsync<ResumenCrmItem>(
                $"api/dashboard/resumen-crm?desde={DateTime.Today.AddDays(-30):yyyy-MM-dd}&hasta={DateTime.Today:yyyy-MM-dd}") ?? new(0, 0);
            _clientesFrios = await ApiClient.GetAsync<List<ClienteFrioItem>>("api/crm/clientes-frios?diasSinContacto=30") ?? new();
            _empleadosPorCentroCosto = await ApiClient.GetAsync<List<EmpleadosPorCentroCostoItem>>("api/dashboard/empleados-por-centro-costo") ?? new();
            _totalEmpleadosActivos = _empleadosPorCentroCosto.Sum(e => e.TotalEmpleados);

            var cartResp = await ApiClient.GetAsync<FacturasPaginadasResponse>("api/facturacion/facturas?soloNoPagadas=true&pagina=1&tamano=5");
            _cartera = cartResp?.Items ?? new();
            var cartTotal = await ApiClient.GetAsync<FacturasPaginadasResponse>("api/facturacion/facturas?soloNoPagadas=true&pagina=1&tamano=200");
            _totalSaldoCartera = cartTotal?.Items?.Sum(f => f.SaldoPendiente) ?? _cartera.Sum(f => f.SaldoPendiente);
        }
        catch (HttpRequestException) { }

        try
        {
            _resumenPlanificacion = await ApiClient.GetAsync<ResumenPlanificacionItem>("api/dashboard/resumen-planificacion") ?? new(0, 0);
            _resumenInventario    = await ApiClient.GetAsync<ResumenInventarioItem>("api/dashboard/resumen-inventario") ?? new(0, 0);
            _desviaciones         = await ApiClient.GetAsync<List<DesviacionItem>>("api/planificacion/desviaciones?umbral=70") ?? new();
            _alertasProyectos     = await ApiClient.GetAsync<List<ProyectoAlertaItem>>("api/proyectos/alertas") ?? new();
        }
        catch { }

        try { _proximoEvento = await ApiClient.GetAsync<EventoCalendarioItem>("api/calendario/eventos/proximo"); }
        catch { }

        // ── Actividad, sparklines y estado del agente ──────────────────────
        try
        {
            var tareaActividad  = ApiClient.GetAsync<List<ActividadFeedItem>>("api/dashboard/actividad?n=15");
            var tareaSparklines = ApiClient.GetAsync<SparklinesDashboard>("api/dashboard/sparklines");
            if (ConfiguracionEmpresa.UsaVisions)
            {
                var tareaAgente = ApiClient.GetAsync<List<EstadoIntegracionResponse>>("api/integracion/estado");
                await Task.WhenAll(tareaActividad, tareaSparklines, tareaAgente);
                _estadoAgente = (await tareaAgente)?.OrderByDescending(a => a.UltimoLatido).FirstOrDefault();
            }
            else
            {
                await Task.WhenAll(tareaActividad, tareaSparklines);
            }
            _actividad  = await tareaActividad  ?? new();
            _sparklines = await tareaSparklines;
        }
        catch { }

        // Timer para refrescar actividad cada 60 s
        _timerActividad = new System.Timers.Timer(60_000);
        _timerActividad.Elapsed += async (_, _) =>
        {
            try { _actividad = await ApiClient.GetAsync<List<ActividadFeedItem>>("api/dashboard/actividad?n=15") ?? new(); }
            catch { }
            await InvokeAsync(StateHasChanged);
        };
        _timerActividad.AutoReset = true;
        _timerActividad.Start();
    }

    private async Task CargarTabFacturacionAsync()
    {
        _tabFactCargando = true;
        StateHasChanged();
        try
        {
            var tareaResumen = ApiClient.GetAsync<ResumenFacturacionItem>(
                $"api/dashboard/resumen-facturacion?desde={_rangoFact.Start:yyyy-MM-dd}&hasta={_rangoFact.End:yyyy-MM-dd}");
            var tareaIngresos = ApiClient.GetAsync<List<IngresoPorMesPunto>>(
                $"api/dashboard/ingresos-por-mes?meses={_mesesFact}");
            var tareaClientes = ApiClient.GetAsync<List<TopClienteItem>>(
                $"api/dashboard/top-clientes?desde={_rangoFact.Start:yyyy-MM-dd}&hasta={_rangoFact.End:yyyy-MM-dd}&top=10");
            var tareaArticulos = ApiClient.GetAsync<List<TopArticuloItem>>(
                $"api/dashboard/top-articulos?desde={_rangoFact.Start:yyyy-MM-dd}&hasta={_rangoFact.End:yyyy-MM-dd}&top=10");
            var tareaYoY = ApiClient.GetAsync<List<ComparativaMesItem>>(
                $"api/dashboard/comparativa-yoy?meses={_mesesFact}");
            var tareaDevolucion = ApiClient.GetAsync<DevolucionesAnalytics>(
                $"api/facturacion/devoluciones/analytics?meses={_mesesFact}");

            await Task.WhenAll(tareaResumen, tareaIngresos, tareaClientes, tareaArticulos, tareaYoY, tareaDevolucion);

            _resumenFact         = await tareaResumen    ?? new(0, 0, 0, 0);
            _ingresosMes         = await tareaIngresos   ?? new();
            _topClientes         = await tareaClientes   ?? new();
            _topArticulos        = await tareaArticulos  ?? new();
            _comparativaYoY      = await tareaYoY        ?? new();
            _analyticsDevolucion = await tareaDevolucion;
            ActualizarGraficoIngresos();
            _tabFactCargado = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar tab Facturación: {ex.Message}", Severity.Error);
        }
        finally
        {
            _tabFactCargando = false;
        }
    }

