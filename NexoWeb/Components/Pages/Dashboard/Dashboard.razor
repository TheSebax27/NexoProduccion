@* Components/Pages/Dashboard/Dashboard.razor *@
@page "/"
@attribute [Authorize]
@inject INexoApiClient ApiClient
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject NexoWeb.Common.Auth.ModulosVisiblesState Modulos
@inject NexoWeb.Common.Auth.ConfiguracionEmpresaState ConfiguracionEmpresa
@inject IDialogService DialogService
@using NexoWeb.Common.Dtos
@using System.Globalization
@using NexoWeb.Components.Pages.Crm
@implements IDisposable

@* ── Estilos del feed de actividad y sparklines ────────────────────── *@
<style>
    .nexo-actividad-feed { display:flex; flex-direction:column; gap:0; }
    .nexo-actividad-item {
        display:flex; align-items:flex-start; gap:12px;
        padding:10px 0;
        border-bottom:1px solid var(--mud-palette-lines-default);
        cursor:pointer;
        transition:background .15s;
    }
    .nexo-actividad-item:last-child { border-bottom:none; }
    .nexo-actividad-item:hover { background:var(--mud-palette-background-grey); border-radius:8px; padding-left:6px; }
    .nexo-actividad-icon {
        width:34px; height:34px; border-radius:50%; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        background:color-mix(in srgb, var(--mud-palette-primary) 12%, transparent);
    }
    .nexo-actividad-body { flex:1; min-width:0; }
    .nexo-actividad-desc { font-size:0.85rem; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .nexo-actividad-meta { font-size:0.72rem; color:var(--n-text-3); margin-top:2px; }
    .nexo-kpi-spark { margin-top:6px; opacity:.7; }
    .nexo-agente-chip {
        display:inline-flex; align-items:center; gap:6px;
        font-size:0.75rem; padding:3px 10px; border-radius:20px;
        background:color-mix(in srgb, var(--mud-palette-success) 15%, transparent);
        border:1px solid color-mix(in srgb, var(--mud-palette-success) 40%, transparent);
        color:var(--mud-palette-success-darken);
    }
    .nexo-agente-chip--warn {
        background:color-mix(in srgb, var(--mud-palette-warning) 15%, transparent);
        border-color:color-mix(in srgb, var(--mud-palette-warning) 40%, transparent);
        color:var(--mud-palette-warning-darken);
    }
    .nexo-agente-chip--error {
        background:color-mix(in srgb, var(--mud-palette-error) 12%, transparent);
        border-color:color-mix(in srgb, var(--mud-palette-error) 35%, transparent);
        color:var(--mud-palette-error);
    }
</style>

<PageTitle>Business Intelligence - NEXO</PageTitle>

@* ── Encabezado de página ─────────────────────────────────── *@
<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">BI</p>
            <h1 class="nexo-page-hero__title">Business Intelligence</h1>
        </div>
    </div>
    <div class="d-flex align-center flex-wrap" style="gap: 0.5rem;">
        @* Chip de estado del agente Visions *@
        @if (ConfiguracionEmpresa.UsaVisions && _estadoAgente is not null)
        {
            var minutos = _estadoAgente.UltimoLatido.HasValue
                ? (int)(DateTime.UtcNow - _estadoAgente.UltimoLatido.Value).TotalMinutes
                : 9999;
            var chipClass = minutos <= 10 ? "nexo-agente-chip" : minutos <= 30 ? "nexo-agente-chip nexo-agente-chip--warn" : "nexo-agente-chip nexo-agente-chip--error";
            var chipIcon = minutos <= 10 ? Icons.Material.Filled.CloudDone : minutos <= 30 ? Icons.Material.Filled.CloudQueue : Icons.Material.Filled.CloudOff;
            var chipLabel = minutos <= 10
                ? $"Visions sync hace {minutos} min"
                : minutos <= 30 ? $"Visions sin sync hace {minutos} min"
                : "Visions: sin conexión";
            <div class="@chipClass" @onclick="@(() => Navigation.NavigateTo("/admin/integracion-visions"))" style="cursor:pointer;">
                <MudIcon Icon="@chipIcon" Size="Size.Small" />
                @chipLabel
            </div>
        }
        <span class="nexo-page-hero__timestamp">
            <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="mr-1" Style="vertical-align: middle; font-size: 14px;" />
            Actualizado @DateTime.Now.ToString("dd MMM, HH:mm")
        </span>
        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.GridOn"
                   OnClick="ExportarExcelAsync" Disabled="_exportando">Excel</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   OnClick="ExportarPdfAsync" Disabled="_exportando">PDF</MudButton>
    </div>
</div>
<InfoAyuda Texto="Workspace BI: navega entre pestañas para análisis de Facturación, Producción, CRM e Inventario. Usa los selectores de fecha dentro de cada gráfico para ajustar el período." />

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-6">No se pudo cargar el dashboard: @_errorCarga</MudAlert>
}
else if (_cargando)
{
    <div class="flex items-center justify-center py-20">
        <div class="text-center">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mb-4" />
            <p class="text-sm" style="color: var(--nexo-text-secondary)">Cargando datos...</p>
        </div>
    </div>
}
else
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4"
             ActivePanelIndexChanged="OnTabChangedAsync" Class="nexo-bi-tabs">

        @* ══════════════════════════════════════════════ TAB GENERAL ══ *@
        <MudTabPanel Text="General" Icon="@Icons.Material.Outlined.Dashboard">

            @* ── FILA 1: 5 KPIs con sparkline ─────────────────────────────── *@
            <div class="nexo-bi-kpi-row mb-4">

                @* Ventas recientes *@
                <div class="nexo-kpi nexo-kpi--primary nexo-bi-kpi">
                    <div class="d-flex align-center justify-space-between">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" /></div>
                        @if (_sparklines is not null)
                        {
                            <span class="nexo-kpi-delta nexo-kpi-delta--up">↑ 7 días</span>
                        }
                    </div>
                    <div class="nexo-kpi__value" style="font-size:1.6rem">
                        @(_sparklines?.Facturas.Sum(x => x.Valor) ?? 0)
                    </div>
                    <div class="nexo-kpi__label">Facturas (semana)</div>
                    <div class="nexo-kpi__sub">Hoy: @(_sparklines?.Facturas.LastOrDefault()?.Valor ?? 0)</div>
                    @if (_sparklines is not null) { <div class="nexo-kpi-spark">@SparklineSvg(_sparklines.Facturas)</div> }
                </div>

                @* Órdenes de producción *@
                <div class="nexo-kpi nexo-kpi--indigo nexo-bi-kpi">
                    <div class="d-flex align-center justify-space-between">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Factory" Size="Size.Small" /></div>
                        @if (_sparklines is not null) { <span class="nexo-kpi-delta nexo-kpi-delta--up">↑ 7 días</span> }
                    </div>
                    <div class="nexo-kpi__value" style="font-size:1.6rem">
                        @(_sparklines?.Ordenes.Sum(x => x.Valor) ?? 0)
                    </div>
                    <div class="nexo-kpi__label">OPs (semana)</div>
                    <div class="nexo-kpi__sub">Hoy: @(_sparklines?.Ordenes.LastOrDefault()?.Valor ?? 0)</div>
                    @if (_sparklines is not null) { <div class="nexo-kpi-spark">@SparklineSvg(_sparklines.Ordenes)</div> }
                </div>

                @* Clientes nuevos *@
                <div class="nexo-kpi nexo-kpi--teal nexo-bi-kpi">
                    <div class="d-flex align-center justify-space-between">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" /></div>
                        <span class="nexo-kpi-delta nexo-kpi-delta--up">30 días</span>
                    </div>
                    <div class="nexo-kpi__value" style="font-size:1.6rem">@_resumenCrm.ClientesNuevos</div>
                    <div class="nexo-kpi__label">Clientes nuevos</div>
                    <div class="nexo-kpi__sub">@_resumenCrm.Interacciones interacciones</div>
                </div>

                @* Productos activos *@
                <div class="nexo-kpi nexo-kpi--blue nexo-bi-kpi">
                    <div class="d-flex align-center justify-space-between">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" /></div>
                        <span class="nexo-kpi-delta" style="color:var(--mud-palette-text-secondary)">catálogo</span>
                    </div>
                    <div class="nexo-kpi__value" style="font-size:1.6rem">@_productosTerminados.Count</div>
                    <div class="nexo-kpi__label">Productos activos</div>
                    <div class="nexo-kpi__sub">En catálogo</div>
                </div>

                @* Stock con alerta *@
                <div class="nexo-kpi nexo-kpi--@(_resumenInventario.ArticulosConAlerta > 0 ? "red" : "green") nexo-bi-kpi">
                    <div class="d-flex align-center justify-space-between">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@(_resumenInventario.ArticulosConAlerta > 0 ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle)" Size="Size.Small" /></div>
                        <span class="nexo-kpi-delta" style="color:@(_resumenInventario.ArticulosConAlerta > 0 ? "var(--mud-palette-error)" : "var(--mud-palette-success)")">
                            @(_resumenInventario.ArticulosConAlerta > 0 ? "¡Atención!" : "OK")
                        </span>
                    </div>
                    <div class="nexo-kpi__value" style="font-size:1.6rem">@_resumenInventario.ArticulosConAlerta</div>
                    <div class="nexo-kpi__label">Stock con alerta</div>
                    <div class="nexo-kpi__sub">@(_resumenInventario.ArticulosConAlerta == 0 ? "Todo en orden" : "Requieren pedido")</div>
                </div>
            </div>

            @* ── FILA 2: Línea (70%) + Dona (30%) ─────────────────────────── *@
            <MudGrid Class="mb-4" Spacing="3">
                <MudItem xs="12" md="8">
                    <MudPaper Class="pa-5" Style="height:100%">
                        <div class="nexo-chart-header mb-3">
                            <MudIcon Icon="@Icons.Material.Outlined.TrendingUp" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div>
                                <div class="nexo-chart-header__title">Tendencia — últimos 7 días</div>
                                <div class="nexo-chart-header__sub">Facturas y OPs de producción</div>
                            </div>
                        </div>
                        @if (_sparklines is not null && _sparklines.Facturas.Count > 0)
                        {
                            <MudChart ChartType="ChartType.Line"
                                      ChartSeries="@_seriesGeneralLinea"
                                      XAxisLabels="@_labelsGeneralLinea"
                                      ChartOptions="@_opcionesGrafico"
                                      Width="100%" Height="220px" />
                        }
                        else
                        {
                            <div class="nexo-empty-state"><MudProgressCircular Indeterminate="true" /></div>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-5" Style="height:100%">
                        <div class="nexo-chart-header mb-3">
                            <MudIcon Icon="@Icons.Material.Outlined.DonutSmall" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div>
                                <div class="nexo-chart-header__title">Documentos (semana)</div>
                                <div class="nexo-chart-header__sub">Distribución por tipo</div>
                            </div>
                        </div>
                        @if (_sparklines is not null)
                        {
                            <MudChart ChartType="ChartType.Donut"
                                      InputData="@_dataGeneralDonut"
                                      InputLabels="@_labelsGeneralDonut"
                                      ChartOptions="@_opcionesGrafico"
                                      Width="100%" Height="180px" />
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* ── FILA 3: Estado OPs · Actividad · Top productos ────────────── *@
            <MudGrid Class="mb-4" Spacing="3">

                @* Producción — estado y cumplimiento *@
                <MudItem xs="12" md="3">
                    <MudPaper Class="pa-5" Style="height:100%">
                        <div class="nexo-chart-header mb-3">
                            <MudIcon Icon="@Icons.Material.Outlined.Factory" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div>
                                <div class="nexo-chart-header__title">Producción</div>
                                <div class="nexo-chart-header__sub">Últimos 14 días</div>
                            </div>
                        </div>
                        <div class="nexo-bi-stat-list">
                            <div class="nexo-bi-stat">
                                <span class="nexo-bi-stat__label">Órdenes finalizadas</span>
                                <span class="nexo-bi-stat__val">@_totalOrdenesFinalizadas</span>
                            </div>
                            <div class="nexo-bi-stat">
                                <span class="nexo-bi-stat__label">A tiempo</span>
                                <span class="nexo-bi-stat__val" style="color:var(--mud-palette-success)">@_totalOrdenesATiempo</span>
                            </div>
                            <div class="nexo-bi-stat">
                                <span class="nexo-bi-stat__label">Cumplimiento</span>
                                <span class="nexo-bi-stat__val" style="color:@(_cumplimientoPromedio >= 80 ? "var(--mud-palette-success)" : _cumplimientoPromedio >= 50 ? "var(--mud-palette-warning)" : "var(--mud-palette-error)")">
                                    @_cumplimientoPromedio.ToString("N0")%
                                </span>
                            </div>
                            <div class="nexo-bi-stat">
                                <span class="nexo-bi-stat__label">Unidades producidas</span>
                                <span class="nexo-bi-stat__val">@_totalRealProducido.ToString("N0")</span>
                            </div>
                            <div class="nexo-bi-stat">
                                <span class="nexo-bi-stat__label">Empleados activos</span>
                                <span class="nexo-bi-stat__val">@_totalEmpleadosActivos</span>
                            </div>
                            <div class="nexo-bi-stat">
                                <span class="nexo-bi-stat__label">Valor de stock</span>
                                <span class="nexo-bi-stat__val">@_resumenInventario.ValorTotalStock.ToString("C0")</span>
                            </div>
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" FullWidth="true" Class="mt-3"
                                   OnClick="@(() => Navigation.NavigateTo("/produccion/ordenes"))">
                            Ver producción
                        </MudButton>
                    </MudPaper>
                </MudItem>

                @* Actividad reciente *@
                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-0" Style="height:100%; overflow:hidden">
                        <div class="nexo-chart-header pa-5 pb-3" style="border-bottom:1px solid var(--mud-palette-lines-default)">
                            <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div>
                                <div class="nexo-chart-header__title">Actividad reciente</div>
                                <div class="nexo-chart-header__sub">Actualiza cada 60 s</div>
                            </div>
                        </div>
                        <div class="pa-4 nexo-actividad-feed">
                            @if (_actividad.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudText>Sin actividad reciente.</MudText></div>
                            }
                            @foreach (var item in _actividad.Take(8))
                            {
                                var iconoColor = item.Color switch
                                {
                                    "primary"   => "color:var(--mud-palette-primary)",
                                    "success"   => "color:var(--mud-palette-success)",
                                    "info"      => "color:var(--mud-palette-info)",
                                    _           => "color:var(--mud-palette-text-secondary)"
                                };
                                var iconoBg = item.Color switch
                                {
                                    "primary"   => "background:color-mix(in srgb,var(--mud-palette-primary) 12%,transparent)",
                                    "success"   => "background:color-mix(in srgb,var(--mud-palette-success) 12%,transparent)",
                                    "info"      => "background:color-mix(in srgb,var(--mud-palette-info) 12%,transparent)",
                                    _           => "background:var(--mud-palette-background-grey)"
                                };
                                var icono = item.Icono switch
                                {
                                    "receipt"       => Icons.Material.Outlined.Receipt,
                                    "shopping_cart" => Icons.Material.Outlined.ShoppingCart,
                                    "factory"       => Icons.Material.Outlined.Factory,
                                    "description"   => Icons.Material.Outlined.Description,
                                    "sync"          => Icons.Material.Outlined.Sync,
                                    _               => Icons.Material.Outlined.Circle
                                };
                                var t = DateTime.UtcNow - item.FechaHora;
                                var tiempo = t.TotalMinutes < 1 ? "ahora" : t.TotalMinutes < 60 ? $"hace {(int)t.TotalMinutes} min" : t.TotalHours < 24 ? $"hace {(int)t.TotalHours} h" : $"hace {(int)t.TotalDays} d";
                                <div class="nexo-actividad-item" @onclick="@(() => Navigation.NavigateTo(item.Link))">
                                    <div class="nexo-actividad-icon" style="@iconoBg">
                                        <MudIcon Icon="@icono" Size="Size.Small" Style="@iconoColor" />
                                    </div>
                                    <div class="nexo-actividad-body">
                                        <div class="nexo-actividad-desc">@item.Descripcion</div>
                                        <div class="nexo-actividad-meta">@tiempo · @item.Entidad</div>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Style="color:var(--mud-palette-text-disabled); margin-top:7px; flex-shrink:0" />
                                </div>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                @* Top 5 productos *@
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-5" Style="height:100%">
                        <div class="nexo-chart-header mb-3">
                            <MudIcon Icon="@Icons.Material.Outlined.Leaderboard" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div>
                                <div class="nexo-chart-header__title">Top productos</div>
                                <div class="nexo-chart-header__sub">Por precio de venta</div>
                            </div>
                        </div>
                        @{
                            var topProds = _productosTerminados.OrderByDescending(p => p.PrecioVenta).Take(5).ToList();
                            var maxPrecio = topProds.Count > 0 ? (double)topProds[0].PrecioVenta : 1;
                        }
                        @foreach (var prod in topProds)
                        {
                            var pct = maxPrecio > 0 ? (double)prod.PrecioVenta / maxPrecio * 100 : 0;
                            <div class="nexo-bi-hbar mb-3">
                                <div class="d-flex justify-space-between mb-1">
                                    <span class="nexo-bi-hbar__label">@(prod.SKU) — @(prod.Nombre.Length > 22 ? prod.Nombre[..22] + "…" : prod.Nombre)</span>
                                    <span class="nexo-bi-hbar__val">@prod.PrecioVenta.ToString("C0")</span>
                                </div>
                                <div class="nexo-bi-hbar__track">
                                    <div class="nexo-bi-hbar__fill" style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                            </div>
                        }
                        @if (topProds.Count == 0)
                        {
                            <div class="nexo-empty-state"><MudText>Sin productos en catálogo.</MudText></div>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* ── FILA 4: Barra cartera por cobrar ─────────────────────────── *@
            @if (_cartera.Count > 0)
            {
                <MudPaper Class="pa-5 mb-4">
                    <div class="nexo-chart-header mb-3">
                        <MudIcon Icon="@Icons.Material.Outlined.AccountBalanceWallet" Size="Size.Small" Class="nexo-chart-header__icon" Style="color:#F43F5E!important" />
                        <div class="flex-grow-1">
                            <div class="nexo-chart-header__title">Cartera por cobrar</div>
                            <div class="nexo-chart-header__sub">@_cartera.Count documento(s) · Total: @_totalSaldoCartera.ToString("C0")</div>
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/facturacion"))">Ver facturas</MudButton>
                    </div>
                    @{
                        var maxSaldo = _cartera.Count > 0 ? (double)_cartera.Max(f => f.SaldoPendiente) : 1;
                    }
                    @foreach (var f in _cartera.Take(6))
                    {
                        var pctC = maxSaldo > 0 ? (double)f.SaldoPendiente / maxSaldo * 100 : 0;
                        var antig = (DateTime.Today - f.Fecha).Days;
                        var color = antig > 60 ? "#EF4444" : antig > 30 ? "#F59E0B" : "#7C5CFF";
                        <div class="nexo-bi-hbar mb-2">
                            <div class="d-flex justify-space-between mb-1">
                                <span class="nexo-bi-hbar__label">@f.Cliente</span>
                                <span class="nexo-bi-hbar__val" style="color:@color">@f.SaldoPendiente.ToString("C0") <span style="font-size:0.7rem;opacity:.7">(+@antig d)</span></span>
                            </div>
                            <div class="nexo-bi-hbar__track">
                                <div class="nexo-bi-hbar__fill" style="width:@pctC.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background:@color"></div>
                            </div>
                        </div>
                    }
                </MudPaper>
            }

            @* ── FILA 5: Alertas ejecutivas ───────────────────────────────── *@
            <div class="nexo-bi-alert-grid mb-4">

                @* Stock bajo *@
                <div class="nexo-bi-alert nexo-bi-alert--@(_resumenInventario.ArticulosConAlerta > 0 ? "red" : "green")"
                     @onclick="@(() => Navigation.NavigateTo("/inventario/stock"))" style="cursor:pointer">
                    <div class="nexo-bi-alert__icon">
                        <MudIcon Icon="@(_resumenInventario.ArticulosConAlerta > 0 ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle)" />
                    </div>
                    <div class="nexo-bi-alert__body">
                        <div class="nexo-bi-alert__title">Stock bajo</div>
                        <div class="nexo-bi-alert__desc">
                            @if (_resumenInventario.ArticulosConAlerta > 0)
                            { @($"{_resumenInventario.ArticulosConAlerta} artículo(s) por debajo del mínimo") }
                            else { <text>Todos los niveles están bien</text> }
                        </div>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Style="opacity:.5" />
                </div>

                @* Clientes fríos *@
                <div class="nexo-bi-alert nexo-bi-alert--@(_clientesFrios.Count > 0 ? "amber" : "green")"
                     @onclick="@(() => Navigation.NavigateTo("/crm/clientes"))" style="cursor:pointer">
                    <div class="nexo-bi-alert__icon">
                        <MudIcon Icon="@Icons.Material.Filled.AcUnit" />
                    </div>
                    <div class="nexo-bi-alert__body">
                        <div class="nexo-bi-alert__title">Clientes fríos</div>
                        <div class="nexo-bi-alert__desc">
                            @if (_clientesFrios.Count > 0)
                            { @($"{_clientesFrios.Count} sin interacción hace +30 días") }
                            else { <text>Sin clientes fríos</text> }
                        </div>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Style="opacity:.5" />
                </div>

                @* Cartera pendiente *@
                <div class="nexo-bi-alert nexo-bi-alert--@(_cartera.Count > 0 ? "red" : "green")"
                     @onclick="@(() => Navigation.NavigateTo("/facturacion"))" style="cursor:pointer">
                    <div class="nexo-bi-alert__icon">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" />
                    </div>
                    <div class="nexo-bi-alert__body">
                        <div class="nexo-bi-alert__title">Pagos pendientes</div>
                        <div class="nexo-bi-alert__desc">
                            @if (_cartera.Count > 0)
                            { @($"{_cartera.Count} doc(s) · {_totalSaldoCartera.ToString("C0")}") }
                            else { <text>Sin documentos por cobrar</text> }
                        </div>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Style="opacity:.5" />
                </div>

                @* Producción atrasada *@
                <div class="nexo-bi-alert nexo-bi-alert--@(_alertasProyectos.Count > 0 || _desviaciones.Count > 0 ? "amber" : "green")"
                     @onclick="@(() => Navigation.NavigateTo("/produccion/ordenes"))" style="cursor:pointer">
                    <div class="nexo-bi-alert__icon">
                        <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" />
                    </div>
                    <div class="nexo-bi-alert__body">
                        <div class="nexo-bi-alert__title">Producción atrasada</div>
                        <div class="nexo-bi-alert__desc">
                            @if (_alertasProyectos.Count > 0 || _desviaciones.Count > 0)
                            { @($"{_alertasProyectos.Count} proyecto(s) · {_desviaciones.Count} desviación(es)") }
                            else { <text>Sin atrasos detectados</text> }
                        </div>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Style="opacity:.5" />
                </div>

            </div>

            @* ── Combos de marketing (si aplica) ─────────────────────────── *@
            @if (!ConfiguracionEmpresa.UsaVisions && _combosActivos.Count > 0)
            {
                <div class="nexo-section"><div class="nexo-section__dot"></div><span class="nexo-section__label">Marketing activo</span><div class="nexo-section__line"></div></div>
                <div class="nexo-kpi-grid mb-4">
                    @foreach (var combo in _combosActivos.Take(4))
                    {
                        <div class="nexo-kpi nexo-kpi--indigo" style="cursor:pointer" @onclick="@(() => Navigation.NavigateTo("/marketing/combos"))">
                            <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" /></div>
                            <div class="nexo-kpi__value">@combo.PrecioEfectivo.ToString("C0")</div>
                            <div class="nexo-kpi__label">@combo.Nombre</div>
                            <div class="nexo-kpi__sub">
                                @if (combo.PorcentajeDescuento > 0) { <text>-@combo.PorcentajeDescuento% · </text> }
                                @(combo.FechaFin.HasValue ? $"Hasta {combo.FechaFin:dd/MM}" : "Sin vencimiento")
                            </div>
                        </div>
                    }
                </div>
            }

            @* ── Próximo evento ───────────────────────────────────────────── *@
            @if (_proximoEvento is not null)
            {
                var ev = _proximoEvento;
                var inicio = ev.FechaInicio.ToLocalTime();
                var colorTipo = ev.ColorTipo;
                <MudPaper Class="pa-4 mb-4" Style="@($"border-left: 4px solid {colorTipo};")">
                    <div class="d-flex align-center flex-wrap" style="gap:12px">
                        <div style="@($"width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,{colorTipo} 12%,transparent);flex-shrink:0")">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Style="@($"color:{colorTipo}")" />
                        </div>
                        <div style="flex:1;min-width:0">
                            <div style="font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:.06em;color:@colorTipo;margin-bottom:2px">Próximo evento · @ev.TipoEvento</div>
                            <div style="font-size:15px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@ev.Titulo</div>
                            <div style="font-size:12px;color:var(--mud-palette-text-secondary);margin-top:2px">
                                @inicio.ToString("dddd d MMM · HH:mm")
                                @if (!string.IsNullOrEmpty(ev.Lugar)) { <text> · @ev.Lugar</text> }
                            </div>
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/planificacion/calendario"))">Ver calendario</MudButton>
                    </div>
                </MudPaper>
            }

        </MudTabPanel>

        @* ═══════════════════════════════════════════ TAB FACTURACIÓN ══ *@
        <MudTabPanel Text="Facturación" Icon="@Icons.Material.Outlined.Receipt">
            @if (_tabFactCargando)
            {
                <div class="d-flex justify-center py-12"><MudProgressCircular Indeterminate="true" /></div>
            }
            else
            {
                <div class="nexo-section" style="margin-top:0.25rem">
                    <div class="nexo-section__dot" style="background:#10B981"></div>
                    <span class="nexo-section__label">Resumen del período</span>
                    <div class="nexo-section__line"></div>
                    <MudDateRangePicker @bind-DateRange="_rangoFact" @bind-DateRange:after="OnRangoFactCambiadoAsync"
                                        Label="Período" Variant="Variant.Outlined" Margin="Margin.Dense"
                                        PickerVariant="PickerVariant.Dialog" DateFormat="dd/MM/yyyy"
                                        Style="max-width:280px;min-width:240px;" />
                </div>
                <div class="nexo-kpi-grid mb-4">
                    <div class="nexo-kpi nexo-kpi--blue">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenFact.DocumentosEmitidos</div>
                        <div class="nexo-kpi__label">Documentos Emitidos</div>
                        <div class="nexo-kpi__sub">En el período seleccionado</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--green">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenFact.TotalEmitido.ToString("C0")</div>
                        <div class="nexo-kpi__label">Total Facturado</div>
                        <div class="nexo-kpi__sub">Bruto sin descuentos</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--teal">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenFact.TotalCobrado.ToString("C0")</div>
                        <div class="nexo-kpi__label">Total Cobrado</div>
                        <div class="nexo-kpi__sub">
                            @{ var pctCob = _resumenFact.TotalEmitido > 0 ? (_resumenFact.TotalCobrado / _resumenFact.TotalEmitido * 100) : 0; }
                            @pctCob.ToString("N1")% de efectividad de cobro
                        </div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--rose">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenFact.SaldoPendiente.ToString("C0")</div>
                        <div class="nexo-kpi__label">Saldo Pendiente</div>
                        <div class="nexo-kpi__sub">Por cobrar al cierre del período</div>
                    </div>
                </div>

                <div class="nexo-section"><div class="nexo-section__dot" style="background:#10B981"></div><span class="nexo-section__label">Evolución de ingresos</span><div class="nexo-section__line"></div></div>
                <MudGrid Class="mb-4">
                    <MudItem xs="12">
                        <MudPaper Class="pa-5 nexo-chart-card" Style="height:400px">
                            <div class="nexo-chart-header nexo-chart-card__header">
                                <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                                <div>
                                    <div class="nexo-chart-header__title">Ingresos por Mes</div>
                                    <div class="nexo-chart-header__sub">Facturado vs Cobrado — últimos @_mesesFact meses</div>
                                </div>
                                <MudSelect T="int" Value="_mesesFact" ValueChanged="OnMesesFactCambiadoAsync"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px">
                                    <MudSelectItem T="int" Value="3">3 meses</MudSelectItem>
                                    <MudSelectItem T="int" Value="6">6 meses</MudSelectItem>
                                    <MudSelectItem T="int" Value="12">12 meses</MudSelectItem>
                                    <MudSelectItem T="int" Value="24">24 meses</MudSelectItem>
                                </MudSelect>
                            </div>
                            <div class="nexo-chart-card__body">
                                @if (_ingresosMes.Count == 0)
                                {
                                    <div class="nexo-empty-state">
                                        <MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" />
                                        <p class="nexo-empty-state__text">Sin facturación registrada en este período.</p>
                                    </div>
                                }
                                else
                                {
                                    <MudChart ChartType="ChartType.Bar" ChartSeries="@_seriesIngresosMes" XAxisLabels="@_labelsIngresosMes"
                                              ChartOptions="@_opcionesGrafico" Width="100%" Height="280px" />
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @* ── Comparativa Año a Año ──────────────────────────────── *@
                @if (_comparativaYoY.Count > 0)
                {
                    <div class="nexo-section">
                        <div class="nexo-section__dot" style="background:#6366f1"></div>
                        <span class="nexo-section__label">Comparativa vs año anterior</span>
                        <div class="nexo-section__line"></div>
                    </div>
                    <div style="overflow-x:auto;margin-bottom:1.5rem">
                        <table style="width:100%;border-collapse:collapse;font-size:0.85rem">
                            <thead>
                                <tr style="color:var(--mud-palette-text-secondary)">
                                    <th style="text-align:left;padding:6px 8px">Mes</th>
                                    <th style="text-align:right;padding:6px 8px">Este año</th>
                                    <th style="text-align:right;padding:6px 8px">Año anterior</th>
                                    <th style="text-align:right;padding:6px 8px">Variación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in _comparativaYoY)
                                {
                                    var pct  = m.VariacionPct;
                                    var color = pct > 0 ? "#10B981" : pct < 0 ? "#EF4444" : "var(--mud-palette-text-secondary)";
                                    var signo = pct > 0 ? "▲" : pct < 0 ? "▼" : "—";
                                    <tr style="border-top:1px solid var(--mud-palette-lines-default)">
                                        <td style="padding:6px 8px;font-weight:500">@m.NombreMes @m.Anio</td>
                                        <td style="text-align:right;padding:6px 8px;font-weight:600">@m.TotalActual.ToString("C0")</td>
                                        <td style="text-align:right;padding:6px 8px;color:var(--mud-palette-text-secondary)">@m.TotalAnterior.ToString("C0")</td>
                                        <td style="text-align:right;padding:6px 8px;font-weight:700;color:@color">
                                            @signo @Math.Abs(pct).ToString("N1")%
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="nexo-section"><div class="nexo-section__dot" style="background:#10B981"></div><span class="nexo-section__label">Rankings</span><div class="nexo-section__line"></div></div>
                <MudGrid Class="mb-4">
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-5 nexo-chart-card">
                            <div class="nexo-chart-header nexo-chart-card__header">
                                <MudIcon Icon="@Icons.Material.Outlined.People" Size="Size.Small" Class="nexo-chart-header__icon" />
                                <div>
                                    <div class="nexo-chart-header__title">Top 10 Clientes</div>
                                    <div class="nexo-chart-header__sub">Por monto facturado en el período</div>
                                </div>
                            </div>
                            <div class="nexo-chart-card__body">
                                @if (_topClientes.Count == 0)
                                {
                                    <div class="nexo-empty-state">
                                        <MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" />
                                        <p class="nexo-empty-state__text">Sin facturas en el período.</p>
                                    </div>
                                }
                                else
                                {
                                    <MudTable Items="_topClientes" Dense="true" Hover="true" Elevation="0">
                                        <HeaderContent>
                                            <MudTh>#</MudTh><MudTh>Cliente</MudTh><MudTh Style="text-align:right">Docs</MudTh><MudTh Style="text-align:right">Total</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            @{ var idx = _topClientes.IndexOf(context) + 1; }
                                            <MudTd Style="font-size:0.8rem;color:#9B9BB4;font-weight:700">@idx</MudTd>
                                            <MudTd>
                                                <div style="font-size:0.85rem;font-weight:500">@context.Cliente</div>
                                                <div style="font-size:0.72rem;color:#9B9BB4">@context.NIT</div>
                                            </MudTd>
                                            <MudTd Style="text-align:right;font-size:0.82rem">@context.NumDocumentos</MudTd>
                                            <MudTd Style="text-align:right;font-weight:700;color:#10B981">@context.TotalFacturado.ToString("C0")</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-5 nexo-chart-card">
                            <div class="nexo-chart-header nexo-chart-card__header">
                                <MudIcon Icon="@Icons.Material.Outlined.Inventory" Size="Size.Small" Class="nexo-chart-header__icon" />
                                <div>
                                    <div class="nexo-chart-header__title">Top 10 Artículos Vendidos</div>
                                    <div class="nexo-chart-header__sub">Por ingresos en el período</div>
                                </div>
                            </div>
                            <div class="nexo-chart-card__body">
                                @if (_topArticulos.Count == 0)
                                {
                                    <div class="nexo-empty-state">
                                        <MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" />
                                        <p class="nexo-empty-state__text">Sin artículos vendidos en el período.</p>
                                    </div>
                                }
                                else
                                {
                                    <MudTable Items="_topArticulos" Dense="true" Hover="true" Elevation="0">
                                        <HeaderContent>
                                            <MudTh>#</MudTh><MudTh>Artículo</MudTh><MudTh Style="text-align:right">Cant.</MudTh><MudTh Style="text-align:right">Total</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            @{ var idx2 = _topArticulos.IndexOf(context) + 1; }
                                            <MudTd Style="font-size:0.8rem;color:#9B9BB4;font-weight:700">@idx2</MudTd>
                                            <MudTd>
                                                <div style="font-size:0.85rem;font-weight:500">@context.Nombre</div>
                                                <div style="font-size:0.72rem;color:#9B9BB4">@context.SKU</div>
                                            </MudTd>
                                            <MudTd Style="text-align:right;font-size:0.82rem">@context.CantidadVendida.ToString("N0")</MudTd>
                                            <MudTd Style="text-align:right;font-weight:700;color:#7C5CFF">@context.TotalFacturado.ToString("C0")</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            @* ── Sección Devoluciones ── *@
            @if (_analyticsDevolucion is not null)
            {
                <div class="nexo-section mt-4">
                    <div class="nexo-section__dot" style="background:#F59E0B"></div>
                    <span class="nexo-section__label">Devoluciones</span>
                    <div class="nexo-section__line"></div>
                </div>
                <div class="nexo-kpi-grid mb-4">
                    <div class="nexo-kpi nexo-kpi--rose">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.AssignmentReturn" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_analyticsDevolucion.TotalDevoluciones</div>
                        <div class="nexo-kpi__label">Devoluciones</div>
                        <div class="nexo-kpi__sub">En el período</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--rose">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.MoneyOff" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_analyticsDevolucion.ValorTotalDevuelto.ToString("C0")</div>
                        <div class="nexo-kpi__label">Valor devuelto</div>
                        <div class="nexo-kpi__sub">Costo mercancía restituida</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--rose">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_analyticsDevolucion.TasaDevolucionPct.ToString("N2")%</div>
                        <div class="nexo-kpi__label">Tasa de devolución</div>
                        <div class="nexo-kpi__sub">% sobre ventas del período</div>
                    </div>
                </div>

                @if (_analyticsDevolucion.TopArticulos.Any())
                {
                    <MudGrid Class="mb-4">
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-4 nexo-chart-card">
                                <div class="nexo-chart-header nexo-chart-card__header">
                                    <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                                    <div>
                                        <div class="nexo-chart-header__title">Artículos más devueltos</div>
                                        <div class="nexo-chart-header__sub">Top 10 por valor devuelto</div>
                                    </div>
                                </div>
                                <MudTable Items="_analyticsDevolucion.TopArticulos" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>#</MudTh><MudTh>Artículo</MudTh>
                                        <MudTh Style="text-align:right">Veces</MudTh>
                                        <MudTh Style="text-align:right">Valor</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        @{ var idxD = _analyticsDevolucion.TopArticulos.IndexOf(context) + 1; }
                                        <MudTd Style="font-size:0.8rem;color:#F59E0B;font-weight:700">@idxD</MudTd>
                                        <MudTd>
                                            <div style="font-size:0.85rem;font-weight:500">@context.Articulo</div>
                                            <div style="font-size:0.72rem;opacity:.6">@context.SKU</div>
                                        </MudTd>
                                        <MudTd Style="text-align:right;font-size:0.82rem">@context.VecesDevuelto</MudTd>
                                        <MudTd Style="text-align:right;font-weight:700;color:#F59E0B">@context.ValorTotal.ToString("C0")</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-4 nexo-chart-card" Style="height:100%">
                                <div class="nexo-chart-header nexo-chart-card__header mb-3">
                                    <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                                    <div>
                                        <div class="nexo-chart-header__title">Devoluciones por mes</div>
                                        <div class="nexo-chart-header__sub">Valor devuelto mensual</div>
                                    </div>
                                </div>
                                @if (_analyticsDevolucion.PorMes.Any())
                                {
                                    <MudChart ChartType="ChartType.Bar"
                                              ChartSeries="@(new List<ChartSeries> { new() { Name = "Valor devuelto", Data = _analyticsDevolucion.PorMes.Select(m => (double)m.ValorDevuelto).ToArray() } })"
                                              XAxisLabels="@(_analyticsDevolucion.PorMes.Select(m => m.Mes[5..]).ToArray())"
                                              ChartOptions="@_opcionesGrafico" Width="100%" Height="200px" />
                                }
                                else
                                {
                                    <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" /><p>Sin devoluciones en el período.</p></div>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }
            }
            }
        </MudTabPanel>

        @* ══════════════════════════════════════════════ TAB PRODUCCIÓN ══ *@
        <MudTabPanel Text="Producción" Icon="@Icons.Material.Outlined.Factory">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div class="flex-grow-1">
                                <div class="nexo-chart-header__title">Producción Planificada vs Real</div>
                                <div class="nexo-chart-header__sub">Comparativo diario</div>
                            </div>
                            <MudDateRangePicker @bind-DateRange="_rangoPlanVsReal" @bind-DateRange:after="OnRangoPlanVsRealCambiadoAsync"
                                                Label="Rango" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                PickerVariant="PickerVariant.Dialog" Style="max-width:300px;min-width:260px;" DateFormat="dd/MM/yyyy" />
                        </div>
                        <div class="nexo-chart-card__body">
                            @if (_planVsReal.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" /><p class="nexo-empty-state__text">Sin producción registrada en este periodo.</p></div>
                            }
                            else
                            {
                                <MudChart ChartType="ChartType.Bar" ChartSeries="@_seriesPlanVsReal" XAxisLabels="@_labelsPlanVsReal" ChartOptions="@_opcionesGrafico" Width="100%" Height="260px" />
                                <MudTable Items="_planVsReal" Dense="true" Hover="true" Elevation="0" Class="mt-4">
                                    <HeaderContent>
                                        <MudTh>Fecha</MudTh><MudTh Style="text-align:right">Planificado</MudTh><MudTh Style="text-align:right">Real</MudTh><MudTh Style="text-align:right">Cumplimiento</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd Style="text-align:right">@context.TotalPlanificado.ToString("N2")</MudTd>
                                        <MudTd Style="text-align:right">@context.TotalReal.ToString("N2")</MudTd>
                                        <MudTd Style="text-align:right">
                                            <MudChip T="string" Size="Size.Small" Color="@(PorcentajeCumplimientoDia(context) >= 80 ? Color.Success : PorcentajeCumplimientoDia(context) >= 50 ? Color.Warning : Color.Error)">@PorcentajeCumplimientoDia(context).ToString("N0")%</MudChip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.Insights" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div class="flex-grow-1">
                                <div class="nexo-chart-header__title">Variación de Producción vs Plan</div>
                                <div class="nexo-chart-header__sub">Verde: supera el plan · Rojo: por debajo</div>
                            </div>
                            <MudDateRangePicker @bind-DateRange="_rangoVariacion" @bind-DateRange:after="OnRangoVariacionCambiadoAsync"
                                                Label="Rango" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                PickerVariant="PickerVariant.Dialog" Style="max-width:260px;min-width:220px;" DateFormat="dd/MM/yyyy" />
                        </div>
                        <div class="nexo-chart-card__body">
                            @if (_variacionProduccion.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" /><p class="nexo-empty-state__text">Sin datos suficientes para calcular la variación.</p></div>
                            }
                            else
                            {
                                <div class="nexo-variacion-chart" style="overflow-x:auto;">
                                    <svg viewBox="@($"0 0 {AnchoSvgVariacion} 240")" preserveAspectRatio="none"
                                         class="nexo-variacion-chart__svg" style="min-width:@(AnchoSvgVariacion)px;width:@(AnchoSvgVariacion)px;">
                                        <line x1="0" y1="120" x2="@AnchoSvgVariacion" y2="120" class="nexo-variacion-chart__zero" />
                                        @((MarkupString)ConstruirSvgVariacion())
                                    </svg>
                                    <div class="nexo-variacion-chart__axis" style="min-width:@(AnchoSvgVariacion)px;">
                                        @foreach (var p in _variacionProduccion) { <span>@p.Fecha.ToString("dd/MM")</span> }
                                    </div>
                                    <div class="nexo-variacion-chart__legend">
                                        <span class="nexo-variacion-chart__legend-dot nexo-variacion-chart__legend-dot--up"></span> Sobre lo planificado
                                        <span class="nexo-variacion-chart__legend-dot nexo-variacion-chart__legend-dot--down"></span> Bajo lo planificado
                                    </div>
                                </div>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.DonutLarge" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div><div class="nexo-chart-header__title">Distribución por Centro de Costo</div><div class="nexo-chart-header__sub">Unidades producidas (histórico)</div></div>
                        </div>
                        <div class="nexo-chart-card__body">
                            @if (_distribucion.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" /><p class="nexo-empty-state__text">Sin órdenes finalizadas aún.</p></div>
                            }
                            else
                            {
                                <MudChart ChartType="ChartType.Donut" InputData="@_dataDistribucion" InputLabels="@_labelsDistribucion" ChartOptions="@_opcionesGrafico" Width="100%" Height="260px" />
                                <MudTable Items="_distribucion" Dense="true" Hover="true" Elevation="0" Class="mt-4">
                                    <HeaderContent>
                                        <MudTh>Centro</MudTh><MudTh Style="text-align:right">Órdenes</MudTh><MudTh Style="text-align:right">Unidades</MudTh><MudTh Style="text-align:right">Inversión</MudTh><MudTh Style="text-align:right">%</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.CentroCosto</MudTd>
                                        <MudTd Style="text-align:right">@context.TotalOrdenes</MudTd>
                                        <MudTd Style="text-align:right">@context.TotalUnidadesProducidas.ToString("N2")</MudTd>
                                        <MudTd Style="text-align:right">@context.InversionTotal.ToString("C2")</MudTd>
                                        <MudTd Style="text-align:right">@PorcentajeDistribucion(context).ToString("N0")%</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.PieChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div class="flex-grow-1">
                                <div class="nexo-chart-header__title">Pérdidas y Mermas por Motivo</div>
                                <div class="nexo-chart-header__sub">Detalle por motivo</div>
                            </div>
                            <MudDateRangePicker @bind-DateRange="_rangoPerdidas" @bind-DateRange:after="OnRangoPerdidasCambiadoAsync"
                                                Label="Rango" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                PickerVariant="PickerVariant.Dialog" Style="max-width:300px;min-width:260px;" DateFormat="dd/MM/yyyy" />
                        </div>
                        <div class="nexo-chart-card__body">
                            @if (_perdidas.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Class="nexo-empty-state__icon nexo-empty-state__icon--success" /><p class="nexo-empty-state__text">Sin pérdidas registradas en este periodo.</p></div>
                            }
                            else
                            {
                                <MudChart ChartType="ChartType.Pie" InputData="@_dataPerdidas" InputLabels="@_labelsPerdidas" ChartOptions="@_opcionesGrafico" Width="100%" Height="260px" />
                                <MudTable Items="_perdidas" Dense="true" Hover="true" Elevation="0" Class="mt-4">
                                    <HeaderContent>
                                        <MudTh>Motivo</MudTh><MudTh Style="text-align:right">Cantidad</MudTh><MudTh Style="text-align:right">Valor</MudTh><MudTh Style="text-align:right">%</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Motivo</MudTd>
                                        <MudTd Style="text-align:right">@context.CantidadTotalPerdida.ToString("N2")</MudTd>
                                        <MudTd Style="text-align:right">@context.ValorTotalPerdido.ToString("C2")</MudTd>
                                        <MudTd Style="text-align:right">@PorcentajePerdida(context).ToString("N0")%</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.ShowChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div><div class="nexo-chart-header__title">Tendencia de Costo Unitario</div><div class="nexo-chart-header__sub">Por producto terminado</div></div>
                        </div>
                        <div class="nexo-chart-card__body">
                            <MudSelect T="int" Value="_articuloSeleccionadoId" ValueChanged="OnProductoCambiadoAsync"
                                       Label="Seleccionar producto" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4">
                                @foreach (var producto in _productosTerminados)
                                {
                                    <MudSelectItem T="int" Value="@producto.ArticuloID">@producto.SKU - @producto.Nombre (@producto.TipoArticulo)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (_articuloSeleccionadoId == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.TouchApp" Class="nexo-empty-state__icon" /><p class="nexo-empty-state__text">Elige un producto para ver su tendencia de costo.</p></div>
                            }
                            else if (_tendencia.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.HourglassEmpty" Class="nexo-empty-state__icon" /><p class="nexo-empty-state__text">Este producto aún no tiene órdenes finalizadas.</p></div>
                            }
                            else
                            {
                                @if (_tendencia.Count == 1) { <MudAlert Severity="Severity.Info" Class="mb-3">Solo hay una orden finalizada. La tendencia se verá con más órdenes.</MudAlert> }
                                <MudChart ChartType="@(_tendencia.Count >= 2 ? ChartType.Line : ChartType.Bar)" ChartSeries="@_seriesTendencia" XAxisLabels="@_labelsTendencia" ChartOptions="@_opcionesGrafico" Width="100%" Height="220px" />
                                <MudTable Items="_tendencia" Dense="true" Hover="true" Elevation="0" Class="mt-4">
                                    <HeaderContent><MudTh>Fecha</MudTh><MudTh Style="text-align:right">Costo Unitario</MudTh></HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd Style="text-align:right">@context.CostoUnitarioReal.ToString("C2")</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header mb-4">
                            <MudIcon Icon="@Icons.Material.Outlined.TableChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div><div class="nexo-chart-header__title">Cumplimiento de Planificación</div><div class="nexo-chart-header__sub">Por centro de costo</div></div>
                        </div>
                        <div class="nexo-chart-card__body">
                            @if (_cumplimiento.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" /><p class="nexo-empty-state__text">Sin órdenes finalizadas aún.</p></div>
                            }
                            else
                            {
                                <MudTable Items="_cumplimiento" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Centro de Costo</MudTh><MudTh Style="text-align:right">Finalizadas</MudTh><MudTh Style="text-align:right">A Tiempo</MudTh><MudTh Style="text-align:right">Cumplimiento</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd><span class="font-semibold">@context.CentroCosto</span></MudTd>
                                        <MudTd Style="text-align:right">@context.TotalOrdenesFinalizadas</MudTd>
                                        <MudTd Style="text-align:right">@context.OrdenesATiempo</MudTd>
                                        <MudTd Style="text-align:right">
                                            <MudChip T="string" Size="Size.Small" Color="@(context.PorcentajeCumplimiento >= 80 ? Color.Success : context.PorcentajeCumplimiento >= 50 ? Color.Warning : Color.Error)">@context.PorcentajeCumplimiento.ToString("N1")%</MudChip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* ═══════════════════════════════════════════════════ TAB CRM ══ *@
        <MudTabPanel Text="CRM" Icon="@Icons.Material.Outlined.People">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <div class="nexo-kpi nexo-kpi--indigo mb-4">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenCrm.ClientesNuevos</div>
                        <div class="nexo-kpi__label">Clientes Nuevos</div>
                        <div class="nexo-kpi__sub">Últimos 30 días</div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="nexo-kpi nexo-kpi--teal mb-4">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenCrm.Interacciones</div>
                        <div class="nexo-kpi__label">Interacciones</div>
                        <div class="nexo-kpi__sub">Últimos 30 días</div>
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="nexo-kpi nexo-kpi--red mb-4">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.AcUnit" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_clientesFrios.Count</div>
                        <div class="nexo-kpi__label">Clientes Fríos</div>
                        <div class="nexo-kpi__sub">Sin contacto hace +30 días</div>
                    </div>
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.AcUnit" Size="Size.Small" Class="nexo-chart-header__icon" Style="color:#6366F1!important" />
                            <div class="flex-grow-1">
                                <div class="nexo-chart-header__title">Clientes Fríos</div>
                                <div class="nexo-chart-header__sub">@_clientesFrios.Count clientes sin interacción reciente</div>
                            </div>
                            <div class="d-flex gap-2">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Map"
                                           OnClick="AbrirMapaClientesAsync">Ver Mapa</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           OnClick="@(() => Navigation.NavigateTo("/crm/clientes"))">Ir al CRM</MudButton>
                            </div>
                        </div>
                        <div class="nexo-chart-card__body">
                            @if (_clientesFrios.Count == 0)
                            {
                                <div class="nexo-empty-state">
                                    <MudIcon Icon="@Icons.Material.Outlined.Whatshot" Class="nexo-empty-state__icon nexo-empty-state__icon--success" />
                                    <p class="nexo-empty-state__text">Todos los clientes han tenido contacto reciente.</p>
                                </div>
                            }
                            else
                            {
                                <MudTable Items="@ClientesFriosPaginados" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Cliente</MudTh><MudTh>Responsable</MudTh><MudTh>Última interacción</MudTh><MudTh>Próximo contacto</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>
                                            <MudLink OnClick="@(() => Navigation.NavigateTo($"/crm/clientes/{context.ExternalId}"))" Style="cursor:pointer;font-weight:500">@context.Nombre</MudLink>
                                        </MudTd>
                                        <MudTd Style="font-size:0.82rem">@(context.Responsable ?? "-")</MudTd>
                                        <MudTd Style="font-size:0.82rem">
                                            @if (context.UltimaInteraccion is null)
                                            { <MudChip T="string" Size="Size.Small" Color="Color.Error">Nunca</MudChip> }
                                            else
                                            {
                                                var dias = (int)(DateTime.UtcNow - context.UltimaInteraccion.Value).TotalDays;
                                                <span style="color:@(dias > 60 ? "#EF4444" : dias > 30 ? "#F59E0B" : "inherit")">hace @dias días</span>
                                            }
                                        </MudTd>
                                        <MudTd Style="font-size:0.82rem">@(context.ProximoContacto?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                                    </RowTemplate>
                                </MudTable>
                                @if (_totalPaginasFrios > 1)
                                {
                                    <div class="d-flex justify-center align-center gap-2 mt-3">
                                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                                       Disabled="@(_paginaFrios <= 1)"
                                                       OnClick="@(() => { _paginaFrios--; StateHasChanged(); })" />
                                        <MudText Typo="Typo.body2">@_paginaFrios / @_totalPaginasFrios</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                                       Disabled="@(_paginaFrios >= _totalPaginasFrios)"
                                                       OnClick="@(() => { _paginaFrios++; StateHasChanged(); })" />
                                    </div>
                                }
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div><div class="nexo-chart-header__title">Empleados por Centro</div><div class="nexo-chart-header__sub">Activos · @_totalEmpleadosActivos total</div></div>
                        </div>
                        <div class="nexo-chart-card__body">
                            @if (_empleadosPorCentroCosto.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" /><p class="nexo-empty-state__text">Sin empleados registrados.</p></div>
                            }
                            else
                            {
                                @if (_empleadosPorCentroCosto.Count > 0)
                                {
                                    <MudChart ChartType="ChartType.Donut"
                                              InputData="@(_empleadosPorCentroCosto.Select(e => (double)e.TotalEmpleados).ToArray())"
                                              InputLabels="@(_empleadosPorCentroCosto.Select(e => e.CentroCosto).ToArray())"
                                              ChartOptions="@_opcionesGrafico" Width="100%" Height="200px" />
                                }
                                <MudTable Items="_empleadosPorCentroCosto" Dense="true" Hover="true" Elevation="0" Class="mt-4">
                                    <HeaderContent><MudTh>Centro</MudTh><MudTh Style="text-align:right">Empleados</MudTh></HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.CentroCosto</MudTd>
                                        <MudTd Style="text-align:right;font-weight:700">@context.TotalEmpleados</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* ══════════════════════════════════════════════ TAB INVENTARIO ══ *@
        <MudTabPanel Text="Inventario" Icon="@Icons.Material.Outlined.Inventory2">
            @if (_tabInvCargando)
            {
                <div class="d-flex justify-center py-12"><MudProgressCircular Indeterminate="true" /></div>
            }
            else
            {
                <div class="nexo-kpi-grid mb-4" style="grid-template-columns: repeat(2,1fr)">
                    <div class="nexo-kpi nexo-kpi--teal">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenInventario.ValorTotalStock.ToString("C0")</div>
                        <div class="nexo-kpi__label">Valor Total de Stock</div>
                        <div class="nexo-kpi__sub">Valorización al costo</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--@(_resumenInventario.ArticulosConAlerta > 0 ? "red" : "green")">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenInventario.ArticulosConAlerta</div>
                        <div class="nexo-kpi__label">Artículos con Alerta</div>
                        <div class="nexo-kpi__sub">@(_resumenInventario.ArticulosConAlerta == 0 ? "Sin artículos por debajo del mínimo" : "Requieren pedido urgente")</div>
                    </div>
                </div>

                @if (_alertasStock.Count > 0)
                {
                    <div class="nexo-section"><div class="nexo-section__dot" style="background:#EF4444"></div><span class="nexo-section__label">Artículos bajo el mínimo</span><div class="nexo-section__line"></div></div>
                    <MudPaper Class="pa-4 mb-4">
                        <MudTable Items="_alertasStock" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>SKU</MudTh>
                                <MudTh>Artículo</MudTh>
                                <MudTh>Centro / Bodega</MudTh>
                                <MudTh Style="text-align:right">Stock actual</MudTh>
                                <MudTh Style="text-align:right">Mínimo</MudTh>
                                <MudTh Style="text-align:right">Déficit</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Style="font-size:0.78rem;color:#9B9BB4;font-weight:600">@context.SKU</MudTd>
                                <MudTd Style="font-size:0.85rem;font-weight:500">@context.Articulo</MudTd>
                                <MudTd Style="font-size:0.78rem">@context.CentroCosto · @context.Bodega</MudTd>
                                <MudTd Style="text-align:right;color:#F59E0B;font-weight:600">@context.CantidadActual.ToString("N2")</MudTd>
                                <MudTd Style="text-align:right">@context.StockMinimo.ToString("N2")</MudTd>
                                <MudTd Style="text-align:right;color:#EF4444;font-weight:700">-@context.Deficit.ToString("N2")</MudTd>
                            </RowTemplate>
                        </MudTable>
                        <div style="margin-top:8px;text-align:right">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/inventario/stock"))">Ver stock completo</MudButton>
                        </div>
                    </MudPaper>
                }
                else if (_resumenInventario.ArticulosConAlerta == 0)
                {
                    <div class="nexo-empty-state">
                        <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Class="nexo-empty-state__icon nexo-empty-state__icon--success" />
                        <p class="nexo-empty-state__text">Todos los artículos están sobre el stock mínimo.</p>
                    </div>
                }
            }
        </MudTabPanel>

        @* ══════════════════════════════════════════════ TAB FINANCIERO ══ *@
        <MudTabPanel Text="Financiero" Icon="@Icons.Material.Outlined.AccountBalance">
            @if (_tabFinCargando)
            {
                <div class="d-flex justify-center py-12"><MudProgressCircular Indeterminate="true" /></div>
            }
