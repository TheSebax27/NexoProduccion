            _resumenInventario    = await ApiClient.GetAsync<ResumenInventarioItem>("api/dashboard/resumen-inventario") ?? new(0, 0);
            _desviaciones         = await ApiClient.GetAsync<List<DesviacionItem>>("api/planificacion/desviaciones?umbral=70") ?? new();
            _alertasProyectos     = await ApiClient.GetAsync<List<ProyectoAlertaItem>>("api/proyectos/alertas") ?? new();
        }
