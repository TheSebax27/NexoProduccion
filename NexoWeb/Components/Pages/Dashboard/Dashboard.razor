        @* ══════════════════════════════════════════════ TAB PRODUCCIÓN ══ *@
        <MudTabPanel Text="Producción" Icon="@Icons.Material.Outlined.Factory">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div class="flex-grow-1">
                                <div class="nexo-chart-header__title">Producción Planificada vs Real</div>
                                <div class="nexo-chart-header__sub">Comparativo diario</div>
                            </div>
                            <MudDateRangePicker @bind-DateRange="_rangoPlanVsReal" @bind-DateRange:after="OnRangoPlanVsRealCambiadoAsync"
                                                Label="Rango" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                PickerVariant="PickerVariant.Dialog" Style="max-width:300px;min-width:260px;" DateFormat="dd/MM/yyyy" />
                        </div>
                        <div class="nexo-chart-card__body">
                            @if (_planVsReal.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" /><p class="nexo-empty-state__text">Sin producción registrada en este periodo.</p></div>
                            }
                            else
                            {
                                <MudChart ChartType="ChartType.Bar" ChartSeries="@_seriesPlanVsReal" XAxisLabels="@_labelsPlanVsReal" ChartOptions="@_opcionesGrafico" Width="100%" Height="260px" />
                                <MudTable Items="_planVsReal" Dense="true" Hover="true" Elevation="0" Class="mt-4">
                                    <HeaderContent>
                                        <MudTh>Fecha</MudTh><MudTh Style="text-align:right">Planificado</MudTh><MudTh Style="text-align:right">Real</MudTh><MudTh Style="text-align:right">Cumplimiento</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd Style="text-align:right">@context.TotalPlanificado.ToString("N2")</MudTd>
                                        <MudTd Style="text-align:right">@context.TotalReal.ToString("N2")</MudTd>
                                        <MudTd Style="text-align:right">
                                            <MudChip T="string" Size="Size.Small" Color="@(PorcentajeCumplimientoDia(context) >= 80 ? Color.Success : PorcentajeCumplimientoDia(context) >= 50 ? Color.Warning : Color.Error)">@PorcentajeCumplimientoDia(context).ToString("N0")%</MudChip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.Insights" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div class="flex-grow-1">
                                <div class="nexo-chart-header__title">Variación de Producción vs Plan</div>
                                <div class="nexo-chart-header__sub">Verde: supera el plan · Rojo: por debajo</div>
                            </div>
                            <MudDateRangePicker @bind-DateRange="_rangoVariacion" @bind-DateRange:after="OnRangoVariacionCambiadoAsync"
                                                Label="Rango" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                PickerVariant="PickerVariant.Dialog" Style="max-width:260px;min-width:220px;" DateFormat="dd/MM/yyyy" />
                        </div>
                        <div class="nexo-chart-card__body">
                            @if (_variacionProduccion.Count == 0)
                            {
                                <div class="nexo-empty-state"><MudIcon Icon="@Icons.Material.Outlined.Inbox" Class="nexo-empty-state__icon" /><p class="nexo-empty-state__text">Sin datos suficientes para calcular la variación.</p></div>
                            }
                            else
                            {
                                <div class="nexo-variacion-chart" style="overflow-x:auto;">
                                    <svg viewBox="@($"0 0 {AnchoSvgVariacion} 240")" preserveAspectRatio="none"
                                         class="nexo-variacion-chart__svg" style="min-width:@(AnchoSvgVariacion)px;width:@(AnchoSvgVariacion)px;">
                                        <line x1="0" y1="120" x2="@AnchoSvgVariacion" y2="120" class="nexo-variacion-chart__zero" />
                                        @((MarkupString)ConstruirSvgVariacion())
                                    </svg>
                                    <div class="nexo-variacion-chart__axis" style="min-width:@(AnchoSvgVariacion)px;">
                                        @foreach (var p in _variacionProduccion) { <span>@p.Fecha.ToString("dd/MM")</span> }
                                    </div>
                                    <div class="nexo-variacion-chart__legend">
                                        <span class="nexo-variacion-chart__legend-dot nexo-variacion-chart__legend-dot--up"></span> Sobre lo planificado
                                        <span class="nexo-variacion-chart__legend-dot nexo-variacion-chart__legend-dot--down"></span> Bajo lo planificado
                                    </div>
                                </div>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 nexo-chart-card">
                        <div class="nexo-chart-header nexo-chart-card__header">
                            <MudIcon Icon="@Icons.Material.Outlined.DonutLarge" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div><div class="nexo-chart-header__title">Distribución por Centro de Costo</div><div class="nexo-chart-header__sub">Unidades producidas (histórico)</div></div>
                        </div>
