@* Components/Pages/Dashboard/Dashboard.razor *@
@page "/"
@attribute [Authorize]
@inject INexoApiClient ApiClient
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject NexoWeb.Common.Auth.ModulosVisiblesState Modulos
@using NexoWeb.Common.Dtos
@using System.Globalization
@implements IDisposable

<PageTitle>Business Intelligence - NEXO</PageTitle>

@* ── Encabezado de página ─────────────────────────────────── *@
<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">BI</p>
            <h1 class="nexo-page-hero__title">Business Intelligence</h1>
        </div>
    </div>
    <div class="d-flex align-center" style="gap: 0.5rem;">
        <span class="nexo-page-hero__timestamp">
            <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="mr-1" Style="vertical-align: middle; font-size: 14px;" />
            Actualizado @DateTime.Now.ToString("dd MMM, HH:mm")
        </span>
        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.GridOn"
                   OnClick="ExportarExcelAsync" Disabled="_exportando">Excel</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   OnClick="ExportarPdfAsync" Disabled="_exportando">PDF</MudButton>
    </div>
</div>
<InfoAyuda Texto="Workspace BI: navega entre pestañas para análisis de Facturación, Producción, CRM e Inventario. Usa los selectores de fecha dentro de cada gráfico para ajustar el período." />

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-6">No se pudo cargar el dashboard: @_errorCarga</MudAlert>
}
else if (_cargando)
{
    <div class="flex items-center justify-center py-20">
        <div class="text-center">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mb-4" />
            <p class="text-sm" style="color: var(--nexo-text-secondary)">Cargando datos...</p>
        </div>
    </div>
}
else
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4"
             ActivePanelIndexChanged="OnTabChangedAsync" Class="nexo-bi-tabs">

        @* ══════════════════════════════════════════════ TAB GENERAL ══ *@
        <MudTabPanel Text="General" Icon="@Icons.Material.Outlined.Dashboard">

            <div class="nexo-section" style="margin-top:0.25rem">
                <div class="nexo-section__dot"></div>
                <span class="nexo-section__label">Producción</span>
                <div class="nexo-section__line"></div>
            </div>
            <div class="nexo-kpi-grid mb-4">
                <div class="nexo-kpi nexo-kpi--blue">
                    <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /></div>
                    <div class="nexo-kpi__value">@_totalOrdenesFinalizadas</div>
                    <div class="nexo-kpi__label">Órdenes Finalizadas</div>
                    <div class="nexo-kpi__sub">@_cumplimiento.Count centro(s) activo(s)</div>
                </div>
                <div class="nexo-kpi nexo-kpi--@(_cumplimientoPromedio >= 80 ? "green" : _cumplimientoPromedio >= 50 ? "amber" : "red")">
                    <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /></div>
                    <div class="nexo-kpi__value">@_cumplimientoPromedio.ToString("N1")%</div>
                    <div class="nexo-kpi__label">Cumplimiento Prom.</div>
                    <div class="nexo-kpi__sub">@_totalOrdenesATiempo / @_totalOrdenesFinalizadas a tiempo</div>
                </div>
                <div class="nexo-kpi nexo-kpi--indigo">
                    <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Factory" Size="Size.Small" /></div>
                    <div class="nexo-kpi__value">@_totalRealProducido.ToString("N0")</div>
                    <div class="nexo-kpi__label">Unidades Producidas</div>
                    <div class="nexo-kpi__sub">Últimos 14 días</div>
                </div>
                <div class="nexo-kpi nexo-kpi--teal">
                    <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" /></div>
                    <div class="nexo-kpi__value">@_productosTerminados.Count</div>
                    <div class="nexo-kpi__label">Productos Terminados</div>
                    <div class="nexo-kpi__sub">En catálogo activo</div>
                </div>
            </div>

            @if (_combosActivos.Count > 0)
            {
                <div class="nexo-section"><div class="nexo-section__dot"></div><span class="nexo-section__label">Marketing</span><div class="nexo-section__line"></div></div>
                <div class="nexo-kpi-grid mb-6">
                    @foreach (var combo in _combosActivos.Take(4))
                    {
                        <div class="nexo-kpi nexo-kpi--indigo" style="cursor:pointer" @onclick="@(() => Navigation.NavigateTo("/marketing/combos"))">
                            <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" /></div>
                            <div class="nexo-kpi__value">@combo.PrecioEfectivo.ToString("C0")</div>
                            <div class="nexo-kpi__label">@combo.Nombre</div>
                            <div class="nexo-kpi__sub">
                                @if (combo.PorcentajeDescuento > 0) { <text>-@combo.PorcentajeDescuento% · </text> }
                                @(combo.FechaFin.HasValue ? $"Hasta {combo.FechaFin:dd/MM}" : "Sin vencimiento")
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="nexo-section"><div class="nexo-section__dot"></div><span class="nexo-section__label">Resumen General</span><div class="nexo-section__line"></div></div>
            <div class="nexo-kpi-grid mb-4">
                <div class="nexo-kpi nexo-kpi--indigo">
                    <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Small" /></div>
                    <div class="nexo-kpi__value">@_resumenCrm.ClientesNuevos</div>
                    <div class="nexo-kpi__label">Clientes Nuevos (CRM)</div>
                    <div class="nexo-kpi__sub">@_resumenCrm.Interacciones interacciones · Últimos 30 días</div>
                </div>
                <div class="nexo-kpi nexo-kpi--blue">
                    <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" /></div>
                    <div class="nexo-kpi__value">@_totalEmpleadosActivos</div>
                    <div class="nexo-kpi__label">Empleados Activos</div>
                    <div class="nexo-kpi__sub">@_empleadosPorCentroCosto.Count centro(s)</div>
                </div>
                <div class="nexo-kpi nexo-kpi--@(_resumenPlanificacion.CumplimientoDemandaPromedio >= 80 ? "green" : _resumenPlanificacion.CumplimientoDemandaPromedio >= 50 ? "amber" : "red")">
                    <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" /></div>
                    <div class="nexo-kpi__value">@_resumenPlanificacion.CumplimientoDemandaPromedio.ToString("N0")%</div>
                    <div class="nexo-kpi__label">Cumplimiento Demanda</div>
                    <div class="nexo-kpi__sub">Venta: @_resumenPlanificacion.CumplimientoVentaPromedio.ToString("N0")% · Mes actual</div>
                </div>
                <div class="nexo-kpi nexo-kpi--teal">
                    <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" /></div>
                    <div class="nexo-kpi__value">@_resumenInventario.ValorTotalStock.ToString("C0")</div>
                    <div class="nexo-kpi__label">Valor de Stock</div>
                    <div class="nexo-kpi__sub">@_resumenInventario.ArticulosConAlerta artículo(s) con alerta</div>
                </div>
                <div class="nexo-kpi nexo-kpi--rose">
                    <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" /></div>
                    <div class="nexo-kpi__value">@_totalSaldoCartera.ToString("C0")</div>
                    <div class="nexo-kpi__label">Cartera Pendiente</div>
                    <div class="nexo-kpi__sub">@_cartera.Count doc(s) sin cobrar</div>
                </div>
            </div>

            @if (_proximoEvento is not null)
            {
                var ev = _proximoEvento;
                var inicio = ev.FechaInicio.ToLocalTime();
                var tiempoHasta = ev.TiempoHasta;
                var colorTipo = ev.ColorTipo;
                <MudPaper Class="pa-4 mb-4" Style="@($"border-left: 4px solid {colorTipo};")">
                    <div class="d-flex align-center flex-wrap" style="gap:12px">
                        <div style="@($"width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,{colorTipo} 12%,transparent);flex-shrink:0")">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Style="@($"color:{colorTipo}")" />
                        </div>
                        <div style="flex:1;min-width:0">
                            <div style="font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:.06em;color:@colorTipo;margin-bottom:2px">Próximo evento · @ev.TipoEvento</div>
                            <div style="font-size:15px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@ev.Titulo</div>
                            <div style="font-size:12px;color:var(--mud-palette-text-secondary);margin-top:2px">
                                @inicio.ToString("dddd d MMM · HH:mm")
                                @if (!string.IsNullOrEmpty(ev.Lugar)) { <text> · @ev.Lugar</text> }
                            </div>
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/planificacion/calendario"))">Ver calendario</MudButton>
                    </div>
                </MudPaper>
            }

            @if (_alertasProyectos.Count > 0 || _desviaciones.Count > 0)
            {
                <div class="nexo-section mt-2"><div class="nexo-section__dot" style="background:#F59E0B"></div><span class="nexo-section__label">Alertas</span><div class="nexo-section__line"></div></div>
            }
            @if (_alertasProyectos.Count > 0)
            {
                <MudPaper Class="pa-5 mb-4">
                    <div class="nexo-chart-header">
                        <MudIcon Icon="@Icons.Material.Outlined.ReportProblem" Size="Size.Small" Class="nexo-chart-header__icon" />
                        <div class="flex-grow-1">
                            <div class="nexo-chart-header__title">Alertas de Proyectos</div>
                            <div class="nexo-chart-header__sub">Atrasados o con costo por encima del presupuesto</div>
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/proyectos"))">Ver Proyectos</MudButton>
                    </div>
                    <MudTable Items="_alertasProyectos" Dense="true" Hover="true" Elevation="0" Class="mt-4">
                        <HeaderContent>
                            <MudTh>Proyecto</MudTh><MudTh>Fecha Fin</MudTh>
                            <MudTh Style="text-align:right">Presupuesto</MudTh><MudTh Style="text-align:right">Costo Actual</MudTh><MudTh>Alerta</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Nombre</MudTd>
                            <MudTd>@(context.FechaFin?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                            <MudTd Style="text-align:right">@context.Presupuesto.ToString("C0")</MudTd>
                            <MudTd Style="text-align:right">@context.CostoTotal.ToString("C0")</MudTd>
                            <MudTd>
                                @if (context.Atrasado) { <MudChip T="string" Size="Size.Small" Color="Color.Error">Atrasado</MudChip> }
                                @if (context.ConSobrecosto) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">Sobrecosto</MudChip> }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
            @if (_desviaciones.Count > 0)
            {
                <MudPaper Class="pa-5 mb-4">
                    <div class="nexo-chart-header">
                        <MudIcon Icon="@Icons.Material.Outlined.TrendingDown" Size="Size.Small" Class="nexo-chart-header__icon" />
                        <div class="flex-grow-1">
                            <div class="nexo-chart-header__title">Desviaciones de Planificación</div>
                            <div class="nexo-chart-header__sub">Centros por debajo del 70% de cumplimiento este mes</div>
                        </div>
                    </div>
                    <MudTable Items="_desviaciones" Dense="true" Hover="true" Elevation="0" Class="mt-4">
                        <HeaderContent>
                            <MudTh>Centro de Costo</MudTh>
                            <MudTh Style="text-align:right">Cumplimiento Demanda</MudTh>
                            <MudTh Style="text-align:right">Cumplimiento Venta</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.CentroCosto</MudTd>
                            <MudTd Style="text-align:right">
                                <MudChip T="string" Size="Size.Small" Color="@(context.CumplimientoDemanda < 70 ? Color.Error : Color.Default)">@context.CumplimientoDemanda.ToString("N0")%</MudChip>
                            </MudTd>
                            <MudTd Style="text-align:right">
                                <MudChip T="string" Size="Size.Small" Color="@(context.CumplimientoVenta < 70 ? Color.Error : Color.Default)">@context.CumplimientoVenta.ToString("N0")%</MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }

            <div class="nexo-section mt-2"><div class="nexo-section__dot" style="background:#F43F5E"></div><span class="nexo-section__label">CRM &amp; Cartera</span><div class="nexo-section__line"></div></div>
            <MudGrid Class="mb-4">
                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-4" Style="height:100%">
                        <div class="nexo-chart-header">
                            <MudIcon Icon="@Icons.Material.Outlined.AcUnit" Size="Size.Small" Class="nexo-chart-header__icon" Style="color:#6366F1!important" />
                            <div class="flex-grow-1">
                                <div class="nexo-chart-header__title">Clientes Fríos</div>
                                <div class="nexo-chart-header__sub">Sin interacción hace más de 30 días · @_clientesFrios.Count en total</div>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/crm/clientes"))">Ver CRM</MudButton>
                        </div>
                        @if (_clientesFrios.Count == 0)
                        {
                            <div class="nexo-empty-state">
                                <MudIcon Icon="@Icons.Material.Outlined.Whatshot" Class="nexo-empty-state__icon nexo-empty-state__icon--success" />
                                <p class="nexo-empty-state__text">Todos los clientes han tenido contacto reciente.</p>
                            </div>
                        }
                        else
                        {
                            <MudTable Items="@ClientesFriosPagina" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Cliente</MudTh><MudTh>Responsable</MudTh><MudTh>Última interacción</MudTh><MudTh>Próximo contacto</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <MudLink OnClick="@(() => Navigation.NavigateTo($"/crm/clientes/{context.ExternalId}"))" Style="cursor:pointer;font-weight:500">@context.Nombre</MudLink>
                                    </MudTd>
                                    <MudTd Style="font-size:0.82rem">@(context.Responsable ?? "-")</MudTd>
                                    <MudTd Style="font-size:0.82rem">
                                        @if (context.UltimaInteraccion is null)
                                        { <MudChip T="string" Size="Size.Small" Color="Color.Error">Nunca</MudChip> }
                                        else
                                        {
                                            var dias = (int)(DateTime.UtcNow - context.UltimaInteraccion.Value).TotalDays;
                                            <span style="color:@(dias > 60 ? "#EF4444" : dias > 30 ? "#F59E0B" : "inherit")">hace @dias días</span>
                                        }
                                    </MudTd>
                                    <MudTd Style="font-size:0.82rem">@(context.ProximoContacto?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                                </RowTemplate>
                            </MudTable>
                            <div class="nexo-frios-pager">
                                <span>Página @_paginaFrios de @TotalPaginasFrios · @_clientesFrios.Count clientes</span>
                                <div style="display:flex;gap:4px">
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(_paginaFrios <= 1)" OnClick="@(() => _paginaFrios--)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(_paginaFrios >= TotalPaginasFrios)" OnClick="@(() => _paginaFrios++)" />
                                </div>
                            </div>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-4" Style="height:100%">
                        <div class="nexo-chart-header">
                            <MudIcon Icon="@Icons.Material.Outlined.RequestQuote" Size="Size.Small" Class="nexo-chart-header__icon" Style="color:#F43F5E!important" />
                            <div class="flex-grow-1">
                                <div class="nexo-chart-header__title">Cartera por Cobrar</div>
                                <div class="nexo-chart-header__sub">Documentos pendientes de pago</div>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/facturacion"))">Ver Facturas</MudButton>
                        </div>
                        @if (_cartera.Count == 0)
                        {
                            <div class="nexo-empty-state">
                                <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Class="nexo-empty-state__icon nexo-empty-state__icon--success" />
                                <p class="nexo-empty-state__text">No hay documentos pendientes de cobro.</p>
                            </div>
                        }
                        else
                        {
                            <div class="nexo-cartera-total">@_totalSaldoCartera.ToString("C0")<span class="nexo-cartera-total__label">saldo total</span></div>
                            <MudTable Items="_cartera" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Cliente</MudTh><MudTh>Fecha</MudTh><MudTh Style="text-align:right">Saldo</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Style="font-size:0.82rem;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@context.Cliente</MudTd>
                                    <MudTd Style="font-size:0.82rem">
                                        @{ var antig = (DateTime.Today - context.Fecha).Days; }
                                        <span style="color:@(antig > 60 ? "#EF4444" : antig > 30 ? "#F59E0B" : "inherit")">
                                            @context.Fecha.ToString("dd/MM/yy")<span style="font-size:0.7rem;opacity:.7"> (+@antig d)</span>
                                        </span>
                                    </MudTd>
                                    <MudTd Style="text-align:right;font-weight:600;color:#F43F5E">@context.SaldoPendiente.ToString("C0")</MudTd>
                                </RowTemplate>
                            </MudTable>
                            @if (_cartera.Count >= 5)
                            {
                                <div style="font-size:0.72rem;color:#9B9BB4;margin-top:6px">Mostrando los @_cartera.Count más antiguos. Ver todos en Facturación → Pendientes.</div>
                            }
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* ═══════════════════════════════════════════ TAB FACTURACIÓN ══ *@
        <MudTabPanel Text="Facturación" Icon="@Icons.Material.Outlined.Receipt">
            @if (_tabFactCargando)
            {
                <div class="d-flex justify-center py-12"><MudProgressCircular Indeterminate="true" /></div>
            }
            else
            {
                <div class="nexo-section" style="margin-top:0.25rem">
                    <div class="nexo-section__dot" style="background:#10B981"></div>
                    <span class="nexo-section__label">Resumen del período</span>
                    <div class="nexo-section__line"></div>
                    <MudDateRangePicker @bind-DateRange="_rangoFact" @bind-DateRange:after="OnRangoFactCambiadoAsync"
                                        Label="Período" Variant="Variant.Outlined" Margin="Margin.Dense"
                                        PickerVariant="PickerVariant.Dialog" DateFormat="dd/MM/yyyy"
                                        Style="max-width:280px;min-width:240px;" />
                </div>
                <div class="nexo-kpi-grid mb-4">
                    <div class="nexo-kpi nexo-kpi--blue">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenFact.DocumentosEmitidos</div>
                        <div class="nexo-kpi__label">Documentos Emitidos</div>
                        <div class="nexo-kpi__sub">En el período seleccionado</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--green">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenFact.TotalEmitido.ToString("C0")</div>
                        <div class="nexo-kpi__label">Total Facturado</div>
                        <div class="nexo-kpi__sub">Bruto sin descuentos</div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--teal">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenFact.TotalCobrado.ToString("C0")</div>
                        <div class="nexo-kpi__label">Total Cobrado</div>
                        <div class="nexo-kpi__sub">
                            @{ var pctCob = _resumenFact.TotalEmitido > 0 ? (_resumenFact.TotalCobrado / _resumenFact.TotalEmitido * 100) : 0; }
                            @pctCob.ToString("N1")% de efectividad de cobro
                        </div>
                    </div>
                    <div class="nexo-kpi nexo-kpi--rose">
                        <div class="nexo-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" /></div>
                        <div class="nexo-kpi__value">@_resumenFact.SaldoPendiente.ToString("C0")</div>
                        <div class="nexo-kpi__label">Saldo Pendiente</div>
                        <div class="nexo-kpi__sub">Por cobrar al cierre del período</div>
                    </div>
                </div>

                <div class="nexo-section"><div class="nexo-section__dot" style="background:#10B981"></div><span class="nexo-section__label">Evolución de ingresos</span><div class="nexo-section__line"></div></div>
                <MudGrid Class="mb-4">
                    <MudItem xs="12">
                        <MudPaper Class="pa-5 nexo-chart-card" Style="height:400px">
                            <div class="nexo-chart-header nexo-chart-card__header">
                                <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Small" Class="nexo-chart-header__icon" />
                                <div>
                                    <div class="nexo-chart-header__title">Ingresos por Mes</div>
                                    <div class="nexo-chart-header__sub">Facturado vs Cobrado — últimos @_mesesFact meses</div>
                                </div>
                                <MudSelect T="int" Value="_mesesFact" ValueChanged="OnMesesFactCambiadoAsync"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px">
                                    <MudSelectItem T="int" Value="3">3 meses</MudSelectItem>
                                    <MudSelectItem T="int" Value="6">6 meses</MudSelectItem>
