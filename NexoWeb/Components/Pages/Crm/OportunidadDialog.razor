@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@this">
            @if (!EsEdicion)
            {
                <MudSelect T="string" @bind-Value="_origen" Label="Origen" Class="mb-3">
                    <MudSelectItem Value="@("LEAD")">Lead existente</MudSelectItem>
                    <MudSelectItem Value="@("CLIENTE")">Cliente existente</MudSelectItem>
                </MudSelect>

                @if (_origen == "LEAD")
                {
                    <MudSelect T="int?" @bind-Value="_leadId" Label="Lead" Required="true" RequiredError="Selecciona un lead" Class="mb-3">
                        @foreach (var l in Leads)
                        {
                            <MudSelectItem T="int?" Value="@l.LeadID">@l.Nombre @(l.Empresa is not null ? $"({l.Empresa})" : "")</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudSelect T="int?" @bind-Value="_clienteId" Label="Cliente" Required="true" RequiredError="Selecciona un cliente" Class="mb-3">
                        @foreach (var c in Clientes)
                        {
                            <MudSelectItem T="int?" Value="@c.ClienteID">@c.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                }
            }

            <MudTextField @bind-Value="_nombre" Label="Nombre de la oportunidad" Required="true"
                          RequiredError="El nombre es obligatorio" Class="mb-3" />

            <MudNumericField T="decimal" @bind-Value="_valorEstimado" Label="Valor Estimado ($)" Format="N0" Class="mb-3" />
            <MudNumericField T="int" @bind-Value="_probabilidad" Label="Probabilidad de cierre (%)" Min="0" Max="100" Class="mb-3" />
            <MudDatePicker @bind-Date="_fechaCierreEsperada" Label="Fecha de cierre esperada" Class="mb-3" />

            <MudSelect T="int?" @bind-Value="_responsableId" Label="Responsable" Clearable="true" Class="mb-3">
                @foreach (var e in Empleados)
                {
                    <MudSelectItem T="int?" Value="@e.EmpleadoID">@e.Nombres @e.Apellidos</MudSelectItem>
                }
            </MudSelect>

            @if (EsEdicion)
            {
                <MudSelect T="string" @bind-Value="_etapa" Label="Etapa" Class="mb-3">
                    <MudSelectItem Value="@("PROSPECCION")">Prospección</MudSelectItem>
                    <MudSelectItem Value="@("CALIFICACION")">Calificación</MudSelectItem>
                    <MudSelectItem Value="@("PROPUESTA")">Propuesta</MudSelectItem>
                    <MudSelectItem Value="@("NEGOCIACION")">Negociación</MudSelectItem>
                    <MudSelectItem Value="@("GANADA")">Ganada</MudSelectItem>
                    <MudSelectItem Value="@("PERDIDA")">Perdida</MudSelectItem>
                </MudSelect>
            }

            <MudTextField @bind-Value="_notas" Label="Notas" Lines="2" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">
            @(EsEdicion ? "Guardar Cambios" : "Crear")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public OportunidadItem? Oportunidad { get; set; }
    [Parameter] public List<LeadItem> Leads { get; set; } = new();
    [Parameter] public List<ClienteItem> Clientes { get; set; } = new();
    [Parameter] public List<EmpleadoItem> Empleados { get; set; } = new();

    private bool EsEdicion => Oportunidad is not null;

    private MudForm _form = default!;
    private string _origen = "LEAD";
    private int? _leadId;
    private int? _clienteId;
    private string _nombre = string.Empty;
    private decimal _valorEstimado;
    private int _probabilidad = 50;
    private DateTime? _fechaCierreEsperada;
    private int? _responsableId;
    private string _etapa = "PROSPECCION";
    private string? _notas;

    protected override void OnInitialized()
    {
        if (Oportunidad is not null)
        {
            _nombre = Oportunidad.Nombre;
            _valorEstimado = Oportunidad.ValorEstimado;
            _probabilidad = Oportunidad.Probabilidad;
            _fechaCierreEsperada = Oportunidad.FechaCierreEsperada;
            _responsableId = Oportunidad.ResponsableID;
            _etapa = Oportunidad.Etapa;
            _notas = Oportunidad.Notas;
        }
    }

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (EsEdicion)
        {
            var request = new ActualizarOportunidadRequest(_nombre.Trim(), _valorEstimado, _probabilidad, _etapa, _fechaCierreEsperada, _responsableId, _notas);
            MudDialog.Close(DialogResult.Ok(request));
        }
        else
        {
            if (_origen == "LEAD" && _leadId is null)
            {
                return;
            }
            if (_origen == "CLIENTE" && _clienteId is null)
            {
                return;
            }

            var request = new CrearOportunidadRequest(
                _origen == "LEAD" ? _leadId : null,
                _origen == "CLIENTE" ? _clienteId : null,
                _nombre.Trim(), _valorEstimado, _probabilidad, _fechaCierreEsperada, _responsableId, _notas);
            MudDialog.Close(DialogResult.Ok(request));
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
