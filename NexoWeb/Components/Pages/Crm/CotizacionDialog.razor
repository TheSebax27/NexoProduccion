@using NexoWeb.Common.Dtos
@inject ISnackbar Snackbar
@inject INexoApiClient ApiClient

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@this">

            @* ── Cliente ─────────────────────────────────────── *@
            <MudAutocomplete T="ClienteItem"
                             Value="_clienteSeleccionado"
                             ValueChanged="OnClienteSeleccionado"
                             Label="Cliente"
                             Required="true"
                             RequiredError="Selecciona un cliente"
                             SearchFunc="BuscarClienteAsync"
                             ToStringFunc="@(c => c is null ? "" : $"{c.Nombre}  ·  {c.NIT}")"
                             Placeholder="Buscar por nombre o NIT…"
                             MinCharacters="1"
                             AdornmentIcon="@Icons.Material.Outlined.Search"
                             Clearable="true"
                             CoerceValue="true"
                             Class="mb-3">
                <ItemTemplate>
                    <div>
                        <span style="font-weight:600">@context.Nombre</span>
                        <span style="font-size:0.78rem; color:var(--mud-palette-text-secondary); margin-left:8px">@context.NIT</span>
                    </div>
                </ItemTemplate>
            </MudAutocomplete>

            @* ── Oportunidad ─────────────────────────────────── *@
            <MudSelect T="int?" @bind-Value="_oportunidadId" Label="Oportunidad (opcional)" Clearable="true" Class="mb-3"
                       HelperText="@(_clienteSeleccionado is not null && !OportunidadesFiltradas.Any() ? "Sin oportunidades activas para este cliente" : null)">
                @foreach (var o in OportunidadesFiltradas)
                {
                    <MudSelectItem T="int?" Value="@o.OportunidadID">@o.Nombre</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker @bind-Date="_fecha" Label="Fecha" Required="true" Class="mb-3" />
            <MudDatePicker @bind-Date="_validoHasta" Label="Válida hasta (opcional)" Class="mb-3" />
            <MudSelect T="int?" @bind-Value="_centroCostoId" Label="Centro de costo (opcional)" Clearable="true" Class="mb-3">
                @foreach (var cc in CentrosCosto)
                {
                    <MudSelectItem T="int?" Value="@((int?)cc.CentroCostoID)">@cc.Nombre</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_notas" Label="Notas (opcional)" Lines="2" Class="mb-3" />

            <MudDivider Class="mb-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Artículos Cotizados</MudText>

            @foreach (var linea in _lineas)
            {
                <div class="d-flex align-center mb-2" style="gap: 0.5rem;">
                    <MudAutocomplete T="ArticuloItem"
                                     Value="linea.ArticuloSeleccionado"
                                     ValueChanged="@((ArticuloItem v) => OnArticuloCambiado(linea, v))"
                                     Label="Artículo"
                                     SearchFunc="BuscarArticuloAsync"
                                     ToStringFunc="@(a => a is null ? "" : $"{a.SKU} — {a.Nombre}")"
                                     Placeholder="SKU o nombre…"
                                     MinCharacters="1"
                                     AdornmentIcon="@Icons.Material.Outlined.Search"
                                     Clearable="true"
                                     CoerceValue="true"
                                     Style="flex: 3;">
                        <ItemTemplate>
                            <div>
                                <span style="font-size:0.78rem; font-weight:700; color:var(--mud-palette-primary); margin-right:6px">@context.SKU</span>
                                <span style="font-size:0.85rem">@context.Nombre</span>
                            </div>
                        </ItemTemplate>
                    </MudAutocomplete>
                    <MudNumericField T="decimal" @bind-Value="linea.Cantidad" Label="Cantidad" Style="flex: 1;" Min="0.01m" Format="N2" />
                    <MudNumericField T="decimal" @bind-Value="linea.PrecioUnitario" Label="Precio Unit." Style="flex: 1;" Min="0m" Format="N0" />
                    <MudText Typo="Typo.body2" Style="flex: 1; text-align: right;">@((linea.Cantidad * linea.PrecioUnitario).ToString("C0"))</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _lineas.Remove(linea))" />
                </div>
            }

            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => _lineas.Add(new LineaEditable()))" Class="mt-2 mb-3">
                Agregar Artículo
            </MudButton>

            <MudText Typo="Typo.subtitle1" Class="d-block" Style="text-align: right;">
                Total: @_lineas.Sum(l => l.Cantidad * l.PrecioUnitario).ToString("C0")
            </MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">
            Crear Cotización
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<OportunidadItem> Oportunidades { get; set; } = new();
    [Parameter] public List<CentroCostoItem> CentrosCosto { get; set; } = new();

    private class LineaEditable
    {
        public ArticuloItem? ArticuloSeleccionado { get; set; }
        public int?     ArticuloID      { get; set; }
        public decimal  Cantidad        { get; set; } = 1;
        public decimal  PrecioUnitario  { get; set; }
    }

    private MudForm      _form   = default!;
    private ClienteItem? _clienteSeleccionado;
    private int?         _oportunidadId;

    private IEnumerable<OportunidadItem> OportunidadesFiltradas =>
        _clienteSeleccionado is null
            ? Oportunidades
            : Oportunidades.Where(o => o.ClienteID == _clienteSeleccionado.ClienteID);

    private DateTime? _fecha      = DateTime.Today;
    private DateTime? _validoHasta = DateTime.Today.AddDays(15);
    private string?   _notas;
    private int?      _centroCostoId;
    private List<LineaEditable> _lineas = new() { new LineaEditable() };

    private void OnClienteSeleccionado(ClienteItem? cliente)
    {
        _clienteSeleccionado = cliente;
        _oportunidadId = null;
    }

    private async Task<IEnumerable<ClienteItem>> BuscarClienteAsync(string texto, CancellationToken ct)
    {
        var url = string.IsNullOrWhiteSpace(texto)
            ? "api/crm/clientes/paginados?pagina=1&tamano=15"
            : $"api/crm/clientes/paginados?texto={Uri.EscapeDataString(texto)}&pagina=1&tamano=15";
        var resp = await ApiClient.GetAsync<ClientesPaginadosResponse>(url);
        return resp?.Items ?? new();
    }

    private async Task<IEnumerable<ArticuloItem>> BuscarArticuloAsync(string texto, CancellationToken ct)
    {
        var url = string.IsNullOrWhiteSpace(texto)
            ? "api/catalogo/articulos?estado=true&pagina=1&tamano=15"
            : $"api/catalogo/articulos?texto={Uri.EscapeDataString(texto)}&estado=true&pagina=1&tamano=15";
        var resp = await ApiClient.GetAsync<ArticulosPaginadosResponse>(url);
        return resp?.Items ?? new();
    }

    private void OnArticuloCambiado(LineaEditable linea, ArticuloItem? articulo)
    {
        linea.ArticuloSeleccionado = articulo;
        linea.ArticuloID           = articulo?.ArticuloID;
        if (articulo is not null)
            linea.PrecioUnitario = articulo.PrecioVenta;
    }

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid || _clienteSeleccionado is null || _fecha is null)
            return;

        var lineasValidas = _lineas
            .Where(l => l.ArticuloID is not null && l.Cantidad > 0)
            .Select(l => new LineaCotizacionInput(l.ArticuloID!.Value, l.Cantidad, l.PrecioUnitario))
            .ToList();

        if (lineasValidas.Count == 0)
        {
            Snackbar.Add("Agrega al menos un artículo con cantidad mayor a cero.", Severity.Warning);
            return;
        }

        var request = new CrearCotizacionRequest(_clienteSeleccionado.ClienteID, _oportunidadId, _fecha.Value, _validoHasta, _notas, lineasValidas, _centroCostoId);
        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancelar() => MudDialog.Cancel();
}
