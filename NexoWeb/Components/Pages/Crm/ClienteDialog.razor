@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_nombre" Label="Nombre / Razon Social" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_nit" Label="NIT" Class="mb-3"
                      HelperText="No puede repetirse -- el sistema lo rechaza si ya existe otro cliente con el mismo NIT." />
        <MudTextField @bind-Value="_telefono" Label="Telefono" Class="mb-3" />
        <MudTextField @bind-Value="_email" Label="Email" Class="mb-3" InputType="InputType.Email" />
        <MudTextField @bind-Value="_direccion" Label="Direccion" Class="mb-3" />

        <MudSelect T="string" @bind-Value="_tipoCliente" Label="Tipo de Cliente" Clearable="true" Class="mb-3">
            <MudSelectItem Value="@("Empresa")">Empresa</MudSelectItem>
            <MudSelectItem Value="@("Persona Natural")">Persona Natural</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" @bind-Value="_fuenteContacto" Label="Fuente del Contacto" Clearable="true" Class="mb-3">
            <MudSelectItem Value="@("Referido")">Referido</MudSelectItem>
            <MudSelectItem Value="@("Redes Sociales")">Redes Sociales</MudSelectItem>
            <MudSelectItem Value="@("Llamada en Frio")">Llamada en Frío</MudSelectItem>
            <MudSelectItem Value="@("Pagina Web")">Página Web</MudSelectItem>
            <MudSelectItem Value="@("Otro")">Otro</MudSelectItem>
        </MudSelect>

        <MudSelect T="int?" @bind-Value="_responsableId" Label="Responsable Comercial" Clearable="true" Class="mb-3">
            @foreach (var e in Empleados)
            {
                <MudSelectItem T="int?" Value="@e.EmpleadoID">@e.Nombres @e.Apellidos</MudSelectItem>
            }
        </MudSelect>

        @if (Cliente is not null)
        {
            <MudDatePicker @bind-Date="_proximoContacto" Label="Proximo Contacto" Clearable="true" Class="mb-3" />
            <MudSwitch T="bool" @bind-Value="_estado" Label="Activo" Color="Color.Success" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(string.IsNullOrWhiteSpace(_nombre))"
                   OnClick="Guardar">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ClienteItem? Cliente { get; set; }
    [Parameter] public List<EmpleadoItem> Empleados { get; set; } = new();

    private string _nombre = "";
    private string? _nit;
    private string? _telefono;
    private string? _email;
    private string? _direccion;
    private string? _tipoCliente;
    private string? _fuenteContacto;
    private int? _responsableId;
    private DateTime? _proximoContacto;
    private bool _estado = true;

    protected override void OnParametersSet()
    {
        if (Cliente is not null)
        {
            _nombre = Cliente.Nombre;
            _nit = Cliente.NIT;
            _telefono = Cliente.Telefono;
            _email = Cliente.Email;
            _direccion = Cliente.Direccion;
            _tipoCliente = Cliente.TipoCliente;
            _fuenteContacto = Cliente.FuenteContacto;
            _responsableId = Cliente.ResponsableID;
            _proximoContacto = Cliente.ProximoContacto;
            _estado = Cliente.Estado;
        }
    }

    private void Guardar()
    {
        object resultado = Cliente is null
            ? new CrearClienteRequest(_nombre.Trim(), _nit?.Trim(), _telefono?.Trim(), _email?.Trim(), _direccion?.Trim(), _fuenteContacto, _tipoCliente, _responsableId)
            : new ActualizarClienteRequest(_nombre.Trim(), _nit?.Trim(), _telefono?.Trim(), _email?.Trim(), _direccion?.Trim(), _estado, _fuenteContacto, _tipoCliente, _responsableId, _proximoContacto);
        MudDialog.Close(DialogResult.Ok(resultado));
    }

    private void Cancelar() => MudDialog.Cancel();
}
