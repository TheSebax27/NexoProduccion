@* Components/Pages/Settings/Settings.razor *@
@page "/settings"
@attribute [Authorize]
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@inject NexoWeb.Common.Auth.ConfiguracionEmpresaState ConfiguracionEmpresa
@inject NexoWeb.Common.Auth.AuthStateService AuthState
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navegacion
@inject IDialogService DialogService
@using NexoWeb.Common.Dtos

<PageTitle>Configuración - NEXO</PageTitle>

<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">Cuenta</p>
            <h1 class="nexo-page-hero__title">Configuración</h1>
        </div>
    </div>
</div>

<div class="nexo-settings-layout">

    @* ── Sidebar de navegacion ─────────────────────────────────────────── *@
    <MudPaper Class="nexo-settings-sidebar pa-2" Elevation="1">

        <div class="nexo-settings-nav-group">Personal</div>

        <div class="nexo-settings-nav-item @(_seccion == "perfil" ? "ns-active" : "")"
             @onclick='() => _seccion = "perfil"'>
            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
            <span>Mi perfil</span>
        </div>

        <div class="nexo-settings-nav-item @(_seccion == "apariencia" ? "ns-active" : "")"
             @onclick='() => _seccion = "apariencia"'>
            <MudIcon Icon="@Icons.Material.Outlined.Palette" Size="Size.Small" />
            <span>Apariencia</span>
        </div>

        <div class="nexo-settings-nav-item @(_seccion == "sesion" ? "ns-active" : "")"
             @onclick='() => _seccion = "sesion"'>
            <MudIcon Icon="@Icons.Material.Outlined.LockOpen" Size="Size.Small" />
            <span>Sesion</span>
        </div>

        <div class="nexo-settings-nav-item @(_seccion == "vista" ? "ns-active" : "")"
             @onclick='() => _seccion = "vista"'>
            <MudIcon Icon="@Icons.Material.Outlined.ViewModule" Size="Size.Small" />
            <span>Vista de listados</span>
        </div>

        <div class="nexo-settings-nav-item @(_seccion == "menu" ? "ns-active" : "")"
             @onclick='() => _seccion = "menu"'>
            <MudIcon Icon="@Icons.Material.Outlined.ViewSidebar" Size="Size.Small" />
            <span>Menú lateral</span>
        </div>

        <div class="nexo-settings-nav-item @(_seccion == "ayuda" ? "ns-active" : "")"
             @onclick='() => _seccion = "ayuda"'>
            <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" />
            <span>Ayuda</span>
        </div>

        <AuthorizeView Roles="Administracion">
            <Authorized>
                <div class="nexo-settings-nav-divider"></div>
                <div class="nexo-settings-nav-group">Empresa</div>

                <div class="nexo-settings-nav-item @(_seccion == "negocio" ? "ns-active" : "")"
                     @onclick='() => _seccion = "negocio"'>
                    <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Small" />
                    <span>Mi Negocio</span>
                </div>

                <div class="nexo-settings-nav-item @(_seccion == "inventario" ? "ns-active" : "")"
                     @onclick='() => _seccion = "inventario"'>
                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />
                    <span>Inventario</span>
                </div>

                <div class="nexo-settings-nav-item @(_seccion == "integraciones" ? "ns-active" : "")"
                     @onclick='() => _seccion = "integraciones"'>
                    <MudIcon Icon="@Icons.Material.Outlined.Extension" Size="Size.Small" />
                    <span>Integraciones</span>
                </div>

                <div class="nexo-settings-nav-item"
                     @onclick='() => Navegacion.NavigateTo("/settings/email")'>
                    <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" />
                    <span>Email</span>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Class="ns-chevron" />
                </div>

                <div class="nexo-settings-nav-item"
                     @onclick='() => Navegacion.NavigateTo("/settings/automatizacion")'>
                    <MudIcon Icon="@Icons.Material.Outlined.Autorenew" Size="Size.Small" />
                    <span>Automatizacion CRM</span>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Class="ns-chevron" />
                </div>
            </Authorized>
        </AuthorizeView>

    </MudPaper>

    @* ── Panel de contenido ────────────────────────────────────────────── *@
    <div class="nexo-settings-content">

        @* ── Perfil ── *@
        @if (_seccion == "perfil")
        {
            <MudPaper Class="pa-0" Style="overflow:hidden">
                <div class="nexo-chart-header pa-5 pb-4" style="border-bottom:1px solid var(--mud-palette-lines-default)">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" Class="nexo-chart-header__icon" />
                    <div>
                        <div class="nexo-chart-header__title">Mi perfil</div>
                        <div class="nexo-chart-header__sub">Tu foto y nombre visibles en la plataforma</div>
                    </div>
                </div>

                @* Foto + datos en layout horizontal *@
                <div style="display:grid; grid-template-columns:220px 1fr; gap:0; min-height:240px">

                    @* Columna foto *@
                    <div style="padding:24px; border-right:1px solid var(--mud-palette-lines-default);
                                display:flex; flex-direction:column; align-items:center; gap:14px;
                                background:color-mix(in srgb, var(--mud-palette-primary) 4%, transparent)">
                        @if (AuthState.FotoPerfilDataUri is not null)
                        {
                            <div style="width:96px; height:96px; border-radius:50%; overflow:hidden;
                                        border:3px solid var(--mud-palette-primary); flex-shrink:0">
                                <img src="@AuthState.FotoPerfilDataUri" alt="Foto"
                                     style="width:100%; height:100%; object-fit:cover" />
                            </div>
                        }
                        else
                        {
                            <div style="width:96px; height:96px; border-radius:50%;
                                        background:var(--mud-palette-primary); color:#fff;
                                        display:flex; align-items:center; justify-content:center;
                                        font-size:2.2rem; font-weight:700; flex-shrink:0; letter-spacing:-1px">
                                @(AuthState.Nombres?[0])@(AuthState.Apellidos?[0])
                            </div>
                        }

                        <div style="font-weight:600; font-size:0.88rem; text-align:center; word-break:break-word">
                            @AuthState.NombreCompleto
                        </div>
                        <div style="font-size:0.75rem; opacity:.6; text-align:center">@AuthState.Rol</div>

                        <div style="display:flex; flex-direction:column; gap:6px; width:100%; margin-top:4px">
                            <InputFile id="perfil-foto-input" OnChange="OnFotoPerfilSeleccionadaAsync"
                                       accept="image/png,image/jpeg,image/webp" style="display:none;" />
                            <label for="perfil-foto-input" class="nexo-perfil-panel__btn-archivo"
                                   style="text-align:center; cursor:pointer">
                                @(AuthState.FotoPerfilDataUri is null ? "Subir foto" : "Cambiar foto")
                            </label>
                            @if (AuthState.FotoPerfilDataUri is not null)
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                           FullWidth="true" OnClick="QuitarFotoPerfilAsync" Disabled="_procesandoFotoPerfil">
                                    Quitar foto
                                </MudButton>
                            }
                        </div>
                        <div style="font-size:0.68rem; opacity:.5; text-align:center">Maximo 1 MB.</div>
                    </div>

                    @* Columna datos *@
                    <div style="padding:24px; display:flex; flex-direction:column; gap:16px">
                        <MudTextField @bind-Value="_perfilNombres" Label="Nombres" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                        <MudTextField @bind-Value="_perfilApellidos" Label="Apellidos" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="GuardarPerfilAsync"
                                   Disabled="@(_guardandoPerfil || string.IsNullOrWhiteSpace(_perfilNombres) || string.IsNullOrWhiteSpace(_perfilApellidos))">
                            @(_guardandoPerfil ? "Guardando..." : "Guardar datos")
                        </MudButton>

                        <div style="font-size:0.75rem; opacity:.55; margin-top:4px">
                            Esta informacion aparece en el menu lateral y en los registros del sistema.
                        </div>
                    </div>
                </div>
            </MudPaper>
        }

        @* ── Apariencia ── *@
        @if (_seccion == "apariencia")
        {
            <MudPaper Class="pa-5">
                <div class="nexo-chart-header mb-4">
                    <MudIcon Icon="@Icons.Material.Outlined.Palette" Size="Size.Small" Class="nexo-chart-header__icon" />
                    <div>
                        <div class="nexo-chart-header__title">Apariencia</div>
                        <div class="nexo-chart-header__sub">Se guarda para tu usuario — no afecta a los demas</div>
                    </div>
                </div>

                <div class="d-flex align-center justify-space-between py-2">
                    <div>
                        <div style="font-weight:600; font-size:0.9rem;">Tema oscuro</div>
                        <div style="font-size:0.78rem; color:var(--n-text-3);">
                            Cambia el fondo de las paginas a oscuro. La barra superior y el menu lateral no cambian.
                        </div>
                    </div>
                    <MudSwitch T="bool" Value="Preferencias.TemaOscuro" ValueChanged="OnTemaOscuroCambiadoAsync"
                               Color="Color.Primary" />
                </div>
            </MudPaper>
        }

        @* ── Sesion ── *@
        else if (_seccion == "sesion")
        {
            <MudPaper Class="pa-5">
                <div class="nexo-chart-header mb-4">
                    <MudIcon Icon="@Icons.Material.Outlined.LockOpen" Size="Size.Small" Class="nexo-chart-header__icon" />
                    <div>
                        <div class="nexo-chart-header__title">Sesion</div>
                        <div class="nexo-chart-header__sub">Control de cuanto tiempo permanece activa tu sesion</div>
                    </div>
                </div>

                <div class="d-flex align-center justify-space-between py-2">
                    <div>
                        <div style="font-weight:600; font-size:0.9rem;">Mantener sesion activa</div>
                        <div style="font-size:0.78rem; color:var(--n-text-3);">
                            Renueva el token automaticamente antes de que expire (util para pantallas de kiosco o trabajo continuo).
                            Sin esta opcion, la sesion cierra al vencer el token (~60 min de inactividad).
                        </div>
                    </div>
                    <MudSwitch T="bool" Value="Preferencias.MantenerSesionActiva"
                               ValueChanged="OnMantenerSesionCambiadoAsync" Color="Color.Primary" />
                </div>
            </MudPaper>
        }

        @* ── Vista de listados ── *@
        else if (_seccion == "vista")
        {
            <MudPaper Class="pa-5">
                <div class="nexo-chart-header mb-4">
                    <MudIcon Icon="@Icons.Material.Outlined.ViewModule" Size="Size.Small" Class="nexo-chart-header__icon" />
                    <div>
                        <div class="nexo-chart-header__title">Vista de listados</div>
                        <div class="nexo-chart-header__sub">Aplica a todas las pantallas con listas (Articulos, Ordenes, Stock, etc.)</div>
                    </div>
                </div>

                <div class="d-flex align-center justify-space-between py-2">
                    <div>
                        <div style="font-weight:600; font-size:0.9rem;">Mostrar como</div>
                        <div style="font-size:0.78rem; color:var(--n-text-3);">Se guarda para tu usuario y no cambia hasta que lo vuelvas a cambiar.</div>
                    </div>
                    <MudButtonGroup OverrideStyles="false">
                        <MudButton Variant="@(Preferencias.VistaListado == "lista" ? Variant.Filled : Variant.Outlined)"
                                   Color="@(Preferencias.VistaListado == "lista" ? Color.Primary : Color.Default)"
                                   StartIcon="@(Preferencias.VistaListado == "lista" ? Icons.Material.Filled.Check : Icons.Material.Filled.ViewList)"
                                   OnClick="@(() => OnVistaCambiadaAsync("lista"))">
                            Lista
                        </MudButton>
                        <MudButton Variant="@(Preferencias.VistaListado == "tarjetas" ? Variant.Filled : Variant.Outlined)"
                                   Color="@(Preferencias.VistaListado == "tarjetas" ? Color.Primary : Color.Default)"
                                   StartIcon="@(Preferencias.VistaListado == "tarjetas" ? Icons.Material.Filled.Check : Icons.Material.Filled.ViewModule)"
                                   OnClick="@(() => OnVistaCambiadaAsync("tarjetas"))">
                            Tarjetas
                        </MudButton>
                    </MudButtonGroup>
                </div>
            </MudPaper>
        }

        @* ── Menú lateral ── *@
        else if (_seccion == "menu")
        {
            <MudPaper Class="pa-0" Style="overflow:hidden">
                <div class="nexo-chart-header pa-5 pb-4" style="border-bottom:1px solid var(--mud-palette-lines-default)">
                    <MudIcon Icon="@Icons.Material.Outlined.ViewSidebar" Size="Size.Small" Class="nexo-chart-header__icon" />
                    <div>
                        <div class="nexo-chart-header__title">Menú lateral</div>
                        <div class="nexo-chart-header__sub">Arrastra o usa las flechas para reordenar los grupos de navegación</div>
                    </div>
                </div>
                <div class="pa-5">
                    @{ var ordenActual = _ordenNavLocal; }
                    <div style="display:flex; flex-direction:column; gap:8px; max-width:420px">
                        @for (int i = 0; i < ordenActual.Count; i++)
                        {
                            var idx = i;
                            var key = ordenActual[idx];
                            <div style="display:flex; align-items:center; gap:10px; background:var(--mud-palette-surface);
                                        border:1px solid var(--mud-palette-lines-default); border-radius:10px;
                                        padding:10px 14px">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Style="color:var(--mud-palette-text-tertiary); cursor:grab" Size="Size.Small" />
                                <span style="flex:1; font-size:0.875rem; font-weight:500">@NombreGrupo(key)</span>
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                               Size="Size.Small"
                                               Disabled="@(idx == 0)"
                                               OnClick="@(() => MoverGrupoArriba(idx))" />
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                               Size="Size.Small"
                                               Disabled="@(idx == ordenActual.Count - 1)"
                                               OnClick="@(() => MoverGrupoAbajo(idx))" />
                            </div>
                        }
                    </div>
                    <div style="display:flex; gap:10px; margin-top:20px">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="GuardarOrdenNavAsync"
                                   Disabled="_guardandoOrdenNav">
                            @(_guardandoOrdenNav ? "Guardando..." : "Guardar orden")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                   OnClick="RestablecerOrdenNavAsync">
                            Restablecer
                        </MudButton>
                    </div>
                </div>
            </MudPaper>
        }

        @* ── Ayuda ── *@
        else if (_seccion == "ayuda")
        {
            <MudPaper Class="pa-5">
                <div class="nexo-chart-header mb-4">
                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Class="nexo-chart-header__icon" />
                    <div>
                        <div class="nexo-chart-header__title">Ayuda</div>
                        <div class="nexo-chart-header__sub">Guia para nuevos usuarios del sistema</div>
                    </div>
                </div>

                <div class="d-flex align-center justify-space-between py-2">
                    <div>
                        <div style="font-weight:600; font-size:0.9rem;">Mostrar informacion en cada pagina</div>
                        <div style="font-size:0.78rem; color:var(--n-text-3);">Muestra un icono con una breve explicacion arriba de cada pantalla.</div>
                    </div>
                    <MudSwitch T="bool" Value="Preferencias.MostrarAyuda" ValueChanged="OnMostrarAyudaCambiadoAsync" Color="Color.Primary" />
                </div>

                <MudDivider Class="my-3" />

                <div class="d-flex align-center justify-space-between py-2">
                    <div>
                        <div style="font-weight:600; font-size:0.9rem;">Flujo de trabajo y contacto</div>
                        <div style="font-size:0.78rem; color:var(--n-text-3);">Como funciona el sistema, y como escribirnos si necesitas ayuda.</div>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.OpenInNew"
                               OnClick="@(() => Navegacion.NavigateTo("/settings/ayuda"))">
                        Ver guia
                    </MudButton>
                </div>
            </MudPaper>
        }

        @* ── Mi Negocio (Administracion) ── *@
        else if (_seccion == "negocio")
        {
            <AuthorizeView Roles="Administracion">
                <Authorized>
                    <MudPaper Class="pa-5">
                        <div class="nexo-chart-header mb-4">
                            <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div>
                                <div class="nexo-chart-header__title">Mi Negocio</div>
                                <div class="nexo-chart-header__sub">Nombre y logo que ven todos los usuarios en el menu lateral</div>
                            </div>
                        </div>

                        <div class="d-flex align-center" style="gap: 1rem;">
                            <img src="@(ConfiguracionEmpresa.LogoDataUri ?? "/images/LogoV.png")" alt="Logo"
                                 style="height: 40px; width: auto; object-fit: contain; border-radius: 6px;" />
                            <div class="d-flex" style="gap: 0.5rem;">
                                <InputFile id="nexo-logo-input" OnChange="OnLogoSeleccionadoAsync"
                                           accept="image/png,image/jpeg,image/webp" style="display:none;" />
                                <label for="nexo-logo-input" class="nexo-perfil-panel__btn-archivo">
                                    @(ConfiguracionEmpresa.LogoDataUri is null ? "Subir logo" : "Cambiar logo")
                                </label>
                                @if (ConfiguracionEmpresa.LogoDataUri is not null)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="QuitarLogoAsync" Disabled="_procesandoLogo">
                                        Quitar
                                    </MudButton>
                                }
                            </div>
                        </div>
                        <div style="font-size:0.7rem; color:var(--n-text-3); margin-top:0.5rem;">
                            Maximo 1 MB. Se muestra siempre al mismo tamano (40px de alto) sin importar las dimensiones originales de la imagen.
                        </div>

                        <MudTextField T="string" @bind-Value="_nombreEmpresa" Label="Nombre del negocio" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Class="mt-4" />
                        <MudTextField T="string" @bind-Value="_nombrePropietario" Label="Nombre del propietario (opcional)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3"
                                      Placeholder="Ej: Juan Perez" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-3"
                                   OnClick="GuardarNombreEmpresaAsync" Disabled="@(_procesandoLogo || string.IsNullOrWhiteSpace(_nombreEmpresa))">
                            Guardar
                        </MudButton>
                    </MudPaper>
                </Authorized>
            </AuthorizeView>
        }

        @* ── Inventario y Produccion (Administracion) ── *@
        else if (_seccion == "inventario")
        {
            <AuthorizeView Roles="Administracion">
                <Authorized>
                    <MudPaper Class="pa-5">
                        <div class="nexo-chart-header mb-4">
                            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div>
                                <div class="nexo-chart-header__title">Inventario y Produccion</div>
                                <div class="nexo-chart-header__sub">Controla como se manejan los lotes y las fechas de vencimiento</div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div style="font-weight:600; font-size:0.9rem; margin-bottom:4px">Modo de seleccion de lotes</div>
                            <div style="font-size:0.78rem; color:var(--n-text-3); margin-bottom:10px">
                                Define como se elige el lote de materia prima al liberar una orden de produccion o registrar un consumo.
                            </div>
                            <MudButtonGroup OverrideStyles="false">
                                <MudButton Variant="@(_modoLotes == "FIFO" ? Variant.Filled : Variant.Outlined)"
                                           Color="@(_modoLotes == "FIFO" ? Color.Primary : Color.Default)"
                                           StartIcon="@(_modoLotes == "FIFO" ? Icons.Material.Filled.Check : Icons.Material.Filled.Sort)"
                                           OnClick="@(() => _modoLotes = "FIFO")">
                                    Automatico (FIFO)
                                </MudButton>
                                <MudButton Variant="@(_modoLotes == "MANUAL" ? Variant.Filled : Variant.Outlined)"
                                           Color="@(_modoLotes == "MANUAL" ? Color.Primary : Color.Default)"
                                           StartIcon="@(_modoLotes == "MANUAL" ? Icons.Material.Filled.Check : Icons.Material.Filled.TouchApp)"
                                           OnClick="@(() => _modoLotes = "MANUAL")">
                                    Manual
                                </MudButton>
                            </MudButtonGroup>
                            @if (_modoLotes == "FIFO")
                            {
                                <div style="font-size:0.75rem; color:var(--n-text-3); margin-top:6px">
                                    El sistema usa siempre el primer lote ingresado (el mas antiguo) — sin intervencion del usuario.
                                </div>
                            }
                            else
                            {
                                <div style="font-size:0.75rem; color:var(--n-text-3); margin-top:6px">
                                    Al liberar una orden el operario elige que lotes consumir (util cuando hay lotes de distintas calidades).
                                </div>
                            }
                        </div>

                        <MudDivider Class="mb-4" />

                        <div class="d-flex align-center justify-space-between mb-2">
                            <div>
                                <div style="font-weight:600; font-size:0.9rem">Manejar fechas de vencimiento</div>
                                <div style="font-size:0.78rem; color:var(--n-text-3)">
                                    Activa alertas y validaciones cuando un lote esta proximo a vencer o ya vencio.
                                </div>
                            </div>
                            <MudSwitch T="bool" @bind-Value="_manejarVencimientos" Color="Color.Primary" />
                        </div>

                        @if (_manejarVencimientos)
                        {
                            <div class="mt-3" style="max-width:280px">
                                <MudNumericField T="int" @bind-Value="_diasAlertaVencimiento"
                                                 Label="Alertar con cuantos dias de anticipacion"
                                                 Min="1" Max="365" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 HelperText="Se mostrara una advertencia cuando falten este numero de dias para que un lote venza." />
                            </div>
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
                                   OnClick="GuardarConfigInventarioAsync" Disabled="_guardandoInventario">
                            @(_guardandoInventario ? "Guardando..." : "Guardar configuracion de inventario")
                        </MudButton>
                    </MudPaper>

                    @* ── Numeracion de Documentos ── *@
                    <MudPaper Class="pa-5 rounded-xl" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default)">
                        <div class="d-flex align-center gap-3 mb-4">
                            <MudIcon Icon="@Icons.Material.Outlined.Tag" Color="Color.Primary" Size="Size.Medium" />
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700">Numeración de Documentos</MudText>
                                <MudText Typo="Typo.caption" Style="color:var(--n-text-3)">
                                    Define cómo se genera el número de documento al crear facturas y remisiones.
                                </MudText>
                            </div>
                        </div>

                        <MudSelect T="string" @bind-Value="_modoNroDoc" Label="Modo de numeración"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                            <MudSelectItem Value=@("Manual")>Manual — el usuario escribe el número</MudSelectItem>
                            <MudSelectItem Value=@("Secuencial")>Secuencial — contador propio de NEXO</MudSelectItem>
                            <MudSelectItem Value=@("Aleatorio")>Aleatorio — 10 dígitos aleatorios</MudSelectItem>
                        </MudSelect>

                        @if (_modoNroDoc == "Secuencial")
                        {
                            <MudNumericField T="long" @bind-Value="_ultimoNroDocSecuencial"
                                             Label="Último número usado (el siguiente será este + 1)"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                             Min="0" />
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="GuardarConfigNroDocAsync" Disabled="_guardandoNroDoc">
                            @(_guardandoNroDoc ? "Guardando..." : "Guardar configuracion de numeracion")
                        </MudButton>
                    </MudPaper>
                </Authorized>
            </AuthorizeView>
        }

        @* ── Integraciones (Administracion) ── *@
        else if (_seccion == "integraciones")
        {
            <AuthorizeView Roles="Administracion">
                <Authorized>
                    <MudPaper Class="pa-5">
                        <div class="nexo-chart-header mb-4">
                            <MudIcon Icon="@Icons.Material.Outlined.Extension" Size="Size.Small" Class="nexo-chart-header__icon" />
                            <div>
                                <div class="nexo-chart-header__title">Integraciones</div>
                                <div class="nexo-chart-header__sub">Configura que sistemas externos usa esta empresa</div>
                            </div>
                        </div>

                        <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Outlined.Info">
                            <strong>¿Qué es Visions?</strong> Visions es el sistema de facturación/punto de venta externo
                            con el que NEXO puede sincronizar ventas e inventario. Si esta empresa <strong>no usa Visions</strong>,
                            desactiva esta opción para ocultar las funciones relacionadas (Mapeo de Artículos Visions,
                            configuración Visions en Centros de Costo, etc.).
                        </MudAlert>

                        <div class="d-flex align-center justify-space-between py-2">
                            <div>
                                <div style="font-weight:600; font-size:0.9rem;">La empresa utiliza Visions</div>
                                <div style="font-size:0.78rem; color:var(--n-text-3);">
                                    Activa o desactiva la integracion con Visions para toda la plataforma.
                                </div>
                            </div>
                            <MudSwitch T="bool" Value="ConfiguracionEmpresa.UsaVisions"
                                       ValueChanged="OnUsaVisionsCambiadoAsync"
                                       Color="Color.Primary" />
                        </div>

                        @if (ConfiguracionEmpresa.UsaVisions)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mt-2"
                                       StartIcon="@Icons.Material.Outlined.SyncAlt"
                                       OnClick="@(() => Navegacion.NavigateTo("/admin/integracion-visions"))">
                                Estado del agente e instalacion
                            </MudButton>
                        }
                    </MudPaper>
                </Authorized>
            </AuthorizeView>
        }

    </div>
</div>

@code {
    private string _seccion = "apariencia";

    // ── Orden del menú lateral ──────────────────────────────────────────
    private static readonly List<string> _ordenNavDefault = new()
    {
        "ventas", "crm", "catalogo", "produccion", "inventario", "planificacion", "rrhh", "admin"
    };
    private static readonly Dictionary<string, string> _nombresGrupo = new()
    {
        ["ventas"]       = "Ventas",
        ["crm"]          = "CRM",
        ["catalogo"]     = "Catálogo",
        ["produccion"]   = "Producción",
        ["inventario"]   = "Inventario",
        ["planificacion"]= "Planificación",
        ["rrhh"]         = "Recursos Humanos",
        ["admin"]        = "Administración",
    };

    private List<string> _ordenNavLocal = new();
    private bool _guardandoOrdenNav;

    private string NombreGrupo(string key) =>
        _nombresGrupo.TryGetValue(key, out var n) ? n : key;

    private void CargarOrdenNavLocal()
    {
        var guardado = Preferencias.OrdenGruposNav;
        _ordenNavLocal = guardado.Count > 0
            ? guardado.Concat(_ordenNavDefault.Except(guardado)).ToList()
            : new List<string>(_ordenNavDefault);
    }

    private void MoverGrupoArriba(int idx)
    {
        if (idx <= 0) return;
        (_ordenNavLocal[idx], _ordenNavLocal[idx - 1]) = (_ordenNavLocal[idx - 1], _ordenNavLocal[idx]);
    }

    private void MoverGrupoAbajo(int idx)
    {
        if (idx >= _ordenNavLocal.Count - 1) return;
        (_ordenNavLocal[idx], _ordenNavLocal[idx + 1]) = (_ordenNavLocal[idx + 1], _ordenNavLocal[idx]);
    }

    private async Task GuardarOrdenNavAsync()
    {
        _guardandoOrdenNav = true;
        await Preferencias.EstablecerOrdenGruposNavAsync(new List<string>(_ordenNavLocal));
        _guardandoOrdenNav = false;
        Snackbar.Add("Orden del menú guardado", Severity.Success);
    }

    private async Task RestablecerOrdenNavAsync()
    {
        _ordenNavLocal = new List<string>(_ordenNavDefault);
        await Preferencias.EstablecerOrdenGruposNavAsync(new List<string>(_ordenNavDefault));
        Snackbar.Add("Orden restablecido al predeterminado", Severity.Info);
    }

    private async Task OnTemaOscuroCambiadoAsync(bool nuevoValor)
    {
        await Preferencias.EstablecerTemaOscuroAsync(nuevoValor);
    }

    private async Task OnVistaCambiadaAsync(string nuevaVista)
    {
        if (Preferencias.VistaListado == nuevaVista) return;

        await Preferencias.EstablecerVistaListadoAsync(nuevaVista);
        Snackbar.Add("Nuevo formato de listado aplicado.", Severity.Success);
    }

    private async Task OnMostrarAyudaCambiadoAsync(bool nuevoValor)
    {
        await Preferencias.EstablecerMostrarAyudaAsync(nuevoValor);
    }

    private async Task OnMantenerSesionCambiadoAsync(bool nuevoValor)
    {
        await Preferencias.EstablecerMantenerSesionActivaAsync(nuevoValor);
        Snackbar.Add(nuevoValor
            ? "Sesion activa: el token se renovara automaticamente."
            : "Sesion normal: cerrara al vencer el token.", Severity.Info);
    }

    // ── Integraciones (Administracion) ───────────────────────────────
    private async Task OnUsaVisionsCambiadoAsync(bool nuevoValor)
    {
        if (!nuevoValor)
        {
            var confirm = await DialogService.ShowMessageBox(
                "Desactivar integracion con Visions",
                "Al desactivar Visions se ocultaran el Mapeo de Articulos, la configuracion Visions en Centros de Costo y todas las menciones relacionadas. Los datos guardados no se eliminan y puedes volver a activarlo cuando quieras. Confirmas?",
                yesText: "Si, desactivar", cancelText: "Cancelar");

            if (confirm != true) return;
        }

        try
        {
            await ConfiguracionEmpresa.ActualizarUsaVisionsAsync(nuevoValor);
            Snackbar.Add(nuevoValor ? "Integracion con Visions activada." : "Integracion con Visions desactivada.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ── Inventario y Produccion (Administracion) ─────────────────────
    private string _modoLotes = "FIFO";
    private bool _manejarVencimientos;
    private int _diasAlertaVencimiento = 7;
    private bool _guardandoInventario;

    // ── Numeracion de Documentos (Administracion) ─────────────────────
    private string _modoNroDoc = "Manual";
    private long _ultimoNroDocSecuencial = 0;
    private bool _guardandoNroDoc;

    private async Task GuardarConfigNroDocAsync()
    {
        _guardandoNroDoc = true;
        try
        {
            await ConfiguracionEmpresa.ActualizarConfigNroDocAsync(_modoNroDoc, _ultimoNroDocSecuencial);
            Snackbar.Add("Configuracion de numeracion guardada.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardandoNroDoc = false; }
    }

    private async Task GuardarConfigInventarioAsync()
    {
        _guardandoInventario = true;
        try
        {
            await ConfiguracionEmpresa.ActualizarConfigInventarioAsync(
                _manejarVencimientos, _diasAlertaVencimiento, _modoLotes);
            Snackbar.Add("Configuracion de inventario guardada.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardandoInventario = false; }
    }

    // ── Mi Negocio (Administracion) ───────────────────────────────────
    private string _nombreEmpresa = "";
    private string? _nombrePropietario;
    private bool _procesandoLogo;

    // ── Mi Perfil ─────────────────────────────────────────────────────
    private string _perfilNombres = "";
    private string _perfilApellidos = "";
    private bool _guardandoPerfil;
    private bool _procesandoFotoPerfil;

    private async Task GuardarPerfilAsync()
    {
        _guardandoPerfil = true;
        try
        {
            var resp = await ApiClient.PutAsync<ActualizarPerfilRequest, PerfilActualizadoResponse>(
                "api/auth/perfil", new ActualizarPerfilRequest(_perfilNombres.Trim(), _perfilApellidos.Trim()));
            await AuthState.ActualizarNombreAsync(_perfilNombres.Trim(), _perfilApellidos.Trim());
            Snackbar.Add("Datos actualizados correctamente.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardandoPerfil = false; }
    }

    private async Task OnFotoPerfilSeleccionadaAsync(InputFileChangeEventArgs e)
    {
        const long maxBytes = 1_000_000;
        if (e.File.Size > maxBytes)
        {
            Snackbar.Add("La imagen es muy grande (maximo 1 MB).", Severity.Warning);
            return;
        }
        _procesandoFotoPerfil = true;
        try
        {
            using var stream = e.File.OpenReadStream(maxBytes);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);
            var base64 = Convert.ToBase64String(memoria.ToArray());
            await ApiClient.PutAsync<ActualizarFotoPerfilRequest, object?>(
                "api/auth/perfil/foto", new ActualizarFotoPerfilRequest(base64, e.File.ContentType));
            await AuthState.ActualizarFotoAsync(base64, e.File.ContentType);
            Snackbar.Add("Foto actualizada.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _procesandoFotoPerfil = false; }
    }

    private async Task QuitarFotoPerfilAsync()
    {
        _procesandoFotoPerfil = true;
        try
        {
            await ApiClient.DeleteAsync("api/auth/perfil/foto");
            await AuthState.EliminarFotoAsync();
            Snackbar.Add("Foto eliminada.", Severity.Success);
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _procesandoFotoPerfil = false; }
    }

    protected override void OnInitialized()
    {
        CargarOrdenNavLocal();
        _nombreEmpresa = ConfiguracionEmpresa.NombreEmpresa;
        _nombrePropietario = ConfiguracionEmpresa.NombrePropietario;
        _modoLotes = ConfiguracionEmpresa.ModoLotes;
        _manejarVencimientos = ConfiguracionEmpresa.ManejarVencimientos;
        _diasAlertaVencimiento = ConfiguracionEmpresa.DiasAlertaVencimiento;
        _modoNroDoc = ConfiguracionEmpresa.ModoNroDoc;
        _ultimoNroDocSecuencial = ConfiguracionEmpresa.UltimoNroDocSecuencial;
        _perfilNombres = AuthState.Nombres ?? "";
        _perfilApellidos = AuthState.Apellidos ?? "";
    }

    private async Task GuardarNombreEmpresaAsync()
    {
        try
        {
            await ConfiguracionEmpresa.ActualizarNombreAsync(
                _nombreEmpresa.Trim(),
                string.IsNullOrWhiteSpace(_nombrePropietario) ? null : _nombrePropietario.Trim());
            Snackbar.Add("Datos del negocio actualizados.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnLogoSeleccionadoAsync(InputFileChangeEventArgs e)
    {
        const long maxBytes = 1_000_000;

        if (e.File.Size > maxBytes)
        {
            Snackbar.Add("La imagen es muy grande (maximo 1 MB).", Severity.Warning);
            return;
        }

        _procesandoLogo = true;
        try
        {
            using var stream = e.File.OpenReadStream(maxBytes);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);
            var base64 = Convert.ToBase64String(memoria.ToArray());

            await ConfiguracionEmpresa.ActualizarLogoAsync(base64, e.File.ContentType);
            Snackbar.Add("Logo actualizado.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _procesandoLogo = false;
        }
    }

    private async Task QuitarLogoAsync()
    {
        _procesandoLogo = true;
        try
        {
            await ConfiguracionEmpresa.EliminarLogoAsync();
            Snackbar.Add("Logo eliminado.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _procesandoLogo = false;
        }
    }
}
