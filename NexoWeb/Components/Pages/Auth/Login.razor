@page "/login"
@inject NexoWeb.Common.ApiClient.INexoApiClient ApiClient
@inject NexoWeb.Common.Auth.AuthStateService AuthState
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesion - NEXO</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Class="pa-8" Elevation="4">
        <MudText Typo="Typo.h5" Class="mb-4">Iniciar sesion</MudText>

        <MudTextField @bind-Value="_username" Label="Usuario" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="_password" Label="Contrasena" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="EntrarAsync" Disabled="_cargando">
            @(_cargando ? "Ingresando..." : "Ingresar")
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string _username = "";
    private string _password = "";
    private string? _error;
    private bool _cargando;

    private async Task EntrarAsync()
    {
        _error = null;
        _cargando = true;

        var respuesta = await ApiClient.LoginAsync(new NexoWeb.Common.Dtos.LoginRequest(_username, _password));

        _cargando = false;

        if (respuesta is null)
        {
            _error = "Usuario o contrasena incorrectos.";
            return;
        }

        await AuthState.IniciarSesionAsync(respuesta);
        Navegacion.NavigateTo("/", forceLoad: false);
    }
}