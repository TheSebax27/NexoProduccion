@page "/inventario/bajas"
@attribute [Authorize(Roles = "Administrador,Bodeguero")]
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@using NexoWeb.Common.Dtos

<PageTitle>Registrar Baja - NEXO</PageTitle>

<div class="d-flex align-center mb-4" style="gap: 0.25rem;">
    <MudText Typo="Typo.h5">Registrar Baja por Merma o Dano</MudText>
    <BotonFavorito Href="/inventario/bajas" Etiqueta="Registrar Baja" />
</div>
<InfoAyuda Texto="Descuenta stock definitivamente por daño o pérdida (no por venta ni traspaso). Solo se listan las bodegas donde el artículo elegido tiene stock. El movimiento queda registrado en el Kardex y no se puede deshacer." />

<MudPaper Class="pa-6" MaxWidth="600px">
    <MudSelect T="int" Value="_articuloId" ValueChanged="OnArticuloCambiadoAsync" Label="Articulo" Class="mb-4" Required="true">
        @foreach (var articulo in _articulos)
        {
            <MudSelectItem T="int" Value="@articulo.ArticuloID">@articulo.SKU - @articulo.Nombre</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="int" @bind-Value="_bodegaId" Label="Bodega" Class="mb-4" Required="true"
               Disabled="@(_articuloId == 0)"
               HelperText="@(_articuloId != 0 && _bodegasConStock.Count == 0 ? "Este articulo no tiene stock en ninguna bodega." : null)">
        @foreach (var bodega in _bodegasConStock)
        {
            <MudSelectItem T="int" Value="@bodega.BodegaID">@bodega.Nombre (@bodega.CentroCosto)</MudSelectItem>
        }
    </MudSelect>

    <MudNumericField @bind-Value="_cantidadPerdida" Label="Cantidad perdida" Min="0.01m" Format="N2" Class="mb-4" Required="true" />

    <MudSelect T="int" @bind-Value="_motivoId" Label="Motivo" Class="mb-4" Required="true">
        @foreach (var motivo in _motivos)
        {
            <MudSelectItem T="int" Value="@motivo.MotivoID">@motivo.Nombre</MudSelectItem>
        }
    </MudSelect>

    <MudTextField @bind-Value="_observacion" Label="Observacion detallada" Lines="3"
                  HelperText="Minimo 5 caracteres. Se guarda tal cual en el KARDEX, se explicito."
                  Class="mb-4" Required="true" />

    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="RegistrarAsync"
               Disabled="@(!FormularioValido || _guardando)" StartIcon="@Icons.Material.Filled.RemoveCircle">
        @(_guardando ? "Registrando..." : "Registrar Baja")
    </MudButton>
</MudPaper>

@code {
    private List<ArticuloItem> _articulos = new();
    private List<BodegaItem> _bodegas = new();
    private List<StockConsolidadoItem> _stock = new();
    private List<MotivoPerdidaItem> _motivos = new();

    private int _articuloId;
    private int _bodegaId;

    // Solo las bodegas donde el articulo elegido realmente tiene stock --
    // evita que el usuario seleccione por error una bodega donde no hay
    // nada que dar de baja.
    private List<BodegaItem> _bodegasConStock =>
        _articuloId == 0
            ? new()
            : _bodegas.Where(b => _stock.Any(s => s.ArticuloID == _articuloId && s.BodegaID == b.BodegaID && s.CantidadActual > 0)).ToList();
    private decimal _cantidadPerdida;
    private int _motivoId;
    private string _observacion = "";
    private bool _guardando;

    private bool FormularioValido =>
        _articuloId > 0 && _bodegaId > 0 && _motivoId > 0 &&
        _cantidadPerdida > 0 && _observacion.Trim().Length >= 5;

    protected override async Task OnInitializedAsync()
    {
        // Las 3 listas para los desplegables se piden en paralelo, no una
        // detras de otra -- son 3 llamadas independientes que no dependen
        // entre si, asi que no hay razon para esperar a que termine una
        // para empezar la siguiente.
        var tareaArticulos = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos");
        var tareaBodegas = ApiClient.GetAsync<List<BodegaItem>>("api/catalogo/bodegas");
        var tareaStock = ApiClient.GetAsync<List<StockConsolidadoItem>>("api/inventario/stock");
        var tareaMotivos = ApiClient.GetAsync<List<MotivoPerdidaItem>>("api/inventario/motivos-perdida");

        await Task.WhenAll(tareaArticulos, tareaBodegas, tareaStock, tareaMotivos);

        _articulos = await tareaArticulos ?? new();
        _bodegas = await tareaBodegas ?? new();
        _stock = await tareaStock ?? new();
        _motivos = await tareaMotivos ?? new();
    }

    private void OnArticuloCambiadoAsync(int nuevoArticuloId)
    {
        _articuloId = nuevoArticuloId;
        // La bodega elegida antes puede ya no tener stock de este articulo
        if (_bodegaId != 0 && _bodegasConStock.All(b => b.BodegaID != _bodegaId))
            _bodegaId = 0;
    }

    private async Task RegistrarAsync()
    {
        var articuloNombre = _articulos.FirstOrDefault(a => a.ArticuloID == _articuloId)?.Nombre ?? "?";
        var bodegaNombre = _bodegas.FirstOrDefault(b => b.BodegaID == _bodegaId)?.Nombre ?? "?";
        var motivoNombre = _motivos.FirstOrDefault(m => m.MotivoID == _motivoId)?.Nombre ?? "?";

        var confirmacion = await DialogService.ShowMessageBox(
            "Confirmar Baja de Inventario",
            $"Esta accion es IRREVERSIBLE y quedara registrada en el Kardex.\n\n" +
            $"Articulo: {articuloNombre}\n" +
            $"Bodega: {bodegaNombre}\n" +
            $"Cantidad: {_cantidadPerdida:N2}\n" +
            $"Motivo: {motivoNombre}\n\n" +
            "¿Confirmar la baja?",
            yesText: "Si, registrar baja",
            noText: "Cancelar");

        if (confirmacion != true)
            return;

        _guardando = true;

        try
        {
            var request = new RegistrarBajaRequest(_articuloId, _bodegaId, null, _cantidadPerdida, _motivoId, _observacion.Trim());
            var resultado = await ApiClient.PostAsync<RegistrarBajaRequest, RegistrarBajaResponse>("api/inventario/bajas", request);

            Snackbar.Add($"Baja registrada correctamente. Codigo: {resultado!.CodigoBaja}", Severity.Success);

            // Limpiamos el formulario para la siguiente baja, sin recargar la pagina
            _cantidadPerdida = 0;
            _observacion = "";
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }
}