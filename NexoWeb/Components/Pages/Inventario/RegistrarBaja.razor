@page "/inventario/bajas"
@attribute [Authorize]
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@using NexoWeb.Common.Dtos

<PageTitle>Registrar Baja - NEXO</PageTitle>

<div class="d-flex align-center mb-4" style="gap: 0.25rem;">
    <MudText Typo="Typo.h5">Registrar Baja por Merma o Daño</MudText>
    <BotonFavorito Href="/inventario/bajas" Etiqueta="Registrar Baja" />
</div>
<InfoAyuda Texto="Descuenta stock definitivamente por daño o pérdida (no por venta ni traspaso). Solo se listan las bodegas donde el artículo elegido tiene stock. El movimiento queda registrado en el Kardex y no se puede deshacer." />

<MudPaper Class="pa-6" MaxWidth="600px">
    <MudSelect T="int?" Value="_articuloId" ValueChanged="OnArticuloCambiado"
               Label="Artículo" Class="mb-4" Required="true"
               Placeholder="Selecciona el artículo">
        @foreach (var articulo in _articulos)
        {
            <MudSelectItem T="int?" Value="@((int?)articulo.ArticuloID)">@articulo.SKU - @articulo.Nombre</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="int?" @bind-Value="_bodegaId" Label="Bodega" Class="mb-4" Required="true"
               Disabled="@(_articuloId is null)"
               Placeholder="Selecciona la bodega"
               HelperText="@(_articuloId is not null && _bodegasConStock.Count == 0 ? "Este artículo no tiene stock en ninguna bodega." : null)">
        @foreach (var bodega in _bodegasConStock)
        {
            <MudSelectItem T="int?" Value="@((int?)bodega.BodegaID)">@bodega.Nombre (@bodega.CentroCosto)</MudSelectItem>
        }
    </MudSelect>

    <div class="d-flex align-end mb-4" style="gap: 0.5rem;">
        <MudNumericField @bind-Value="_cantidadPerdida" Label="Cantidad perdida"
                         Min="0.01m" Format="N2" Required="true" Style="flex:1" />
        @if (!string.IsNullOrWhiteSpace(ArticuloSeleccionado?.Unidad))
        {
            <MudText Style="margin-bottom:0.5rem; color:var(--n-text-2); font-size:0.9rem;">
                @ArticuloSeleccionado!.Unidad
            </MudText>
        }
    </div>

    <MudSelect T="int?" @bind-Value="_motivoId" Label="Motivo" Class="mb-4" Required="true"
               Placeholder="Selecciona el motivo">
        @foreach (var motivo in _motivos)
        {
            <MudSelectItem T="int?" Value="@((int?)motivo.MotivoID)">@motivo.Nombre</MudSelectItem>
        }
    </MudSelect>

    <MudTextField @bind-Value="_observacion" Label="Observación detallada" Lines="3"
                  HelperText="Mínimo 5 caracteres. Se guarda tal cual en el KARDEX, sé explícito."
                  Class="mb-4" Required="true" />

    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="RegistrarAsync"
               Disabled="@(!FormularioValido || _guardando)" StartIcon="@Icons.Material.Filled.RemoveCircle">
        @(_guardando ? "Registrando..." : "Registrar Baja")
    </MudButton>
</MudPaper>

@code {
    private List<ArticuloItem> _articulos = new();
    private List<BodegaItem> _bodegas = new();
    private List<StockConsolidadoItem> _stock = new();
    private List<MotivoPerdidaItem> _motivos = new();

    private int? _articuloId;
    private int? _bodegaId;
    private int? _motivoId;

    private ArticuloItem? ArticuloSeleccionado =>
        _articuloId.HasValue ? _articulos.FirstOrDefault(a => a.ArticuloID == _articuloId.Value) : null;

    private List<BodegaItem> _bodegasConStock =>
        _articuloId is null
            ? new()
            : _bodegas.Where(b => _stock.Any(s => s.ArticuloID == _articuloId.Value && s.BodegaID == b.BodegaID && s.CantidadActual > 0)).ToList();

    private decimal _cantidadPerdida;
    private string _observacion = "";
    private bool _guardando;

    private bool FormularioValido =>
        _articuloId.HasValue && _bodegaId.HasValue && _motivoId.HasValue &&
        _cantidadPerdida > 0 && _observacion.Trim().Length >= 5;

    protected override async Task OnInitializedAsync()
    {
        var tareaArticulos = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos");
        var tareaBodegas   = ApiClient.GetAsync<List<BodegaItem>>("api/catalogo/bodegas");
        var tareaStock     = ApiClient.GetAsync<List<StockConsolidadoItem>>("api/inventario/stock");
        var tareaMotivos   = ApiClient.GetAsync<List<MotivoPerdidaItem>>("api/inventario/motivos-perdida");

        await Task.WhenAll(tareaArticulos, tareaBodegas, tareaStock, tareaMotivos);

        _articulos = await tareaArticulos ?? new();
        _bodegas   = await tareaBodegas   ?? new();
        _stock     = await tareaStock     ?? new();
        _motivos   = await tareaMotivos   ?? new();
    }

    private void OnArticuloCambiado(int? nuevoId)
    {
        _articuloId = nuevoId;
        if (_bodegaId.HasValue && _bodegasConStock.All(b => b.BodegaID != _bodegaId.Value))
            _bodegaId = null;
    }

    private async Task RegistrarAsync()
    {
        var articuloNombre = ArticuloSeleccionado?.Nombre ?? "?";
        var bodegaNombre   = _bodegas.FirstOrDefault(b => b.BodegaID == _bodegaId)?.Nombre ?? "?";
        var motivoNombre   = _motivos.FirstOrDefault(m => m.MotivoID == _motivoId)?.Nombre ?? "?";
        var unidad         = ArticuloSeleccionado?.Unidad ?? "und";

        var confirmacion = await DialogService.ShowMessageBox(
            "Confirmar Baja de Inventario",
            $"Esta acción es IRREVERSIBLE y quedará registrada en el Kardex.\n\n" +
            $"Artículo: {articuloNombre}\n" +
            $"Bodega: {bodegaNombre}\n" +
            $"Cantidad: {_cantidadPerdida:N2} {unidad}\n" +
            $"Motivo: {motivoNombre}\n\n" +
            "¿Confirmar la baja?",
            yesText: "Sí, registrar baja",
            noText: "Cancelar");

        if (confirmacion != true) return;

        _guardando = true;
        try
        {
            var request = new RegistrarBajaRequest(_articuloId!.Value, _bodegaId!.Value, null, _cantidadPerdida, _motivoId!.Value, _observacion.Trim());
            var resultado = await ApiClient.PostAsync<RegistrarBajaRequest, RegistrarBajaResponse>("api/inventario/bajas", request);

            Snackbar.Add($"Baja registrada. Código: {resultado!.CodigoBaja}", Severity.Success);

            _cantidadPerdida = 0;
            _observacion = "";
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardando = false; }
    }
}
