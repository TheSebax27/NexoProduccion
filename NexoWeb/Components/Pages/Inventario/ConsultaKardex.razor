@page "/inventario/kardex"
@attribute [Authorize(Roles = "Administracion,Jefes,Empleados")]
@inject INexoApiClient ApiClient
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@using NexoWeb.Common.Dtos
@using NexoWeb.Common.Helpers

<PageTitle>Kardex de Artículos - NEXO</PageTitle>

<div class="d-flex align-center mb-4" style="gap: 0.25rem;">
    <MudText Typo="Typo.h5">Kardex de Artículos</MudText>
    <BotonFavorito Href="/inventario/kardex" Etiqueta="Kardex de Artículos" />
</div>
<InfoAyuda Texto="Historial detallado de cada movimiento de inventario (entradas, salidas, ajustes, traspasos) con el saldo tras cada operación. Filtra por artículo, bodega o rango de fechas. La columna 'Valor' muestra el impacto económico del movimiento." />

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_articuloId" Label="Artículo" Clearable="true">
                @foreach (var a in _articulos)
                {
                    <MudSelectItem T="int?" Value="@((int?)a.ArticuloID)">@a.SKU - @a.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="int?" @bind-Value="_bodegaId" Label="Bodega" Clearable="true">
                @foreach (var b in _bodegas)
                {
                    <MudSelectItem T="int?" Value="@((int?)b.BodegaID)">@b.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_desde" Label="Desde" DateFormat="dd/MM/yyyy" PickerVariant="PickerVariant.Dialog" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudDatePicker @bind-Date="_hasta" Label="Hasta" DateFormat="dd/MM/yyyy" PickerVariant="PickerVariant.Dialog" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="string" @bind-Value="_filtroCategoria" Label="Tipo" Clearable="true">
                <MudSelectItem T="string" Value="@("Entrada")">Entradas</MudSelectItem>
                <MudSelectItem T="string" Value="@("Salida")">Salidas</MudSelectItem>
                <MudSelectItem T="string" Value="@("Producción")">Producción</MudSelectItem>
                <MudSelectItem T="string" Value="@("Ajuste")">Ajustes</MudSelectItem>
                <MudSelectItem T="string" Value="@("Baja")">Bajas / Pérdidas</MudSelectItem>
                <MudSelectItem T="string" Value="@("Traspaso")">Traspasos</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConsultarAsync"
                       Disabled="_cargando" StartIcon="@Icons.Material.Filled.Search" FullWidth="true">
                @(_cargando ? "Consultando..." : "Consultar")
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorCarga</MudAlert>
}
@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_movimientos.Count > 0)
{
    var mostrados = MovimientosFiltrados.ToList();
    <div class="d-flex align-center justify-space-between mb-2">
        <MudText Typo="Typo.caption">
            @mostrados.Count movimiento(s)
            @if (!string.IsNullOrEmpty(_filtroCategoria)) { <text> de tipo "@_filtroCategoria"</text> }
            (máximo 500 por consulta)
        </MudText>
        <MudText Typo="Typo.caption" Style="color:var(--n-text-3);">
            Valor total: @mostrados.Sum(m => m.ValorMovimiento).ToString("C0")
        </MudText>
    </div>

    @if (Preferencias.VistaListado == "tarjetas")
    {
        <div class="nexo-card-grid">
            @foreach (var mov in mostrados)
            {
                <div class="nexo-item-card">
                    <div class="d-flex align-center justify-space-between mb-1">
                        <div class="nexo-item-card__title" style="font-size:0.9rem;">@mov.Articulo</div>
                        @ChipTipo(mov)
                    </div>
                    <div class="nexo-item-card__sub">@mov.SKU · @mov.Bodega · @mov.Fecha.ToString("dd/MM/yy HH:mm")</div>
                    <div class="nexo-item-card__row">
                        <span>Cantidad</span>
                        <strong>@FormatearCantidad(mov)</strong>
                    </div>
                    <div class="nexo-item-card__row">
                        <span>Costo unit.</span>
                        <strong>@mov.CostoUnitario.ToString("C2")</strong>
                    </div>
                    <div class="nexo-item-card__row">
                        <span>Valor</span>
                        <strong>@mov.ValorMovimiento.ToString("C0")</strong>
                    </div>
                    <div class="nexo-item-card__row">
                        <span>Saldo</span>
                        <strong>@FormatearCantidad(mov.CantidadSaldo, mov.Unidad, mov.UnidadesPorEmbalaje)</strong>
                    </div>
                    @if (mov.ObservacionDetallada is not null)
                    {
                        <div class="nexo-item-card__sub mt-1">@mov.ObservacionDetallada</div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <MudTable Items="mostrados" Hover="true" Dense="true" Striped="true" RowsPerPage="25">
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
            </PagerContent>
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>SKU / Artículo</MudTh>
                <MudTh>Bodega</MudTh>
                <MudTh>Tipo</MudTh>
                <MudTh Style="text-align:right">Cantidad</MudTh>
                <MudTh Style="text-align:right">Costo Unit.</MudTh>
                <MudTh Style="text-align:right">Valor</MudTh>
                <MudTh Style="text-align:right">Saldo</MudTh>
                <MudTh>Detalle</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yy HH:mm")</MudTd>
                <MudTd DataLabel="Artículo">
                    <div style="font-weight:600; font-size:0.8rem; color:var(--n-text-3);">@context.SKU</div>
                    <div>@context.Articulo</div>
                </MudTd>
                <MudTd DataLabel="Bodega">@context.Bodega</MudTd>
                <MudTd DataLabel="Tipo">@ChipTipo(context)</MudTd>
                <MudTd DataLabel="Cantidad" Style="text-align:right">@FormatearCantidad(context)</MudTd>
                <MudTd DataLabel="Costo Unit." Style="text-align:right">@context.CostoUnitario.ToString("C2")</MudTd>
                <MudTd DataLabel="Valor" Style="text-align:right; font-weight:600;">
                    <span style="color:@(context.EsEntrada ? "var(--mud-palette-success)" : "var(--mud-palette-error)")">
                        @(context.EsEntrada ? "+" : "-")@context.ValorMovimiento.ToString("C0")
                    </span>
                </MudTd>
                <MudTd DataLabel="Saldo" Style="text-align:right">
                    @FormatearCantidad(context.CantidadSaldo, context.Unidad, context.UnidadesPorEmbalaje)
                </MudTd>
                <MudTd DataLabel="Detalle" Style="max-width:200px; white-space:normal; font-size:0.8rem;">
                    @(context.ObservacionDetallada ?? "-")
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No hay movimientos con estos filtros.</MudText>
            </NoRecordsContent>
        </MudTable>
    }
}
else if (_consultaEjecutada)
{
    <MudAlert Severity="Severity.Info">No se encontraron movimientos con los filtros indicados.</MudAlert>
}

@code {
    private List<KardexMovimientoItem> _movimientos = new();
    private List<ArticuloItem> _articulos = new();
    private List<BodegaItem> _bodegas = new();
    private int? _articuloId;
    private int? _bodegaId;
    private DateTime? _desde;
    private DateTime? _hasta;
    private string? _filtroCategoria;
    private bool _cargando;
    private bool _consultaEjecutada;
    private string? _errorCarga;

    private IEnumerable<KardexMovimientoItem> MovimientosFiltrados =>
        string.IsNullOrEmpty(_filtroCategoria)
            ? _movimientos
            : _movimientos.Where(m => CategoriaDe(m.TipoMovimiento) == _filtroCategoria);

    private static string CategoriaDe(string tipo) => tipo switch
    {
        var t when t.Contains("Ajuste")                                              => "Ajuste",
        var t when t.Contains("Baja") || t.Contains("Pérdida")                      => "Baja",
        var t when t.Contains("Traspaso")                                            => "Traspaso",
        var t when t.Contains("Compra") || t.Contains("Entrada")                    => "Entrada",
        var t when t.Contains("Venta") || t.Contains("Salida") || t.Contains("Despacho") => "Salida",
        var t when t.Contains("Produccion") || t.Contains("Producción")             => "Producción",
        _ => "Otro"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tareaArticulos = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos");
            var tareaBodegas = ApiClient.GetAsync<List<BodegaItem>>("api/catalogo/bodegas");
            await Task.WhenAll(tareaArticulos, tareaBodegas);
            _articulos = await tareaArticulos ?? new();
            _bodegas = await tareaBodegas ?? new();
        }
        catch { }
    }

    private async Task ConsultarAsync()
    {
        _cargando = true;
        _errorCarga = null;
        _consultaEjecutada = true;

        try
        {
            var query = new List<string>();
            if (_articuloId.HasValue) query.Add($"articuloId={_articuloId}");
            if (_bodegaId.HasValue) query.Add($"bodegaId={_bodegaId}");
            if (_desde.HasValue) query.Add($"desde={_desde.Value:yyyy-MM-dd}");
            if (_hasta.HasValue) query.Add($"hasta={_hasta.Value:yyyy-MM-dd}");

            var ruta = "api/inventario/kardex" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
            _movimientos = await ApiClient.GetAsync<List<KardexMovimientoItem>>(ruta) ?? new();
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private static string FormatearCantidad(KardexMovimientoItem mov)
    {
        var signo = mov.EsEntrada ? "+" : "-";
        var abs = Math.Abs(mov.Cantidad);
        var texto = FormatearCantidad(abs, mov.Unidad, mov.UnidadesPorEmbalaje);
        return signo + texto;
    }

    private static string FormatearCantidad(decimal cantidad, string? unidad, decimal? unidadesPorEmbalaje)
    {
        if (unidad == "cja" && unidadesPorEmbalaje is > 0)
            return StockHelper.FormatearCajaUnidades(cantidad, unidadesPorEmbalaje.Value);
        return $"{cantidad:N3} {unidad}".Trim();
    }

    private static RenderFragment ChipTipo(KardexMovimientoItem mov) => builder =>
    {
        var (color, icon) = mov.TipoMovimiento switch
        {
            var t when t.Contains("Ajuste") => (Color.Info, Icons.Material.Filled.Tune),
            var t when t.Contains("Baja") || t.Contains("Pérdida") => (Color.Error, Icons.Material.Filled.DeleteOutline),
            var t when t.Contains("Traspaso") => (Color.Secondary, Icons.Material.Filled.SwapHoriz),
            var t when t.Contains("Compra") || t.Contains("Entrada") => (Color.Success, Icons.Material.Filled.ArrowDownward),
            var t when t.Contains("Venta") || t.Contains("Salida") || t.Contains("Despacho") => (Color.Warning, Icons.Material.Filled.ArrowUpward),
            var t when t.Contains("Produccion") || t.Contains("Producción") => (Color.Tertiary, Icons.Material.Filled.Factory),
            _ => (mov.EsEntrada ? Color.Success : Color.Error, Icons.Material.Filled.SwapVert)
        };

        builder.OpenComponent<MudChip<string>>(0);
        builder.AddAttribute(1, "T", typeof(string));
        builder.AddAttribute(2, "Size", Size.Small);
        builder.AddAttribute(3, "Color", color);
        builder.AddAttribute(4, "Icon", icon);
        builder.AddAttribute(5, "ChildContent", (RenderFragment)(b =>
        {
            b.AddContent(0, mov.TipoMovimiento);
        }));
        builder.CloseComponent();
    };
}
