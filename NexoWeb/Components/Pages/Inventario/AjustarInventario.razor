@page "/inventario/ajustes"
@attribute [Authorize(Roles = "Administracion,Empleados")]
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@using NexoWeb.Common.Dtos

<PageTitle>Ajuste de Inventario - NEXO</PageTitle>

<div class="d-flex align-center mb-4" style="gap: 0.25rem;">
    <MudText Typo="Typo.h5">Ajuste de Inventario</MudText>
    <BotonFavorito Href="/inventario/ajustes" Etiqueta="Ajuste de Inventario" />
</div>
<InfoAyuda Texto="Usa esta pantalla para cargar el stock inicial de un artículo (por ejemplo, al arrancar el sistema) o para corregir la cantidad tras un conteo físico. El movimiento queda registrado en el Kardex como 'Ajuste de Inventario' y afecta el costo promedio del artículo." />

<MudPaper Class="pa-6" MaxWidth="600px">
    <MudSelect T="int" @bind-Value="_articuloId" @bind-Value:after="OnArticuloCambiado"
               Label="Articulo" Class="mb-4" Required="true">
        @foreach (var articulo in _articulos)
        {
            <MudSelectItem T="int" Value="@articulo.ArticuloID">@articulo.SKU - @articulo.Nombre (@articulo.TipoArticulo)</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="int" @bind-Value="_bodegaId" Label="Bodega" Class="mb-4" Required="true">
        @foreach (var bodega in _bodegas)
        {
            <MudSelectItem T="int" Value="@bodega.BodegaID">@bodega.Nombre (@bodega.CentroCosto)</MudSelectItem>
        }
    </MudSelect>

    @* ── Sección de cantidad: adapta según el tipo de unidad del artículo ── *@
    @if (ArticuloSeleccionado is { } art)
    {
        @if (!_modoManual && art.Unidad == "cja" && art.UnidadesPorEmbalaje is > 0)
        {
            @* Modo caja: inputs separados cajas + unidades *@
            <div class="d-flex align-end mb-1" style="gap: 0.75rem;">
                <MudNumericField @bind-Value="_cajas" @bind-Value:after="RecalcularDesdeCajas"
                                 Label="Cajas" Min="0m" Format="N0" Style="flex:1" />
                <MudNumericField @bind-Value="_unidades" @bind-Value:after="RecalcularDesdeCajas"
                                 Label="Unidades sueltas" Min="0m"
                                 HelperText="@($"(máx {art.UnidadesPorEmbalaje - 1:N0} por caja)")"
                                 Max="@(art.UnidadesPorEmbalaje!.Value - 1)"
                                 Format="N0" Style="flex:1" />
            </div>
            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.caption" Style="color:var(--n-text-3);">
                    Total: @(_cantidad.ToString("N5")) cajas = @((_cantidad * art.UnidadesPorEmbalaje.Value).ToString("N0")) unidades
                </MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           OnClick="@(() => { _modoManual = true; })" Style="font-size:0.75rem;">
                    Cambiar a otro valor manualmente
                </MudButton>
            </div>
        }
        else if (!_modoManual)
        {
            @* Modo normal con unidad conocida *@
            <div class="d-flex align-end mb-1" style="gap: 0.5rem;">
                <MudNumericField @bind-Value="_cantidad" Label="Cantidad a agregar" Min="0.001m" Format="N3"
                                 Class="flex-1" Required="true" />
                @if (!string.IsNullOrWhiteSpace(art.Unidad))
                {
                    <MudText Style="margin-bottom:0.5rem; color:var(--n-text-2); font-size:0.9rem;">@art.Unidad</MudText>
                }
            </div>
            <div class="d-flex align-center justify-space-between mb-3">
                <span></span>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           OnClick="@(() => { _modoManual = true; })" Style="font-size:0.75rem;">
                    Cambiar a otro valor manualmente
                </MudButton>
            </div>
        }
        else
        {
            @* Modo manual (decimal libre) *@
            <MudNumericField @bind-Value="_cantidad" Label="Cantidad a agregar (valor manual)" Min="0.000001m"
                             Format="N6" Class="mb-1" Required="true"
                             HelperText="@($"Escribe el valor decimal exacto en unidad base ({art.Unidad ?? "und"})")" />
            <div class="d-flex align-center justify-space-between mb-3">
                <span></span>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                           OnClick="VolveModoFriendly" Style="font-size:0.75rem;">
                    Volver al modo normal
                </MudButton>
            </div>
        }
    }
    else
    {
        @* Sin artículo seleccionado: campo genérico *@
        <MudNumericField @bind-Value="_cantidad" Label="Cantidad a agregar" Min="0.01m" Format="N2" Class="mb-4" Required="true" />
    }

    <MudMoneyField @bind-Value="_costoUnitario" Label="Costo Unitario" Required="true"
                   HelperText="Se usa para recalcular el costo promedio del articulo." Class="mb-4" />

    <MudTextField @bind-Value="_motivo" Label="Motivo del ajuste" Lines="3"
                  HelperText="Minimo 5 caracteres. Ej: 'Carga inicial de stock al arrancar el sistema.'"
                  Class="mb-4" Required="true" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RegistrarAsync"
               Disabled="@(!FormularioValido || _guardando)" StartIcon="@Icons.Material.Filled.AddCircle">
        @(_guardando ? "Registrando..." : "Registrar Ajuste")
    </MudButton>
</MudPaper>

@code {
    private List<ArticuloItem> _articulos = new();
    private List<BodegaItem> _bodegas = new();

    private int _articuloId;
    private int _bodegaId;
    private decimal _cantidad;
    private decimal _costoUnitario;
    private string _motivo = "";
    private bool _guardando;

    // Modo de entrada de cantidad
    private bool _modoManual;
    private decimal _cajas;
    private decimal _unidades;

    private ArticuloItem? ArticuloSeleccionado =>
        _articuloId > 0 ? _articulos.FirstOrDefault(a => a.ArticuloID == _articuloId) : null;

    private bool FormularioValido =>
        _articuloId > 0 && _bodegaId > 0 && _cantidad > 0 &&
        _costoUnitario >= 0 && _motivo.Trim().Length >= 5;

    protected override async Task OnInitializedAsync()
    {
        var tareaArticulos = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos");
        var tareaBodegas = ApiClient.GetAsync<List<BodegaItem>>("api/catalogo/bodegas");

        await Task.WhenAll(tareaArticulos, tareaBodegas);

        _articulos = await tareaArticulos ?? new();
        _bodegas = await tareaBodegas ?? new();
    }

    private void OnArticuloCambiado()
    {
        // Resetear modo al cambiar de artículo
        _modoManual = false;
        _cajas = 0;
        _unidades = 0;
        _cantidad = 0;
    }

    private void RecalcularDesdeCajas()
    {
        var art = ArticuloSeleccionado;
        if (art?.UnidadesPorEmbalaje is > 0)
            _cantidad = _cajas + _unidades / art.UnidadesPorEmbalaje.Value;
        else
            _cantidad = _cajas;
    }

    private void VolveModoFriendly()
    {
        _modoManual = false;
        var art = ArticuloSeleccionado;
        if (art?.Unidad == "cja" && art.UnidadesPorEmbalaje is > 0)
        {
            _cajas = Math.Floor(_cantidad);
            _unidades = Math.Round((_cantidad - _cajas) * art.UnidadesPorEmbalaje.Value, 0);
        }
    }

    private async Task RegistrarAsync()
    {
        var art = ArticuloSeleccionado;
        var articuloNombre = art?.Nombre ?? "?";
        var bodegaNombre = _bodegas.FirstOrDefault(b => b.BodegaID == _bodegaId)?.Nombre ?? "?";

        var resumenCantidad = (art?.Unidad == "cja" && art.UnidadesPorEmbalaje is > 0)
            ? $"{_cantidad:N5} cajas ({_cantidad * art.UnidadesPorEmbalaje!.Value:N0} und)"
            : $"{_cantidad:N3} {art?.Unidad ?? "und"}";

        var confirmacion = await DialogService.ShowMessageBox(
            "Confirmar Ajuste de Inventario",
            $"Esta accion quedara registrada en el Kardex y no se puede deshacer directamente.\n\n" +
            $"Articulo: {articuloNombre}\n" +
            $"Bodega: {bodegaNombre}\n" +
            $"Cantidad a agregar: {resumenCantidad}\n" +
            $"Costo unitario: {_costoUnitario:C2}\n\n" +
            "¿Confirmar el ajuste?",
            yesText: "Si, registrar ajuste",
            noText: "Cancelar");

        if (confirmacion != true)
            return;

        _guardando = true;

        try
        {
            var request = new AjustarInventarioRequest(_articuloId, _bodegaId, _cantidad, _costoUnitario, _motivo.Trim());
            var resultado = await ApiClient.PostAsync<AjustarInventarioRequest, AjustarInventarioResponse>("api/inventario/ajustes", request);

            Snackbar.Add($"Ajuste registrado correctamente. Codigo: {resultado!.CodigoAjuste}. Nuevo saldo: {resultado.NuevoSaldo:N3}", Severity.Success);

            _cantidad = 0;
            _cajas = 0;
            _unidades = 0;
            _costoUnitario = 0;
            _motivo = "";
            _modoManual = false;
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }
}
