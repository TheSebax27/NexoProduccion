@page "/inventario/stock"
@attribute [Authorize]
@implements IDisposable
@inject NexoWeb.Common.ApiClient.INexoApiClient ApiClient
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@inject NavigationManager Navegacion
@using NexoWeb.Common.Dtos
@using NexoWeb.Common.Helpers

<PageTitle>Consulta de Stock - NEXO</PageTitle>

<div class="d-flex align-center mb-4" style="gap: 0.25rem;">
    <MudText Typo="Typo.h5">Consulta de Stock</MudText>
    <BotonFavorito Href="/inventario/stock" Etiqueta="Consulta de Stock" />
</div>
<InfoAyuda Texto="Consulta cuánto stock tienes de cada artículo, en qué bodega y a qué costo. Cada artículo muestra su total agrupado; haz clic en la flecha para ver el detalle por lote. El chip 'Requiere pedido' te lleva directo a crear una Orden de Compra." />

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="3">
        <MudTextField @bind-Value="_filtroSku" Label="Buscar por SKU" Variant="Variant.Outlined"
                      Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="CargarAsync" />
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudSelect T="int?" Value="_filtroCentroCostoId" ValueChanged="OnCentroCostoCambiadoAsync"
                   Label="Centro de Costo" Variant="Variant.Outlined" Clearable="true">
            @foreach (var cc in _centrosCosto)
            {
                <MudSelectItem T="int?" Value="@cc.CentroCostoID">@cc.Nombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudSelect T="int?" @bind-Value="_filtroBodegaId" @bind-Value:after="CargarAsync"
                   Label="Bodega" Variant="Variant.Outlined" Clearable="true">
            @foreach (var b in _bodegasFiltradas)
            {
                <MudSelectItem T="int?" Value="@b.BodegaID">@b.Nombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="3" Class="d-flex align-center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarAsync" StartIcon="@Icons.Material.Filled.Refresh">
            Actualizar
        </MudButton>
    </MudItem>
</MudGrid>

@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_grupos.Count == 0)
{
    <MudText>No hay stock que coincida con el filtro.</MudText>
}
else if (Preferencias.VistaListado == "tarjetas")
{
    <div class="nexo-card-grid">
        @foreach (var grupo in _grupos)
        {
            <div class="nexo-item-card">
                @if (grupo.TieneImagen)
                {
                    <img src="@($"api/catalogo/articulos/{grupo.ArticuloID}/imagen?v={_cacheBust}")" alt=""
                         style="width:100%; height:120px; object-fit:cover; border-radius:8px; margin-bottom:0.5rem;" />
                }
                <div class="nexo-item-card__title">@grupo.Articulo</div>
                <div class="nexo-item-card__sub">@grupo.SKU · @grupo.Bodega · @grupo.CentroCosto</div>
                <div class="nexo-item-card__row">
                    <span>Cantidad</span>
                    <strong>@FormatearCantidad(grupo.CantidadTotal, grupo.Unidad, grupo.UnidadesPorEmbalaje)</strong>
                </div>
                <div class="nexo-item-card__row">
                    <span style="color:var(--n-text-3); font-size:0.78rem;">Valor stock (lote)</span>
                    <strong>@grupo.ValorTotal.ToString("C0")</strong>
                </div>
                <div class="nexo-item-card__row">
                    <span style="color:var(--n-text-3); font-size:0.78rem;">Costo promedio</span>
                    <span style="font-size:0.85rem;">@grupo.CostoPromedio.ToString("C0")</span>
                </div>
                <div class="nexo-item-card__row">
                    <span style="color:var(--n-text-3); font-size:0.78rem;">Precio venta</span>
                    <span style="font-size:0.85rem; color:var(--mud-palette-success);">@grupo.PrecioVenta.ToString("C0")</span>
                </div>
                @if (grupo.Lotes.Count > 1)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Layers"
                               OnClick="@(() => ToggleExpand(grupo.Key))">
                        @(grupo.Lotes.Count) lotes @(_expandidos.Contains(grupo.Key) ? "▲" : "▼")
                    </MudButton>
                    @if (_expandidos.Contains(grupo.Key))
                    {
                        @foreach (var lote in grupo.Lotes)
                        {
                            <div style="border-left: 2px solid var(--n-primary); padding-left: 0.75rem; margin-top:0.5rem; font-size:0.82rem;">
                                <div>@(lote.NumeroLote ?? "Sin lote") @(lote.FechaVencimiento.HasValue ? "· Vence: " + lote.FechaVencimiento.Value.ToString("dd/MM/yy") : "")</div>
                                <div>@FormatearCantidad(lote.CantidadActual, lote.Unidad, lote.UnidadesPorEmbalaje) · Costo: @lote.CostoUnitarioLote.ToString("C0")</div>
                            </div>
                        }
                    }
                }
                @if (grupo.CantidadTotal <= 0)
                {
                    var esPt0 = grupo.TipoArticulo == "Producto Terminado";
                    <div class="nexo-item-card__actions">
                        <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                 Icon="@(esPt0 ? Icons.Material.Filled.Factory : Icons.Material.Filled.ShoppingCart)"
                                 OnClick="@(() => IrAlertaAsync(grupo.ArticuloID, grupo.TipoArticulo))" Style="cursor:pointer;">
                            @(esPt0 ? "Sin stock · Producir" : "Sin stock")
                        </MudChip>
                    </div>
                }
                else if (grupo.RequierePedido)
                {
                    var esPt1 = grupo.TipoArticulo == "Producto Terminado";
                    <div class="nexo-item-card__actions">
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                                 Icon="@(esPt1 ? Icons.Material.Filled.Factory : Icons.Material.Filled.ShoppingCart)"
                                 OnClick="@(() => IrAlertaAsync(grupo.ArticuloID, grupo.TipoArticulo))" Style="cursor:pointer;">
                            @(esPt1 ? "Nueva producción" : "Requiere pedido")
                        </MudChip>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <MudTable Items="_grupos" Hover="true" Dense="true" Striped="true"
              RowsPerPage="50" AllowUnsorted="false">
        <HeaderContent>
            <MudTh></MudTh>
            <MudTh></MudTh>
            <MudTh>SKU</MudTh>
            <MudTh>Articulo</MudTh>
            <MudTh>Bodega</MudTh>
            <MudTh>Centro de Costo</MudTh>
            <MudTh Style="text-align:right">Cantidad</MudTh>
            <MudTh Style="text-align:right">
                <MudTooltip Text="Suma del stock valorado al costo de cada lote (FEFO/FIFO)">
                    Valor Stock ⓘ
                </MudTooltip>
            </MudTh>
            <MudTh Style="text-align:right">
                <MudTooltip Text="Promedio ponderado histórico del catálogo">
                    Costo Prom. ⓘ
                </MudTooltip>
            </MudTh>
            <MudTh Style="text-align:right">P. Venta</MudTh>
            <MudTh>Alerta</MudTh>
        </HeaderContent>
        <RowTemplate>
            @* Fila resumen del grupo *@
            <MudTd DataLabel="">
                @if (context.TieneImagen)
                {
                    <img src="@($"api/catalogo/articulos/{context.ArticuloID}/imagen?v={_cacheBust}")" alt=""
                         style="width:32px; height:32px; object-fit:cover; border-radius:6px;" />
                }
            </MudTd>
            <MudTd DataLabel="">
                @if (context.Lotes.Count > 1)
                {
                    <MudIconButton Size="Size.Small"
                                   Icon="@(_expandidos.Contains(context.Key) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   OnClick="@(() => ToggleExpand(context.Key))" />
                }
            </MudTd>
            <MudTd DataLabel="SKU">@context.SKU</MudTd>
            <MudTd DataLabel="Articulo">@context.Articulo</MudTd>
            <MudTd DataLabel="Bodega">@context.Bodega</MudTd>
            <MudTd DataLabel="Centro de Costo">@context.CentroCosto</MudTd>
            <MudTd DataLabel="Cantidad" Style="text-align:right">
                @FormatearCantidad(context.CantidadTotal, context.Unidad, context.UnidadesPorEmbalaje)
                @if (context.Lotes.Count > 1)
                {
                    <MudText Typo="Typo.caption" Class="d-block" Style="color:var(--n-text-3);">
                        @context.Lotes.Count lotes
                    </MudText>
                }
            </MudTd>
            <MudTd DataLabel="Valor Stock" Style="text-align:right">@context.ValorTotal.ToString("C0")</MudTd>
            <MudTd DataLabel="Costo Prom." Style="text-align:right; color:var(--n-text-3);">@context.CostoPromedio.ToString("C0")</MudTd>
            <MudTd DataLabel="P. Venta" Style="text-align:right; color:var(--mud-palette-success);">@context.PrecioVenta.ToString("C0")</MudTd>
            <MudTd DataLabel="Alerta">
                @if (context.CantidadTotal <= 0)
                {
                    var esPtL0 = context.TipoArticulo == "Producto Terminado";
                    <MudChip T="string" Color="Color.Error" Size="Size.Small"
                             Icon="@(esPtL0 ? Icons.Material.Filled.Factory : Icons.Material.Filled.ShoppingCart)"
                             OnClick="@(() => IrAlertaAsync(context.ArticuloID, context.TipoArticulo))" Style="cursor:pointer;">
                        @(esPtL0 ? "Sin stock · Producir" : "Sin stock")
                    </MudChip>
                }
                else if (context.RequierePedido)
                {
                    var esPtL1 = context.TipoArticulo == "Producto Terminado";
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                             Icon="@(esPtL1 ? Icons.Material.Filled.Factory : Icons.Material.Filled.ShoppingCart)"
                             OnClick="@(() => IrAlertaAsync(context.ArticuloID, context.TipoArticulo))" Style="cursor:pointer;">
                        @(esPtL1 ? "Nueva producción" : "Requiere pedido")
                    </MudChip>
                }
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @* Filas de detalle por lote cuando el grupo está expandido *@
            @if (_expandidos.Contains(context.Key) && context.Lotes.Count > 1)
            {
                @foreach (var lote in context.Lotes)
                {
                    <MudTr Style="background:var(--mud-palette-background-grey, rgba(0,0,0,0.03));">
                        <MudTd colspan="2"></MudTd>
                        <MudTd colspan="2">
                            <div style="padding-left:1.5rem; font-size:0.82rem; color:var(--n-text-2);">
                                <strong>@(lote.NumeroLote ?? "Sin lote")</strong>
                                @if (lote.FechaVencimiento.HasValue)
                                {
                                    <text> · Vence @lote.FechaVencimiento.Value.ToString("dd/MM/yyyy")</text>
                                }
                            </div>
                        </MudTd>
                        <MudTd>@lote.Bodega</MudTd>
                        <MudTd></MudTd>
                        <MudTd Style="text-align:right; font-size:0.85rem;">
                            @FormatearCantidad(lote.CantidadActual, lote.Unidad, lote.UnidadesPorEmbalaje)
                        </MudTd>
                        <MudTd Style="text-align:right; font-size:0.85rem;">
                            <div>@lote.ValorTotal.ToString("C0")</div>
                            <div style="font-size:0.78rem; color:var(--n-text-3);">@lote.CostoUnitarioLote.ToString("C0")/und</div>
                        </MudTd>
                        <MudTd></MudTd>
                    </MudTr>
                }
            }
        </ChildRowContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 25, 50, 100 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudText>No hay stock que coincida con el filtro.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private record GrupoStock(
        (int ArticuloID, int BodegaID, int CentroCostoID) Key,
        int ArticuloID, string SKU, string Articulo, string TipoArticulo,
        string? Unidad, decimal? UnidadesPorEmbalaje,
        int BodegaID, string Bodega, int CentroCostoID, string CentroCosto,
        decimal CantidadTotal, decimal ValorTotal, bool RequierePedido, bool TieneImagen,
        List<StockConsolidadoItem> Lotes,
        decimal CostoPromedio, decimal PrecioVenta
    );

    private List<StockConsolidadoItem> _stock = new();
    private List<GrupoStock> _grupos = new();
    private readonly HashSet<(int, int, int)> _expandidos = new();

    private string _filtroSku = "";
    private int? _filtroCentroCostoId;
    private int? _filtroBodegaId;
    private bool _cargando = true;
    private string? _error;
    private readonly long _cacheBust = DateTime.UtcNow.Ticks;

    private List<CentroCostoItem> _centrosCosto = new();
    private List<BodegaItem> _bodegas = new();
    private IEnumerable<BodegaItem> _bodegasFiltradas =>
        _filtroCentroCostoId is null ? _bodegas : _bodegas.Where(b => b.CentroCostoID == _filtroCentroCostoId);

    protected override void OnInitialized()
    {
        Preferencias.OnCambio += OnPreferenciasCambiaron;
    }

    private void OnPreferenciasCambiaron() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Preferencias.OnCambio -= OnPreferenciasCambiaron;
    }

    protected override async Task OnInitializedAsync()
    {
        var tareaCentrosCosto = ApiClient.GetAsync<List<CentroCostoItem>>("api/catalogo/centros-costo");
        var tareaBodegas      = ApiClient.GetAsync<List<BodegaItem>>("api/catalogo/bodegas");
        await Task.WhenAll(tareaCentrosCosto, tareaBodegas);
        _centrosCosto = await tareaCentrosCosto ?? new();
        _bodegas      = await tareaBodegas ?? new();

        await CargarAsync();
    }

    private void IrAlertaAsync(int articuloId, string tipoArticulo)
    {
        if (tipoArticulo == "Producto Terminado")
            Navegacion.NavigateTo("/produccion/ordenes/crear");
        else
            Navegacion.NavigateTo($"/compras/ordenes?articuloId={articuloId}");
    }

    private async Task OnCentroCostoCambiadoAsync(int? nuevoCentroCostoId)
    {
        _filtroCentroCostoId = nuevoCentroCostoId;
        if (_filtroBodegaId is not null && _bodegasFiltradas.All(b => b.BodegaID != _filtroBodegaId))
            _filtroBodegaId = null;

        await CargarAsync();
    }

    private void ToggleExpand((int, int, int) key)
    {
        if (!_expandidos.Remove(key))
            _expandidos.Add(key);
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = null;

        try
        {
            var parametros = new List<string>();
            if (!string.IsNullOrWhiteSpace(_filtroSku)) parametros.Add($"sku={Uri.EscapeDataString(_filtroSku)}");
            if (_filtroCentroCostoId is not null) parametros.Add($"centroCostoId={_filtroCentroCostoId}");
            if (_filtroBodegaId is not null) parametros.Add($"bodegaId={_filtroBodegaId}");

            var ruta = "api/inventario/stock" + (parametros.Count > 0 ? "?" + string.Join("&", parametros) : "");
            _stock = await ApiClient.GetAsync<List<StockConsolidadoItem>>(ruta) ?? new();

            _grupos = _stock
                .GroupBy(s => (s.ArticuloID, s.BodegaID, s.CentroCostoID))
                .Select(g =>
                {
                    var first = g.First();
                    var key = (first.ArticuloID, first.BodegaID, first.CentroCostoID);
                    return new GrupoStock(
                        key,
                        first.ArticuloID, first.SKU, first.Articulo, first.TipoArticulo,
                        first.Unidad, first.UnidadesPorEmbalaje,
                        first.BodegaID, first.Bodega, first.CentroCostoID, first.CentroCosto,
                        g.Sum(s => s.CantidadActual), g.Sum(s => s.ValorTotal),
                        first.StockMinimo > 0 && g.Sum(s => s.CantidadActual) <= first.StockMinimo, first.TieneImagen,
                        g.ToList(), first.CostoPromedio, first.PrecioVenta
                    );
                })
                .ToList();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el stock: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private static string FormatearCantidad(decimal cantidad, string? unidad, decimal? unidadesPorEmbalaje)
    {
        if (unidad == "cja" && unidadesPorEmbalaje is > 0)
            return StockHelper.FormatearCajaUnidades(cantidad, unidadesPorEmbalaje.Value);
        return $"{cantidad:N2} {unidad}".Trim();
    }
}
