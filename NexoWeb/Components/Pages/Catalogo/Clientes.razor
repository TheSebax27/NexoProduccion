@page "/catalogo/clientes"
@attribute [Authorize(Roles = "Administrador")]
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@using NexoWeb.Common.Dtos

<PageTitle>Clientes - NEXO</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Clientes</MudText>
<InfoAyuda Texto="Registra los clientes de la empresa. Se pueden asociar opcionalmente a una Orden de Producción para saber para quién se está fabricando." />

<MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AbrirCreacionAsync"
           StartIcon="@Icons.Material.Filled.PersonAdd" Class="mb-4">
    Nuevo Cliente
</MudButton>

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar los clientes: @_errorCarga</MudAlert>
}
@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_clientes.Count == 0)
{
    <MudText>No hay clientes registrados.</MudText>
}
else if (Preferencias.VistaListado == "tarjetas")
{
    <div class="nexo-card-grid">
        @foreach (var cliente in _clientes)
        {
            <div class="nexo-item-card">
                <div class="d-flex align-center justify-space-between">
                    <div class="nexo-item-card__title">@cliente.Nombre</div>
                    <MudChip T="string" Color="@(cliente.Estado ? Color.Success : Color.Error)" Size="Size.Small">
                        @(cliente.Estado ? "Activo" : "Inactivo")
                    </MudChip>
                </div>
                <div class="nexo-item-card__sub">@(cliente.NIT ?? "Sin NIT")</div>
                <div class="nexo-item-card__row"><span>Contacto</span><strong>@(cliente.Contacto ?? "-")</strong></div>
                <div class="nexo-item-card__row"><span>Teléfono</span><strong>@(cliente.Telefono ?? "-")</strong></div>
                <div class="nexo-item-card__row"><span>Email</span><strong>@(cliente.Email ?? "-")</strong></div>
                <div class="nexo-item-card__actions">
                    <MudButton Size="Size.Small" OnClick="@(() => AbrirEdicionAsync(cliente))">Editar</MudButton>
                </div>
            </div>
        }
    </div>
}
else
{
    <MudTable Items="_clientes" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>NIT</MudTh>
            <MudTh>Contacto</MudTh>
            <MudTh>Telefono</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Accion</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="NIT">@(context.NIT ?? "-")</MudTd>
            <MudTd DataLabel="Contacto">@(context.Contacto ?? "-")</MudTd>
            <MudTd DataLabel="Telefono">@(context.Telefono ?? "-")</MudTd>
            <MudTd DataLabel="Email">@(context.Email ?? "-")</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="@(context.Estado ? Color.Success : Color.Error)" Size="Size.Small">
                    @(context.Estado ? "Activo" : "Inactivo")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Accion">
                <MudButton Size="Size.Small" OnClick="@(() => AbrirEdicionAsync(context))">Editar</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay clientes registrados.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<ClienteItem> _clientes = new();
    private bool _cargando = true;
    private string? _errorCarga;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _errorCarga = null;
        try
        {
            _clientes = await ApiClient.GetAsync<List<ClienteItem>>("api/catalogo/clientes") ?? new();
        }
        catch (Exception ex) { _errorCarga = ex.Message; }
        finally { _cargando = false; }
    }

    private async Task AbrirCreacionAsync()
    {
        var dialogo = await DialogService.ShowAsync<ClienteDialog>("Nuevo Cliente");
        var resultado = await dialogo.Result;
        if (resultado is null || resultado.Canceled) return;
        try
        {
            var request = (CrearClienteRequest)resultado.Data!;
            await ApiClient.PostAsync<CrearClienteRequest, object?>("api/catalogo/clientes", request);
            Snackbar.Add("Cliente creado correctamente.", Severity.Success);
            await CargarAsync();
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task AbrirEdicionAsync(ClienteItem cliente)
    {
        var parametros = new DialogParameters<ClienteDialog> { { x => x.Cliente, cliente } };
        var dialogo = await DialogService.ShowAsync<ClienteDialog>("Editar Cliente", parametros);
        var resultado = await dialogo.Result;
        if (resultado is null || resultado.Canceled) return;
        try
        {
            var request = (ActualizarClienteRequest)resultado.Data!;
            await ApiClient.PutAsync<ActualizarClienteRequest, object?>($"api/catalogo/clientes/{cliente.ClienteID}", request);
            Snackbar.Add("Cliente actualizado correctamente.", Severity.Success);
            await CargarAsync();
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
