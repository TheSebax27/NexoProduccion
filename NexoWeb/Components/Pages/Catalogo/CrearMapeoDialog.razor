@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@this">
            <MudSelect T="int?" @bind-Value="_articuloId" Label="Articulo (Producto Terminado)" Required="true"
                       RequiredError="Selecciona un articulo" Class="mb-3">
                @foreach (var articulo in ArticulosDisponibles)
                {
                    <MudSelectItem T="int?" Value="@articulo.ArticuloID">@articulo.SKU - @articulo.Nombre</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_codigoArticuloVisions" Label="Referencia en Visions" Required="true"
                          RequiredError="La referencia es obligatoria"
                          HelperText="El codigo REFERENCIA tal cual esta en dbo.TARJETA de Visions. Si no existe todavia, se crea automaticamente." />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">Mapear</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<ArticuloItem> ArticulosDisponibles { get; set; } = new();
    [Parameter] public int CentroCostoID { get; set; }

    private MudForm _form = default!;
    private int? _articuloId;
    private string _codigoArticuloVisions = string.Empty;

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid || _articuloId is null)
            return;

        var request = new CrearMapeoArticuloRequest(_articuloId.Value, CentroCostoID, _codigoArticuloVisions.Trim());
        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancelar() => MudDialog.Cancel();
}
