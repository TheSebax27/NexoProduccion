@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@this">
            @if (!EsEdicion)
            {
                <MudTextField @bind-Value="_codigo" Label="Codigo" Required="true"
                              RequiredError="El codigo es obligatorio" Class="mb-3" />

                <MudSelect T="string" @bind-Value="_tipoCentro" Label="Tipo de Centro" Required="true"
                           RequiredError="Selecciona un tipo" Class="mb-3">
                    <MudSelectItem Value="@("PLANTA_CENTRAL")">Planta Central</MudSelectItem>
                    <MudSelectItem Value="@("SUCURSAL")">Sucursal</MudSelectItem>
                    <MudSelectItem Value="@("FRANQUICIA")">Franquicia</MudSelectItem>
                    <MudSelectItem Value="@("PUNTO_VENTA")">Punto de Venta</MudSelectItem>
                </MudSelect>
            }

            <MudTextField @bind-Value="_nombre" Label="Nombre" Required="true"
                          RequiredError="El nombre es obligatorio" Class="mb-3" />

            <MudTextField @bind-Value="_direccion" Label="Direccion" Class="mb-3" />

            <MudTextField @bind-Value="_telefono" Label="Telefono" Class="mb-3" />

            @if (EsEdicion)
            {
                <MudSwitch T="bool" @bind-Value="_estado" Color="Color.Success" Label="Activo" Class="mb-3" />

                <MudDivider Class="mb-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Integracion con Visions</MudText>

                <MudSwitch T="bool" @bind-Value="_tieneVisions" Color="Color.Primary" Label="Este cliente tiene Visions" Class="mb-3" />

                @if (_tieneVisions)
                {
                    <MudNumericField T="int?" @bind-Value="_centroCostoVisions" Label="Codigo CENTROCOSTO en Visions"
                                      HelperText="El numero que identifica ESTA sucursal dentro de la base de datos de Visions de este cliente (columna CENTROCOSTO en dbo.TARJETA / dbo.MOVDETALLES / dbo.CENTROSDECOSTO de Visions). Cada cliente tiene su propia base -- si solo tiene una sucursal, casi siempre es 1."
                                      Min="0" Class="mb-3" />

                    <MudSelect T="int?" @bind-Value="_bodegaVentaVisionsId" Label="Bodega de Venta Visions"
                               HelperText="Bodega desde donde se descuenta el stock cuando se registra una venta en Visions" Class="mb-3">
                        @foreach (var bodega in Bodegas)
                        {
                            <MudSelectItem T="int?" Value="@bodega.BodegaID">@bodega.Nombre</MudSelectItem>
                        }
                    </MudSelect>

                    <MudText Typo="Typo.body2" Class="mb-1">Tipos de documento que cuentan como venta</MudText>
                    <MudText Typo="Typo.caption" Class="mb-2 mud-text-secondary">
                        No todos los clientes facturan igual en Visions -- marca solo los que este cliente usa realmente.
                    </MudText>
                    @foreach (var prefijo in PrefijosVisionsDisponibles)
                    {
                        <MudCheckBox T="bool" Value="@_prefijosSeleccionados.Contains(prefijo.Codigo)"
                                     ValueChanged="@((bool v) => AlternarPrefijo(prefijo.Codigo, v))"
                                     Label="@($"{prefijo.Codigo} - {prefijo.Descripcion}")" Dense="true" />
                    }
                }
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">
            @(EsEdicion ? "Guardar Cambios" : "Crear")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    // Si se pasa un CentroCosto existente, el dialogo entra en modo edicion
    // (oculta Codigo y Tipo, que no son editables una vez creado el registro).
    [Parameter] public CentroCostoItem? CentroCosto { get; set; }

    // Bodegas de este Centro de Costo, para elegir la Bodega de Venta Visions.
    // Se pasa filtrada desde CentrosCosto.razor (aun no existen bodegas al crear).
    [Parameter] public List<BodegaItem> Bodegas { get; set; } = new();

    private bool EsEdicion => CentroCosto is not null;

    private MudForm _form = default!;
    private string _codigo = string.Empty;
    private string _tipoCentro = "SUCURSAL";
    private string _nombre = string.Empty;
    private string? _direccion;
    private string? _telefono;
    private bool _estado = true;
    private bool _tieneVisions;
    // Se guarda como texto en la BD (IdentificadorClienteVisions es nvarchar
    // por flexibilidad), pero en Visions SIEMPRE es el codigo numerico
    // CENTROCOSTO (smallint) de esa sucursal -- ver TareaAplicarEntradasInventario
    // en NexoSyncAgent, que lo usa directo como parametro contra dbo.TARJETA.CENTROCOSTO.
    private int? _centroCostoVisions;
    private int? _bodegaVentaVisionsId;
    private readonly HashSet<string> _prefijosSeleccionados = new();

    // Lista fija de tipos de documento de venta que puede manejar Visions.
    // Si aparece un cliente con un tipo distinto, agregarlo aqui.
    private static readonly (string Codigo, string Descripcion)[] PrefijosVisionsDisponibles =
    {
        ("POS", "Factura POS"),
        ("FV", "Factura de Venta"),
        ("FE", "Factura Electronica"),
        ("NC", "Nota Credito"),
        ("ND", "Nota Debito"),
    };

    protected override void OnInitialized()
    {
        if (CentroCosto is not null)
        {
            _nombre = CentroCosto.Nombre;
            _direccion = CentroCosto.Direccion;
            _estado = CentroCosto.Estado;
            _tieneVisions = CentroCosto.TieneVisions;
            _centroCostoVisions = int.TryParse(CentroCosto.IdentificadorClienteVisions, out var centroCostoVisionsParseado) ? centroCostoVisionsParseado : null;
            _bodegaVentaVisionsId = CentroCosto.BodegaVentaVisionsID;

            if (!string.IsNullOrWhiteSpace(CentroCosto.PrefijosDocumentoVentaVisions))
            {
                foreach (var codigo in CentroCosto.PrefijosDocumentoVentaVisions.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    _prefijosSeleccionados.Add(codigo);
            }
        }
    }

    private void AlternarPrefijo(string codigo, bool seleccionado)
    {
        if (seleccionado)
            _prefijosSeleccionados.Add(codigo);
        else
            _prefijosSeleccionados.Remove(codigo);
    }

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (EsEdicion)
        {
            var prefijos = _prefijosSeleccionados.Count > 0 ? string.Join(",", _prefijosSeleccionados) : null;
            var request = new ActualizarCentroCostoRequest(
                _nombre, _direccion, _telefono, _estado,
                _tieneVisions, _tieneVisions ? _centroCostoVisions?.ToString() : null, _tieneVisions ? _bodegaVentaVisionsId : null,
                _tieneVisions ? prefijos : null);
            MudDialog.Close(DialogResult.Ok(request));
        }
        else
        {
            var request = new CrearCentroCostoRequest(_codigo, _nombre, _tipoCentro, _direccion, _telefono);
            MudDialog.Close(DialogResult.Ok(request));
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}