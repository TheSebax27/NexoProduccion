@page "/catalogo/bodegas"
@attribute [Authorize(Roles = "Administrador")]
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NexoWeb.Common.Dtos

<PageTitle>Bodegas - NEXO</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Bodegas</MudText>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="int?" Value="_filtroCentroCostoId" ValueChanged="OnFiltroCambiadoAsync"
                   Label="Filtrar por Centro de Costo" Clearable="true">
            @foreach (var centro in _centrosCosto)
            {
                <MudSelectItem T="int?" Value="@centro.CentroCostoID">@centro.Nombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

<MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AbrirCreacionAsync"
           StartIcon="@Icons.Material.Filled.Add" Class="mb-4"
           Disabled="_centrosCosto.Count == 0">
    Nueva Bodega
</MudButton>

@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <MudTable Items="_bodegas" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Centro de Costo</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Virtual</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Accion</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Centro de Costo">@context.CentroCosto</MudTd>
            <MudTd DataLabel="Tipo">@context.TipoBodega</MudTd>
            <MudTd DataLabel="Virtual">@(context.EsVirtual ? "Si" : "No")</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="@(context.Estado ? Color.Success : Color.Error)" Size="Size.Small">
                    @(context.Estado ? "Activa" : "Inactiva")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Accion">
                @if (context.Estado)
                {
                    <MudButton Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DesactivarAsync(context))">
                        Desactivar
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay bodegas registradas para este filtro.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<BodegaItem> _bodegas = new();
    private List<CentroCostoItem> _centrosCosto = new();
    private int? _filtroCentroCostoId;
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        // La API no expone "todos", solo activos por defecto en centros-costo;
        // eso es correcto aqui porque solo se puede crear una bodega en un
        // centro de costo activo.
        _centrosCosto = await ApiClient.GetAsync<List<CentroCostoItem>>("api/catalogo/centros-costo") ?? new();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        var ruta = _filtroCentroCostoId.HasValue
            ? $"api/catalogo/bodegas?centroCostoId={_filtroCentroCostoId}"
            : "api/catalogo/bodegas";

        _bodegas = await ApiClient.GetAsync<List<BodegaItem>>(ruta) ?? new();
        _cargando = false;
    }

    private async Task OnFiltroCambiadoAsync(int? nuevoValor)
    {
        _filtroCentroCostoId = nuevoValor;
        await CargarAsync();
    }

    private async Task AbrirCreacionAsync()
    {
        var parametros = new DialogParameters<BodegaDialog>
        {
            { x => x.CentrosCosto, _centrosCosto }
        };

        var dialogo = await DialogService.ShowAsync<BodegaDialog>("Nueva Bodega", parametros);
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled)
            return;

        try
        {
            var request = (CrearBodegaRequest)resultado.Data!;
            await ApiClient.PostAsync<CrearBodegaRequest, object?>("api/catalogo/bodegas", request);
            Snackbar.Add("Bodega creada correctamente.", Severity.Success);
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DesactivarAsync(BodegaItem bodega)
    {
        var confirmado = await DialogService.ShowMessageBox(
            "Confirmar",
            $"¿Desactivar la bodega '{bodega.Nombre}'? No podra usarse en nuevos movimientos de inventario.",
            yesText: "Desactivar", cancelText: "Cancelar");

        if (confirmado != true)
            return;

        try
        {
            await ApiClient.DeleteAsync($"api/catalogo/bodegas/{bodega.BodegaID}");
            Snackbar.Add("Bodega desactivada.", Severity.Success);
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}