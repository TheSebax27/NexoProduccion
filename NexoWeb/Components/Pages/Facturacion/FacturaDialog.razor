@using NexoWeb.Common.Dtos
@using NexoWeb.Common.Helpers
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@this">
            <MudSelect T="int?" @bind-Value="_clienteId" Label="Cliente" Required="true"
                       RequiredError="Selecciona un cliente" Class="mb-3">
                @foreach (var c in Clientes)
                {
                    <MudSelectItem T="int?" Value="@c.ClienteID">@c.Nombre</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker @bind-Date="_fecha" Label="Fecha" Required="true" Class="mb-3" />
            <MudTextField @bind-Value="_notas" Label="Notas (opcional)" Lines="2" Class="mb-3" />

            <MudDivider Class="mb-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Artículos Vendidos</MudText>

            @foreach (var linea in _lineas)
            {
                var art = Articulos.FirstOrDefault(a => a.ArticuloID == linea.ArticuloID);
                <MudPaper Elevation="0" Class="mb-3 pa-2" Style="border:1px solid var(--mud-palette-divider); border-radius:8px;">
                    <div class="d-flex align-center mb-2" style="gap: 0.5rem;">
                        <MudSelect T="int?" Value="linea.ArticuloID" ValueChanged="@((int? v) => OnArticuloCambiado(linea, v))"
                                   Label="Artículo" Style="flex: 1;">
                            @foreach (var a in Articulos)
                            {
                                <MudSelectItem T="int?" Value="@a.ArticuloID">@a.SKU - @a.Nombre</MudSelectItem>
                            }
                        </MudSelect>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => _lineas.Remove(linea))" />
                    </div>

                    @* Cantidad: caja+unidades o simple *@
                    @if (art?.EsUnidadCaja == true)
                    {
                        <div class="d-flex align-center mb-1" style="gap:0.5rem;">
                            <MudNumericField T="int" @bind-Value="linea.Cajas" Label="Cajas" Min="0" Style="flex:1;" />
                            @if (!art.SoloEnCajas)
                            {
                                <MudNumericField T="int" @bind-Value="linea.Unidades" Label="Unidades sueltas"
                                                Min="0" Max="@((int)(art.UnidadesPorEmbalaje!.Value - 1))" Style="flex:1;" />
                            }
                            <MudText Typo="Typo.caption" Style="flex:1; color:var(--n-text-3);">
                                = @StockHelper.CajasYUnidadesADecimal(linea.Cajas, linea.Unidades, art.UnidadesPorEmbalaje!.Value).ToString("N4") cajas
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <MudNumericField T="decimal" @bind-Value="linea.CantidadSimple" Label="Cantidad"
                                         Min="0.01m" Format="N2" Class="mb-1" />
                    }

                    @* Hint de precio por unidad si el artículo tiene uno definido *@
                    @if (art?.EsUnidadCaja == true && art.PrecioVentaUnidad.HasValue)
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--n-text-3);" Class="mt-1">
                            Precio caja: @art.PrecioVenta.ToString("N0") · Precio unitario: @art.PrecioVentaUnidad.Value.ToString("N0")
                        </MudText>
                    }

                    @* Precio: catálogo con indicador, o precio personalizado *@
                    <div class="d-flex align-center mt-1" style="gap:0.5rem; flex-wrap:wrap;">
                        <MudCheckBox T="bool" @bind-Value="linea.UsarPrecioCatalogo" Color="Color.Primary"
                                     Label="Precio catálogo" Dense="true" />
                        @if (linea.UsarPrecioCatalogo)
                        {
                            <MudText Typo="Typo.body2">@linea.PrecioUnitario.ToString("N0")</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="@(() => linea.UsarPrecioCatalogo = false)"
                                           Title="Ingresar precio personalizado" />
                        }
                        else
                        {
                            <MudNumericField T="decimal" @bind-Value="linea.PrecioUnitario" Label="Precio unitario"
                                            Min="0m" Format="N0" Style="flex:1;" />
                            @if (art is not null && linea.PrecioUnitario != art.PrecioVenta)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.LocalOffer">
                                    Precio especial
                                </MudChip>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Title="Restaurar precio catálogo"
                                           OnClick="@(() => { linea.PrecioUnitario = art?.PrecioVenta ?? 0; linea.UsarPrecioCatalogo = true; })" />
                        }
                        <MudText Typo="Typo.body2" Style="margin-left:auto; font-weight:600;">
                            @((CantidadFinal(linea) * linea.PrecioUnitario).ToString("C0"))
                        </MudText>
                    </div>
                </MudPaper>
            }

            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => _lineas.Add(new LineaEditable()))" Class="mt-1 mb-3">
                Agregar Artículo
            </MudButton>

            <MudText Typo="Typo.subtitle1" Class="d-block" Style="text-align: right;">
                Total: @_lineas.Sum(l => CantidadFinal(l) * l.PrecioUnitario).ToString("C0")
            </MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">
            Crear Factura
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<ClienteItem> Clientes { get; set; } = new();
    [Parameter] public List<ArticuloItem> Articulos { get; set; } = new();

    private class LineaEditable
    {
        public int?    ArticuloID         { get; set; }
        public int     Cajas              { get; set; } = 1;
        public int     Unidades           { get; set; } = 0;
        public decimal CantidadSimple     { get; set; } = 1;
        public decimal PrecioUnitario     { get; set; }
        public bool    UsarPrecioCatalogo { get; set; } = true;
    }

    private MudForm _form = default!;
    private int? _clienteId;
    private DateTime? _fecha = DateTime.Today;
    private string? _notas;
    private List<LineaEditable> _lineas = new() { new LineaEditable() };

    private decimal CantidadFinal(LineaEditable linea)
    {
        var art = Articulos.FirstOrDefault(a => a.ArticuloID == linea.ArticuloID);
        if (art?.EsUnidadCaja == true)
            return StockHelper.CajasYUnidadesADecimal(linea.Cajas, linea.Unidades, art.UnidadesPorEmbalaje!.Value);
        return linea.CantidadSimple;
    }

    private void OnArticuloCambiado(LineaEditable linea, int? articuloId)
    {
        linea.ArticuloID = articuloId;
        linea.Cajas = 1;
        linea.Unidades = 0;
        linea.CantidadSimple = 1;
        var art = Articulos.FirstOrDefault(a => a.ArticuloID == articuloId);
        linea.PrecioUnitario = art?.PrecioVenta ?? 0;
        linea.UsarPrecioCatalogo = true;
    }

    private async Task GuardarAsync()
    {
        await _form.Validate();
        if (!_form.IsValid || _clienteId is null || _fecha is null)
            return;

        var lineasValidas = _lineas
            .Where(l => l.ArticuloID is not null && CantidadFinal(l) > 0)
            .Select(l => new LineaFacturaInput(l.ArticuloID!.Value, CantidadFinal(l), l.PrecioUnitario))
            .ToList();

        if (lineasValidas.Count == 0)
        {
            Snackbar.Add("Agrega al menos un artículo con cantidad mayor a cero.", Severity.Warning);
            return;
        }

        var request = new CrearFacturaRequest(_clienteId.Value, _fecha.Value, _notas, lineasValidas);
        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancelar() => MudDialog.Cancel();
}
