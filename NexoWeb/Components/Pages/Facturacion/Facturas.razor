@page "/facturacion"
@attribute [Authorize]
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NexoWeb.Common.Dtos

<PageTitle>Facturacion - NEXO</PageTitle>

<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">Operaciones</p>
            <h1 class="nexo-page-hero__title">Facturacion</h1>
        </div>
    </div>
    <div class="d-flex align-center" style="gap:8px">
        <BotonFavorito Href="/facturacion" Etiqueta="Facturacion" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirCreacionAsync">
            Nueva Factura
        </MudButton>
    </div>
</div>

@* ── Filtros ── *@
<MudPaper Elevation="0" Class="pa-3 mb-4" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px">
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(170px,1fr)); gap:10px; align-items:end">
        <MudSelect T="string?" Value="_filtroTipDoc" ValueChanged="OnFiltroTipDocAsync"
                   Label="Tipo de documento" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var td in TiposDocumento.Todos)
            {
                <MudSelectItem T="string?" Value="@td">@td</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" Value="_filtroClienteId" ValueChanged="OnFiltroClienteAsync"
                   Label="Cliente" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var c in _clientes)
            {
                <MudSelectItem T="int?" Value="@c.ClienteID">@c.Nombre</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" Value="_filtroCentroCostoId" ValueChanged="OnFiltroCCAsync"
                   Label="Centro de Costo" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var cc in _centrosCosto)
            {
                <MudSelectItem T="int?" Value="@cc.CentroCostoID">@cc.Nombre</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string?" Value="_filtroEstado" ValueChanged="OnFiltroEstadoAsync"
                   Label="Estado pago" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="string?" Value="@("PENDIENTE")">Pendiente</MudSelectItem>
            <MudSelectItem T="string?" Value="@("PARCIAL")">Pago parcial</MudSelectItem>
            <MudSelectItem T="string?" Value="@("PAGADA")">Pagada</MudSelectItem>
        </MudSelect>
        <MudDatePicker Date="_filtroDesde"
                       DateChanged="@(async v => { _filtroDesde = v; await CargarFacturasAsync(); })"
                       Label="Desde" DateFormat="dd/MM/yyyy"
                       Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudDatePicker Date="_filtroHasta"
                       DateChanged="@(async v => { _filtroHasta = v; await CargarFacturasAsync(); })"
                       Label="Hasta" DateFormat="dd/MM/yyyy"
                       Variant="Variant.Outlined" Margin="Margin.Dense" />
    </div>
</MudPaper>

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorCarga</MudAlert>
}
@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_facturas.Count == 0)
{
    <MudAlert Severity="Severity.Info">No hay documentos que coincidan con los filtros.</MudAlert>
}
else
{
    <MudTable Items="_facturas" Hover="true" Dense="true" Striped="true"
              Style="overflow-x:auto">
        <HeaderContent>
            <MudTh>Tipo Doc</MudTh>
            <MudTh>Nro. Doc</MudTh>
            <MudTh>Fecha</MudTh>
            <MudTh>Cliente / NIT</MudTh>
            <MudTh>Centro de Costo</MudTh>
            <MudTh Style="text-align:right">Total</MudTh>
            <MudTh Style="text-align:right">Pagado</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Inventario</MudTh>
            <MudTh>Visions</MudTh>
            <MudTh>Accion</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tipo Doc">
                <MudChip T="string" Size="Size.Small" Color="@ColorTipDoc(context.TipDoc)">
                    @context.TipDoc
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Nro. Doc" Style="font-size:0.82rem">@(context.NroDoc ?? "-")</MudTd>
            <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Cliente">
                <div style="font-size:0.85rem; font-weight:500">@context.Cliente</div>
                @if (context.NitCliente is not null)
                {
                    <div style="font-size:0.72rem; opacity:.6">NIT @context.NitCliente</div>
                }
            </MudTd>
            <MudTd DataLabel="Centro de Costo" Style="font-size:0.82rem">@(context.CentroCostoNombre ?? "-")</MudTd>
            <MudTd DataLabel="Total" Style="text-align:right">@context.Total.ToString("C0")</MudTd>
            <MudTd DataLabel="Pagado" Style="text-align:right">@context.TotalPagado.ToString("C0")</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Size="Size.Small" Color="@ColorEstado(context.Estado)">@EtiquetaEstado(context.Estado)</MudChip>
            </MudTd>
            <MudTd DataLabel="Inventario">
                @if (context.StockDescontado)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Title="Stock descontado" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Default" Size="Size.Small" Title="Stock pendiente" />
                }
            </MudTd>
            <MudTd DataLabel="Visions">
                @if (context.VisionsConfirmado)
                {
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Success" Size="Size.Small" Title="Confirmado en Visions" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Default" Size="Size.Small" Title="Pendiente / No aplica" />
                }
            </MudTd>
            <MudTd DataLabel="Accion">
                <MudButton Size="Size.Small" OnClick="@(() => AbrirGestionAsync(context))">Gestionar</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<FacturaItem> _facturas = new();
    private List<ClienteItem> _clientes = new();
    private List<ArticuloItem> _articulos = new();
    private List<ComboItem> _combosActivos = new();
    private List<CentroCostoBasicoItem> _centrosCosto = new();
    private bool _cargando = true;
    private string? _errorCarga;

    private string? _filtroTipDoc;
    private int? _filtroClienteId;
    private int? _filtroCentroCostoId;
    private string? _filtroEstado;
    private DateTime? _filtroDesde;
    private DateTime? _filtroHasta;

    private Color ColorTipDoc(string tipDoc) => tipDoc switch
    {
        "FACTURA" or "REMISION" => Color.Primary,
        "DEVOLUCION PROVEEDOR" or "NOTA DEVOLUCION" => Color.Warning,
        "NOTA DEBITO" => Color.Secondary,
        "ORDEN COMPRA" => Color.Info,
        "EGRESO" or "PERDIDA INVENTARIO" => Color.Error,
        _ => Color.Default
    };

    private Color ColorEstado(string estado) => estado switch
    {
        "PAGADA" => Color.Success,
        "PARCIAL" => Color.Warning,
        _ => Color.Error
    };

    private static string EtiquetaEstado(string estado) => estado switch
    {
        "PAGADA" => "Pagada",
        "PARCIAL" => "Pago parcial",
        _ => "Pendiente"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tareaClientes = ApiClient.GetAsync<List<ClienteItem>>("api/crm/clientes");
            var tareaArticulos = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos");
            var tareaFacturas = ApiClient.GetAsync<List<FacturaItem>>("api/facturacion/facturas");
            var tareaCombos = ApiClient.GetAsync<List<ComboItem>>("api/marketing/combos");
            var tareaCentros = ApiClient.GetAsync<List<CentroCostoItem>>("api/catalogo/centros-costo");

            await Task.WhenAll(tareaClientes, tareaArticulos, tareaFacturas, tareaCombos, tareaCentros);

            _clientes = (await tareaClientes ?? new()).Where(c => c.Estado).ToList();
            _articulos = (await tareaArticulos ?? new()).Where(a => a.Estado).ToList();
            _facturas = await tareaFacturas ?? new();
            _combosActivos = (await tareaCombos ?? new()).Where(c => c.Estado != "Inactivo").ToList();
            _centrosCosto = (await tareaCentros ?? new())
                .Where(c => c.Estado)
                .Select(c => new CentroCostoBasicoItem(c.CentroCostoID, c.Nombre))
                .ToList();
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarFacturasAsync()
    {
        try
        {
            var query = new List<string>();
            if (_filtroClienteId is not null) query.Add($"clienteId={_filtroClienteId}");
            if (_filtroCentroCostoId is not null) query.Add($"centroCostoId={_filtroCentroCostoId}");
            if (_filtroTipDoc is not null) query.Add($"tipDoc={Uri.EscapeDataString(_filtroTipDoc)}");
            if (_filtroEstado is not null) query.Add($"estado={_filtroEstado}");
            if (_filtroDesde is not null) query.Add($"desde={_filtroDesde.Value:yyyy-MM-dd}");
            if (_filtroHasta is not null) query.Add($"hasta={_filtroHasta.Value:yyyy-MM-dd}");

            var ruta = "api/facturacion/facturas" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
            _facturas = await ApiClient.GetAsync<List<FacturaItem>>(ruta) ?? new();
            _errorCarga = null;
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
    }

    private async Task OnFiltroTipDocAsync(string? v) { _filtroTipDoc = v; await CargarFacturasAsync(); }
    private async Task OnFiltroClienteAsync(int? v) { _filtroClienteId = v; await CargarFacturasAsync(); }
    private async Task OnFiltroCCAsync(int? v) { _filtroCentroCostoId = v; await CargarFacturasAsync(); }
    private async Task OnFiltroEstadoAsync(string? v) { _filtroEstado = v; await CargarFacturasAsync(); }

    private async Task AbrirCreacionAsync()
    {
        var parametros = new DialogParameters<FacturaDialog>
        {
            { x => x.Clientes, _clientes },
            { x => x.Articulos, _articulos },
            { x => x.CombosActivos, _combosActivos },
            { x => x.CentrosCosto, _centrosCosto }
        };

        var dialogo = await DialogService.ShowAsync<FacturaDialog>("Nueva Factura", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled) return;

        try
        {
            var request = (CrearFacturaRequest)resultado.Data!;
            await ApiClient.PostAsync<CrearFacturaRequest, object?>("api/facturacion/facturas", request);
            Snackbar.Add("Documento creado correctamente.", Severity.Success);
            await CargarFacturasAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AbrirGestionAsync(FacturaItem factura)
    {
        var parametros = new DialogParameters<GestionFacturaDialog> { { x => x.Factura, factura } };
        var dialogo = await DialogService.ShowAsync<GestionFacturaDialog>("Gestionar", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await dialogo.Result;
        await CargarFacturasAsync();
    }
}
