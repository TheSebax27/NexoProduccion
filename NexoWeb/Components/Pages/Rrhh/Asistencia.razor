@page "/rrhh/asistencia"
@using NexoWeb.Common.Dtos
@using NexoWeb.Common.ApiClient
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administracion,Jefes")]
@inject INexoApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>Asistencia — NEXO</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Control de Asistencia</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tv"
               Href="/rrhh/kiosco" Target="_blank">
        Abrir Kiosco
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Warning"
               StartIcon="@Icons.Material.Filled.EditNote"
               OnClick="AbrirManual">
        Registrar Manual
    </MudButton>
</MudStack>

@* Filtros *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="12" sm="4">
            <MudSelect T="int?" @bind-Value="_filtroEmpleadoId" Label="Empleado"
                       Clearable Placeholder="Todos">
                @foreach (var e in _empleados)
                {
                    <MudSelectItem T="int?" Value="@((int?)e.EmpleadoID)">
                        @e.Nombres @e.Apellidos
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudDatePicker @bind-Date="_desde" Label="Desde" DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudDatePicker @bind-Date="_hasta" Label="Hasta" DateFormat="dd/MM/yyyy" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth
                       StartIcon="@Icons.Material.Filled.Search" OnClick="Cargar">
                Buscar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_cargando)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
}

<MudTable Items="_registros" Dense Hover Bordered Loading="_cargando" LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>Empleado</MudTh>
        <MudTh>Fecha</MudTh>
        <MudTh>Entrada</MudTh>
        <MudTh>Método</MudTh>
        <MudTh>Salida</MudTh>
        <MudTh>Método</MudTh>
        <MudTh>Horas</MudTh>
        <MudTh>Tardanza</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Empleado">@context.Empleado</MudTd>
        <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy")</MudTd>

        <MudTd DataLabel="Entrada">
            @if (context.HoraEntrada is not null)
            {
                <MudText>@context.HoraEntrada.Value.ToString("HH:mm")</MudText>
                @if (context.EntradaNota is not null)
                {
                    <MudTooltip Text="@($"Nota: {context.EntradaNota}")">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Warning" />
                    </MudTooltip>
                }
            }
            else
            {
                <MudText Color="Color.Secondary">—</MudText>
            }
        </MudTd>

        <MudTd DataLabel="Método entrada">
            @ChipMetodo(context.MetodoEntrada, context.EntradaRegistradaPor)
        </MudTd>

        <MudTd DataLabel="Salida">
            @if (context.HoraSalida is not null)
            {
                <MudText>@context.HoraSalida.Value.ToString("HH:mm")</MudText>
                @if (context.SalidaNota is not null)
                {
                    <MudTooltip Text="@($"Nota: {context.SalidaNota}")">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Warning" />
                    </MudTooltip>
                }
            }
            else
            {
                <MudText Color="Color.Secondary">—</MudText>
            }
        </MudTd>

        <MudTd DataLabel="Método salida">
            @ChipMetodo(context.MetodoSalida, context.SalidaRegistradaPor)
        </MudTd>

        <MudTd DataLabel="Horas">
            @(context.HorasEfectivas.HasValue ? $"{context.HorasEfectivas:F1}h" : "—")
        </MudTd>

        <MudTd DataLabel="Tardanza">
            @if (context.MinutosTardanza.HasValue)
            {
                var min = context.MinutosTardanza.Value;
                var color = min == 0 ? Color.Success : min <= 15 ? Color.Warning : Color.Error;
                <MudChip T="string" Size="Size.Small" Color="@color">
                    @(min == 0 ? "A tiempo" : $"+{min} min")
                </MudChip>
            }
            else
            {
                <MudText Color="Color.Secondary">—</MudText>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">No hay registros para los filtros seleccionados.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    List<EmpleadoItem> _empleados = [];
    List<RegistroAsistenciaItem> _registros = [];
    bool _cargando;

    int? _filtroEmpleadoId;
    DateTime? _desde = DateTime.Today.AddDays(-6);
    DateTime? _hasta = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        _empleados = await Api.GetAsync<List<EmpleadoItem>>("api/rrhh/empleados") ?? [];
        await Cargar();
    }

    async Task Cargar()
    {
        _cargando = true;
        try
        {
            var desde = _desde.HasValue ? $"desde={_desde.Value:yyyy-MM-dd}&" : "";
            var hasta = _hasta.HasValue ? $"hasta={_hasta.Value:yyyy-MM-dd}&" : "";
            var emp   = _filtroEmpleadoId.HasValue ? $"empleadoId={_filtroEmpleadoId}&" : "";
            _registros = await Api.GetAsync<List<RegistroAsistenciaItem>>(
                $"api/rrhh/asistencia/lista?{emp}{desde}{hasta}") ?? [];
        }
        finally { _cargando = false; }
    }

    async Task AbrirManual()
    {
        var params_ = new DialogParameters<RegistrarManualAsistenciaDialog>
        {
            { x => x.Empleados, _empleados }
        };
        var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialogo = await Dialog.ShowAsync<RegistrarManualAsistenciaDialog>(
            "Registro Manual de Asistencia", params_, opts);
        var resultado = await dialogo.Result;
        if (resultado is { Canceled: false, Data: MarcarManualRequest req })
        {
            try
            {
                await Api.PostAsync<MarcarManualRequest, object?>(
                    "api/rrhh/asistencia/marcar/manual", req);
                Snackbar.Add($"Registro manual de {req.Tipo} guardado.", Severity.Warning);
                await Cargar();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    RenderFragment ChipMetodo(string? metodo, string? registradoPor) => __builder =>
    {
        if (metodo is null) { __builder.AddMarkupContent(0, "<span style='color:var(--mud-palette-text-secondary)'>—</span>"); return; }
        var esManual = metodo == "MANUAL";
        var label    = esManual ? "✎ MANUAL" : "QR";
        var color    = esManual ? "var(--mud-palette-warning)" : "var(--mud-palette-success)";
        var tooltip  = esManual && registradoPor is not null ? $" title=\"Registrado por: {registradoPor}\"" : "";
        __builder.AddMarkupContent(0,
            $"<span style='font-size:.75rem;font-weight:600;color:{color};border:1px solid {color};border-radius:12px;padding:2px 8px'{tooltip}>{label}</span>");
    };
}
