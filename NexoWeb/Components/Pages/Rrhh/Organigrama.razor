@page "/rrhh/organigrama"
@attribute [Authorize]
@inject INexoApiClient ApiClient
@using NexoWeb.Common.Dtos

<PageTitle>Organigrama - NEXO</PageTitle>

<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">Recursos Humanos</p>
            <h1 class="nexo-page-hero__title">Organigrama</h1>
        </div>
    </div>
    <BotonFavorito Href="/rrhh/organigrama" Etiqueta="Organigrama" />
</div>

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default); border-radius:8px">
    <div style="display:flex; align-items:center; gap:8px">
        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Secondary" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Jerarquia basada en el campo "Jefe Directo" de cada empleado. Se edita desde Empleados.
        </MudText>
    </div>
</MudPaper>

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudo cargar el organigrama: @_errorCarga</MudAlert>
}
@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_nodos.Count == 0)
{
    <MudText>No hay empleados activos.</MudText>
}
else
{
    @foreach (var raiz in _nodos.Where(n => n.JefeDirectoID is null || !_nodos.Any(p => p.EmpleadoID == n.JefeDirectoID)))
    {
        <OrganigramaRama Nodo="raiz" Todos="_nodos" Nivel="0" />
    }
}

@code {
    private List<OrganigramaNodo> _nodos = new();
    private bool _cargando = true;
    private string? _errorCarga;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _nodos = await ApiClient.GetAsync<List<OrganigramaNodo>>("api/rrhh/empleados/organigrama") ?? new();
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }
}
