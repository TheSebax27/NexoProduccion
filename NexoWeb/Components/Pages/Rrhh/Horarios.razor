@page "/rrhh/horarios"
@using NexoWeb.Common.Dtos
@using NexoWeb.Common.ApiClient
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject INexoApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>Horarios — NEXO</PageTitle>

<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">Recursos Humanos</p>
            <h1 class="nexo-page-hero__title">Horarios de Trabajo</h1>
        </div>
    </div>
    <AuthorizeView Roles="Administracion" Context="authHero">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirNuevoHorario">
            Nuevo Horario
        </MudButton>
    </AuthorizeView>
</div>

@* ── Lista de horarios ── *@
<MudPaper Class="pa-4 mb-6" Elevation="1">
    <div class="nexo-chart-header mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="nexo-chart-header__icon" />
        <div>
            <div class="nexo-chart-header__title">Horarios definidos</div>
            <div class="nexo-chart-header__sub">Cada negocio puede tener varios horarios (turnos manana, tarde, etc.)</div>
        </div>
    </div>

    @if (_cargando)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
    else if (_horarios.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No hay horarios creados aun.</MudAlert>
    }
    else
    {
        <MudTable Items="_horarios" Dense Hover Bordered>
            <HeaderContent>
                <MudTh>Nombre</MudTh>
                <MudTh>Ciclo</MudTh>
                <MudTh>Marcaje</MudTh>
                <MudTh>Tolerancia</MudTh>
                <MudTh>Dias configurados</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nombre"><strong>@context.Nombre</strong></MudTd>
                <MudTd DataLabel="Ciclo">
                    <MudChip T="string" Size="Size.Small" Color="@(context.TipoCiclo == "FIJO" ? Color.Default : Color.Secondary)">
                        @(context.TipoCiclo switch { "SEMANA_AB" => "A/B", "SEMANA_4" => "A/B/C/D", _ => "Fijo" })
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Marcaje">
                    <MudChip T="string" Size="Size.Small"
                             Color="@(context.RegistraSalida ? Color.Info : Color.Default)"
                             Icon="@(context.RegistraSalida ? Icons.Material.Filled.SwapHoriz : Icons.Material.Filled.Login)">
                        @(context.RegistraSalida ? "Entrada y salida" : "Solo entrada")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Tolerancia">@context.ToleranciaTardanzaMin min</MudTd>
                <MudTd DataLabel="Dias">@ResumenDias(context)</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small"
                             Color="@(context.Activo ? Color.Success : Color.Default)">
                        @(context.Activo ? "Activo" : "Inactivo")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <div class="d-flex" style="gap:4px;">
                        <MudTooltip Text="Ver detalle">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Size="Size.Small" Color="Color.Info"
                                           OnClick="@(() => VerHorarioAsync(context))" />
                        </MudTooltip>
                        <AuthorizeView Roles="Administracion" Context="auth">
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => EditarHorarioAsync(context))" />
                            </MudTooltip>
                            <MudTooltip Text="@(context.Activo ? "Desactivar" : "Activar")">
                                <MudIconButton Icon="@(context.Activo ? Icons.Material.Filled.ToggleOff : Icons.Material.Filled.ToggleOn)"
                                               Size="Size.Small"
                                               Color="@(context.Activo ? Color.Default : Color.Success)"
                                               OnClick="@(() => ToggleActivoAsync(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => EliminarAsync(context))" />
                            </MudTooltip>
                        </AuthorizeView>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@* ── Asignar horario a empleado (solo admin) ── *@
<AuthorizeView Roles="Administracion" Context="authAsig">
    <MudPaper Class="pa-4" Elevation="1">
        <div class="nexo-chart-header mb-3">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" Class="nexo-chart-header__icon" />
            <div>
                <div class="nexo-chart-header__title">Asignar horario a empleado</div>
                <div class="nexo-chart-header__sub">Solo empleados sin horario activo. Cada empleado puede tener un unico horario vigente.</div>
            </div>
        </div>

        <MudGrid Spacing="2" AlignItems="AlignItems.End">
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" @bind-Value="_asigEmpleadoId" Label="Empleado"
                           Placeholder="Selecciona el empleado">
                    @foreach (var e in _empleadosSinHorario)
                    {
                        <MudSelectItem T="int?" Value="@((int?)e.EmpleadoID)">
                            @e.Nombres @e.Apellidos
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="int?" @bind-Value="_asigHorarioId" Label="Horario"
                           Placeholder="Selecciona el horario">
                    @foreach (var h in _horarios.Where(x => x.Activo))
                    {
                        <MudSelectItem T="int?" Value="@((int?)h.HorarioID)">
                            @h.Nombre
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="_asigDesde" Label="Vigente desde"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth
                           Disabled="@(!AsignacionValida || _asignando)"
                           OnClick="AsignarHorarioAsync">
                    @(_asignando ? "Guardando..." : "Asignar")
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
</AuthorizeView>

@code {
    List<HorarioItem> _horarios = [];
    List<EmpleadoSimpleItem> _empleadosSinHorario = [];
    bool _cargando;

    int? _asigEmpleadoId;
    int? _asigHorarioId;
    DateTime? _asigDesde = DateTime.Today;
    bool _asignando;

    bool AsignacionValida =>
        _asigEmpleadoId.HasValue && _asigHorarioId.HasValue && _asigDesde.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var tHorarios  = Api.GetAsync<List<HorarioItem>>("api/rrhh/asistencia/horarios");
            var tEmpleados = Api.GetAsync<List<EmpleadoSimpleItem>>("api/rrhh/asistencia/empleados-sin-horario");
            await Task.WhenAll(tHorarios, tEmpleados);
            _horarios            = tHorarios.Result  ?? [];
            _empleadosSinHorario = tEmpleados.Result ?? [];
        }
        finally { _cargando = false; }
    }

    async Task AbrirNuevoHorario()
    {
        var opts = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialogo = await Dialog.ShowAsync<NuevoHorarioDialog>("Nuevo Horario", opts);
        var resultado = await dialogo.Result;
        if (resultado is { Canceled: false, Data: CrearHorarioRequest req })
        {
            try
            {
                await Api.PostAsync<CrearHorarioRequest>("api/rrhh/asistencia/horarios", req);
                _horarios = await Api.GetAsync<List<HorarioItem>>("api/rrhh/asistencia/horarios") ?? [];
                Snackbar.Add($"Horario '{req.Nombre}' creado.", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    async Task EditarHorarioAsync(HorarioItem horario)
    {
        var opts = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var parametros = new DialogParameters<EditarHorarioDialog>
        {
            { x => x.Horario, horario }
        };
        var dialogo = await Dialog.ShowAsync<EditarHorarioDialog>("Editar Horario", parametros, opts);
        var resultado = await dialogo.Result;
        if (resultado is { Canceled: false, Data: CrearHorarioRequest req })
        {
            try
            {
                await Api.PutAsync($"api/rrhh/asistencia/horarios/{horario.HorarioID}", req);
                _horarios = await Api.GetAsync<List<HorarioItem>>("api/rrhh/asistencia/horarios") ?? [];
                Snackbar.Add($"Horario '{horario.Nombre}' actualizado.", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    async Task VerHorarioAsync(HorarioItem horario)
    {
        var opts = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parametros = new DialogParameters<VerHorarioDialog>
        {
            { x => x.Horario, horario }
        };
        await Dialog.ShowAsync<VerHorarioDialog>(horario.Nombre, parametros, opts);
    }

    async Task AsignarHorarioAsync()
    {
        if (!AsignacionValida) return;
        _asignando = true;
        try
        {
            await Api.PostAsync<AsignarHorarioEmpleadoRequest>(
                $"api/rrhh/asistencia/empleados/{_asigEmpleadoId}/horario",
                new AsignarHorarioEmpleadoRequest(_asigHorarioId!.Value, _asigDesde!.Value));

            var horarioNombre = _horarios.FirstOrDefault(h => h.HorarioID == _asigHorarioId)?.Nombre ?? "";
            var emp = _empleadosSinHorario.FirstOrDefault(e => e.EmpleadoID == _asigEmpleadoId.Value);
            var empleadoNombre = emp is not null ? $"{emp.Nombres} {emp.Apellidos}" : "";
            Snackbar.Add($"Horario '{horarioNombre}' asignado a {empleadoNombre} desde {_asigDesde!.Value:dd/MM/yyyy}.", Severity.Success);
            _asigEmpleadoId = null;
            _asigHorarioId = null;
            _asigDesde = DateTime.Today;
            // Recargar empleados sin horario (el asignado ya no debe aparecer)
            _empleadosSinHorario = await Api.GetAsync<List<EmpleadoSimpleItem>>("api/rrhh/asistencia/empleados-sin-horario") ?? [];
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _asignando = false; }
    }

    async Task ToggleActivoAsync(HorarioItem horario)
    {
        try
        {
            await Api.PatchAsync($"api/rrhh/asistencia/horarios/{horario.HorarioID}/toggle-activo");
            _horarios = await Api.GetAsync<List<HorarioItem>>("api/rrhh/asistencia/horarios") ?? [];
            Snackbar.Add($"Horario '{horario.Nombre}' {(horario.Activo ? "desactivado" : "activado")}.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    async Task EliminarAsync(HorarioItem horario)
    {
        var confirm = await Dialog.ShowMessageBox(
            "Confirmar eliminacion",
            $"Eliminar el horario '{horario.Nombre}'? Esta accion no se puede deshacer.",
            yesText: "Eliminar", cancelText: "Cancelar");
        if (confirm != true) return;

        try
        {
            await Api.DeleteAsync($"api/rrhh/asistencia/horarios/{horario.HorarioID}");
            _horarios = await Api.GetAsync<List<HorarioItem>>("api/rrhh/asistencia/horarios") ?? [];
            Snackbar.Add($"Horario '{horario.Nombre}' eliminado.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    static string ResumenDias(HorarioItem h)
    {
        if (h.Dias.Count == 0) return "—";
        var n = new[] { "", "Lun", "Mar", "Mie", "Jue", "Vie", "Sab", "Dom" };
        if (h.TipoCiclo == "FIJO")
            return string.Join(", ", h.Dias.Select(d => n[d.DiaSemana]));
        var semanas = h.Dias.Select(d => d.Semana).Distinct().OrderBy(s => s).ToList();
        return string.Join(" / ", semanas.Select(s =>
            $"{s}: {string.Join(",", h.Dias.Where(d => d.Semana == s).Select(d => n[d.DiaSemana]))}"));
    }
}
