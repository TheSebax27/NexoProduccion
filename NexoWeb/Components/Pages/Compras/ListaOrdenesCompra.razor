@page "/compras/ordenes"
@attribute [Authorize(Roles = "Administrador,Bodeguero")]
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NexoWeb.Common.Dtos

<PageTitle>Ordenes de Compra - NEXO</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Ordenes de Compra</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => AbrirCreacionAsync(null))"
           StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
    Nueva Orden de Compra
</MudButton>

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar las ordenes de compra: @_errorCarga</MudAlert>
}
@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else if (_errorCarga is null)
{
    <MudTable Items="_ordenes" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>Codigo</MudTh>
            <MudTh>Proveedor</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Emision</MudTh>
            <MudTh>Total</MudTh>
            <MudTh>Detalle</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Codigo">@context.Codigo</MudTd>
            <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="@(context.EstadoOC == "RECIBIDA" ? Color.Success : Color.Warning)" Size="Size.Small">
                    @context.EstadoOC
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Emision">@context.FechaEmision.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Total">@context.Total.ToString("C0")</MudTd>
            <MudTd DataLabel="Detalle">
                <MudButton Size="Size.Small" OnClick="@(() => VerDetalleAsync(context.OrdenCompraID))">
                    Ver / Recibir
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@if (_detalleAbierto is not null)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Detalle de la orden</MudText>
        <MudTable Items="_detalle" Dense="true">
            <HeaderContent>
                <MudTh>Articulo</MudTh>
                <MudTh>Solicitado</MudTh>
                <MudTh>Recibido</MudTh>
                <MudTh>Costo Unit.</MudTh>
                <MudTh>Accion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Articulo">@context.Articulo</MudTd>
                <MudTd DataLabel="Solicitado">@context.CantidadSolicitada.ToString("N2")</MudTd>
                <MudTd DataLabel="Recibido">@context.CantidadRecibida.ToString("N2")</MudTd>
                <MudTd DataLabel="Costo Unit.">@context.CostoUnitario.ToString("C2")</MudTd>
                <MudTd DataLabel="Accion">
                    @if (context.CantidadRecibida < context.CantidadSolicitada)
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => AbrirRecepcionAsync(context))">
                            Recibir
                        </MudButton>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Completo</MudChip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<OrdenCompraResumen> _ordenes = new();
    private List<OrdenCompraDetalleItem> _detalle = new();
    private List<ProveedorItem> _proveedores = new();
    private List<BodegaItem> _bodegas = new();
    private List<ArticuloItem> _articulos = new();
    private int? _detalleAbierto;
    private bool _cargando = true;
    private string? _errorCarga;

    // Llegada desde Consulta de Stock (chip "Requiere pedido"): abre el
    // dialogo de creacion automaticamente con el articulo ya cargado.
    [SupplyParameterFromQuery] private int? ArticuloId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();

        if (ArticuloId.HasValue)
            await AbrirCreacionAsync(ArticuloId.Value);
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _errorCarga = null;

        try
        {
            _ordenes = await ApiClient.GetAsync<List<OrdenCompraResumen>>("api/compras/ordenes") ?? new();
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task VerDetalleAsync(int ordenCompraId)
    {
        _detalleAbierto = ordenCompraId;
        _detalle = await ApiClient.GetAsync<List<OrdenCompraDetalleItem>>($"api/compras/ordenes/{ordenCompraId}/detalle") ?? new();
    }

    private async Task AbrirCreacionAsync(int? articuloPreseleccionado = null)
    {
        // Se cargan los catalogos SOLO cuando el usuario realmente va a crear
        // una orden -- no en cada carga de la pagina, para no pedir datos
        // que quiza nunca se usen en esa visita.
        if (_proveedores.Count == 0)
        {
            var tareaProveedores = ApiClient.GetAsync<List<ProveedorItem>>("api/catalogo/proveedores");
            var tareaBodegas = ApiClient.GetAsync<List<BodegaItem>>("api/catalogo/bodegas");
            // Se compran Materia Prima, Insumos y Servicios (lo que llega de proveedores,
            // ej. claves de licencia). Producto Terminado no se compra (se produce).
            var tareaArticulos = ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos");

            await Task.WhenAll(tareaProveedores, tareaBodegas, tareaArticulos);

            _proveedores = await tareaProveedores ?? new();
            _bodegas = await tareaBodegas ?? new();
            _articulos = (await tareaArticulos ?? new())
                .Where(a => a.TipoArticulo is "Materia Prima" or "Insumo" or "Servicio")
                .ToList();
        }

        var parametros = new DialogParameters<CrearOrdenCompraDialog>
        {
            { x => x._proveedores, _proveedores },
            { x => x._bodegas, _bodegas },
            { x => x._articulos, _articulos },
            { x => x.ArticuloPreseleccionadoID, articuloPreseleccionado }
        };

        var dialogo = await DialogService.ShowAsync<CrearOrdenCompraDialog>("Nueva Orden de Compra", parametros);
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled)
            return;

        try
        {
            var request = (CrearOrdenCompraRequest)resultado.Data!;
            await ApiClient.PostAsync<CrearOrdenCompraRequest, object?>("api/compras/ordenes", request);
            Snackbar.Add("Orden de compra creada correctamente.", Severity.Success);
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AbrirRecepcionAsync(OrdenCompraDetalleItem linea)
    {
        var pendiente = linea.CantidadSolicitada - linea.CantidadRecibida;

        var parametros = new DialogParameters<RecibirLineaDialog>
        {
            { x => x.Articulo, linea.Articulo },
            { x => x.Pendiente, pendiente },
            { x => x.Unidad, linea.Unidad },
            { x => x.UnidadesPorEmbalaje, linea.UnidadesPorEmbalaje }
        };

        var dialogo = await DialogService.ShowAsync<RecibirLineaDialog>("Recibir Mercancia", parametros);
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled)
            return;

        try
        {
            var request = (RecibirLineaOrdenCompraRequest)resultado.Data!;
            await ApiClient.PostAsync<RecibirLineaOrdenCompraRequest, object?>(
                $"api/compras/ordenes/detalle/{linea.OrdenCompraDetalleID}/recibir", request);

            Snackbar.Add("Mercancia recibida correctamente.", Severity.Success);
            await VerDetalleAsync(_detalleAbierto!.Value); // recarga el detalle para reflejar la cantidad nueva
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}