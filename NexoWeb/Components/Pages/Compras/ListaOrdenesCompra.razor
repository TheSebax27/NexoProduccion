@page "/compras/ordenes"
@attribute [Authorize]
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NexoWeb.Common.Auth.PreferenciasState Preferencias
@using NexoWeb.Common.Dtos

<PageTitle>Entradas - NEXO</PageTitle>

<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">Operaciones</p>
            <h1 class="nexo-page-hero__title">Entradas</h1>
        </div>
    </div>
    <div class="d-flex align-center" style="gap:8px">
        <VistaToggle OnCambio="StateHasChanged" />
        <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="AbrirOCSugeridaAsync"
                   Disabled="_cargandoSugerencia">
            @(_cargandoSugerencia ? "Calculando…" : "OC Sugerida")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AbrirCreacionAsync(null))">
            Nuevo Pedido
        </MudButton>
    </div>
</div>

<InfoAyuda Texto="Registra pedidos a proveedores. Puedes recibirlos en varias entregas parciales desde 'Ver / Recibir'. Al crearse, el pedido se exporta automáticamente a Visions para su procesamiento como Entrada de Mercancía." />

@if (_errorCarga is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar los pedidos: @_errorCarga</MudAlert>
}

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
         Class="nexo-bi-tabs mb-2"
         ActivePanelIndexChanged="OnTabCambiado">

    @* ════ Tab 1: Pendientes ════ *@
    <MudTabPanel Text="Pendientes" Icon="@Icons.Material.Filled.Schedule">
        @if (_cargando)
        { <MudProgressLinear Indeterminate="true" Class="mt-2" /> }
        @if (_enVisions.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mt-2 mb-1">
                Los siguientes pedidos están en proceso en VISIONS. Se recibirán automáticamente en NEXO cuando VISIONS los confirme.
            </MudAlert>
            <MudTable Items="_enVisions" Hover="true" Dense="true" Striped="true" Class="mb-3">
                <HeaderContent>
                    <MudTh>Código</MudTh>
                    <MudTh>Proveedor</MudTh>
                    <MudTh>Emisión</MudTh>
                    <MudTh Style="text-align:right">Total</MudTh>
                    <MudTh>Detalle</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Código">@context.Codigo</MudTd>
                    <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
                    <MudTd DataLabel="Emisión">@context.FechaEmision.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Total" Style="text-align:right">@context.Total.ToString("C0")</MudTd>
                    <MudTd DataLabel="Detalle">
                        <MudButton Size="Size.Small" OnClick="@(() => VerDetalleAsync(context.OrdenCompraID))">Ver</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        @if (!_pendientes.Any() && !_enVisions.Any())
        { <MudAlert Severity="Severity.Success" Class="mt-2">No hay pedidos pendientes de recibir.</MudAlert> }
        else if (_pendientes.Any())
        {
            <MudTable Items="_pendientes" Hover="true" Dense="true" Striped="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>Código</MudTh>
                    <MudTh>Proveedor</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Emisión</MudTh>
                    <MudTh Style="text-align:right">Total</MudTh>
                    <MudTh>Detalle</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Código">@context.Codigo</MudTd>
                    <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
                    <MudTd DataLabel="Estado">
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">@context.EstadoOC</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Emisión">@context.FechaEmision.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Total" Style="text-align:right">@context.Total.ToString("C0")</MudTd>
                    <MudTd DataLabel="Detalle">
                        <div class="d-flex" style="gap:4px">
                            <MudButton Size="Size.Small" OnClick="@(() => VerDetalleAsync(context.OrdenCompraID))">
                                Ver / Recibir
                            </MudButton>
                            @if (!context.ExportadoVisions)
                            {
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error" Title="Eliminar pedido"
                                               OnClick="@(() => EliminarOrdenAsync(context))" />
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    @* ════ Tab 2: Comparación de Precios ════ *@
    <MudTabPanel Text="Comparación" Icon="@Icons.Material.Filled.BarChart">
        @if (_cmpCargando)
        { <MudProgressLinear Indeterminate="true" Class="mt-2" /> }
        else
        {
            @* Filtros *@
            <div class="d-flex flex-wrap gap-2 mt-2 mb-3">
                <AppSelect TValue="int?" Value="_cmpFiltroArticulo"
                           ValueChanged="@((int? v) => { _cmpFiltroArticulo = v; StateHasChanged(); })"
                           Label="Filtrar por artículo" Style="width:100%"
                           Items="@(_cmpArticulos.Select(art => new AppSelectItem<int?>(art.Value, (int?)art.Key)))" />
                <AppSelect TValue="int?" Value="_cmpFiltroProveedor"
                           ValueChanged="@((int? v) => { _cmpFiltroProveedor = v; StateHasChanged(); })"
                           Label="Filtrar por proveedor" Style="width:100%"
                           Items="@(_cmpProveedores.Select(prov => new AppSelectItem<int?>(prov.Value, (int?)prov.Key)))" />
            </div>

            @if (!_cmpDatos.Any())
            {
                <MudAlert Severity="Severity.Info">Sin datos de compra para comparar con los filtros actuales.</MudAlert>
            }
            else
            {
                @* Agrupamos por artículo para mostrar comparación entre proveedores *@
                @foreach (var grupo in _cmpDatos.GroupBy(r => r.ArticuloID))
                {
                    var filas = grupo.ToList();
                    var precioMenor = filas.Min(f => f.PrecioPromedio);

                    <MudPaper Class="pa-3 mb-3" Elevation="1">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.subtitle1"><strong>@filas[0].Articulo</strong></MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@filas[0].SKU</MudChip>
                        </div>
                        <MudTable Items="@filas" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Proveedor</MudTh>
                                <MudTh Style="text-align:right">Pedidos</MudTh>
                                <MudTh Style="text-align:right">Precio Mín.</MudTh>
                                <MudTh Style="text-align:right">Precio Prom.</MudTh>
                                <MudTh Style="text-align:right">Precio Máx.</MudTh>
                                <MudTh Style="text-align:right">Último</MudTh>
                                <MudTh Style="text-align:right">Variación</MudTh>
                                <MudTh>Últ. compra</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @{
                                    var esMasBarato = context.PrecioPromedio == precioMenor;
                                    var variacion = precioMenor > 0
                                        ? (context.PrecioPromedio - precioMenor) / precioMenor * 100m
                                        : 0m;
                                }
                                <MudTd DataLabel="Proveedor">
                                    @if (esMasBarato)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Success"
                                                 Size="Size.Small" Class="mr-1" Style="vertical-align:middle" />
                                    }
                                    @context.Proveedor
                                </MudTd>
                                <MudTd DataLabel="Pedidos" Style="text-align:right">@context.TotalPedidos</MudTd>
                                <MudTd DataLabel="Precio Mín." Style="text-align:right">@context.PrecioMin.ToString("C2")</MudTd>
                                <MudTd DataLabel="Precio Prom." Style="@($"text-align:right;font-weight:{(esMasBarato ? "700" : "400")};color:{(esMasBarato ? "var(--mud-palette-success)" : "inherit")}")">
                                    @context.PrecioPromedio.ToString("C2")
                                </MudTd>
                                <MudTd DataLabel="Precio Máx." Style="text-align:right">@context.PrecioMax.ToString("C2")</MudTd>
                                <MudTd DataLabel="Último" Style="text-align:right">@context.UltimoPrecio.ToString("C2")</MudTd>
                                <MudTd DataLabel="Variación" Style="text-align:right">
                                    @if (variacion == 0)
                                    { <MudChip T="string" Size="Size.Small" Color="Color.Success" Style="pointer-events:none">Más barato</MudChip> }
                                    else
                                    { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Style="pointer-events:none">+@variacion.ToString("N1")%</MudChip> }
                                </MudTd>
                                <MudTd DataLabel="Últ. compra">@context.UltimaCompra.ToString("dd/MM/yyyy")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }
            }
        }
    </MudTabPanel>

    @* ════ Tab 3: Historial ════ *@
    <MudTabPanel Text="Historial" Icon="@Icons.Material.Filled.History">
        @if (_cargando)
        { <MudProgressLinear Indeterminate="true" Class="mt-2" /> }
        else if (_ordenes.Count == 0)
        { <MudAlert Severity="Severity.Info" Class="mt-2">No hay pedidos registrados.</MudAlert> }
        else if (Preferencias.VistaListado == "tarjetas")
        {
            <div class="nexo-card-grid mt-2">
                @foreach (var orden in _ordenes)
                {
                    <div class="nexo-item-card">
                        <div class="d-flex align-center justify-space-between">
                            <div class="nexo-item-card__title">@orden.Codigo</div>
                            <MudChip T="string" Color="@(orden.EstadoOC == "RECIBIDA" ? Color.Success : Color.Warning)" Size="Size.Small">
                                @orden.EstadoOC
                            </MudChip>
                        </div>
                        <div class="nexo-item-card__sub">@orden.Proveedor</div>
                        <div class="nexo-item-card__row"><span>Emisión</span><strong>@orden.FechaEmision.ToString("dd/MM/yyyy")</strong></div>
                        <div class="nexo-item-card__row"><span>Recibido</span><strong>@(orden.FechaRecepcion?.ToString("dd/MM/yyyy") ?? "-")</strong></div>
                        <div class="nexo-item-card__row"><span>Total</span><strong>@orden.Total.ToString("C0")</strong></div>
                        <div class="nexo-item-card__actions">
                            <MudButton Size="Size.Small" OnClick="@(() => VerDetalleAsync(orden.OrdenCompraID))">Ver / Recibir</MudButton>
                            @if (orden.EstadoOC != "RECIBIDA")
                            {
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error" Title="Eliminar pedido"
                                               OnClick="@(() => EliminarOrdenAsync(orden))" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <MudTable Items="_ordenes" Hover="true" Dense="true" Striped="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>Código</MudTh>
                    <MudTh>Proveedor</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Emisión</MudTh>
                    <MudTh>Recepción</MudTh>
                    <MudTh Style="text-align:right">Total</MudTh>
                    <MudTh>Detalle</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Código">@context.Codigo</MudTd>
                    <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
                    <MudTd DataLabel="Estado">
                        <MudChip T="string" Color="@(context.EstadoOC == "RECIBIDA" ? Color.Success : Color.Warning)" Size="Size.Small">
                            @context.EstadoOC
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Emisión">@context.FechaEmision.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Recepción">@(context.FechaRecepcion?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                    <MudTd DataLabel="Total" Style="text-align:right">@context.Total.ToString("C0")</MudTd>
                    <MudTd DataLabel="Detalle">
                        <div class="d-flex" style="gap:4px">
                            <MudButton Size="Size.Small" OnClick="@(() => VerDetalleAsync(context.OrdenCompraID))">
                                Ver / Recibir
                            </MudButton>
                            @if (context.EstadoOC != "RECIBIDA")
                            {
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error" Title="Eliminar pedido"
                                               OnClick="@(() => EliminarOrdenAsync(context))" />
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>
</MudTabs>

@if (_detalleAbierto is not null)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Detalle del pedido</MudText>
        @{ var _ordenDetalle = _ordenes.FirstOrDefault(o => o.OrdenCompraID == _detalleAbierto); }
        @if (_ordenDetalle?.NroDocVisions is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                Procesado en VISIONS — <strong>@_ordenDetalle.TipDocVisions @_ordenDetalle.NroDocVisions</strong>
            </MudAlert>
        }
        <MudTable Items="_detalle" Dense="true">
            <HeaderContent>
                <MudTh>Artículo</MudTh>
                <MudTh Style="text-align:right">Solicitado</MudTh>
                <MudTh Style="text-align:right">Recibido</MudTh>
                <MudTh>Fecha Recibido</MudTh>
                <MudTh Style="text-align:right">Costo Unit.</MudTh>
                <MudTh>Acción</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Artículo">@context.Articulo</MudTd>
                <MudTd DataLabel="Solicitado" Style="text-align:right">@context.CantidadSolicitada.ToString("N2")</MudTd>
                <MudTd DataLabel="Recibido" Style="text-align:right">@context.CantidadRecibida.ToString("N2")</MudTd>
                <MudTd DataLabel="Fecha Recibido">@(context.FechaUltimaRecepcion?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                <MudTd DataLabel="Costo Unit." Style="text-align:right">@context.CostoUnitario.ToString("C2")</MudTd>
                <MudTd DataLabel="Acción">
                    @if (context.CantidadRecibida >= context.CantidadSolicitada)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Completo</MudChip>
                    }
                    else if (!_ordenDetalleEsVisions)
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => AbrirRecepcionAsync(context))">
                            Recibir
                        </MudButton>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">En VISIONS</MudChip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<OrdenCompraResumen> _ordenes = new();
    private IEnumerable<OrdenCompraResumen> _pendientes   => _ordenes.Where(o => o.EstadoOC != "RECIBIDA" && !o.ExportadoVisions);
    private IEnumerable<OrdenCompraResumen> _enVisions    => _ordenes.Where(o => o.EstadoOC != "RECIBIDA" && o.ExportadoVisions);
    private bool _ordenDetalleEsVisions => _ordenes.FirstOrDefault(o => o.OrdenCompraID == _detalleAbierto)?.ExportadoVisions ?? false;
    private List<OrdenCompraDetalleItem> _detalle = new();
    private List<ProveedorItem> _proveedores = new();
    private List<BodegaItem> _bodegas = new();
    private List<CentroCostoItem> _centrosCosto = new();
    private int? _detalleAbierto;
    private bool _cargando = true;
    private bool _cargandoSugerencia;
    private string? _errorCarga;

    // ── Tab Comparación ──
    private List<ComparacionPrecioRow> _cmpTodos = new();
    private IEnumerable<ComparacionPrecioRow> _cmpDatos =>
        _cmpTodos.Where(r =>
            (_cmpFiltroArticulo is null || r.ArticuloID == _cmpFiltroArticulo) &&
            (_cmpFiltroProveedor is null || r.ProveedorID == _cmpFiltroProveedor));
    private Dictionary<int, string> _cmpArticulos = new();
    private Dictionary<int, string> _cmpProveedores = new();
    private int? _cmpFiltroArticulo;
    private int? _cmpFiltroProveedor;
    private bool _cmpCargando;
    private bool _cmpCargado;

    [SupplyParameterFromQuery] private int? ArticuloId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();

        if (ArticuloId.HasValue)
            await AbrirCreacionAsync(ArticuloId.Value);
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _errorCarga = null;

        try
        {
            _ordenes = await ApiClient.GetAsync<List<OrdenCompraResumen>>("api/compras/ordenes") ?? new();
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task VerDetalleAsync(int ordenCompraId)
    {
        _detalleAbierto = ordenCompraId;
        _detalle = await ApiClient.GetAsync<List<OrdenCompraDetalleItem>>($"api/compras/ordenes/{ordenCompraId}/detalle") ?? new();
    }

    private async Task AbrirCreacionAsync(int? articuloPreseleccionado = null)
    {
        if (_proveedores.Count == 0)
        {
            var tareaProveedores = ApiClient.GetAsync<List<ProveedorItem>>("api/catalogo/proveedores");
            var tareaBodegas = ApiClient.GetAsync<List<BodegaItem>>("api/catalogo/bodegas");
            var tareaCentrosCosto = ApiClient.GetAsync<List<CentroCostoItem>>("api/catalogo/centros-costo");

            await Task.WhenAll(tareaProveedores, tareaBodegas, tareaCentrosCosto);

            _proveedores = await tareaProveedores ?? new();
            _bodegas = await tareaBodegas ?? new();
            _centrosCosto = await tareaCentrosCosto ?? new();
        }

        var parametros = new DialogParameters<CrearOrdenCompraDialog>
        {
            { x => x._proveedores, _proveedores },
            { x => x._bodegas, _bodegas },
            { x => x._centrosCosto, _centrosCosto },
            { x => x.ArticuloPreseleccionadoID, articuloPreseleccionado }
        };

        var dialogo = await DialogService.ShowAsync<CrearOrdenCompraDialog>("Nuevo Pedido", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled)
            return;

        try
        {
            var request = (CrearOrdenCompraRequest)resultado.Data!;
            await ApiClient.PostAsync<CrearOrdenCompraRequest, object?>("api/compras/ordenes", request);
            Snackbar.Add("Pedido creado correctamente.", Severity.Success);
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AbrirOCSugeridaAsync()
    {
        _cargandoSugerencia = true;
        try
        {
            var sugeridas = await ApiClient.GetAsync<List<OCLineSugeridaItem>>("api/inventario/oc-sugerida") ?? new();
            if (sugeridas.Count == 0)
            {
                Snackbar.Add("No hay artículos bajo el stock mínimo con historial de consumo.", Severity.Info);
                return;
            }

            if (_proveedores.Count == 0)
            {
                var tp = ApiClient.GetAsync<List<ProveedorItem>>("api/catalogo/proveedores");
                var tb = ApiClient.GetAsync<List<BodegaItem>>("api/catalogo/bodegas");
                var tc = ApiClient.GetAsync<List<CentroCostoItem>>("api/catalogo/centros-costo");
                await Task.WhenAll(tp, tb, tc);
                _proveedores = await tp ?? new();
                _bodegas     = await tb ?? new();
                _centrosCosto = await tc ?? new();
            }

            var parametros = new DialogParameters<CrearOrdenCompraDialog>
            {
                { x => x._proveedores,    _proveedores },
                { x => x._bodegas,        _bodegas },
                { x => x._centrosCosto,   _centrosCosto },
                { x => x.LineasSugeridas, sugeridas }
            };

            var dialogo = await DialogService.ShowAsync<CrearOrdenCompraDialog>(
                $"OC Sugerida — {sugeridas.Count} artículo{(sugeridas.Count == 1 ? "" : "s")} bajo mínimo",
                parametros,
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
            var resultado = await dialogo.Result;
            if (resultado is null || resultado.Canceled) return;

            try
            {
                var request = (CrearOrdenCompraRequest)resultado.Data!;
                await ApiClient.PostAsync<CrearOrdenCompraRequest, object?>("api/compras/ordenes", request);
                Snackbar.Add("Pedido sugerido creado correctamente.", Severity.Success);
                await CargarAsync();
            }
            catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
        catch (HttpRequestException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _cargandoSugerencia = false; }
    }

    private async Task OnTabCambiado(int index)
    {
        if (index == 1 && !_cmpCargado)
            await CargarComparacionAsync();
    }

    private async Task CargarComparacionAsync()
    {
        _cmpCargando = true;
        try
        {
            _cmpTodos = await ApiClient.GetAsync<List<ComparacionPrecioRow>>(
                "api/compras/ordenes/comparacion-precios") ?? new();
            _cmpArticulos = _cmpTodos
                .GroupBy(r => r.ArticuloID)
                .ToDictionary(g => g.Key, g => $"{g.First().SKU} – {g.First().Articulo}");
            _cmpProveedores = _cmpTodos
                .GroupBy(r => r.ProveedorID)
                .ToDictionary(g => g.Key, g => g.First().Proveedor);
            _cmpCargado = true;
        }
        catch (Exception ex) { Snackbar.Add($"Error al cargar comparación: {ex.Message}", Severity.Warning); }
        finally { _cmpCargando = false; }
    }

    private async Task EliminarOrdenAsync(OrdenCompraResumen orden)
    {
        var confirmado = await DialogService.ShowMessageBox(
            "Eliminar pedido",
            $"¿Eliminar el pedido {orden.Codigo} ({orden.Proveedor})? Esta acción no se puede deshacer.",
            yesText: "Eliminar", cancelText: "Cancelar");

        if (confirmado != true) return;

        try
        {
            await ApiClient.DeleteAsync($"api/compras/ordenes/{orden.OrdenCompraID}");
            Snackbar.Add("Pedido eliminado correctamente.", Severity.Success);
            if (_detalleAbierto == orden.OrdenCompraID) _detalleAbierto = null;
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AbrirRecepcionAsync(OrdenCompraDetalleItem linea)
    {
        var pendiente = linea.CantidadSolicitada - linea.CantidadRecibida;

        var parametros = new DialogParameters<RecibirLineaDialog>
        {
            { x => x.Articulo, linea.Articulo },
            { x => x.Pendiente, pendiente },
            { x => x.Unidad, linea.Unidad },
            { x => x.UnidadesPorEmbalaje, linea.UnidadesPorEmbalaje }
        };

        var dialogo = await DialogService.ShowAsync<RecibirLineaDialog>("Recibir Mercancía", parametros);
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled)
            return;

        try
        {
            var request = (RecibirLineaOrdenCompraRequest)resultado.Data!;
            await ApiClient.PostAsync<RecibirLineaOrdenCompraRequest, object?>(
                $"api/compras/ordenes/detalle/{linea.OrdenCompraDetalleID}/recibir", request);

            Snackbar.Add("Mercancía recibida correctamente.", Severity.Success);
            await VerDetalleAsync(_detalleAbierto!.Value);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
