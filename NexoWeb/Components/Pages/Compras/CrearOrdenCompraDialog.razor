@inject INexoApiClient ApiClient
@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_codigo" Label="Codigo de la orden" Class="mb-3" />

        <MudSelect T="int" @bind-Value="_proveedorId" Label="Proveedor" Class="mb-3">
            @foreach (var proveedor in _proveedores)
            {
                <MudSelectItem T="int" Value="@proveedor.ProveedorID">@proveedor.RazonSocial</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int" @bind-Value="_bodegaDestinoId" Label="Bodega Destino" Class="mb-4">
            @foreach (var bodega in _bodegas)
            {
                <MudSelectItem T="int" Value="@bodega.BodegaID">@bodega.Nombre (@bodega.CentroCosto)</MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Articulos</MudText>

        @foreach (var linea in _lineas)
        {
            <MudGrid Class="mb-2" AlignItems="Center.Center">
                <MudItem xs="5">
                    <MudSelect T="int" @bind-Value="linea.ArticuloID" Label="Articulo" Dense="true">
                        @foreach (var articulo in _articulos)
                        {
                            <MudSelectItem T="int" Value="@articulo.ArticuloID">@articulo.SKU - @articulo.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField @bind-Value="linea.Cantidad" Label="Cantidad" Min="0.01m" Dense="true" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField @bind-Value="linea.CostoUnitario" Label="Costo Unit." Min="0m" Dense="true" />
                </MudItem>
                <MudItem xs="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="@(() => _lineas.Remove(linea))" />
                </MudItem>
            </MudGrid>
        }

        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarLinea" Class="mt-2">
            Agregar articulo
        </MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirmar" Disabled="!FormularioValido">
            Crear Orden
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public List<ProveedorItem> _proveedores { get; set; } = new();
    [Parameter] public List<BodegaItem> _bodegas { get; set; } = new();
    [Parameter] public List<ArticuloItem> _articulos { get; set; } = new();

    private string _codigo = "";
    private int _proveedorId;
    private int _bodegaDestinoId;
    private List<LineaFormulario> _lineas = new();

    private class LineaFormulario
    {
        public int ArticuloID { get; set; }
        public decimal Cantidad { get; set; }
        public decimal CostoUnitario { get; set; }
    }

    private bool FormularioValido =>
        !string.IsNullOrWhiteSpace(_codigo) && _proveedorId > 0 && _bodegaDestinoId > 0 &&
        _lineas.Count > 0 && _lineas.All(l => l.ArticuloID > 0 && l.Cantidad > 0 && l.CostoUnitario > 0);

    protected override void OnInitialized()
    {
        AgregarLinea(); // arranca con una fila vacia, para no obligar al usuario a hacer click primero
    }

    private void AgregarLinea() => _lineas.Add(new LineaFormulario());

    private void Confirmar()
    {
        var request = new CrearOrdenCompraRequest(
            _codigo, _proveedorId, _bodegaDestinoId,
            _lineas.Select(l => new DetalleOrdenCompraRequest(l.ArticuloID, l.Cantidad, l.CostoUnitario)).ToList());

        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancelar() => MudDialog.Cancel();
}