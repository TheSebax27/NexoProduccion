@page "/admin/integracion-visions"
@attribute [Authorize(Roles = "Administracion")]
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IConfiguration Config
@inject IDialogService DialogService
@implements IDisposable
@using NexoWeb.Common.Dtos
@using NexoWeb.Components.Pages.Catalogo

<PageTitle>Integración Visions — NEXO ERP</PageTitle>

<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">Configuración</p>
            <h1 class="nexo-page-hero__title">Integración con Visions</h1>
        </div>
    </div>
</div>
<InfoAyuda Texto="Configura y monitorea el agente de sincronización entre NEXO ERP y el sistema POS Visions: estado, logs y ajustes." />

<MudTabs @ref="_tabs" Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pt-4">

    <!-- ══════════════════════════════════════ TAB 1: ESTADO -->
    <MudTabPanel Text="Estado del agente" Icon="@Icons.Material.Outlined.MonitorHeart">

        @if (_cargando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else if (_errorCarga is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorCarga</MudAlert>
        }
        else if (!_agentes.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                No hay agentes registrados. Ve a la pestaña <strong>"Configurar agente"</strong>
                para crear uno.
            </MudAlert>
        }
        else
        {
            @foreach (var ag in _agentes)
            {
                var estado = EstadoAgente(ag);
                var expandido = _actividadExpandida.Contains(ag.AgenteSyncID);
                var act = _actividad.GetValueOrDefault(ag.AgenteSyncID);

                <MudPaper Class="mb-4 pa-0" Elevation="0"
                          Style="border: 1px solid var(--mud-palette-divider); border-radius: 16px; overflow:hidden;">

                    <!-- ── Cabecera del agente ── -->
                    <div style="background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-primary-darken) 100%); padding: 20px 24px;"
                         class="d-flex justify-space-between align-center flex-wrap gap-2">
                        <div class="d-flex align-center gap-3">
                            <MudIcon Icon="@Icons.Material.Outlined.Router" Style="color:white; font-size:2rem;" />
                            <div>
                                <MudText Typo="Typo.h6" Style="color:white; font-weight:600; margin:0;">@ag.NombreCentroCosto</MudText>
                                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.75);">@ag.Descripcion</MudText>
                            </div>
                        </div>
                        <div class="d-flex align-center gap-2 flex-wrap">
                            <MudChip T="string" Color="@estado.Color" Size="Size.Medium"
                                     Style="font-weight:600; min-width:110px; justify-content:center;">
                                @if (estado.Color == Color.Success) { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" /> }
                                else if (estado.Color == Color.Error) { <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Class="mr-1" /> }
                                else { <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" /> }
                                @estado.Texto
                            </MudChip>
                            @if (ag.HayActualizacion)
                            {
                                <MudTooltip Text="@($"v{ag.VersionAgente} instalada — v{ag.VersionDisponible} disponible")">
                                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                                               StartIcon="@Icons.Material.Outlined.SystemUpdate"
                                               OnClick="@(() => ActualizarAgenteAsync(ag.AgenteSyncID))">
                                        Actualizar ahora
                                    </MudButton>
                                </MudTooltip>
                            }
                            <MudIconButton Icon="@Icons.Material.Outlined.Settings" Size="Size.Small"
                                           Style="color:white;" Title="Configurar agente"
                                           OnClick="@(() => AbrirConfigAsync(ag.AgenteSyncID))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small"
                                           Style="color:rgba(255,255,255,0.7);" Title="Eliminar agente"
                                           OnClick="@(() => EliminarAgenteAsync(ag.AgenteSyncID))" />
                        </div>
                    </div>

                    <!-- ── Métricas rápidas ── -->
                    <div class="pa-4">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6" md="3">
                                <div style="text-align:center; padding:12px; background:var(--mud-palette-background-grey); border-radius:10px;">
                                    <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Color="Color.Primary" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;">Último latido</MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight:500;">
                                        @(ag.UltimoLatido.HasValue ? ag.UltimoLatido.Value.ToLocalTime().ToString("dd/MM HH:mm") : "Nunca")
                                    </MudText>
                                    @if (ag.UltimoLatido.HasValue)
                                    {
                                        var hace = DateTime.UtcNow - ag.UltimoLatido.Value;
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Hace @(hace.TotalMinutes < 1 ? "menos de 1 min" : $"{(int)hace.TotalMinutes} min")
                                        </MudText>
                                    }
                                </div>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <div style="text-align:center; padding:12px; background:var(--mud-palette-background-grey); border-radius:10px;">
                                    <MudIcon Icon="@Icons.Material.Outlined.Send" Color="Color.Success" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;">Enviados hoy</MudText>
                                    <MudText Typo="Typo.h6" Style="font-weight:700; color: var(--mud-palette-success);">@ag.EventosProcesadosHoy</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">sincronizaciones</MudText>
                                </div>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <div style="text-align:center; padding:12px; background:var(--mud-palette-background-grey); border-radius:10px;">
                                    <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" Color="Color.Info" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;">Ventas importadas hoy</MudText>
                                    <MudText Typo="Typo.h6" Style="font-weight:700; color: var(--mud-palette-info);">@ag.VentasImportadasHoy</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">desde Visions</MudText>
                                </div>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <div style="text-align:center; padding:12px; background:@(ag.EventosConError > 0 ? "rgba(var(--mud-palette-error-rgb),0.08)" : "var(--mud-palette-background-grey)"); border-radius:10px;">
                                    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline"
                                             Color="@(ag.EventosConError > 0 ? Color.Error : Color.Default)" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;">Con error</MudText>
                                    <MudText Typo="Typo.h6" Style="@($"font-weight:700; color:{(ag.EventosConError > 0 ? "var(--mud-palette-error)" : "inherit")}")">
                                        @ag.EventosConError
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(ag.EventosPendientes > 0 ? $"{ag.EventosPendientes} pendientes" : "sin pendientes")
                                    </MudText>
                                </div>
                            </MudItem>
                        </MudGrid>

                        @if (ag.EventosConError > 0)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" Icon="@Icons.Material.Outlined.BugReport">
                                <strong>@ag.EventosConError evento(s) con error</strong> — expande el historial para ver el detalle.
                                Posible causa: artículo no mapeado o referencia inexistente en Visions.
                            </MudAlert>
                        }

                        <!-- ── Actividad / historial ── -->
                        <div class="mt-3">
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       StartIcon="@(expandido ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)"
                                       OnClick="@(() => ToggleActividadAsync(ag.AgenteSyncID))">
                                @(expandido ? "Ocultar historial" : "Ver historial de sincronización")
                            </MudButton>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">Últimos 25 eventos</MudText>
                        </div>

                        @if (expandido)
                        {
                            @if (act is null)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
                            }
                            else
                            {
                                <!-- ── Facturas hoy ── -->
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-3 mb-1" Style="display:block; letter-spacing:.08em;">
                                    FACTURAS HOY
                                </MudText>
                                <MudGrid Spacing="2" Class="mb-3">
                                    <MudItem xs="12" sm="6" md="3">
                                        <div style="padding:10px 14px; border-left:3px solid var(--mud-palette-success); background:var(--mud-palette-background-grey); border-radius:0 8px 8px 0;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">NEXO → Visions</MudText>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:var(--mud-palette-success);">@act.FacturasNexoVisionsHoy</MudText>
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <div style="padding:10px 14px; border-left:3px solid var(--mud-palette-info); background:var(--mud-palette-background-grey); border-radius:0 8px 8px 0;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Ventas Visions → NEXO</MudText>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:var(--mud-palette-info);">@act.VentasVisionsNexoHoy</MudText>
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <div style="padding:10px 14px; border-left:3px solid var(--mud-palette-info); background:var(--mud-palette-background-grey); border-radius:0 8px 8px 0;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Compras recibidas hoy</MudText>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:var(--mud-palette-info);">@act.ComprasHoy</MudText>
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <div style="padding:10px 14px; border-left:3px solid var(--mud-palette-warning); background:var(--mud-palette-background-grey); border-radius:0 8px 8px 0;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Ajustes / Bajas hoy</MudText>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight:700; color:var(--mud-palette-warning);">@act.AjustesHoy</MudText>
                                        </div>
                                    </MudItem>
                                </MudGrid>

                                <!-- ── Catálogo sincronizado ── -->
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1" Style="display:block; letter-spacing:.08em;">
                                    CATÁLOGO SINCRONIZADO (TOTAL EN NEXO)
                                </MudText>
                                <MudGrid Spacing="2" Class="mb-3">
                                    <MudItem xs="12" sm="6" md="2">
                                        <div style="padding:10px 14px; border-left:3px solid var(--mud-palette-primary); background:var(--mud-palette-background-grey); border-radius:0 8px 8px 0;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Artículos</MudText>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@act.TotalArticulos</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@act.ArticulosEnlazados mapeados</MudText>
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="2">
                                        <div style="padding:10px 14px; border-left:3px solid var(--mud-palette-primary); background:var(--mud-palette-background-grey); border-radius:0 8px 8px 0;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Marcas</MudText>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@act.TotalMarcas</MudText>
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="2">
                                        <div style="padding:10px 14px; border-left:3px solid var(--mud-palette-primary); background:var(--mud-palette-background-grey); border-radius:0 8px 8px 0;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Grupos Mayor</MudText>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@act.TotalGruposMayor</MudText>
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="2">
                                        <div style="padding:10px 14px; border-left:3px solid var(--mud-palette-primary); background:var(--mud-palette-background-grey); border-radius:0 8px 8px 0;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Grupos Menor</MudText>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@act.TotalGruposMenor</MudText>
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="2">
                                        <div style="padding:10px 14px; border-left:3px solid var(--mud-palette-primary); background:var(--mud-palette-background-grey); border-radius:0 8px 8px 0;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Clientes</MudText>
                                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@act.TotalClientes</MudText>
                                        </div>
                                    </MudItem>
                                </MudGrid>

                                <!-- Timeline de eventos -->
                                @if (!act.UltimosEventos.Any())
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Sin eventos registrados aún.</MudText>
                                }
                                else
                                {
                                    <MudTable Items="@act.UltimosEventos" Dense="true" Hover="true" Elevation="0"
                                              Style="border:1px solid var(--mud-palette-divider); border-radius:8px; overflow:hidden;">
                                        <HeaderContent>
                                            <MudTh Style="width:130px;">Fecha</MudTh>
                                            <MudTh>Tipo</MudTh>
                                            <MudTh>Artículo</MudTh>
                                            <MudTh Style="width:80px; text-align:right;">Cantidad</MudTh>
                                            <MudTh Style="width:100px; text-align:center;">Estado</MudTh>
                                            <MudTh>Detalle</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd>
                                                <MudText Typo="Typo.caption">
                                                    @((context.FechaEnvio ?? context.FechaCreacion).ToLocalTime().ToString("dd/MM HH:mm"))
                                                </MudText>
                                            </MudTd>
                                            <MudTd>
                                                <div class="d-flex align-center gap-1">
                                                    <MudIcon Icon="@IconoEvento(context.TipoEvento)" Size="Size.Small"
                                                             Color="@ColorIconoEvento(context.TipoEvento)" />
                                                    <MudText Typo="Typo.caption" Style="font-size:11px;">
                                                        @EtiquetaEvento(context.TipoEvento)
                                                    </MudText>
                                                </div>
                                            </MudTd>
                                            <MudTd>
                                                <MudText Typo="Typo.caption" Style="font-family:monospace;">
                                                    @(context.ReferenciaVisions ?? "–")
                                                </MudText>
                                                @if (!string.IsNullOrWhiteSpace(context.NombreArticulo))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                                             Style="display:block; font-size:10px; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                                        @context.NombreArticulo
                                                    </MudText>
                                                }
                                            </MudTd>
                                            <MudTd Style="text-align:right;">
                                                <MudText Typo="Typo.caption" Style="font-family:monospace;">
                                                    @(context.Cantidad != 0 ? context.Cantidad.ToString("N2") : "–")
                                                </MudText>
                                            </MudTd>
                                            <MudTd Style="text-align:center;">
                                                @if (context.Estado == "CONFIRMADO")
                                                {
                                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Style="height:20px;">✓ OK</MudChip>
                                                }
                                                else if (context.Estado == "ERROR")
                                                {
                                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Style="height:20px;">✗ Error</MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Style="height:20px;">⏳ Pendiente</MudChip>
                                                }
                                            </MudTd>
                                            <MudTd>
                                                @if (!string.IsNullOrWhiteSpace(context.MensajeError))
                                                {
                                                    <MudTooltip Text="@context.MensajeError" Placement="Placement.Left">
                                                        <MudText Typo="Typo.caption" Color="Color.Error"
                                                                 Style="max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:block; cursor:help;">
                                                            @context.MensajeError
                                                        </MudText>
                                                    </MudTooltip>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Tertiary">—</MudText>
                                                }
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-2"
                                               StartIcon="@Icons.Material.Outlined.Refresh"
                                               OnClick="@(() => { _actividad.Remove(ag.AgenteSyncID); _ = CargarActividadAsync(ag.AgenteSyncID); })">
                                        Actualizar historial
                                    </MudButton>
                                }
                            }
                        }

                        <!-- Versión -->
                        <MudDivider Class="mt-3 mb-2" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Versión agente: <strong>@(ag.VersionAgente ?? "desconocida")</strong>
                            @if (ag.HayActualizacion) { <span style="color:var(--mud-palette-warning);"> — v@(ag.VersionDisponible) disponible · haz clic en "Actualizar ahora"</span> }
                        </MudText>
                    </div>
                </MudPaper>
            }

            <div class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Refresh"
                           OnClick="CargarEstadoAsync" Disabled="_cargando">Actualizar estado</MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Se actualiza cada 30 segundos</MudText>
            </div>
        }
    </MudTabPanel>

    <!-- ══════════════════════════════════════ TAB 2: GUÍA -->
    <MudTabPanel Text="Instalación" Icon="@Icons.Material.Outlined.MenuBook">

        <MudAlert Severity="Severity.Info" Class="mb-4">
            El <strong>NexoSyncAgent</strong> es un servicio de Windows que se instala con un solo clic desde esta pantalla.
            Arranca automáticamente con Windows, no requiere consola ni intervención manual.
            El agente siempre queda en <code>C:\NexoSyncAgent\</code> en el servidor de NEXO.
        </MudAlert>

        <div class="nexo-item-card pa-4 mb-3">
            <div class="d-flex align-center gap-3 mb-2">
                <MudAvatar Color="Color.Primary" Size="Size.Small">1</MudAvatar>
                <MudText Typo="Typo.subtitle1" Style="font-weight:500">Crear y configurar el agente</MudText>
            </div>
            <ol style="padding-left:1.25rem;font-size:0.875rem;line-height:1.9;">
                <li>Ir a la pestaña <strong>"Configurar agente"</strong></li>
                <li>Seleccionar el Centro de Costo que usará este agente y hacer clic en <strong>"Crear"</strong></li>
                <li>Completar el servidor SQL de Visions y el intervalo de sincronización</li>
                <li>Clic en <strong>"Guardar configuración"</strong></li>
            </ol>
        </div>

        <div class="nexo-item-card pa-4 mb-3">
            <div class="d-flex align-center gap-3 mb-2">
                <MudAvatar Color="Color.Primary" Size="Size.Small">2</MudAvatar>
                <MudText Typo="Typo.subtitle1" Style="font-weight:500">Instalar el agente</MudText>
            </div>
            <MudPaper Class="pa-3" Outlined="true">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudIcon Icon="@Icons.Material.Outlined.FileDownload" Color="Color.Success" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Descargar e instalar en el equipo del cliente</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">El instalador incluye todo — no hay que editar ningún archivo</MudText>
                    </div>
                </div>
                <ol style="padding-left:1.1rem;font-size:0.875rem;line-height:2;">
                    <li>Clic en <strong>"Descargar instalador"</strong> — genera <code>NexoAgente-Setup.exe</code> con todo incluido</li>
                    <li>En el equipo del cliente: doble clic en <code>NexoAgente-Setup.exe</code></li>
                    <li>Aceptar el Control de cuentas (UAC) — único paso manual</li>
                </ol>
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                    El instalador se copia solo a <code>C:\NexoSyncAgent\</code>, instala el servicio de Windows y lo arranca.
                    No hay extracción, no hay archivos BAT, no hay edición manual. Desde ese momento sincroniza con NEXO y arranca con Windows.
                </MudAlert>
            </MudPaper>
        </div>

        <div class="nexo-item-card pa-4 mb-3">
            <div class="d-flex align-center gap-3 mb-2">
                <MudAvatar Color="Color.Warning" Size="Size.Small"><MudIcon Icon="@Icons.Material.Outlined.WifiOff" Size="Size.Small" /></MudAvatar>
                <MudText Typo="Typo.subtitle1" Style="font-weight:500">¿Qué pasa si se corta la conexión?</MudText>
            </div>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">NEXO → Visions</MudText>
                    <MudText Typo="Typo.body2">Los eventos quedan en cola PENDIENTE. Al recuperar conexión se aplican automáticamente.</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Visions → NEXO (ventas POS)</MudText>
                    <MudText Typo="Typo.body2">Las ventas no se marcan exportadas hasta que NEXO confirme. Se exportan todas al reconectar.</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                        Backoff automático: 30 s → 60 s → 120 s antes de reintentar cuando NEXO no responde.
                    </MudAlert>
                </MudItem>
            </MudGrid>
        </div>
    </MudTabPanel>

    <!-- ══════════════════════════════════════ TAB 3: CONFIGURAR -->
    <MudTabPanel Text="Configurar agente" Icon="@Icons.Material.Outlined.Settings" BadgeData="@(_agentes.Count > 0 ? null : "!")" BadgeColor="Color.Warning">

        @if (_cargandoConfig)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_configAgente is not null)
        {
            <!-- ── Panel de configuracion de un agente existente ── -->
            <div class="d-flex align-center gap-2 mb-4">
                <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small"
                               OnClick="@(() => _configAgente = null)" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:500">
                    Configuración — @_configAgente.NombreCentroCosto
                </MudText>
            </div>

            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                La <strong>URL de NEXO API</strong> y la <strong>clave del agente</strong> se configuran automáticamente al descargar el instalador — no hay que escribirlas.
            </MudAlert>

            <MudGrid>
                <!-- Servidor SQL de Visions -->
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_editVisionsServer"
                                  Label="Servidor SQL de Visions"
                                  Variant="Variant.Outlined"
                                  Placeholder="NOMBRE-PC\SQLEXPRESS"
                                  HelperText="Solo el nombre del servidor o instancia. Ej: DESKTOP-ABC123\JONATHAN" />
                </MudItem>


                <!-- Intervalo -->
                <MudItem xs="12" md="4">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudText Typo="Typo.body2">Unidad:</MudText>
                        <MudChip T="string" Color="@(!_usarSegundos ? Color.Primary : Color.Default)"
                                 Size="Size.Small" OnClick="@(() => _usarSegundos = false)">Minutos</MudChip>
                        <MudChip T="string" Color="@(_usarSegundos ? Color.Primary : Color.Default)"
                                 Size="Size.Small" OnClick="@(() => _usarSegundos = true)">Segundos</MudChip>
                    </div>
                    @if (_usarSegundos)
                    {
                        <MudNumericField @bind-Value="_editIntervalSeconds"
                                         Label="Intervalo (segundos)"
                                         Variant="Variant.Outlined" FullWidth="true"
                                         Min="10" Max="3600"
                                         HelperText="Mínimo 10 s. Útil para alta frecuencia o pruebas." />
                    }
                    else
                    {
                        <MudNumericField @bind-Value="_editIntervalMinutes"
                                         Label="Intervalo (minutos)"
                                         Variant="Variant.Outlined" FullWidth="true"
                                         Min="1" Max="60"
                                         HelperText="Cada cuántos minutos sincroniza con NEXO." />
                    }
                </MudItem>

                <!-- Inicio de sync de ventas -->
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Inicio de sincronización de ventas</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;" Class="mb-2">
                        Define desde qué fecha se importan ventas de Visions hacia NEXO. Útil al instalar en clientes con historial largo.
                    </MudText>
                    <div class="d-flex gap-2 flex-wrap align-center mb-2">
                        <MudChip T="string" Color="@(_modoFechaVentas == 0 ? Color.Primary : Color.Default)"
                                 Size="Size.Small"
                                 OnClick="@(() => { _modoFechaVentas = 0; _editFechaInicioVentas = null; })">
                            Traer todas
                        </MudChip>
                        <MudChip T="string" Color="@(_modoFechaVentas == 1 ? Color.Primary : Color.Default)"
                                 Size="Size.Small"
                                 OnClick="@(() => { _modoFechaVentas = 1; _editFechaInicioVentas = DateTime.Today; })">
                            Desde hoy
                        </MudChip>
                        <MudChip T="string" Color="@(_modoFechaVentas == 2 ? Color.Primary : Color.Default)"
                                 Size="Size.Small"
                                 OnClick="@(() => _modoFechaVentas = 2)">
                            Fecha específica
                        </MudChip>
                    </div>
                    @if (_modoFechaVentas == 2)
                    {
                        <MudDatePicker @bind-Date="_editFechaInicioVentas"
                                       Label="Importar ventas desde"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy"
                                       HelperText="Solo se importarán ventas con fecha igual o posterior a esta." />
                    }
                    @if (_modoFechaVentas == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Se importarán <strong>todas las ventas históricas</strong> de Visions. En clientes con años de datos esto puede generar miles de registros en la primera sincronización.
                        </MudAlert>
                    }
                    @if (_modoFechaVentas == 1)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Solo se importarán ventas desde <strong>hoy (@DateTime.Today.ToString("dd/MM/yyyy"))</strong>. El historial anterior no se traerá a NEXO.
                        </MudAlert>
                    }
                    @if (_modoFechaVentas == 2 && _editFechaInicioVentas.HasValue)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                            Solo se importarán ventas desde <strong>@_editFechaInicioVentas.Value.ToString("dd/MM/yyyy")</strong>.
                        </MudAlert>
                    }
                </MudItem>

                <!-- SINCANTSA -->
                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Control de inventario en ventas</MudText>
                    <MudSwitch @bind-Value="_editSincAntsa" Color="Color.Primary"
                               Label="Bloquear ventas sin existencias (SINCANTSA)"
                               LabelPosition="LabelPosition.End" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block;" Class="mt-1">
                        Cuando está activo, Visions impide grabar una venta si el artículo no tiene existencias suficientes.
                    </MudText>
                </MudItem>

                <!-- Botones -->
                <MudItem xs="12">
                    <div class="d-flex gap-2 flex-wrap align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Save"
                                   OnClick="GuardarConfigAsync" Disabled="_guardando">
                            Guardar configuración
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   StartIcon="@Icons.Material.Outlined.FileDownload"
                                   OnClick="DescargarInstaladorAsync" Disabled="_descargando">
                            @(_descargando ? "Preparando instalador…" : "Descargar instalador")
                        </MudButton>
                        <MudTooltip Text="Solo para actualizar la configuración en un agente ya instalado, sin reinstalar el servicio">
                            <MudButton Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Outlined.Settings"
                                       OnClick="DescargarAppsettingsAsync">
                                Actualizar config (.json)
                            </MudButton>
                        </MudTooltip>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        Descarga <strong>NexoAgente-Setup.exe</strong> (~87 MB). En el equipo del cliente: doble clic → Aceptar UAC → listo. Sin extracción, sin BAT, sin editar nada.
                    </MudText>
                </MudItem>

                <!-- Instrucción para servidor remoto -->
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudAlert Severity="Severity.Info" Dense="true">
                        <strong>¿Visions está en otro servidor?</strong>
                        Haz clic en <strong>"Descargar appsettings.json"</strong> — el archivo ya viene con
                        la clave de API configurada. Cópialo junto al <code>NexoSyncAgent.exe</code>
                        (reemplaza el existente) y ejecuta <code>Instalar-NexoSyncAgent.bat</code> como Administrador.
                        No necesitas escribir ni copiar ninguna clave manualmente.
                    </MudAlert>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <!-- ── Lista de agentes existentes ── -->
            @if (_agentes.Any())
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Selecciona el agente que deseas configurar:
                </MudText>
                <MudGrid>
                    @foreach (var ag in _agentes)
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-3" Elevation="0"
                                      Style="border: 0.5px solid var(--mud-palette-divider); border-radius: 10px;">
                                <div class="d-flex align-center justify-space-between">
                                    <div class="d-flex align-center gap-2 cursor-pointer flex-grow-1"
                                         @onclick="@(() => AbrirConfigAsync(ag.AgenteSyncID))">
                                        <MudIcon Icon="@Icons.Material.Outlined.Router" Color="Color.Primary" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2">@ag.NombreCentroCosto</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@ag.Descripcion</MudText>
                                        </div>
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small"
                                                   Color="Color.Error" Title="Eliminar agente"
                                                   OnClick="@(() => EliminarAgenteAsync(ag.AgenteSyncID))" />
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
                <MudDivider Class="my-4" />
            }

            <!-- ── Crear nuevo agente ── -->
            <MudText Typo="Typo.subtitle1" Style="font-weight:500" Class="mb-3">Crear nuevo agente</MudText>
            @if (!CentrosCostoDisponibles.Any())
            {
                <MudAlert Severity="Severity.Info">Todos los centros de costo ya tienen un agente asignado.</MudAlert>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="5">
                        <MudSelect T="int?" @bind-Value="_nuevoCcId" Label="Centro de Costo"
                                   Variant="Variant.Outlined" FullWidth="true" Placeholder="Selecciona...">
                            @foreach (var cc in CentrosCostoDisponibles)
                            {
                                <MudSelectItem T="int?" Value="@((int?)cc.CentroCostoID)">@cc.Nombre</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudTextField @bind-Value="_nuevaDescripcion" Label="Descripcion (opcional)"
                                      Variant="Variant.Outlined" FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                   Style="height:56px;"
                                   OnClick="CrearAgenteAsync"
                                   Disabled="@(_creandoAgente || _nuevoCcId is null)">
                            @(_creandoAgente ? "Creando..." : "Crear")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }
        }
    </MudTabPanel>

    <!-- ══════════════════════════════════════ TAB 4: ARTÍCULOS PENDIENTES -->
    <MudTabPanel Text="Artículos pendientes" Icon="@Icons.Material.Outlined.LinkOff"
                 BadgeData="@(_totalPendientes > 0 ? _totalPendientes.ToString() : null)"
                 BadgeColor="Color.Warning">

        @if (_cargandoPendientes)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Warning" Class="mb-4" />
        }
        else if (!_pendientesPorAgente.Any(kv => kv.Value.Any()))
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                No hay artículos de Visions pendientes de mapeo. Todo está vinculado.
            </MudAlert>
        }
        else
        {
            @foreach (var ag in _agentes)
            {
                var pendientes = _pendientesPorAgente.GetValueOrDefault(ag.AgenteSyncID);
                if (pendientes is null || !pendientes.Any()) continue;

                <MudText Typo="Typo.subtitle1" Class="mb-2 mt-4">
                    <MudIcon Icon="@Icons.Material.Outlined.Store" Size="Size.Small" Class="mr-1" />
                    @ag.NombreCentroCosto — @pendientes.Count artículo(s) sin mapear
                </MudText>

                <MudTable Items="@pendientes" Dense="true" Hover="true" Class="mb-6"
                          Style="border:1px solid var(--mud-palette-divider); border-radius:12px;">
                    <HeaderContent>
                        <MudTh>Código Visions</MudTh>
                        <MudTh>Nombre en Visions</MudTh>
                        <MudTh Style="text-align:right">Costo</MudTh>
                        <MudTh Style="text-align:right">Precio</MudTh>
                        <MudTh Style="text-align:right">Cant. vendida</MudTh>
                        <MudTh Style="text-align:right">Detectado</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><code>@context.CodigoArticuloVisions</code></MudTd>
                        <MudTd>@(context.NombreVisions ?? "—")</MudTd>
                        <MudTd Style="text-align:right">@(context.CostoVisions?.ToString("N2") ?? "—")</MudTd>
                        <MudTd Style="text-align:right">@(context.PrecioVisions?.ToString("N2") ?? "—")</MudTd>
                        <MudTd Style="text-align:right">@context.CantidadDetectada.ToString("N2")</MudTd>
                        <MudTd Style="text-align:right">@context.FechaDetectado.ToString("dd/MM/yy HH:mm")</MudTd>
                        <MudTd Style="text-align:right">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => AbrirResolverAsync(ag.AgenteSyncID, ag.CentroCostoID, context))">
                                Resolver
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudTabPanel>

    <!-- ══════════════════════════════════════ TAB 5: PROGRESO DE SYNC -->
    <MudTabPanel Text="Progreso de sync" Icon="@Icons.Material.Outlined.Sync">

        @if (_cargandoProgreso)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else if (!_progreso.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">No hay agentes registrados aún.</MudAlert>
        }
        else
        {
            @foreach (var p in _progreso)
            {
                var totalVisions = p.TotalMapeados + p.TotalPendientesMapeo;
                var pctMapeados  = totalVisions > 0 ? (double)p.TotalMapeados / totalVisions * 100 : 100;
                var pctCompletos = p.TotalMapeados > 0 ? (double)p.ArticulosMapeadosCompletos / p.TotalMapeados * 100 : 0;

                <MudPaper Class="mb-4 pa-0" Elevation="0"
                          Style="border: 1px solid var(--mud-palette-divider); border-radius: 16px; overflow:hidden;">

                    <!-- Cabecera por CC -->
                    <div style="background:var(--mud-palette-background-grey); padding:14px 20px;"
                         class="d-flex justify-space-between align-center flex-wrap gap-2">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Store" Color="Color.Primary" />
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@p.NombreCentroCosto</MudText>
                        </div>
                        <div class="d-flex align-center gap-2 flex-wrap">
                            @if (p.UltimoLatido.HasValue)
                            {
                                var hace = DateTime.UtcNow - p.UltimoLatido.Value;
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                    Latido hace @(hace.TotalMinutes < 1 ? "menos de 1 min" : $"{(int)hace.TotalMinutes} min")
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Sin latido</MudChip>
                            }
                        </div>
                    </div>

                    <div class="pa-5">
                        <MudGrid Spacing="4">

                            <!-- Artículos Visions mapeados -->
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="letter-spacing:.07em; display:block;" Class="mb-2">
                                    ARTÍCULOS DE VISIONS EN NEXO
                                </MudText>
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudText Typo="Typo.h5" Style="font-weight:700;">@p.TotalMapeados</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">mapeados de @totalVisions detectados</MudText>
                                </div>
                                <MudProgressLinear Value="@pctMapeados" Color="Color.Success" Rounded="true" Size="Size.Large" Class="mb-1" />
                                @if (p.TotalPendientesMapeo > 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Warning">
                                        @p.TotalPendientesMapeo sin mapear — revisa la pestaña "Artículos pendientes"
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Success">¡Todo mapeado!</MudText>
                                }
                            </MudItem>

                            <!-- Calidad del catálogo (por CC) -->
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="letter-spacing:.07em; display:block;" Class="mb-2">
                                    CALIDAD DEL CATÁLOGO (@p.NombreCentroCosto)
                                </MudText>
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--mud-palette-success);">@p.ArticulosMapeadosCompletos</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">con Marca e IVA completos</MudText>
                                </div>
                                @if (p.TotalMapeados > 0)
                                {
                                    <MudProgressLinear Value="@pctCompletos" Color="Color.Success" Rounded="true" Size="Size.Large" Class="mb-1" />
                                    <MudText Typo="Typo.caption" Color="@(p.ArticulosMapeadosSinDatos > 0 ? Color.Error : Color.Success)">
                                        @if (p.ArticulosMapeadosSinDatos > 0)
                                        {
                                            @($"{p.ArticulosMapeadosSinDatos} artículo(s) sin Marca o sin IVA")
                                        }
                                        else
                                        {
                                            @("¡Catálogo completo!")
                                        }
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Sin artículos mapeados aún</MudText>
                                }
                            </MudItem>

                            <!-- Ventas procesadas -->
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="letter-spacing:.07em; display:block;" Class="mb-2">
                                    VENTAS VISIONS → NEXO
                                </MudText>
                                <MudText Typo="Typo.h4" Color="Color.Secondary" Style="font-weight:700;">@p.TotalEventosProcesados.ToString("N0")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">movimientos de inventario aplicados desde el POS</MudText>
                            </MudItem>

                            <!-- Facturas -->
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="letter-spacing:.07em; display:block;" Class="mb-2">
                                    FACTURAS NEXO → VISIONS
                                </MudText>
                                <MudText Typo="Typo.h4" Color="Color.Tertiary" Style="font-weight:700;">@p.TotalFacturasVisions.ToString("N0")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">facturas de NEXO confirmadas en Visions</MudText>
                            </MudItem>

                        </MudGrid>
                    </div>
                </MudPaper>
            }

            <!-- Catálogo compartido NEXO (global, no por CC) -->
            @if (_salud is not null)
            {
                <MudPaper Class="mt-2 pa-5" Elevation="0"
                          Style="border: 1px dashed var(--mud-palette-divider); border-radius: 16px; opacity:.9;">
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudIcon Icon="@Icons.Material.Outlined.LibraryBooks" Color="Color.Default" />
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                            Catálogo compartido NEXO <span style="font-weight:400;">(global — aplica a todos los centros de costo)</span>
                        </MudText>
                    </div>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <div style="padding:10px 14px; border-left:2px solid var(--mud-palette-divider); border-radius:0 8px 8px 0; background:var(--mud-palette-background-grey);">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Total artículos NEXO</MudText>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_salud.TotalArticulos.ToString("N0")</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div style="padding:10px 14px; border-left:2px solid var(--mud-palette-divider); border-radius:0 8px 8px 0; background:var(--mud-palette-background-grey);">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Marcas</MudText>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_salud.TotalMarcas</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div style="padding:10px 14px; border-left:2px solid var(--mud-palette-divider); border-radius:0 8px 8px 0; background:var(--mud-palette-background-grey);">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Grupos</MudText>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_salud.TotalGruposMayor / @_salud.TotalGruposMenor</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Mayor / Menor</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div style="padding:10px 14px; border-left:2px solid var(--mud-palette-divider); border-radius:0 8px 8px 0; background:var(--mud-palette-background-grey);">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Clientes activos</MudText>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_salud.TotalClientes.ToString("N0")</MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            <div class="d-flex justify-end mt-3">
                <MudButton StartIcon="@Icons.Material.Outlined.Refresh" Variant="Variant.Text"
                           OnClick="@(async () => { await CargarProgresoAsync(); await CargarSaludAsync(); })" Size="Size.Small">
                    Actualizar
                </MudButton>
                <MudText Typo="Typo.caption" Class="align-self-center ml-2" Style="color:var(--mud-palette-text-disabled)">
                    Se actualiza automáticamente cada 30 s
                </MudText>
            </div>
        }

    </MudTabPanel>


</MudTabs>

@code {
    // ── Estado ──────────────────────────────────────────────────────────
    private MudTabs? _tabs;
    private bool _cargando = true;
    private string? _errorCarga;
    private List<EstadoIntegracionResponse> _agentes = new();
    private List<CentroCostoItem> _centrosCosto = new();
    private System.Timers.Timer? _timer;

    // ── Actividad por agente ─────────────────────────────────────────────
    private Dictionary<int, ActividadAgenteResponse> _actividad = new();
    private HashSet<int> _actividadExpandida = new();

    // ── Config agente ────────────────────────────────────────────────────
    private bool _cargandoConfig;
    private ConfiguracionAgenteCompletaResponse? _configAgente;
    private string? _editVisionsServer;
    private int _editIntervalMinutes = 5;
    private int _editIntervalSeconds = 30;
    private bool _usarSegundos;
    private bool _guardando;
    private bool _descargando;
    // 0 = traer todas, 1 = desde hoy, 2 = desde fecha específica
    private int _modoFechaVentas;
    private DateTime? _editFechaInicioVentas;

    // ── Progreso de sincronización ───────────────────────────────────────
    private bool _cargandoProgreso;
    private List<ProgresoSyncResponse> _progreso = new();

    // ── Artículos pendientes de mapeo ────────────────────────────────────
    private bool _cargandoPendientes;
    private Dictionary<int, List<ArticuloPendienteMapeoItem>> _pendientesPorAgente = new();
    private int _totalPendientes => _pendientesPorAgente.Values.Sum(l => l.Count);

    // ── Salud del catálogo ───────────────────────────────────────────────
    private bool _cargandoSalud;
    private SaludCatalogoResponse? _salud;
    private DateTime _saludFecha;

    // ── SINCANTSA ────────────────────────────────────────────────────────────
    private bool _editSincAntsa;

    // ── Crear agente ─────────────────────────────────────────────────────
    private int? _nuevoCcId;
    private string _nuevaDescripcion = string.Empty;
    private bool _creandoAgente;

    private IEnumerable<CentroCostoItem> CentrosCostoDisponibles =>
        _centrosCosto.Where(cc => !_agentes.Any(a => a.CentroCostoID == cc.CentroCostoID));

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarEstadoAsync(), CargarCatalogoAsync(), CargarProgresoAsync(), CargarSaludAsync());
        await CargarPendientesAsync();
        _timer = new System.Timers.Timer(30_000);
        _timer.Elapsed += async (_, _) =>
        {
            await Task.WhenAll(CargarEstadoAsync(), CargarProgresoAsync(), CargarSaludAsync());
            await InvokeAsync(StateHasChanged);
        };
        _timer.Start();
    }

    private async Task CargarProgresoAsync()
    {
        _cargandoProgreso = true;
        try { _progreso = await ApiClient.GetAsync<List<ProgresoSyncResponse>>("api/integracion/progreso-sync") ?? new(); }
        catch { /* silencioso — no bloquea el resto de la UI */ }
        finally { _cargandoProgreso = false; }
    }

    private async Task CargarSaludAsync()
    {
        _cargandoSalud = true;
        try
        {
            _salud = await ApiClient.GetAsync<SaludCatalogoResponse>("api/integracion/salud-catalogo");
            _saludFecha = DateTime.UtcNow;
        }
        catch { /* silencioso — no bloquea el resto de la UI */ }
        finally { _cargandoSalud = false; }
    }

    private async Task CargarEstadoAsync()
    {
        _cargando = true;
        _errorCarga = null;
        try { _agentes = await ApiClient.GetAsync<List<EstadoIntegracionResponse>>("api/integracion/estado") ?? new(); }
        catch (Exception ex) { _errorCarga = ex.Message; }
        finally { _cargando = false; }
    }

    private async Task CargarCatalogoAsync()
    {
        try
        {
            _centrosCosto = await ApiClient.GetAsync<List<CentroCostoItem>>("api/catalogo/centros-costo?soloActivos=true") ?? new();
        }
        catch { /* no bloquea la UI si esto falla */ }
    }

    private async Task CargarPendientesAsync()
    {
        _cargandoPendientes = true;
        _pendientesPorAgente = new();
        try
        {
            foreach (var ag in _agentes)
            {
                var lista = await ApiClient.GetAsync<List<ArticuloPendienteMapeoItem>>(
                    $"api/integracion/articulos-pendientes?centroCostoId={ag.CentroCostoID}") ?? new();
                _pendientesPorAgente[ag.AgenteSyncID] = lista;
            }
        }
        catch { /* silencioso */ }
        finally { _cargandoPendientes = false; }
    }

    private async Task AbrirResolverAsync(int agenteSyncId, int centroCostoId, ArticuloPendienteMapeoItem pendiente)
    {
        var parameters = new DialogParameters<ResolverPendienteDialog>
        {
            { x => x.Pendiente, pendiente }
        };

        var dialog = await DialogService.ShowAsync<ResolverPendienteDialog>("Resolver artículo pendiente", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ResolverArticuloPendienteRequest request })
        {
            try
            {
                await ApiClient.PostAsync($"api/integracion/articulos-pendientes/{pendiente.PendienteID}/resolver", request);
                Snackbar.Add("Artículo resuelto y ventas procesadas correctamente.", Severity.Success);
                await CargarPendientesAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al resolver: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task AbrirConfigAsync(int agenteSyncId)
    {
        _cargandoConfig = true;
        _configAgente = null;
        _tabs?.ActivatePanel(2);
        try
        {
            _configAgente = await ApiClient.GetAsync<ConfiguracionAgenteCompletaResponse>(
                $"api/integracion/agentes/{agenteSyncId}/config");

            if (_configAgente is not null)
            {
                _editVisionsServer     = ExtraerServidorSql(_configAgente.VisionsDbConexion);
                _usarSegundos         = _configAgente.IntervalSeconds > 0;
                _editIntervalMinutes  = _configAgente.IntervalMinutes > 0 ? _configAgente.IntervalMinutes : 5;
                _editIntervalSeconds  = _configAgente.IntervalSeconds > 0 ? _configAgente.IntervalSeconds : 30;
                _editFechaInicioVentas = _configAgente.FechaInicioSyncVentas;
                _modoFechaVentas = _configAgente.FechaInicioSyncVentas is null ? 0
                    : _configAgente.FechaInicioSyncVentas.Value.Date == DateTime.Today ? 1 : 2;

                try
                {
                    var sincAntsa = await ApiClient.GetAsync<SincAntsaResponse>(
                        $"api/integracion/agentes/{agenteSyncId}/sincantsa");
                    _editSincAntsa = sincAntsa?.Activo ?? false;
                }
                catch { _editSincAntsa = false; }
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _cargandoConfig = false; }
    }

    private async Task ToggleActividadAsync(int agenteSyncId)
    {
        if (_actividadExpandida.Contains(agenteSyncId))
        {
            _actividadExpandida.Remove(agenteSyncId);
            return;
        }
        _actividadExpandida.Add(agenteSyncId);
        if (!_actividad.ContainsKey(agenteSyncId))
            await CargarActividadAsync(agenteSyncId);
    }

    private async Task CargarActividadAsync(int agenteSyncId)
    {
        try
        {
            var r = await ApiClient.GetAsync<ActividadAgenteResponse>($"api/integracion/agentes/{agenteSyncId}/actividad");
            if (r is not null) _actividad[agenteSyncId] = r;
        }
        catch { /* silencioso — no bloquea la UI */ }
    }

    private async Task GuardarConfigAsync()
    {
        if (_configAgente is null) return;
        _guardando = true;
        try
        {
            var minutos  = _usarSegundos ? 0 : _editIntervalMinutes;
            var segundos = _usarSegundos ? _editIntervalSeconds : 0;
            var fechaVentas = _modoFechaVentas == 0 ? null : _editFechaInicioVentas;
            await ApiClient.PutAsync<ActualizarConfiguracionAgenteRequest, object>(
                $"api/integracion/agentes/{_configAgente.AgenteSyncID}/config",
                new ActualizarConfiguracionAgenteRequest(
                    _editVisionsServer, null, minutos, segundos, null, null, fechaVentas));
            await ApiClient.PutAsync<SincAntsaRequest, object>(
                $"api/integracion/agentes/{_configAgente.AgenteSyncID}/sincantsa",
                new SincAntsaRequest(_editSincAntsa));
            Snackbar.Add("Configuración guardada.", Severity.Success);
            _configAgente = _configAgente with
            {
                VisionsDbConexion     = _editVisionsServer,
                IntervalMinutes       = minutos,
                IntervalSeconds       = segundos,
                FechaInicioSyncVentas = fechaVentas,
            };
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardando = false; }
    }

    private async Task CrearAgenteAsync()
    {
        if (_nuevoCcId is null) return;
        _creandoAgente = true;
        try
        {
            var cc = _centrosCosto.FirstOrDefault(c => c.CentroCostoID == _nuevoCcId.Value);
            var descripcion = string.IsNullOrWhiteSpace(_nuevaDescripcion)
                ? $"Agente Sync - {cc?.Nombre ?? _nuevoCcId.ToString()}"
                : _nuevaDescripcion;

            await ApiClient.PostAsync<GenerarApiKeyRequest, GenerarApiKeyResponse>(
                "api/integracion/agentes/api-key",
                new GenerarApiKeyRequest(_nuevoCcId.Value, descripcion));

            Snackbar.Add("Agente creado. Configura el servidor SQL y descarga el instalador.", Severity.Success);
            _nuevoCcId = null;
            _nuevaDescripcion = string.Empty;
            await Task.WhenAll(CargarEstadoAsync(), CargarCatalogoAsync());
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _creandoAgente = false; }
    }

    private async Task DescargarInstaladorAsync()
    {
        if (_configAgente is null) return;
        _descargando = true;
        try
        {
            await GuardarConfigAsync();

            var resultado = await ApiClient.PostAsync<object, DescargaTokenResponse>(
                $"api/integracion/agentes/{_configAgente.AgenteSyncID}/preparar-descarga", new { });

            if (resultado?.Token is null)
            {
                Snackbar.Add("No se pudo preparar el instalador. Verifica que NexoApi fue publicado con el agente bundled.", Severity.Error);
                return;
            }

            await JS.InvokeVoidAsync("nexoDescargarUrl", $"/api/integracion/descargar-agente/{resultado.Token}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _descargando = false; }
    }

    private async Task DescargarAppsettingsAsync()
    {
        if (_configAgente is null) return;
        try
        {
            var bytes = await ApiClient.GetBytesAsync(
                $"api/integracion/agentes/{_configAgente.AgenteSyncID}/appsettings-json");
            if (bytes.Length == 0) return;
            var contenido = System.Text.Encoding.UTF8.GetString(bytes);

            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("nexoDescargarArchivo", "appsettings.json", "application/json", base64);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ActualizarAgenteAsync(int agenteSyncId)
    {
        _cargandoConfig = true;
        try
        {
            _configAgente = await ApiClient.GetAsync<ConfiguracionAgenteCompletaResponse>(
                $"api/integracion/agentes/{agenteSyncId}/config");
            if (_configAgente is not null)
            {
                _editVisionsServer    = ExtraerServidorSql(_configAgente.VisionsDbConexion);
                _usarSegundos        = _configAgente.IntervalSeconds > 0;
                _editIntervalMinutes = _configAgente.IntervalMinutes > 0 ? _configAgente.IntervalMinutes : 5;
                _editIntervalSeconds = _configAgente.IntervalSeconds > 0 ? _configAgente.IntervalSeconds : 30;
                await DescargarInstaladorAsync();
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _cargandoConfig = false; _configAgente = null; }
    }

    private async Task EliminarAgenteAsync(int agenteSyncId)
    {
        var confirmado = await DialogService.ShowMessageBox(
            "Eliminar agente",
            "¿Seguro que deseas eliminar este agente? Se detendrá la sincronización con Visions para ese Centro de Costo. Esta acción no se puede deshacer.",
            yesText: "Sí, eliminar",
            cancelText: "Cancelar");

        if (confirmado != true) return;

        try
        {
            await ApiClient.DeleteAsync($"api/integracion/agentes/{agenteSyncId}");
            Snackbar.Add("Agente eliminado.", Severity.Success);
            if (_configAgente?.AgenteSyncID == agenteSyncId)
                _configAgente = null;
            await Task.WhenAll(CargarEstadoAsync(), CargarCatalogoAsync());
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static string? ExtraerServidorSql(string? conexion)
    {
        if (string.IsNullOrWhiteSpace(conexion)) return null;
        var match = System.Text.RegularExpressions.Regex.Match(conexion, @"(?i)(?:server|data source)\s*=\s*([^;]+)");
        return match.Success ? match.Groups[1].Value.Trim() : conexion;
    }

