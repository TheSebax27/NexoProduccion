@page "/admin/integracion-visions"
@attribute [Authorize(Roles = "Administracion")]
@inject INexoApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IConfiguration Config
@implements IDisposable

<PageTitle>Integración Visions — NEXO ERP</PageTitle>

<div class="nexo-page-hero">
    <div class="nexo-page-hero__left">
        <div class="nexo-page-hero__accent"></div>
        <div>
            <p class="nexo-page-hero__module">Configuración</p>
            <h1 class="nexo-page-hero__title">Integración con Visions</h1>
        </div>
    </div>
</div>

<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pt-4">

    <!-- ══════════════════════════════════════ TAB 1: ESTADO -->
    <MudTabPanel Text="Estado del agente" Icon="@Icons.Material.Outlined.MonitorHeart">

        @if (_cargando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else if (_errorCarga is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorCarga</MudAlert>
        }
        else if (!_agentes.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                No hay agentes registrados. Genera una API Key en <strong>Catálogo → Centros de Costo</strong>
                y luego configura e instala el agente desde la pestaña <strong>"Configurar agente"</strong>.
            </MudAlert>
        }
        else
        {
            <MudGrid>
                @foreach (var ag in _agentes)
                {
                    var estado = EstadoAgente(ag);
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Elevation="0" Style="border: 0.5px solid var(--mud-palette-divider); border-radius: 12px;">
                            <div class="d-flex justify-space-between align-center mb-2">
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:500">@ag.NombreCentroCosto</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@ag.Descripcion</MudText>
                                </div>
                                <div class="d-flex align-center gap-2">
                                    <MudChip T="string" Color="@estado.Color" Size="Size.Small">@estado.Texto</MudChip>
                                    <MudIconButton Icon="@Icons.Material.Outlined.Settings" Size="Size.Small"
                                                   Title="Configurar agente"
                                                   OnClick="@(() => AbrirConfigAsync(ag.AgenteSyncID))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small"
                                                   Color="Color.Error" Title="Eliminar agente"
                                                   OnClick="@(() => EliminarAgenteAsync(ag.AgenteSyncID))" />
                                </div>
                            </div>

                            <MudDivider Class="mb-3" />

                            <MudGrid Spacing="2">
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Último latido</MudText>
                                    <MudText Typo="Typo.body2">
                                        @(ag.UltimoLatido.HasValue ? ag.UltimoLatido.Value.ToLocalTime().ToString("dd/MM HH:mm:ss") : "Nunca")
                                    </MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Versión agente</MudText>
                                    <MudText Typo="Typo.body2">@(ag.VersionAgente ?? "–")</MudText>
                                </MudItem>
                                <MudItem xs="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pendientes</MudText>
                                    <MudText Typo="Typo.body2" Color="@(ag.EventosPendientes > 0 ? Color.Warning : Color.Default)">@ag.EventosPendientes</MudText>
                                </MudItem>
                                <MudItem xs="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Con error</MudText>
                                    <MudText Typo="Typo.body2" Color="@(ag.EventosConError > 0 ? Color.Error : Color.Default)">@ag.EventosConError</MudText>
                                </MudItem>
                                <MudItem xs="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Enviados hoy</MudText>
                                    <MudText Typo="Typo.body2">@ag.EventosProcesadosHoy</MudText>
                                </MudItem>
                                <MudItem xs="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Ventas hoy</MudText>
                                    <MudText Typo="Typo.body2">@ag.VentasImportadasHoy</MudText>
                                </MudItem>
                            </MudGrid>

                            @if (ag.EventosConError > 0)
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                                    @ag.EventosConError evento(s) bloqueado(s) — revisa el mapeo de artículos.
                                </MudAlert>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <div class="mt-3 d-flex align-center gap-2">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Refresh"
                           OnClick="CargarEstadoAsync" Disabled="_cargando">Actualizar</MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Se actualiza cada 30 segundos</MudText>
            </div>
        }
    </MudTabPanel>

    <!-- ══════════════════════════════════════ TAB 2: GUÍA -->
    <MudTabPanel Text="Instalación" Icon="@Icons.Material.Outlined.MenuBook">

        <MudAlert Severity="Severity.Info" Class="mb-4">
            El <strong>NexoSyncAgent</strong> es un servicio de Windows que se instala con un solo clic desde esta pantalla.
            Arranca automáticamente con Windows, no requiere consola ni intervención manual.
            El agente siempre queda en <code>C:\NexoSyncAgent\</code> en el servidor de NEXO.
        </MudAlert>

        <div class="nexo-item-card pa-4 mb-3">
            <div class="d-flex align-center gap-3 mb-2">
                <MudAvatar Color="Color.Primary" Size="Size.Small">1</MudAvatar>
                <MudText Typo="Typo.subtitle1" Style="font-weight:500">Registrar el agente en NEXO</MudText>
            </div>
            <ol style="padding-left:1.25rem;font-size:0.875rem;line-height:1.9;">
                <li>Ir a <strong>Catálogo → Centros de Costo</strong> → editar la sucursal</li>
                <li>Activar <strong>"Tiene integración con Visions"</strong> y configurar código CENTROCOSTO, bodega y prefijos</li>
                <li>Clic en <strong>"Generar API Key"</strong> — NEXO crea el agente automáticamente</li>
            </ol>
        </div>

        <div class="nexo-item-card pa-4 mb-3">
            <div class="d-flex align-center gap-3 mb-2">
                <MudAvatar Color="Color.Primary" Size="Size.Small">2</MudAvatar>
                <MudText Typo="Typo.subtitle1" Style="font-weight:500">Preparar la base de datos de Visions</MudText>
            </div>
            <MudPaper Class="pa-3" Style="background:#1e1e2e;border-radius:8px;overflow-x:auto;">
                <MudText Typo="Typo.caption" Style="color:#a6adc8;font-family:monospace;white-space:pre;">sqlcmd -S SERVIDOR\INSTANCIA -d NombreBaseVisions -E -i "C:\NexoSyncAgent\ScriptsVisions\sincronizacionVisionsNexo.sql"</MudText>
            </MudPaper>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">Solo crea 3 tablas <code>NEXO_*</code>. No toca nada existente.</MudText>
        </div>

        <div class="nexo-item-card pa-4 mb-3">
            <div class="d-flex align-center gap-3 mb-2">
                <MudAvatar Color="Color.Primary" Size="Size.Small">3</MudAvatar>
                <MudText Typo="Typo.subtitle1" Style="font-weight:500">Instalar el agente (elige el método según el servidor)</MudText>
            </div>
            <MudPaper Class="pa-3" Outlined="true">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudIcon Icon="@Icons.Material.Outlined.FileDownload" Color="Color.Success" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Descargar e instalar en el equipo del cliente</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">El instalador incluye todo — no hay que editar ningún archivo</MudText>
                    </div>
                </div>
                <ol style="padding-left:1.1rem;font-size:0.875rem;line-height:2;">
                    <li>Ir a <strong>Configurar agente</strong> (ícono ⚙), completar la conexión a Visions y guardar</li>
                    <li>Clic en <strong>"Descargar instalador"</strong> — genera <code>NexoAgente-Setup.exe</code> con todo incluido</li>
                    <li>En el equipo del cliente: doble clic en <code>NexoAgente-Setup.exe</code></li>
                    <li>Aceptar el Control de cuentas (UAC) — único paso manual</li>
                </ol>
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                    El instalador se copia solo a <code>C:\NexoSyncAgent\</code>, instala el servicio de Windows y lo arranca.
                    No hay extracción, no hay archivos BAT, no hay edición manual. Desde ese momento sincroniza con NEXO y arranca con Windows.
                </MudAlert>
            </MudPaper>
        </div>

        <div class="nexo-item-card pa-4 mb-3">
            <div class="d-flex align-center gap-3 mb-2">
                <MudAvatar Color="Color.Warning" Size="Size.Small"><MudIcon Icon="@Icons.Material.Outlined.WifiOff" Size="Size.Small" /></MudAvatar>
                <MudText Typo="Typo.subtitle1" Style="font-weight:500">¿Qué pasa si se corta la conexión?</MudText>
            </div>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">NEXO → Visions</MudText>
                    <MudText Typo="Typo.body2">Los eventos quedan en cola PENDIENTE. Al recuperar conexión se aplican automáticamente.</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">Visions → NEXO (ventas POS)</MudText>
                    <MudText Typo="Typo.body2">Las ventas no se marcan exportadas hasta que NEXO confirme. Se exportan todas al reconectar.</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                        Backoff automático: 30 s → 60 s → 120 s antes de reintentar cuando NEXO no responde.
                    </MudAlert>
                </MudItem>
            </MudGrid>
        </div>
    </MudTabPanel>

    <!-- ══════════════════════════════════════ TAB 3: CONFIGURAR -->
    <MudTabPanel Text="Configurar agente" Icon="@Icons.Material.Outlined.Settings" BadgeData="@(_agentes.Count > 0 ? null : "!")" BadgeColor="Color.Warning">

        @if (!_agentes.Any())
        {
            <MudAlert Severity="Severity.Info">
                Primero genera una API Key en <strong>Catálogo → Centros de Costo</strong>.
                El agente aparecerá aquí una vez generada.
            </MudAlert>
        }
        else if (_configAgente is null && !_cargandoConfig)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Selecciona el agente que deseas configurar:
            </MudText>
            <MudGrid>
                @foreach (var ag in _agentes)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="border: 0.5px solid var(--mud-palette-divider); border-radius: 10px;">
                            <div class="d-flex align-center justify-space-between">
                                <div class="d-flex align-center gap-2 cursor-pointer flex-grow-1"
                                     @onclick="@(() => AbrirConfigAsync(ag.AgenteSyncID))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Router" Color="Color.Primary" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2">@ag.NombreCentroCosto</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@ag.Descripcion</MudText>
                                    </div>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small"
                                               Color="Color.Error" Title="Eliminar agente"
                                               OnClick="@(() => EliminarAgenteAsync(ag.AgenteSyncID))" />
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
        else if (_cargandoConfig)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_configAgente is not null)
        {
            <div class="d-flex align-center gap-2 mb-4">
                <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small"
                               OnClick="@(() => _configAgente = null)" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:500">
                    Configuración — @_configAgente.NombreCentroCosto
                </MudText>
            </div>

            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                La <strong>URL de NEXO API</strong> y la <strong>clave del agente</strong> se configuran automáticamente al descargar el instalador — no hay que escribirlas.
            </MudAlert>

            <MudGrid>
                <!-- Servidor SQL de Visions -->
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_editVisionsServer"
                                  Label="Servidor SQL de Visions"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Placeholder="NOMBRE-PC\SQLEXPRESS"
                                  HelperText="Solo el nombre del servidor o instancia. Ej: DESKTOP-ABC123\JONATHAN" />
                </MudItem>

                <!-- Intervalo -->
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_editIntervalMinutes"
                                     Label="Intervalo de sincronización (min)"
                                     Variant="Variant.Outlined" FullWidth="true"
                                     Min="1" Max="60"
                                     HelperText="Cada cuántos minutos sincroniza con NEXO." />
                </MudItem>

                <!-- Botones -->
                <MudItem xs="12">
                    <div class="d-flex gap-2 flex-wrap align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Save"
                                   OnClick="GuardarConfigAsync" Disabled="_guardando">
                            Guardar configuración
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   StartIcon="@Icons.Material.Outlined.FileDownload"
                                   OnClick="DescargarInstaladorAsync" Disabled="_descargando">
                            @(_descargando ? "Preparando instalador…" : "Descargar instalador")
                        </MudButton>
                        <MudTooltip Text="Solo para actualizar la configuración en un agente ya instalado, sin reinstalar el servicio">
                            <MudButton Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Outlined.Settings"
                                       OnClick="DescargarAppsettingsAsync">
                                Actualizar config (.json)
                            </MudButton>
                        </MudTooltip>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        Descarga <strong>NexoAgente-Setup.exe</strong> (~87 MB). En el equipo del cliente: doble clic → Aceptar UAC → listo. Sin extracción, sin BAT, sin editar nada.
                    </MudText>
                </MudItem>

                <!-- Instrucción para servidor remoto -->
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudAlert Severity="Severity.Info" Dense="true">
                        <strong>¿Visions está en otro servidor?</strong>
                        Haz clic en <strong>"Descargar appsettings.json"</strong> — el archivo ya viene con
                        la clave de API configurada. Cópialo junto al <code>NexoSyncAgent.exe</code>
                        (reemplaza el existente) y ejecuta <code>Instalar-NexoSyncAgent.bat</code> como Administrador.
                        No necesitas escribir ni copiar ninguna clave manualmente.
                    </MudAlert>
                </MudItem>
            </MudGrid>
        }
    </MudTabPanel>

</MudTabs>

@code {
    // ── Estado ──────────────────────────────────────────────────────────
    private bool _cargando = true;
    private string? _errorCarga;
    private List<EstadoIntegracionResponse> _agentes = new();
    private System.Timers.Timer? _timer;

    // ── Config agente ────────────────────────────────────────────────────
    private bool _cargandoConfig;
    private ConfiguracionAgenteCompletaResponse? _configAgente;
    private string? _editVisionsServer;
    private int _editIntervalMinutes = 5;
    private bool _guardando;
    private bool _descargando;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadoAsync();
        _timer = new System.Timers.Timer(30_000);
        _timer.Elapsed += async (_, _) =>
        {
            await CargarEstadoAsync();
            await InvokeAsync(StateHasChanged);
        };
        _timer.Start();
    }

    private async Task CargarEstadoAsync()
    {
        _cargando = true;
        _errorCarga = null;
        try { _agentes = await ApiClient.GetAsync<List<EstadoIntegracionResponse>>("api/integracion/estado") ?? new(); }
        catch (Exception ex) { _errorCarga = ex.Message; }
        finally { _cargando = false; }
    }

    private async Task AbrirConfigAsync(int agenteSyncId)
    {
        _cargandoConfig = true;
        _configAgente = null;
        try
        {
            _configAgente = await ApiClient.GetAsync<ConfiguracionAgenteCompletaResponse>(
                $"api/integracion/agentes/{agenteSyncId}/config");

            if (_configAgente is not null)
            {
                _editVisionsServer   = ExtraerServidorSql(_configAgente.VisionsDbConexion);
                _editIntervalMinutes = _configAgente.IntervalMinutes > 0 ? _configAgente.IntervalMinutes : 5;
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _cargandoConfig = false; }
    }

    private async Task GuardarConfigAsync()
    {
        if (_configAgente is null) return;
        _guardando = true;
        try
        {
            await ApiClient.PutAsync<ActualizarConfiguracionAgenteRequest, object>(
                $"api/integracion/agentes/{_configAgente.AgenteSyncID}/config",
                new ActualizarConfiguracionAgenteRequest(_editVisionsServer, null, _editIntervalMinutes, null));
            Snackbar.Add("Configuración guardada.", Severity.Success);
            _configAgente = _configAgente with
            {
                VisionsDbConexion = _editVisionsServer,
                IntervalMinutes   = _editIntervalMinutes
            };
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _guardando = false; }
    }

    private async Task DescargarInstaladorAsync()
    {
        if (_configAgente is null) return;
        _descargando = true;
        try
        {
            // Guardar config primero para que el ZIP lleve los datos actuales.
            await GuardarConfigAsync();

            // La API genera el ZIP + rota la API Key y devuelve un token de descarga de un solo uso.
            var resultado = await ApiClient.PostAsync<object, DescargaTokenResponse>(
                $"api/integracion/agentes/{_configAgente.AgenteSyncID}/preparar-descarga", new { });

            if (resultado?.Token is null)
            {
                Snackbar.Add("No se pudo preparar el instalador. Verifica que NexoApi fue publicado con el agente bundled.", Severity.Error);
                return;
            }

            // El endpoint de descarga es AllowAnonymous; el navegador descarga el ZIP directamente.
            var apiBase = Config["NexoApi:BaseUrl"]!.TrimEnd('/');
            await JS.InvokeVoidAsync("nexoDescargarUrl", $"{apiBase}/api/integracion/descargar-agente/{resultado.Token}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _descargando = false; }
    }

    private async Task DescargarAppsettingsAsync()
    {
        if (_configAgente is null) return;
        try
        {
            var contenido = await ApiClient.GetAsync<string>(
                $"api/integracion/agentes/{_configAgente.AgenteSyncID}/appsettings-json");
            if (contenido is null) return;

            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(contenido));
            await JS.InvokeVoidAsync("nexoDescargarArchivo", "appsettings.json", "application/json", base64);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task EliminarAgenteAsync(int agenteSyncId)
    {
        try
        {
            await ApiClient.DeleteAsync($"api/integracion/agentes/{agenteSyncId}");
            Snackbar.Add("Agente eliminado.", Severity.Success);
            if (_configAgente?.AgenteSyncID == agenteSyncId)
                _configAgente = null;
            await CargarEstadoAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    // Extrae el nombre de servidor de una cadena de conexion completa o lo devuelve tal cual si ya es solo el nombre.
    private static string? ExtraerServidorSql(string? conexion)
    {
        if (string.IsNullOrWhiteSpace(conexion)) return null;
        var match = System.Text.RegularExpressions.Regex.Match(conexion, @"(?i)(?:server|data source)\s*=\s*([^;]+)");
        return match.Success ? match.Groups[1].Value.Trim() : conexion;
    }

    private record DescargaTokenResponse(string Token);

    private (Color Color, string Texto) EstadoAgente(EstadoIntegracionResponse ag)
    {
        if (!ag.Activo) return (Color.Default, "Desactivado");
        if (!ag.UltimoLatido.HasValue) return (Color.Warning, "Sin conexión");
        var hace = DateTime.UtcNow - ag.UltimoLatido.Value;
        if (hace.TotalMinutes < 10) return (Color.Success, "Conectado");
        if (hace.TotalMinutes < 30) return (Color.Warning, "Alerta");
        return (Color.Error, "Sin respuesta");
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
