<MudNavMenu>
    @* Favoritos *@
    @if (Preferencias.Favoritos.Count > 0)
    {
        <MudNavGroup Title="Favoritos" Icon="@Icons.Material.Filled.Bookmark" Expanded="false">
            @foreach (var favorito in Preferencias.Favoritos)
            {
                <MudNavLink Href="@favorito.Href">@favorito.Etiqueta</MudNavLink>
            }
        </MudNavGroup>
    }

    @* Business Intelligence — raiz, sin grupo *@
    @if (Modulos.EsVisible("BI"))
    {
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Insights">
            Business Intelligence
        </MudNavLink>
    }

    @* Produccion *@
    @if (Modulos.EsVisible("PRODUCCION"))
    {
        <MudNavGroup Title="Produccion" Icon="@Icons.Material.Filled.Factory" Expanded="true">
            @if (Modulos.EsVisible("PRODUCCION.ORDENES"))
            {
                <MudNavLink Href="/produccion/ordenes" Icon="@Icons.Material.Filled.Assignment">Ordenes de Produccion</MudNavLink>
            }
            @if (Modulos.EsVisible("PRODUCCION.RECETAS"))
            {
                <MudNavLink Href="/produccion/recetas" Icon="@Icons.Material.Filled.MenuBook">Recetas (BOM)</MudNavLink>
            }
            @if (Modulos.EsVisible("PRODUCCION.MAQUINARIA"))
            {
                <MudNavLink Href="/produccion/maquinaria" Icon="@Icons.Material.Filled.PrecisionManufacturing">Maquinaria</MudNavLink>
            }
        </MudNavGroup>
    }

    @* Inventario *@
    @if (Modulos.EsVisible("INVENTARIO"))
    {
        <MudNavGroup Title="Inventario" Icon="@Icons.Material.Filled.Inventory2" Expanded="false">
            @if (Modulos.EsVisible("INVENTARIO.STOCK"))
            {
                <MudNavLink Href="/inventario/stock" Icon="@Icons.Material.Filled.Inventory">Consulta de Stock</MudNavLink>
            }
            @if (Modulos.EsVisible("INVENTARIO.KARDEX"))
            {
                <MudNavLink Href="/inventario/kardex" Icon="@Icons.Material.Filled.ReceiptLong">Kardex de Articulos</MudNavLink>
            }
            @if (Modulos.EsVisible("INVENTARIO.AJUSTES"))
            {
                <MudNavLink Href="/inventario/ajustes" Icon="@Icons.Material.Filled.Tune">Ajuste de Inventario</MudNavLink>
            }
            @if (Modulos.EsVisible("INVENTARIO.BAJAS"))
            {
                <MudNavLink Href="/inventario/bajas" Icon="@Icons.Material.Filled.RemoveCircleOutline">Registrar Baja</MudNavLink>
            }
            @if (Modulos.EsVisible("INVENTARIO.TRASPASOS"))
            {
                <MudNavLink Href="/inventario/traspasos" Icon="@Icons.Material.Filled.MoveDown">Traspasos</MudNavLink>
            }
        </MudNavGroup>
    }

    @* Operaciones *@
    @if (Modulos.EsVisible("OPERACIONES"))
    {
        <MudNavGroup Title="Operaciones" Icon="@Icons.Material.Filled.SwapHoriz" Expanded="false">
            @if (Modulos.EsVisible("OPERACIONES.MOVIMIENTOS"))
            {
                <MudNavLink Href="/operaciones/movimientos" Icon="@Icons.Material.Filled.Timeline">Movimientos</MudNavLink>
            }
            @if (Modulos.EsVisible("OPERACIONES.COMPRAS"))
            {
                <MudNavLink Href="/compras/ordenes" Icon="@Icons.Material.Filled.ShoppingCart">Ordenes de Compra</MudNavLink>
            }
            @if (Modulos.EsVisible("OPERACIONES.DESPACHOS"))
            {
                <MudNavLink Href="/logistica/despachos" Icon="@Icons.Material.Filled.LocalShipping">Despachos</MudNavLink>
            }
            @if (Modulos.EsVisible("OPERACIONES.FACTURACION"))
            {
                <MudNavLink Href="/facturacion" Icon="@Icons.Material.Filled.Receipt">Facturacion</MudNavLink>
            }
        </MudNavGroup>
    }

    @* Catalogo *@
    @if (Modulos.EsVisible("CATALOGO"))
    {
        <MudNavGroup Title="Catalogo" Icon="@Icons.Material.Filled.Category" Expanded="false">
            @if (Modulos.EsVisible("CATALOGO.ARTICULOS"))
            {
                <MudNavLink Href="/catalogo/articulos" Icon="@Icons.Material.Filled.ViewInAr">Articulos</MudNavLink>
            }
            @if (Modulos.EsVisible("CATALOGO.CENTROSCOSTO"))
            {
                <MudNavLink Href="/catalogo/centros-costo" Icon="@Icons.Material.Filled.BusinessCenter">Centros de Costo</MudNavLink>
            }
            @if (Modulos.EsVisible("CATALOGO.CENTROSTRABAJO"))
            {
                <MudNavLink Href="/catalogo/centros-trabajo" Icon="@Icons.Material.Filled.Work">Centros de Trabajo</MudNavLink>
            }
            @if (Modulos.EsVisible("CATALOGO.BODEGAS"))
            {
                <MudNavLink Href="/catalogo/bodegas" Icon="@Icons.Material.Filled.Warehouse">Bodegas</MudNavLink>
            }
            @if (Modulos.EsVisible("CATALOGO.PROVEEDORES"))
            {
                <MudNavLink Href="/catalogo/proveedores" Icon="@Icons.Material.Filled.Store">Proveedores</MudNavLink>
                @if (ConfiguracionEmpresa.UsaVisions)
                {
                    <MudNavLink Href="/catalogo/mapeo-articulos-visions" Icon="@Icons.Material.Filled.SyncAlt">Mapeo Articulos Visions</MudNavLink>
                }
            }
        </MudNavGroup>
    }

    @* Planificacion *@
    @if (Modulos.EsVisible("PLANIFICACION"))
    {
        <MudNavGroup Title="Planificacion" Icon="@Icons.Material.Filled.Timeline" Expanded="false">
            @if (Modulos.EsVisible("PLANIFICACION.DEMANDA"))
            {
                <MudNavLink Href="/planificacion/demanda" Icon="@Icons.Material.Filled.TrendingUp">Demanda Proyectada</MudNavLink>
            }
            @if (Modulos.EsVisible("PLANIFICACION.METAS"))
            {
                <MudNavLink Href="/planificacion/metas-venta" Icon="@Icons.Material.Filled.Flag">Metas de Venta</MudNavLink>
            }
            @if (Modulos.EsVisible("PLANIFICACION.CALENDARIO"))
            {
                <MudNavLink Href="/planificacion/calendario" Icon="@Icons.Material.Filled.CalendarMonth">Calendario</MudNavLink>
            }
            @if (Modulos.EsVisible("PLANIFICACION.PROYECTOS"))
            {
                <MudNavLink Href="/proyectos" Icon="@Icons.Material.Filled.AccountTree">Proyectos</MudNavLink>
            }
        </MudNavGroup>
    }

    @* CRM *@
    @if (Modulos.EsVisible("CRM"))
    {
        <MudNavGroup Title="CRM" Icon="@Icons.Material.Filled.Handshake" Expanded="false">
            @if (Modulos.EsVisible("CRM.CLIENTES"))
            {
                <MudNavLink Href="/crm/clientes" Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
            }
            @if (Modulos.EsVisible("CRM.LEADS"))
            {
                <MudNavLink Href="/crm/leads" Icon="@Icons.Material.Filled.PersonSearch">Leads</MudNavLink>
            }
            @if (Modulos.EsVisible("CRM.OPORTUNIDADES"))
            {
                <MudNavLink Href="/crm/oportunidades" Icon="@Icons.Material.Filled.MonetizationOn">Oportunidades</MudNavLink>
            }
            @if (Modulos.EsVisible("CRM.ACTIVIDADES"))
            {
                <MudNavLink Href="/crm/actividades" Icon="@Icons.Material.Filled.EventNote">Actividades</MudNavLink>
            }
            @if (Modulos.EsVisible("CRM.COTIZACIONES"))
            {
                <MudNavLink Href="/crm/cotizaciones" Icon="@Icons.Material.Filled.RequestQuote">Cotizaciones</MudNavLink>
            }
            @if (Modulos.EsVisible("CRM.CAMPANAS"))
            {
                <MudNavLink Href="/crm/campanas" Icon="@Icons.Material.Filled.Campaign">Campanas</MudNavLink>
            }
            @if (Modulos.EsVisible("CRM.COMBOS"))
            {
                <MudNavLink Href="/marketing/combos" Icon="@Icons.Material.Filled.LocalOffer">Combos / Ofertas</MudNavLink>
            }
        </MudNavGroup>
    }

    @* Recursos Humanos *@
    @if (Modulos.EsVisible("RRHH"))
    {
        <MudNavGroup Title="Recursos Humanos" Icon="@Icons.Material.Filled.Badge" Expanded="false">
            @if (Modulos.EsVisible("RRHH.EMPLEADOS"))
            {
                <MudNavLink Href="/rrhh/empleados" Icon="@Icons.Material.Filled.Person">Empleados</MudNavLink>
            }
            @if (Modulos.EsVisible("RRHH.ASISTENCIA"))
            {
                <MudNavLink Href="/rrhh/asistencia" Icon="@Icons.Material.Filled.FactCheck">Asistencia</MudNavLink>
            }
            @if (Modulos.EsVisible("RRHH.HORARIOS"))
            {
                <MudNavLink Href="/rrhh/horarios" Icon="@Icons.Material.Filled.Schedule">Horarios</MudNavLink>
            }
            @if (Modulos.EsVisible("RRHH.CARGOS"))
            {
                <MudNavLink Href="/rrhh/cargos" Icon="@Icons.Material.Filled.Work">Cargos y Departamentos</MudNavLink>
            }
            @if (Modulos.EsVisible("RRHH.AUSENCIAS"))
            {
                <MudNavLink Href="/rrhh/ausencias" Icon="@Icons.Material.Filled.BeachAccess">Ausencias y Vacaciones</MudNavLink>
            }
            @if (Modulos.EsVisible("RRHH.ORGANIGRAMA"))
            {
                <MudNavLink Href="/rrhh/organigrama" Icon="@Icons.Material.Filled.AccountTree">Organigrama</MudNavLink>
            }
            @* Usuarios del sistema y Roles — exclusivo Admin *@
            <AuthorizeView Roles="Administracion">
                <Authorized>
                    @if (Modulos.EsVisible("RRHH.USUARIOS"))
                    {
                        <MudNavLink Href="/admin/usuarios" Icon="@Icons.Material.Filled.ManageAccounts">Usuarios del Sistema</MudNavLink>
                    }
                    <MudNavLink Href="/admin/roles" Icon="@Icons.Material.Filled.AdminPanelSettings">
                        Roles y Modulos
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    [Inject] private NexoWeb.Common.Auth.PreferenciasState Preferencias { get; set; } = default!;
    [Inject] private NexoWeb.Common.Auth.ConfiguracionEmpresaState ConfiguracionEmpresa { get; set; } = default!;
    [Inject] private NexoWeb.Common.Auth.ModulosVisiblesState Modulos { get; set; } = default!;
    [Inject] private NexoWeb.Common.Auth.AuthStateService Auth { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        ConfiguracionEmpresa.OnCambio += StateHasChanged;
        Modulos.OnCambio += StateHasChanged;
        Auth.OnChange += RecargarModulos;

        await Modulos.CargarAsync(Auth.Rol, Auth.UsuarioId);
    }

    private async void RecargarModulos()
    {
        await Modulos.CargarAsync(Auth.Rol, Auth.UsuarioId);
        await InvokeAsync(StateHasChanged);
    }
}
