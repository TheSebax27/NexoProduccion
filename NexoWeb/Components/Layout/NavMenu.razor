<MudNavMenu>
    @* Favoritos: paginas marcadas desde el boton de marcador de cada
       subpagina (ver BotonFavorito.razor) -- grupo vacio si no hay ninguna. *@
    @if (Preferencias.Favoritos.Count > 0)
    {
        <MudNavGroup Title="Favoritos" Icon="@Icons.Material.Filled.Bookmark" Expanded="false">
            @foreach (var favorito in Preferencias.Favoritos)
            {
                <MudNavLink Href="@favorito.Href">@favorito.Etiqueta</MudNavLink>
            }
        </MudNavGroup>
    }

    <AuthorizeView Roles="Administracion,Jefes,Empleados">
        <Authorized>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Insights">
                Business Intelligence
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    @* El grupo entero debe ocultarse si el rol no tiene acceso a NINGUNA
       subpagina de adentro -- antes el MudNavGroup se mostraba siempre,
       vacio, para roles sin acceso a ningun hijo (ej. Empleados veia
       "Produccion" sin ninguna opcion debajo). *@
    <AuthorizeView Roles="Administracion,Jefes,Subempleados" Context="grupoProduccion">
        <Authorized>
            <MudNavGroup Title="Produccion" Icon="@Icons.Material.Filled.Factory" Expanded="true">
                <AuthorizeView Roles="Administracion,Jefes,Subempleados">
                    <Authorized>
                        <MudNavLink Href="/produccion/ordenes">Ordenes de Produccion</MudNavLink>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="Administracion,Jefes">
                    <Authorized>
                        <MudNavLink Href="/produccion/recetas">Recetas (BOM)</MudNavLink>
                    </Authorized>
                </AuthorizeView>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    @* Inventario siempre tiene al menos "Consulta de Stock" (todos los
       roles autenticados), asi que el grupo no necesita AuthorizeView propio. *@
    <MudNavGroup Title="Inventario" Icon="@Icons.Material.Filled.Inventory2" Expanded="false">
        <MudNavLink Href="/inventario/stock">Consulta de Stock</MudNavLink>
        <AuthorizeView Roles="Administracion,Jefes,Empleados">
            <Authorized>
                <MudNavLink Href="/inventario/kardex">Kardex de Artículos</MudNavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Administracion,Empleados">
            <Authorized>
                <MudNavLink Href="/inventario/ajustes">Ajuste de Inventario</MudNavLink>
                <MudNavLink Href="/inventario/bajas">Registrar Baja</MudNavLink>
                <MudNavLink Href="/inventario/traspasos">Traspasos</MudNavLink>
            </Authorized>
        </AuthorizeView>
    </MudNavGroup>

    <AuthorizeView Roles="Administracion,Empleados">
        <Authorized>
            <MudNavGroup Title="Operaciones" Icon="@Icons.Material.Filled.SwapHoriz" Expanded="false">
                <MudNavLink Href="/operaciones/movimientos" Icon="@Icons.Material.Filled.Timeline">Movimientos</MudNavLink>
                <MudNavLink Href="/compras/ordenes" Icon="@Icons.Material.Filled.ShoppingCart">Ordenes de Compra</MudNavLink>
                <MudNavLink Href="/logistica/despachos" Icon="@Icons.Material.Filled.LocalShipping">Despachos</MudNavLink>
                <MudNavLink Href="/facturacion" Icon="@Icons.Material.Filled.Receipt">Facturación</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administracion,Jefes" Context="grupoCatalogo">
        <Authorized>
            <MudNavGroup Title="Catalogo" Icon="@Icons.Material.Filled.Category" Expanded="false">
                @* Articulos.razor exige Administracion,Jefes -- antes este
                   link no tenia AuthorizeView y aparecia para cualquiera (ej.
                   Empleados), pero al entrar la pagina lo rechazaba (pantalla en blanco). *@
                <AuthorizeView Roles="Administracion,Jefes">
                    <Authorized>
                        <MudNavLink Href="/catalogo/articulos">Articulos</MudNavLink>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="Administracion">
                    <Authorized>
                        <MudNavLink Href="/catalogo/centros-costo">Centros de Costo</MudNavLink>
                        <MudNavLink Href="/catalogo/centros-trabajo">Centros de Trabajo</MudNavLink>
                        <MudNavLink Href="/catalogo/bodegas">Bodegas</MudNavLink>
                        <MudNavLink Href="/catalogo/proveedores">Proveedores</MudNavLink>
                        @if (ConfiguracionEmpresa.UsaVisions)
                        {
                            <MudNavLink Href="/catalogo/mapeo-articulos-visions">Mapeo Articulos Visions</MudNavLink>
                        }
                    </Authorized>
                </AuthorizeView>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administracion,Jefes">
        <Authorized>
            <MudNavGroup Title="Planificacion" Icon="@Icons.Material.Filled.Timeline" Expanded="false">
                <MudNavLink Href="/planificacion/demanda">Demanda Proyectada</MudNavLink>
                <MudNavLink Href="/planificacion/metas-venta">Metas de Venta</MudNavLink>
                <MudNavLink Href="/proyectos">Proyectos</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administracion">
        <Authorized>
            <MudNavGroup Title="CRM" Icon="@Icons.Material.Filled.Handshake" Expanded="false">
                <MudNavLink Href="/crm/clientes">Clientes</MudNavLink>
                <MudNavLink Href="/crm/leads">Leads</MudNavLink>
                <MudNavLink Href="/crm/oportunidades">Oportunidades</MudNavLink>
                <MudNavLink Href="/crm/cotizaciones">Cotizaciones</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administracion">
        <Authorized>
            <MudNavGroup Title="Recursos Humanos" Icon="@Icons.Material.Filled.Badge" Expanded="false">
                <MudNavLink Href="/rrhh/empleados">Empleados</MudNavLink>
                <MudNavLink Href="/rrhh/cargos">Cargos y Departamentos</MudNavLink>
                <MudNavLink Href="/rrhh/ausencias">Ausencias y Vacaciones</MudNavLink>
                <MudNavLink Href="/rrhh/organigrama">Organigrama</MudNavLink>
                <MudNavLink Href="/admin/usuarios">Usuarios del Sistema</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    [Inject] private NexoWeb.Common.Auth.PreferenciasState Preferencias { get; set; } = default!;
    [Inject] private NexoWeb.Common.Auth.ConfiguracionEmpresaState ConfiguracionEmpresa { get; set; } = default!;

    protected override void OnInitialized()
    {
        ConfiguracionEmpresa.OnCambio += StateHasChanged;
    }
}
