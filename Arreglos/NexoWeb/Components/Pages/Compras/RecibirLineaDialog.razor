@using NexoWeb.Common.Dtos

<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">Articulo: <b>@Articulo</b></MudText>
        <MudText Class="mb-3">Pendiente por recibir: <b>@Pendiente.ToString("N2")</b></MudText>

        <MudNumericField @bind-Value="_cantidadRecibida" Label="Cantidad recibida" Min="0.01m" Max="@Pendiente" Class="mb-3" />
        <MudTextField @bind-Value="_numeroLote" Label="Numero de lote" Class="mb-3" />
        <MudDatePicker @bind-Date="_fechaVencimiento" Label="Fecha de vencimiento (opcional)" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirmar"
                   Disabled="@(_cantidadRecibida <= 0 || string.IsNullOrWhiteSpace(_numeroLote))">
            Recibir
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Articulo { get; set; } = "";
    [Parameter] public decimal Pendiente { get; set; }

    private decimal _cantidadRecibida;
    private string _numeroLote = "";
    private DateTime? _fechaVencimiento;

    private void Confirmar()
    {
        var request = new RecibirLineaOrdenCompraRequest(_cantidadRecibida, _numeroLote, _fechaVencimiento);
        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancelar() => MudDialog.Cancel();
}