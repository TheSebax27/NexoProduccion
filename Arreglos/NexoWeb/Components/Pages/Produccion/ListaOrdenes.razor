@page "/produccion/ordenes"
@attribute [Authorize(Roles = "Administrador,SupervisorPlanta,Operario")]
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NexoWeb.Common.Dtos

<PageTitle>Ordenes de Produccion - NEXO</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Ordenes de Produccion</MudText>
@if (_puedeGestionar)
{
    <MudButton Variant="Variant.Filled" Color="Color.Success" Href="/produccion/ordenes/crear"
               StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
        Nueva Orden
    </MudButton>
}
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="string" @bind-Value="_filtroEstado" Label="Filtrar por estado" Clearable="true">
            <MudSelectItem Value="@("Planificada")">Planificada</MudSelectItem>
            <MudSelectItem Value="@("Liberada")">Liberada</MudSelectItem>
            <MudSelectItem Value="@("En Proceso")">En Proceso</MudSelectItem>
            <MudSelectItem Value="@("Finalizada")">Finalizada</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4" Class="d-flex align-center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarAsync" StartIcon="@Icons.Material.Filled.Refresh">
            Actualizar
        </MudButton>
    </MudItem>
</MudGrid>

@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <MudTable Items="_ordenes" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>Codigo</MudTh>
            <MudTh>Producto</MudTh>
            <MudTh>Centro de Costo</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Programada</MudTh>
            <MudTh>Producida</MudTh>
            <MudTh>Costo Unitario</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Codigo">@context.CodigoOP</MudTd>
            <MudTd DataLabel="Producto">@context.Producto</MudTd>
            <MudTd DataLabel="Centro de Costo">@context.CentroCosto</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="@ColorSegunEstado(context.Estado)" Size="Size.Small">@context.Estado</MudChip>
            </MudTd>
            <MudTd DataLabel="Programada">@context.CantidadProgramada.ToString("N2")</MudTd>
            <MudTd DataLabel="Producida">@(context.CantidadProducidaReal?.ToString("N2") ?? "-")</MudTd>
            <MudTd DataLabel="Costo Unitario">@(context.CostoUnitarioReal?.ToString("C2") ?? "-")</MudTd>
            <MudTd DataLabel="Acciones">
                @if (context.Estado == "Planificada" && _puedeGestionar)
                {
                    <MudButton Size="Size.Small" Color="Color.Info" OnClick="@(() => LiberarAsync(context.OrdenProduccionID))">
                        Liberar
                    </MudButton>
                }
                @if (context.Estado == "Liberada" && _puedeGestionar)
                {
                    <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => IniciarAsync(context.OrdenProduccionID))">
                        Iniciar
                    </MudButton>
                }
                @if (context.Estado == "En Proceso" && _puedeCerrar)
                {
                    <MudButton Size="Size.Small" Color="Color.Success" OnClick="@(() => AbrirCierreAsync(context.OrdenProduccionID))">
                        Cerrar
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay ordenes de produccion con este filtro.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAuth { get; set; }

    private List<OrdenProduccionResumen> _ordenes = new();
    private string? _filtroEstado;
    private bool _cargando = true;
    private bool _puedeGestionar;
    private bool _puedeCerrar;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAuth is not null)
        {
            var estado = await EstadoAuth;
            _puedeGestionar = estado.User.IsInRole("Administrador") || estado.User.IsInRole("SupervisorPlanta");
            _puedeCerrar = _puedeGestionar; // cerrar tiene la misma restriccion que liberar
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;

        var ruta = string.IsNullOrEmpty(_filtroEstado)
            ? "api/produccion/ordenes"
            : $"api/produccion/ordenes?estado={Uri.EscapeDataString(_filtroEstado)}";

        try
        {
            _ordenes = await ApiClient.GetAsync<List<OrdenProduccionResumen>>(ruta) ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo cargar la lista: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task LiberarAsync(int id) =>
    await EjecutarAccionAsync(() => ApiClient.PostAsync($"api/produccion/ordenes/{id}/liberar"), "Orden liberada correctamente.");

private async Task IniciarAsync(int id) =>
    await EjecutarAccionAsync(() => ApiClient.PostAsync($"api/produccion/ordenes/{id}/iniciar"), "Orden iniciada, materia prima descontada.");

    private async Task AbrirCierreAsync(int id)
    {
        var dialogo = await DialogService.ShowAsync<CerrarOrdenDialog>("Cerrar Orden de Produccion");
        var resultado = await dialogo.Result;

        if (resultado is null || resultado.Canceled)
            return;

        var request = (CerrarOrdenProduccionRequest)resultado.Data!;

        await EjecutarAccionAsync(() => ApiClient.PostAsync<CerrarOrdenProduccionRequest, object?>($"api/produccion/ordenes/{id}/cerrar", request),
            "Orden finalizada correctamente.");
    }

    private async Task EjecutarAccionAsync(Func<Task> accion, string mensajeExito)
    {
        try
        {
            await accion();
            Snackbar.Add(mensajeExito, Severity.Success);
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            // El ExceptionHandlingMiddleware de NexoApi ya nos manda el
            // mensaje de negocio exacto (ej. "Stock insuficiente...");
            // aqui solo lo mostramos tal cual llega.
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static Color ColorSegunEstado(string estado) => estado switch
    {
        "Planificada" => Color.Default,
        "Liberada" => Color.Info,
        "En Proceso" => Color.Warning,
        "Finalizada" => Color.Success,
        "Cancelada" => Color.Error,
        _ => Color.Default
    };
}