@page "/produccion/recetas"
@attribute [Authorize(Roles = "Administrador,SupervisorPlanta")]
@inject INexoApiClient ApiClient
@inject IDialogService DialogService
@inject NavigationManager Navegacion
@using NexoWeb.Common.Dtos

<PageTitle>Recetas (BOM) - NEXO</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Recetas (BOM)</MudText>

<MudGrid Class="mb-4" Justify="Justify.SpaceBetween">
    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="int?" Value="_filtroProductoId" ValueChanged="OnFiltroCambiadoAsync"
                   Label="Filtrar por Producto Terminado" Clearable="true">
            @foreach (var articulo in _articulos)
            {
                <MudSelectItem T="int?" Value="@articulo.ArticuloID">@articulo.Nombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem>
        <MudSwitch T="bool" @bind-Value="_soloActivas" Label="Solo versiones activas" Color="Color.Primary"
                   @bind-Value:after="CargarAsync" />
    </MudItem>
</MudGrid>

<MudButton Variant="Variant.Filled" Color="Color.Success" Href="/produccion/recetas/crear"
           StartIcon="@Icons.Material.Filled.Add" Class="mb-4">
    Nueva Receta
</MudButton>

@if (_cargando)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4" />
}
else
{
    <MudTable Items="_recetas" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>Producto Terminado</MudTh>
            <MudTh>Receta</MudTh>
            <MudTh>Version</MudTh>
            <MudTh>Rendimiento</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Producto Terminado">@context.ProductoTerminado</MudTd>
            <MudTd DataLabel="Receta">@context.NombreReceta</MudTd>
            <MudTd DataLabel="Version">v@(context.Version)</MudTd>
            <MudTd DataLabel="Rendimiento">@context.CantidadRendimientoBase.ToString("N2") @context.UnidadRendimiento</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="@(context.Estado ? Color.Success : Color.Default)" Size="Size.Small">
                    @(context.Estado ? "Activa" : "Reemplazada")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudButton Size="Size.Small" OnClick="@(() => VerDetalleAsync(context))">
                    Ver Insumos
                </MudButton>
                @if (context.Estado)
                {
                    <MudButton Size="Size.Small" Color="Color.Primary"
                               Href="@($"/produccion/recetas/{context.RecetaID}/nueva-version")">
                        Nueva Version
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay recetas registradas para este filtro.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<RecetaResumen> _recetas = new();
    private List<ArticuloItem> _articulos = new();
    private int? _filtroProductoId;
    private bool _soloActivas = true;
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        // Se usa para el filtro por producto terminado y para etiquetar el
        // selector "Producto Terminado" al crear una receta nueva.
        _articulos = await ApiClient.GetAsync<List<ArticuloItem>>("api/catalogo/articulos") ?? new();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;

        var query = new List<string> { $"soloActivas={_soloActivas.ToString().ToLower()}" };
        if (_filtroProductoId.HasValue)
            query.Add($"productoTerminadoId={_filtroProductoId}");

        var ruta = "api/produccion/recetas?" + string.Join("&", query);
        _recetas = await ApiClient.GetAsync<List<RecetaResumen>>(ruta) ?? new();
        _cargando = false;
    }

    private async Task OnFiltroCambiadoAsync(int? nuevoValor)
    {
        _filtroProductoId = nuevoValor;
        await CargarAsync();
    }

    private async Task VerDetalleAsync(RecetaResumen receta)
    {
        var parametros = new DialogParameters<RecetaDetalleDialog>
        {
            { x => x.RecetaID, receta.RecetaID }
        };

        await DialogService.ShowAsync<RecetaDetalleDialog>(
            $"Insumos de: {receta.NombreReceta} (v{receta.Version})", parametros);
    }
}